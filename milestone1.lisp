(load (merge-pathnames "load.lisp" *load-truename*))
(load (merge-pathnames "fixtures.lisp" *load-truename*))
(in-package #:lisploop)

;;; Freeze the two reporting objectives before running the experiment.
(defparameter *objective-settings* '((:description 0 0) (:positive-work 1/100 1/1000)))

(defun report-outcome (message)
  (format t "  call=~S ~S ~S~%" (message-call-id message) (message-claim message)
          (message-evidence message)))

(defun report-ledger (name ledger)
  (format t "~A: ~D ~S~%" name (ledger-total ledger)
          (sort (copy-tree (ledger-counts ledger)) #'string< :key (lambda (x) (symbol-name (car x))))))

(let ((start (get-internal-real-time))
      (experiment-work (make-ledger)))
  (format t "lisploop / plan4 milestone 1 / encoding v1, tariff v1~%")
  (format t "SBCL ~A; deterministic fixture, no random seed or learned prior.~%" (lisp-implementation-version))
  (format t "Settings (name lambda-run lambda-search), fixed before execution: ~S~2%" *objective-settings*)
  (multiple-value-bind (frame oracle records) (gf5-fixture experiment-work)
    (let* ((field (gf 5)) (inputs (schema-inputs (frame-schema frame)))
           (language (make-language field inputs))
           (job (start-search frame language :call-id :m1-direct))
           (bound (description-size oracle))
           (initial-bound (description-size (app (op :+ field) (var 0 field) (var 1 field)))))
      (format t "Observations: complete GF(5), rows (key a b y):~%~S~%" records)
      (format t "Frame: inputs ~S, target ~S. Each row has a singleton allowed set.~%" inputs field)
      (format t "Keys are occurrence identities, never predictor arguments.~%")
      (format t "Oracle, outside learner inputs: y=a+2b; only its observations enter search.~%")
      (format t "Grammar: v0, v1, field literals 0..4, binary + and *. No quotienting or rewrites.~%")
      (format t "Proposal: direct programs. Child requirement: none. Origin: :m1-direct.~2%")
      (report-outcome (resume-search job initial-bound 15))
      (assert (null (search-job-results job)))
      (let ((small (resume-search job initial-bound 100000)))
        (report-outcome small)
        (assert (eq :bounded-exhaustion (message-claim small)))
        (assert (null (search-job-results job))))
      (report-outcome (resume-search job bound (1+ (ledger-total (search-job-ledger job)))))
      (let ((complete (resume-search job bound 5000000)))
        (report-outcome complete)
        (assert (eq :bounded-exhaustion (message-claim complete))))
      (let* ((best (search-job-best job))
             (model (candidate-expression best))
             (lookup (lookup-model frame experiment-work))
             (lookup-run (replay-model lookup frame experiment-work))
             (replay-run (replay-model model frame experiment-work))
             (targets (lit (sequence-type field) (mapcar #'fourth records)))
             (raw-table (lit (sequence-type (tuple-type :index field field field)) records))
             (search-work (ledger-total (search-job-ledger job))))
        (assert (= replay-run (candidate-run-work best)))
        (format t "~%Returned model: ~S~%" model)
        (format t "Canonical bytes: ~A~%" (canonical-string model))
        (format t "Verified candidates: ~D; rejected: ~D. First accepted at work ~D.~%"
                (length (search-job-results job)) (search-job-rejected job)
                (candidate-discovery-work best))
        (format t "Isolated decode/replay: 25/25. Evidence: exhaustive finite-domain validation, GF(5).~%")
        (format t "Formula: S=~D bytes, W_run=~D on 25 rows, canonical W_search=~D.~%"
                (candidate-size best) replay-run search-work)
        (format t "Packaged lookup baseline: S=~D bytes, W_run=~D; 25 encoded entries, no live store.~%"
                (description-size lookup) lookup-run)
        (format t "Literal target sequence: ~D bytes; full (key,a,b,y) table: ~D bytes.~%"
                (description-size targets) (description-size raw-table))
        (format t "The target-sequence baseline is an ordered whole object, not a function of (a,b).~%")
        (format t "This fixture does not compress that target sequence under encoding v1 (~D vs ~D bytes).~%"
                (candidate-size best) (description-size targets))
        (dolist (setting *objective-settings*)
          (destructuring-bind (name run-weight search-weight) setting
            (let* ((ranked (stable-sort (copy-list (search-job-results job)) #'<
                                        :key (lambda (c) (candidate-score c run-weight))))
                   (chosen (first ranked))
                   (score (candidate-score chosen run-weight)))
              (format t "~S: best verified J=~,3F; lookup J=~,3F; procedure J=~,3F.~%"
                      name score (+ (description-size lookup) (* run-weight lookup-run))
                      (+ score (* search-weight (+ search-work (ledger-total experiment-work))))))))
        (report-ledger "Canonical discovery ledger" (search-job-ledger job))
        (report-ledger "Experiment overhead (observations, baseline, independent replay)" experiment-work)
        (format t "Total acquisition work for this comparison: ~D. Validation execution is charged here;~%"
                (+ search-work (ledger-total experiment-work)))
        (format t "W_run separately reports future execution of an already acquired model.~2%"))
      ;; A supplied decoder is a mechanism check, not an automatically discovered view.
      (let* ((control-work (make-ledger))
             (decoder (app (op :+ field) (var 0 field) (var 9 field)))
             (bindings (list (cons 3 (var 1 field))))
             (child (pullback-frame frame decoder 9 field bindings control-work))
             (child-job (start-search child (make-language field (schema-inputs (frame-schema child)))
                                       :call-id :m1-supplied-child))
             (outcome (resume-search child-job initial-bound 1000000))
             (child-best (search-job-best child-job)))
        (assert (and child-best (eq :bounded-exhaustion (message-claim outcome))))
        (format t "Supplied pullback/reassembly control (separate work ledger):~%")
        (format t "  Origin :m1-supplied-child -> supplied parent decoder ~S~%" decoder)
        (format t "  Input binding ~S; child receives only b as v3.~%" bindings)
        (format t "  Child requirement on each row: a + z = y (compiled forward predicate; no inverse enumeration).~%")
        (format t "  First child row: key=~S known=~S predicate=~S~%"
                (row-key (first (frame-rows child))) (row-known (first (frame-rows child)))
                (allowed-expression (row-allowed (first (frame-rows child)))))
        (report-outcome outcome)
        (format t "  Returned child: ~S~%" (candidate-expression child-best))
        (let* ((model (compose-model decoder 9 (candidate-expression child-best) bindings control-work))
               (work (replay-model model frame control-work)))
          (format t "  Assembled and independently replayed parent: ~S~%" model)
          (format t "  25/25, S=~D, W_run=~D. No automatic decomposition search or speedup claim.~%"
                  (description-size model) work))
        (report-ledger "  Child search" (search-job-ledger child-job))
        (report-ledger "  Pullback and parent replay" control-work))
      (let* ((bad-frame (make-frame (make-schema :inputs inputs :target field)
                                    (list (make-row :key 0 :known '(1 1) :allowed (finite-allowed field '(0)))
                                          (make-row :key 1 :known '(1 1) :allowed (finite-allowed field '(1))))))
             (bad-job (start-search bad-frame language :call-id :m1-contradiction))
             (outcome (resume-search bad-job initial-bound 100000)))
        (assert (and (eq :bounded-exhaustion (message-claim outcome)) (null (search-job-results bad-job))))
        (format t "~%Negative control: identical inputs with distinct singleton outputs; no candidate.~%")
        (report-outcome outcome))
      (format t "~%Controls in make test additionally cover joint fibers, ordered/multiple occurrences,~%")
      (format t "hidden-answer rejection, paid lookups, typed AU/matching, and independent tiny-bound enumeration.~%")
      (format t "Conclusion: a known finite explanation remains reachable after cutoffs and larger limits.~%")
      (format t "Completion and empirical validation are scoped to the declared grammar/domain; no integer law is proved.~%")))
  (format t "Wall time: ~,3F s (including experiment controls; excludes loading).~%"
          (/ (- (get-internal-real-time) start) internal-time-units-per-second)))
