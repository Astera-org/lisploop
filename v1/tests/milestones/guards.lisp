(in-package #:lisploop)

(defun guard-test-observations (domain values expressions &optional inputs)
  (let* ((inputs (or inputs (list (cons 0 domain))))
         (scope (make-observation-scope (probe-frame domain inputs values) (make-language domain inputs)))
         (job (start-observation-search scope :expressions expressions :retain-outcomes t)))
    (resume-observation-search job
                               (reduce #'max expressions :key (lambda (e) (description-size e inputs))) 10000000)
    job))

(defun guard-test-language (domain inputs &optional (conditionals t))
  (make-language domain inputs :operators (append (list (op := domain))
                                                  (when conditionals (list (op :if :bool))))))

(defun guard-problem-for (problems left right)
  (find-if (lambda (problem)
             (some (lambda (pair) (or (equal pair (list left right)) (equal pair (list right left))))
                   (guard-problem-equations problem)))
           problems))

(deftest joint-field-guard-discovery-and-support-reference
  (dolist (p '(5 7))
    (multiple-value-bind (validations observations problems searches ledger) (discover-guarded-field-laws p)
      (let* ((domain (gf p))
             (inputs (list (cons 0 domain)))
             (g-bound (guard-search-bound domain inputs))
             (x (var 0 domain))
             (one (lit domain 1))
             (ratio (app (op :/ domain) x x))
             (problem (guard-problem-for problems ratio one))
             (certificate (law-validation-certificate (validation-for-equation validations ratio one))))
        (check problem)
        (check (equal (cons nil (make-list (1- p) :initial-element t)) (guard-problem-support problem)))
        (check (= p (getf certificate :assignments)))
        (check (= (1- p) (getf certificate :active)))
        (check (= (+ (1+ p) (* 3 (expt (1+ p) 2))) (length (observation-job-records observations))))
        (check (= (* 2 (1+ p)) (count :error (observation-job-records observations) :key #'observed-expression-status)))
        (check (= (length problems) (length (remove-duplicates problems :key #'guard-problem-support :test #'equal))))
        (check (plusp (ledger-total ledger)))
        ;; Compare every pair's mask against host field arithmetic, independent
        ;; of the VM, including every zero denominator and unequal defined value.
        (labels ((reference (expression value)
                   (case (ast-kind expression)
                     (:var value)
                     (:lit (ast-value expression))
                     (:app (let* ((args (rest expression))
                                  (a (reference (first args) value))
                                  (b (reference (second args) value)))
                             (if (or (eq a :error) (eq b :error))
                                 :error
                                 (case (operator-name (first expression))
                                   (:- (mod (- a b) p))
                                   (:* (mod (* a b) p))
                                   (:/ (if (zerop b) :error
                                           (mod (* a (loop for n from 1 below p
                                                           when (= 1 (mod (* n b) p)) return n))
                                                p))))))))))
          (loop for tail on (observation-job-records observations) for left = (first tail) do
            (dolist (right (rest tail))
              (let ((expected (loop for i below p
                                    for a = (reference (observed-expression-expression left) i)
                                    for b = (reference (observed-expression-expression right) i)
                                    collect (and (not (eq a :error)) (not (eq b :error)) (= a b)))))
                (check (equal expected (observed-support left right)))
                (let ((found (guard-problem-for problems (observed-expression-expression left)
                                                (observed-expression-expression right))))
                  (if (and (some #'identity expected) (not (every #'identity expected)))
                      (check (and found (equal expected (guard-problem-support found))))
                      (check (null found))))))))
        (loop for problem in problems for search in searches do
          (check (= g-bound (search-job-completed-bound search)))
          (when (search-job-best search)
            (let ((guard (candidate-expression (search-job-best search))))
              (loop for expected in (guard-problem-support problem) for i from 0 do
                (check (eq expected (result guard (knowledge-entry-inputs (law-validation-law (first validations))) (list i))))))))
        (dolist (validation validations)
          (check (eq :validated (law-validation-status validation)))
          (check-codec-roundtrip (law-statement (law-validation-law validation))
                                 (knowledge-entry-inputs (law-validation-law validation))))))))

(deftest retained-row-outcomes-and-exact-support
  (let* ((x (var 0 :int)) (one (lit :int 1)) (zero (lit :int 0))
         (ratio (app (op :/ :int) x x)) (reciprocal (app (op :/ :int) one x))
         (bad (app (op :/ :int) one zero))
         (job (guard-test-observations :int '((0) (1) (2))
                                       (list ratio reciprocal one zero bad (lit :bool nil) (lit :bool t))))
         (record (find-observation job ratio))
         (outcomes (observed-expression-outcomes record)))
    (check (eq :error (observed-expression-status record)))
    (check (equal '(:error :value :value) (mapcar #'observation-outcome-status outcomes)))
    (check (observation-outcome-error (first outcomes)))
    (check (= 1 (observation-outcome-value (third outcomes))))
    (check (= (observed-expression-run-work record) (reduce #'+ outcomes :key #'observation-outcome-work)))
    (check (equal '(nil t t) (observed-support record (find-observation job one))))
    (check (equal '(nil t nil) (observed-support record (find-observation job reciprocal))))
    (check (equal '(nil nil nil) (observed-support (find-observation job bad) (find-observation job bad))))
    (check (not (observed-agreement-p record record)))
    ;; Successful false is a value, not an error or missing observation.
    (let ((false (find-observation job (lit :bool nil))))
      (check (equal '(t t t) (observed-support false false)))
      (raises (observed-support false (find-observation job zero))))
    (let* ((other (guard-test-observations :int '((0) (1) (2)) (list ratio one))))
      (raises (observed-support record (find-observation other one))))
    (let ((default (start-observation-search (observation-job-scope job) :expressions (list ratio))))
      (resume-observation-search default 100 100000)
      (check (null (observed-expression-outcomes (find-observation default ratio))))
      (raises (propose-guard-problems default))))
  ;; Joint values are compared as whole tuples, never independent coordinates.
  (let* ((pair (tuple-type :int :int))
         (left (lit pair '(0 1))) (right (lit pair '(1 0)))
         (job (guard-test-observations :int '((0)) (list left right))))
    (check (equal '(nil) (observed-support (find-observation job left) (find-observation job right))))))

(deftest outcome-retention-budget-parity
  (let* ((inputs '((0 . :int))) (x (var 0 :int))
         (expression (app (op :/ :int) (lit :int (ash 1 128)) x))
         (scope (make-observation-scope (probe-frame :int inputs (list '(0) (list (ash 1 128)) '(2)))
                                        (make-language :int inputs)))
         (bound (description-size expression inputs)))
    (multiple-value-bind (batch stepped)
        (check-observation-resumption
         (lambda () (start-observation-search scope :expressions (list expression) :retain-outcomes t))
         bound)
      (let ((total (ledger-total (observation-job-ledger batch)))
            (partial (start-observation-search scope :expressions (list expression) :retain-outcomes t)))
        (dolist (limit (list 0 1 (floor total 2) (max 0 (1- total))))
          (when (< limit total)
            (resume-observation-search partial bound limit)
            (check (<= (ledger-total (observation-job-ledger partial)) limit))
            (raises (propose-guard-problems partial)))))
      (check (= 3 (length (observed-expression-outcomes (find-observation stepped expression))))))))

(deftest guard-residual-frame-and-occurrence-isolation
  (let* ((inputs '((7 . :int)))
         (scope (make-observation-scope (probe-frame :int inputs '((2) (2) (0))) (make-language :int inputs)))
         (mask '(t t nil)) (ledger (make-ledger)) (frame (support-frame scope mask ledger)))
    (check (equal inputs (schema-inputs (frame-schema frame))))
    (check (equal '(0 1 2) (mapcar #'row-key (frame-rows frame))))
    (check (equal '((2) (2) (0)) (mapcar #'row-known (frame-rows frame))))
    (check (equal '((t) (t) (nil)) (mapcar (lambda (r) (extract-allowed-values (row-requirement r))) (frame-rows frame))))
    (check (plusp (ledger-total ledger)))
    (raises (expression-type (var 99 :int) (schema-inputs (frame-schema frame))))
    (raises (support-frame scope '(t :unknown nil)))
    (raises (support-frame scope '(t nil)))
    (multiple-value-bind (representatives residual) (quotient-values mask)
      (check (equal mask (result (decode-model (encode-model (quotient-model :bool representatives residual)))))))
    (setf (first (row-known (first (frame-rows frame)))) 99)
    (check (= 2 (first (row-known (first (frame-rows (observation-scope-frame scope)))))))))

(deftest guard-discovery-resume-validation-and-rewriting
  (let* ((domain (gf 5)) (inputs (list (cons 0 domain))) (x (var 0 domain))
         (g-bound (guard-search-bound domain inputs))
         (one (lit domain 1)) (ratio (app (op :/ domain) x x))
         (obs (guard-test-observations domain '((0) (1) (2) (3) (4)) (list ratio one)))
         (problem (first (propose-guard-problems obs)))
         (language (guard-test-language domain inputs)))
    (check (equal '(nil t t t t) (guard-problem-support problem)))
    (multiple-value-bind (below-batch)
        (check-search-resumption (lambda () (start-guard-search problem language :call-id :guard))
                                 (1- g-bound))
      (check (= (1- g-bound) (search-job-completed-bound below-batch)))
      (check (null (propose-guarded-laws problem below-batch))))
    (multiple-value-bind (batch)
        (check-search-resumption (lambda () (start-guard-search problem language :call-id :guard))
                                 g-bound)
      (let* ((laws (propose-guarded-laws problem batch)) (law (first laws))
             (guard (knowledge-entry-guard law)) (validation (checked-law law))
             (safe (app (op :if domain) guard ratio (lit domain 0)))
             (rewritten (normalize-for-test safe inputs (list validation) domain)))
        (check (= 1 (length laws)))
        (check (= 5 (getf (law-validation-certificate validation) :assignments)))
        (check (= 4 (getf (law-validation-certificate validation) :active)))
        (check (equal rewritten (app (op :if domain) guard one (lit domain 0))))
        (check (equal ratio (normalize-for-test ratio inputs (list validation) domain)))
        (check-codec-roundtrip (law-statement law) inputs)
        (dotimes (i 5)
          (check (eq (not (zerop i)) (result guard inputs (list i))))
          (check (= (result safe inputs (list i)) (result rewritten inputs (list i)))))
        (let ((unguarded (resume-law-validation (start-law-validation (make-law domain inputs ratio one)) 100000)))
          (check (eq :refuted (law-validation-status unguarded))))
        (raises (prepare-rewrite-library (list validation) (gf 7)))))
    ;; Equality alone cannot express this support within the declared bound.
    (let ((limited (start-guard-search problem (guard-test-language domain inputs nil))))
      (check (eq :bounded-exhaustion (message-claim (resume-search limited g-bound 1000000))))
      (check (null (propose-guarded-laws problem limited)))))
  ;; Neither all-error agreement nor all-row agreement creates a guard problem.
  (let* ((domain (gf 5)) (zero (lit domain 0)) (one (lit domain 1))
         (bad (app (op :/ domain) one zero))
         (other (app (op :/ domain) zero zero)))
    (check (null (propose-guard-problems (guard-test-observations domain '((0) (1)) (list bad other)))))
    (check (null (propose-guard-problems (guard-test-observations domain '((0) (1))
                                         (list one (app (op :+ domain) one zero))))))))

(deftest learned-guard-on-samples-is-not-a-certificate
  (let* ((domain (gf 7)) (inputs (list (cons 0 domain))) (x (var 0 domain))
         (g-bound (guard-search-bound domain inputs))
         (square (app (op :* domain) x x)) (fourth (app (op :* domain) square square))
         (one (lit domain 1))
         (obs (guard-test-observations domain '((0) (1) (6)) (list fourth one)))
         (problem (first (propose-guard-problems obs)))
         (search (start-guard-search problem (guard-test-language domain inputs))))
    (resume-search search g-bound 1000000)
    (let* ((law (first (propose-guarded-laws problem search)))
           (sample (resume-law-validation (start-law-validation law :samples '((0) (1) (6))) 100000))
           (full (resume-law-validation (start-law-validation law) 100000)))
      (check (eq :conjecture (law-validation-status sample)))
      (check (null (law-validation-certificate sample)))
      (check (eq :refuted (law-validation-status full)))
      (check (equal '(2) (getf (law-validation-counterexample full) :inputs)))
      (raises (prepare-rewrite-library (list sample) domain))
      (raises (prepare-rewrite-library (list full) domain))))
  (let* ((int-inputs '((0 . :int)))
         (x (var 0 :int)) (ratio (app (op :/ :int) x x)) (one (lit :int 1))
         (obs (guard-test-observations :int '((-1) (0) (1)) (list ratio one)))
         (problem (first (propose-guard-problems obs)))
         (job (start-guard-search problem
                                  (make-language :int int-inputs :literals '(0)
                                                 :operators (list (op := :int) (op :if :bool)))))
         (int-bound (guard-search-bound :int int-inputs)))
    (check (eq :bounded-exhaustion (message-claim (resume-search job int-bound 1000000))))
    (let* ((law (first (propose-guarded-laws problem job)))
           (validation (resume-law-validation (start-law-validation law :samples '((-10) (0) (10))) 100000)))
      (check (eq :conjecture (law-validation-status validation)))
      (raises (start-law-validation law))
      (raises (prepare-rewrite-library (list validation) :int)))))

(deftest multi-input-guards-and-unequal-values
  (let* ((domain (gf 3)) (inputs (list (cons 7 domain) (cons 99 domain)))
         (a (var 7 domain)) (b (var 99 domain))
         (left (app (op :* domain) (app (op :/ domain) a b) b))
         (rows (loop for i below 3 append (loop for j below 3 collect (list i j))))
         (obs (guard-test-observations domain rows (list left a) inputs))
         (problem (first (propose-guard-problems obs)))
         (job (start-guard-search problem (guard-test-language domain inputs)))
         (bound (description-size (bool-not (app (op := domain) b (lit domain 0))) inputs)))
    (check (equal '(nil t t nil t t nil t t) (guard-problem-support problem)))
    (resume-search job bound 2000000)
    (let ((validation (checked-law (first (propose-guarded-laws problem job)))))
      (check (= 6 (getf (law-validation-certificate validation) :active)))))
  (let* ((domain (gf 3)) (inputs (list (cons 0 domain))) (x (var 0 domain))
         (square (app (op :* domain) x x))
         (obs (guard-test-observations domain '((0) (1) (2)) (list x square)))
         (problem (first (propose-guard-problems obs)))
         (job (start-guard-search problem (guard-test-language domain inputs))))
    (check (equal '(t t nil) (guard-problem-support problem)))
    (resume-search job (guard-search-bound domain inputs) 1000000)
    (check (= 2 (getf (law-validation-certificate
                       (checked-law (first (propose-guarded-laws problem job))))
                      :active)))))

(deftest tuple-law-corpus-and-guard-discovery
  (let* ((d3 (gf 3))
         (pair3 (tuple-type d3 d3))
         (tuple-inputs (list (cons 0 pair3)))
         (t0 (var 0 pair3))
         (idx0 (lit :int 0))
         (idx1 (lit :int 1))
         (at-op (op :at pair3))
         (tup-op (op :tuple pair3))
         (eta-law (make-law d3 tuple-inputs
                            (app tup-op (app at-op t0 idx0) (app at-op t0 idx1))
                            t0))
         (nz-guard (bool-not (app (op := d3) (app at-op t0 idx1) (lit d3 0))))
         (guarded-tuple-law
           (make-law d3 tuple-inputs
                     (app tup-op
                          (app at-op t0 idx0)
                          (app (op :/ d3) (app at-op t0 idx1) (app at-op t0 idx1)))
                     (app tup-op (app at-op t0 idx0) (lit d3 1))
                     :guard nz-guard)))
    ;; 1. Law corpus serialization roundtrip for tuple laws.
    (let* ((corpus (make-law-corpus (list eta-law guarded-tuple-law)))
           (decoded (decode-law-corpus (law-corpus-packet corpus))))
      (check (= 2 (length decoded)))
      (loop for expected in (list eta-law guarded-tuple-law)
            for actual in decoded do
        (check (equal (knowledge-entry-domain expected) (knowledge-entry-domain actual)))
        (check (equal (knowledge-entry-inputs expected) (knowledge-entry-inputs actual)))
        (check (equal (knowledge-entry-expression expected) (knowledge-entry-expression actual)))
        (check (equal (knowledge-entry-guard expected) (knowledge-entry-guard actual)))))
    ;; 2. Guard problem discovery over tuple-input and tuple-output observation scopes.
    (let* ((rows (loop for i below 9 collect (law-assignment tuple-inputs i)))
           (c0 (app at-op t0 idx0))
           (c1 (app at-op t0 idx1))
           (zero (lit d3 0))
           (tup-lhs (app tup-op c0 c1))
           (tup-rhs (app tup-op c0 zero))
           (zero-c1-guard (app (op := d3) c1 zero))
           (scope (make-observation-scope
                   (probe-frame d3 tuple-inputs rows)
                   (make-language d3 tuple-inputs :operators (list at-op tup-op) :literals '(0))))
           (obs-job (start-observation-search scope
                                              :expressions (list tup-lhs tup-rhs)
                                              :retain-outcomes t))
           (bound (max (description-size tup-lhs tuple-inputs)
                       (description-size tup-rhs tuple-inputs))))
      (check (eq :replay-complete (message-claim (resume-observation-search obs-job bound 200000))))
      (let ((problems (propose-guard-problems obs-job)))
        (check (= 1 (length problems)))
        (let* ((problem (first problems))
               (guard-lang (make-language d3 tuple-inputs
                                          :operators (list at-op (op := d3))
                                          :literals '(0)
                                          :constants (list idx1)))
               (guard-bound (description-size zero-c1-guard tuple-inputs))
               (guard-search (start-guard-search problem guard-lang)))
          (check (eq :bounded-exhaustion (message-claim (resume-search guard-search guard-bound 200000))))
          (let ((discovered (propose-guarded-laws problem guard-search)))
            (check (= 1 (length discovered)))
            (let ((validated (checked-law (first discovered))))
              (check (eq :validated (law-validation-status validated)))
              (check (= 9 (getf (law-validation-certificate validated) :assignments)))
              (check (= 3 (getf (law-validation-certificate validated) :active))))))))))
