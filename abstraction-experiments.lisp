(in-package #:lisploop)

(defun m6-reference-aligned-au (sources &optional inputs)
  "Independent reference implementation of aligned syntactic anti-unification.
Uses an association list of disagreement vectors and assigns holes from 100 upward
to test `patterns-isomorphic-p` up to hole renaming."
  (assert sources)
  (let ((memo nil)
        (next-hole 100))
    (labels ((ref-sort (term)
               (if (operator-p term)
                   (operator-type term)
                   (expression-type term inputs t)))
             (walk (terms)
               (let ((sorts (mapcar #'ref-sort terms)))
                 (assert (every (lambda (s) (equal s (first sorts))) sorts))
                 (cond
                   ((every (lambda (term) (equal term (first terms))) terms)
                    (first terms))
                   ((and (every #'app-p terms)
                         (let ((sigs (mapcar (lambda (term) (operator-type (first term))) terms)))
                           (every (lambda (sig) (equal sig (first sigs))) sigs)))
                    (apply #'app
                           (walk (mapcar #'first terms))
                           (loop for i below (length (rest (first terms)))
                                 collect (walk (mapcar (lambda (term) (nth i (rest term))) terms)))))
                   (t
                    (let ((existing (assoc terms memo :test #'equal)))
                      (if existing
                          (cdr existing)
                          (let ((h (hole (prog1 next-hole (incf next-hole)) (first sorts))))
                            (push (cons terms h) memo)
                            h))))))))
      (walk sources))))

(defun verify-corpus-abstraction-replay (abstraction expected-trees expected-inputs &optional ledger)
  "Bit-encode, decode, and execute `(subexpression-abstraction-model abstraction)` in the VM,
and verify that `decode-tree-corpus` reconstructs EXPECTED-TREES in exact occurrence order."
  (let* ((model (subexpression-abstraction-model abstraction))
         (decoded-model (decode-model (encode-model model nil)))
         (run (evaluate decoded-model nil nil :ledger ledger :budget 10000000)))
    (assert (eq :value (evaluation-status run)))
    (multiple-value-bind (reconstructed-trees schema)
        (decode-tree-corpus (evaluation-value run))
      (assert (equal expected-inputs schema))
      (assert (equal expected-trees reconstructed-trees))
      (evaluation-work run))))

(defun run-m6-aligned-stages-and-controls ()
  (let ((work (make-ledger)))
    (format t "~%M6 / Stages 1-3 / Pattern reconstruction, matching, aligned AU, and controls.~%")
    ;; 1. Operator holes, repeated holes, and broken repeated-hole control
    (let* ((sig (operator-type (op :+ :int)))
           (template (app (hole 0 sig) (hole 1 :int) (hole 1 :int)))
           (repeated-sources (list (app (op :+ :int) (lit :int 2) (lit :int 2))
                                   (app (op :* :int) (lit :int 3) (lit :int 3))))
           (broken-sources (list (app (op :+ :int) (lit :int 2) (lit :int 2))
                                 (app (op :* :int) (lit :int 3) (lit :int 4)))))
      (multiple-value-bind (pattern substs) (anti-unify repeated-sources nil work)
        (assert (equal template pattern))
        (assert (patterns-isomorphic-p pattern (m6-reference-aligned-au repeated-sources) nil work))
        ;; Lower pattern to `:code-apply` constructor and reconstruct via child substitution frame
        (multiple-value-bind (constructor ctor-inputs) (compile-au-constructor pattern nil work)
          (let* ((sub-frame (au-substitutions-frame pattern substs :inputs nil :ledger work))
                 (sub-lookup (lookup-model sub-frame work)))
            (declare (ignore sub-lookup))
            (loop for src in repeated-sources
                  for subst in substs
                  for row in (frame-rows sub-frame)
                  for tuple-val = (first (extract-allowed-values (row-requirement row)))
                  for run = (evaluate constructor ctor-inputs tuple-val :ledger work)
                  do (assert (eq :value (evaluation-status run)))
                     (assert (equal src (evaluation-value run)))
                     (assert (equal src (instantiate pattern subst))))))
        (format t "Aligned AU on (+ 2 2) and (* 3 3) recovers ~S (matches reference up to hole renaming).~%"
                pattern))
      (multiple-value-bind (broken-pat broken-substs) (anti-unify broken-sources nil work)
        (assert (not (nth-value 1 (match-pattern template (second broken-sources) nil work))))
        (assert (= 3 (length (first broken-substs))))
        (assert (patterns-isomorphic-p broken-pat (m6-reference-aligned-au broken-sources) nil work))
        (format t "Replacing (* 3 3) by (* 3 4) breaks repeated hole -> ~S (3 distinct holes).~%"
                broken-pat)))
    ;; 2. Incompatible operator signatures fallback vs incompatible result sorts
    (let* ((bool-sources (list (app (op := :int) (lit :int 1) (lit :int 1))
                               (app (op := (gf 5)) (lit (gf 5) 2) (lit (gf 5) 2))))
           (bool-lgg (anti-unify bool-sources nil work)))
      (assert (equal (hole 0 :bool) bool-lgg))
      (assert (patterns-isomorphic-p bool-lgg (m6-reference-aligned-au bool-sources) nil work))
      (format t "Incompatible operator signatures (= :int) vs (= GF(5)) fall back to whole-AST hole ~S.~%"
              bool-lgg))
    ;; 3. Planted template need not be the LGG when substitutions share additional structure
    (let* ((inputs '((0 . :int)))
           (x (var 0 :int))
           (planted (app (op :+ :int) (hole 0 :int) (hole 1 :int)))
           (shared-substs (list (list (cons 0 (lit :int 1))
                                      (cons 1 (app (op :* :int) (lit :int 2) x)))
                                (list (cons 0 (lit :int 3))
                                      (cons 1 (app (op :* :int) (lit :int 2) (lit :int 5))))))
           (instances (mapcar (lambda (s) (instantiate planted s)) shared-substs)))
      (multiple-value-bind (lgg lgg-substs) (anti-unify instances inputs work)
        (declare (ignore lgg-substs))
        (assert (not (patterns-isomorphic-p planted lgg inputs work)))
        (assert (nth-value 1 (match-pattern planted lgg inputs work)))
        (format t "Planted template ~S with shared substitution structure tightens to LGG ~S.~%"
                planted lgg)))
    (report-ledger "M6 Stages 1-3 work" work)))

(defun run-m6-hidden-occurrence-subgraph-search ()
  (let ((work (make-ledger)))
    (format t "~%M6 / Stage 4 / Hidden occurrence paths, subgraph correspondence search, and compression.~%")
    (multiple-value-bind (trees inputs oracle)
        (planted-abstraction-fixture :domain :int :repetitions 1 :ledger work)
      (multiple-value-bind (best-comp best-struct proposals corpus)
          (discover-subexpression-abstractions trees inputs :ledger work)
        (declare (ignore corpus))
        (let ((aligned-root (find :aligned-root proposals :key #'subexpression-abstraction-kind)))
          (assert (patterns-isomorphic-p (getf oracle :pattern)
                                         (subexpression-abstraction-pattern best-struct)
                                         inputs work))
          (assert (equal (getf oracle :paths)
                         (subexpression-abstraction-paths best-struct)))
          (verify-corpus-abstraction-replay best-comp trees inputs work)
          (verify-corpus-abstraction-replay best-struct trees inputs work)
          (format t "Recovered hidden paths ~S and planted template ~S across ~D wrapped trees.~%"
                  (subexpression-abstraction-paths best-struct)
                  (subexpression-abstraction-pattern best-struct)
                  (length trees))
          (format t "  Aligned root AU pattern (paths all NIL): ~S (structural-score=~D, S=~D bits).~%"
                  (subexpression-abstraction-pattern aligned-root)
                  (subexpression-abstraction-structural-score aligned-root)
                  (subexpression-abstraction-bits aligned-root))
          (format t "  Hidden-path subgraph AU (paths ~S): structural-score=~D, S=~D bits (literal S=~D bits, gain=~D bits).~%"
                  (subexpression-abstraction-paths best-struct)
                  (subexpression-abstraction-structural-score best-struct)
                  (subexpression-abstraction-bits best-struct)
                  (subexpression-abstraction-literal-bits best-struct)
                  (subexpression-abstraction-gain best-struct)))))
    ;; Repetition compression sweep across 1, 2, 4 repetitions (4, 8, 16 wrapped trees)
    (format t "~%M6 / Stage 4B / Repetition compression sweep on wrapped trees (reps=1,2,4):~%")
    (let ((prev-gain most-negative-fixnum))
      (dolist (reps '(1 2 4))
        (let ((rep-ledger (make-ledger)))
          (multiple-value-bind (trees inputs oracle)
              (planted-abstraction-fixture :domain :int :repetitions reps :ledger rep-ledger)
            (multiple-value-bind (best-comp best-struct proposals)
                (discover-subexpression-abstractions trees inputs :ledger rep-ledger)
              (let ((dict-prop (find :dictionary proposals :key #'subexpression-abstraction-kind))
                    (root-prop (find :aligned-root proposals :key #'subexpression-abstraction-kind)))
                (assert (patterns-isomorphic-p (getf oracle :pattern)
                                               (subexpression-abstraction-pattern best-struct)
                                               inputs rep-ledger))
                (assert (equal (getf oracle :paths) (subexpression-abstraction-paths best-struct)))
                (verify-corpus-abstraction-replay best-comp trees inputs rep-ledger)
                (verify-corpus-abstraction-replay best-struct trees inputs rep-ledger)
                (assert (> (subexpression-abstraction-gain best-struct) prev-gain))
                (setf prev-gain (subexpression-abstraction-gain best-struct))
                (format t "  reps=~D (~2D trees): literal S=~4D | whole-dict S=~4D | root-AU S=~4D | subgraph-AU S=~4D bits (gain=~3D bits).~%"
                        reps (length trees)
                        (subexpression-abstraction-literal-bits best-struct)
                        (subexpression-abstraction-bits dict-prop)
                        (subexpression-abstraction-bits root-prop)
                        (subexpression-abstraction-bits best-struct)
                        (subexpression-abstraction-gain best-struct))))))))
    ;; Unrelated control trees & deterministic randomized planted templates
    (multiple-value-bind (mixed-trees mixed-inputs mixed-oracle)
        (planted-abstraction-fixture :domain :int :repetitions 2 :include-unrelated-p t :ledger work)
      (multiple-value-bind (best-comp best-struct)
          (discover-subexpression-abstractions mixed-trees mixed-inputs :ledger work)
        (assert (patterns-isomorphic-p (getf mixed-oracle :pattern)
                                       (subexpression-abstraction-pattern best-struct)
                                       mixed-inputs work))
        (assert (equal (getf mixed-oracle :paths)
                       (subexpression-abstraction-paths best-struct)))
        (verify-corpus-abstraction-replay best-comp mixed-trees mixed-inputs work)
        (verify-corpus-abstraction-replay best-struct mixed-trees mixed-inputs work)
        (format t "~%Unrelated-tree control (8 planted + 2 unrelated): paths=~S, S=~D bits (literal S=~D bits).~%"
                (subexpression-abstraction-paths best-struct)
                (subexpression-abstraction-bits best-struct)
                (subexpression-abstraction-literal-bits best-struct))))
    (let ((lcg-state 424242))
      (dotimes (trial 4)
        (multiple-value-bind (r-trees r-inputs r-oracle next-state)
            (randomized-planted-abstraction-fixture :domain :int :state lcg-state :count 4
                                                    :include-unrelated-p t :ledger work)
          (declare (ignore r-oracle))
          (setf lcg-state next-state)
          (multiple-value-bind (best-comp best-struct)
              (discover-subexpression-abstractions r-trees r-inputs :ledger work)
            (verify-corpus-abstraction-replay best-comp r-trees r-inputs work)
            (verify-corpus-abstraction-replay best-struct r-trees r-inputs work)
            ;; Discovered structural abstraction is at least as good as the planted recipe
            (assert (plusp (subexpression-abstraction-structural-score best-struct))))))
      (format t "Verified 4 deterministic randomized planted-template + unrelated-tree trials.~%"))
    (report-ledger "M6 Stage 4 subgraph discovery & replay" work)))

(defun run-m6-validated-law-alternate-syntax ()
  (let* ((domain (gf 5))
         (work (make-ledger))
         (law-inputs (list (cons 0 domain)))
         (x (var 0 domain))
         (zero (lit domain 0))
         (one (lit domain 1))
         (plus (op :+ domain))
         (mul (op :* domain))
         ;; Validate x + 0 = x and x * 1 = x over GF(5)
         (add-zero-law (make-law domain law-inputs (app plus x zero) x))
         (mul-one-law (make-law domain law-inputs (app mul x one) x))
         (v1 (start-law-validation add-zero-law))
         (v2 (start-law-validation mul-one-law)))
    (format t "~%M6 / Stage 5 / Validated alternate syntax vs exact AST spelling preservation.~%")
    (resume-law-validation v1 100000)
    (resume-law-validation v2 100000)
    (assert (eq :validated (law-validation-status v1)))
    (assert (eq :validated (law-validation-status v2)))
    (charge work :law-validation (+ (ledger-total (law-validation-ledger v1))
                                    (ledger-total (law-validation-ledger v2))))
    (let* ((library (prepare-rewrite-library (list v1 v2) domain))
           (scope (list (cons 0 domain) (cons 1 domain)))
           (a (var 0 domain))
           (b (var 1 domain))
           (sub0 (app mul a (lit domain 2)))
           (sub1 (app mul b (lit domain 3)))
           (sub2 (app mul (app plus a b) (lit domain 4)))
           ;; In t2 and t3, one branch is wrapped in (+ ... '0) or (* ... '1), obscuring the root (+ ?u ?u) pattern
           (raw-trees
             (list (app plus sub0 sub0)
                   (app plus sub1 sub1)
                   (app plus (app plus sub2 zero) sub2)
                   (app plus sub0 (app mul sub0 one)))))
      (multiple-value-bind (raw-best-comp raw-best-struct raw-proposals)
          (discover-subexpression-abstractions raw-trees scope :domain domain :ledger work)
        (declare (ignore raw-best-struct))
        (multiple-value-bind (norm-best-comp norm-best-struct norm-proposals norm-corpus norm-trees)
            (discover-subexpression-abstractions raw-trees scope :domain domain
                                                 :rewrite-library library :ledger work)
          (declare (ignore norm-best-struct norm-corpus))
          (let ((raw-root (find :aligned-root raw-proposals :key #'subexpression-abstraction-kind))
                (norm-root (find :aligned-root norm-proposals :key #'subexpression-abstraction-kind)))
            ;; 1. Exact AST spelling is preserved on raw trees and differs from law-normalized trees
            (assert (not (equal raw-trees norm-trees)))
            (verify-corpus-abstraction-replay raw-best-comp raw-trees scope work)
            (verify-corpus-abstraction-replay norm-best-comp norm-trees scope work)
            ;; 2. Raw trees and normalized trees are behaviorally identical across all 25 GF(5)^2 inputs
            (loop for r-tree in raw-trees
                  for n-tree in norm-trees
                  do (dotimes (v0 5)
                       (dotimes (v1 5)
                         (let ((ev-r (evaluate r-tree scope (list v0 v1) :ledger work))
                               (ev-n (evaluate n-tree scope (list v0 v1) :ledger work)))
                           (assert (and (eq :value (evaluation-status ev-r))
                                        (eq :value (evaluation-status ev-n))
                                        (= (evaluation-value ev-r) (evaluation-value ev-n))))))))
            ;; 3. Validated rewriting exposes a strictly tighter root LGG pattern and smaller corpus S
            (assert (> (subexpression-abstraction-structural-score norm-root)
                       (subexpression-abstraction-structural-score raw-root)))
            (assert (< (subexpression-abstraction-bits norm-root)
                       (subexpression-abstraction-bits raw-root)))
            (format t "Raw root AU pattern: ~S (structural-score=~D, S=~D bits; exact spelling retained).~%"
                    (subexpression-abstraction-pattern raw-root)
                    (subexpression-abstraction-structural-score raw-root)
                    (subexpression-abstraction-bits raw-root))
            (format t "Law-normalized root AU pattern: ~S (structural-score=~D, S=~D bits; behaviorally identical).~%"
                    (subexpression-abstraction-pattern norm-root)
                    (subexpression-abstraction-structural-score norm-root)
                    (subexpression-abstraction-bits norm-root))
            (report-ledger "M6 Stage 5 law validation, rewriting & AU" work)))))))

(defun run-m6 ()
  (run-m6-aligned-stages-and-controls)
  (run-m6-hidden-occurrence-subgraph-search)
  (run-m6-validated-law-alternate-syntax))
