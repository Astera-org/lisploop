(in-package #:lisploop)

;;; Typed grammar enumeration, exact search over frame rows, and observation search.

(defstruct (language (:constructor %make-language))
  domain inputs operators (literals :all) constants (version 3))

(defun make-language (domain inputs &key (operators (list (op :+ domain) (op :* domain)))
                                        (literals :all) constants)
  "Finite typed productions over the VM's primitives, including quoted syntax."
  (assert (or (eq domain :int) (gf-type-p domain)))
  (assert (valid-inputs-p inputs))
  (mapc #'operator-type operators)
  (dolist (c constants) (assert (lit-p c)) (expression-type c nil))
  (assert (or (eq literals :all) (and (listp literals) (every (lambda (v) (value-p v domain)) literals))))
  (%make-language :domain (copy-tree domain) :inputs (copy-tree inputs)
                  :operators (remove-duplicates (copy-tree operators) :test #'equal)
                  :constants (remove-duplicates (copy-tree constants) :test #'equal)
                  :literals (if (eq literals :all) :all (remove-duplicates (copy-list literals) :from-end t))))

(defun derive-language (language &key (inputs (language-inputs language))
                                      (operators (language-operators language))
                                      (literals (language-literals language))
                                      (constants (language-constants language)))
  "A language over LANGUAGE's domain that differs from it only in the fields supplied."
  (make-language (language-domain language) inputs :operators operators :literals literals :constants constants))

(defun language-operator-p (language name)
  (some (lambda (o) (and (operator-p o) (eq name (operator-name o)))) (language-operators language)))

(defun snapshot-language (language)
  (let ((s (copy-language language)))
    (setf (language-domain s) (copy-tree (language-domain language))
          (language-inputs s) (copy-tree (language-inputs language))
          (language-operators s) (copy-tree (language-operators language))
          (language-literals s) (copy-tree (language-literals language))
          (language-constants s) (copy-tree (language-constants language)))
    s))

(defun language-header-size (language &optional (target (language-domain language)))
  (header-size (language-inputs language) target))

(defun language-booleans-p (language)
  (or (find :bool (language-inputs language) :key #'cdr)
      (some (lambda (o) (member :bool (cons (third (operator-type o)) (second (operator-type o)))))
            (language-operators language))))

(defstruct (enumerator (:constructor %make-enumerator))
  language allowed-inputs (size 1) (phase :variables) (cursor 0) (literal-pass 0)
  literal-next literal-end (operator-index 0) sizes indices (buckets (make-hash-table :test #'equal)))

(defun make-enumerator (language &optional (allowed-inputs (language-inputs language)))
  (%make-enumerator :language language :allowed-inputs allowed-inputs))

(defun syntax-bucket (enumerator type size)
  (gethash (list type size) (enumerator-buckets enumerator)))

(defun index-expression (enumerator expression)
  (let* ((lang (enumerator-language enumerator))
         (tp (expression-type expression (language-inputs lang)))
         (key (list tp (enumerator-size enumerator)))
         (bkts (enumerator-buckets enumerator)))
    (assert (= (enumerator-size enumerator) (body-size expression (language-inputs lang))))
    (unless (gethash key bkts) (setf (gethash key bkts) (make-array 0 :adjustable t :fill-pointer 0)))
    (vector-push-extend expression (gethash key bkts))
    tp))

(defun literal-range (domain size pass)
  (let ((payload (- size 2)))
    (if (eq domain :int)
        (let ((w (loop for w from 1 to payload when (= payload (+ w (* 2 (1- (integer-length w))))) return w)))
          (if (null w) (values 1 0)
              (let ((lo (ash 1 (1- w))) (hi (1- (ash 1 w))))
                (if (= pass 0) (values (ceiling (1- lo) 2) (floor (1- hi) 2))
                    (values (max 1 (ceiling lo 2)) (floor hi 2))))))
        (if (and (= pass 0) (= payload (integer-length (1- (second domain)))))
            (values 0 (1- (second domain))) (values 1 0)))))

(defun reset-enumerator-bound (e)
  (incf (enumerator-size e))
  (setf (enumerator-phase e) :variables (enumerator-cursor e) 0 (enumerator-literal-pass e) 0
        (enumerator-literal-next e) nil (enumerator-operator-index e) 0
        (enumerator-sizes e) nil (enumerator-indices e) nil))

(defun first-composition (total arity)
  (when (>= total arity) (append (make-list (1- arity) :initial-element 1) (list (- total (1- arity))))))

(defun next-composition (sizes)
  (loop for i downfrom (- (length sizes) 2) to 0
        for tail = (nthcdr (1+ i) sizes) for tot = (reduce #'+ tail)
        when (> tot (length tail)) do
          (return (append (subseq sizes 0 i) (list (1+ (nth i sizes)))
                          (make-list (1- (length tail)) :initial-element 1) (list (- tot (length tail)))))))

(defun advance-application-cursor (e buckets)
  (let ((idxs (enumerator-indices e)))
    (loop for i downfrom (1- (length idxs)) to 0 do
      (incf (nth i idxs))
      (when (< (nth i idxs) (length (nth i buckets))) (return-from advance-application-cursor))
      (setf (nth i idxs) 0)))
  (unless (setf (enumerator-sizes e) (next-composition (enumerator-sizes e)))
    (incf (enumerator-operator-index e))))

(defun enumeration-step (e)
  "One cursor operation; return (candidate, event). No eager Cartesian products."
  (let* ((lang (enumerator-language e)) (inputs (language-inputs lang))
         (domain (language-domain lang)) (lits (language-literals lang)) (size (enumerator-size e)))
    (flet ((atom-step (items build next)
             (let ((tail (nthcdr (enumerator-cursor e) items)))
               (if (null tail) (setf (enumerator-cursor e) 0 (enumerator-phase e) next)
                   (let ((expr (funcall build (first tail))))
                     (incf (enumerator-cursor e))
                     (when (and expr (= size (body-size expr inputs)))
                       (return-from enumeration-step (values expr :candidate))))))))
      (ecase (enumerator-phase e)
        (:variables (atom-step (enumerator-allowed-inputs e) (lambda (in) (var (car in) (cdr in))) :literals))
        (:literals
         (cond ((not (eq lits :all)) (atom-step lits (lambda (v) (lit domain v)) :booleans))
               ((>= (enumerator-literal-pass e) 2) (setf (enumerator-phase e) :booleans))
               (t (unless (enumerator-literal-next e)
                    (multiple-value-bind (lo hi) (literal-range domain size (enumerator-literal-pass e))
                      (setf (enumerator-literal-next e) lo (enumerator-literal-end e) hi)))
                  (if (> (enumerator-literal-next e) (enumerator-literal-end e))
                      (setf (enumerator-literal-next e) nil (enumerator-literal-pass e) (1+ (enumerator-literal-pass e)))
                      (let ((v (enumerator-literal-next e)))
                        (incf (enumerator-literal-next e))
                        (return-from enumeration-step
                          (values (lit domain (if (= 1 (enumerator-literal-pass e)) (- v) v)) :candidate)))))))
        (:booleans (atom-step (when (and (= size 3) (language-booleans-p lang)) '(nil t))
                              (lambda (v) (lit :bool v)) (if (language-constants lang) :constants :applications)))
        (:constants (atom-step (language-constants lang)
                               (lambda (c) (unless (or (and (equal (ast-type c) domain)
                                                            (or (eq :all lits) (member (ast-value c) lits)))
                                                       (and (eq :bool (ast-type c)) (language-booleans-p lang)))
                                             c))
                               :applications))
        (:applications
         (let ((op (nth (enumerator-operator-index e) (language-operators lang))))
           (if (null op) (setf (enumerator-phase e) :finish)
               (let ((types (second (operator-type op))))
                 (when (null types)
                   (incf (enumerator-operator-index e))
                   (return-from enumeration-step
                     (if (= size (application-overhead op)) (values (app op) :candidate) (values nil :progress))))
                 (unless (enumerator-sizes e)
                   (setf (enumerator-sizes e) (first-composition (- size (application-overhead op)) (length types))
                         (enumerator-indices e) (make-list (length types) :initial-element 0)))
                 (if (null (enumerator-sizes e)) (incf (enumerator-operator-index e))
                     (let ((bkts (mapcar (lambda (tp bits) (syntax-bucket e tp bits)) types (enumerator-sizes e))))
                       (if (some #'null bkts)
                           (unless (setf (enumerator-sizes e) (next-composition (enumerator-sizes e)))
                             (incf (enumerator-operator-index e)))
                           (let ((expr (apply #'app op (mapcar #'aref bkts (enumerator-indices e)))))
                             (advance-application-cursor e bkts)
                             (return-from enumeration-step (values expr :candidate))))))))))
        (:finish (reset-enumerator-bound e) (return-from enumeration-step (values nil :bound)))))
    (values nil :progress)))

(defstruct candidate expression size run-work discovery-work)
(defstruct message call-id claim evidence)

(defstruct row-job
  call-id frame language enumerator (mode :enumeration) queue (ledger (make-ledger))
  (phase :enumerate) (debt 0) expression rows evaluation (completed-bound 0) (requested-bound 0) (messages nil))

(defstruct (search-job (:include row-job) (:constructor %make-search-job))
  proposals (resolved-rows 0) predicted (run-work 0) (results nil) best (run-weight 0) row-budget
  (rejected 0) diagnostics library rewriting normal-form (reused-rejections 0)
  (rejection-cache (make-hash-table :test #'equal)) (row-values (make-hash-table :test #'equal)))

(defvar *next-call-id* 0)

(defun proposal-queue (expressions language)
  (let ((inputs (language-inputs language)) (q (remove-duplicates (copy-tree expressions) :test #'equal)))
    (dolist (e q) (expression-type e inputs))
    (stable-sort q #'< :key (lambda (e) (description-size e inputs)))))

(defun row-job-target (job) (schema-target (frame-schema (row-job-frame job))))
(defun next-row (job) (pop (row-job-rows job)) (setf (row-job-phase job) :row))

(defun row-job-step (job budget admit consume finish)
  (let ((ledger (row-job-ledger job)) (e (row-job-enumerator job)) (inps (language-inputs (row-job-language job))))
    (ecase (row-job-phase job)
      (:enumerate
       (charge ledger :enumeration)
       (multiple-value-bind (expr ev) (if e (enumeration-step e) (values (pop (row-job-queue job)) :candidate))
         (case ev
           (:candidate (setf (row-job-expression job) expr (row-job-debt job) (syntax-work expr) (row-job-phase job) :construct))
           (:bound (setf (row-job-completed-bound job) (+ (language-header-size (row-job-language job) (row-job-target job))
                                                          (1- (enumerator-size e))))))))
      (:construct
       (pay-debt (row-job-debt job) budget ledger :construction)
       (when (zerop (row-job-debt job))
         (let ((expr (row-job-expression job)))
           (setf (row-job-rows job) (frame-rows (row-job-frame job))
                 (row-job-phase job) (funcall admit job (if e (index-expression e expr) (expression-type expr inps)))))))
      (:row (charge ledger :scheduling)
            (if (row-job-rows job)
                (setf (row-job-evaluation job) (start-evaluation (row-job-expression job) inps (row-known (first (row-job-rows job))))
                      (row-job-phase job) :evaluate)
                (funcall finish job)))
      (:evaluate (let ((st (row-job-evaluation job)))
                   (advance-accounted-evaluation st budget ledger :evaluation :validation)
                   (funcall consume job st))))))

(defun row-job-bound-complete-p (job bound)
  (if (eq :enumeration (row-job-mode job))
      (>= (row-job-completed-bound job) bound)
      (and (eq :enumerate (row-job-phase job))
           (or (null (row-job-queue job))
               (> (description-size (first (row-job-queue job)) (language-inputs (row-job-language job))) bound)))))

(defun resume-row-job (job step description-limit work-limit quantum &rest evidence)
  (assert (and (integerp description-limit) (>= description-limit (row-job-requested-bound job))
               (integerp work-limit) (>= work-limit 0)))
  (assert (or (null quantum) (and (integerp quantum) (plusp quantum))))
  (setf (row-job-requested-bound job) description-limit)
  (let ((ledger (row-job-ledger job)) (replay-p (eq :replay (row-job-mode job))))
    (loop until (or (row-job-bound-complete-p job description-limit) (>= (ledger-total ledger) work-limit))
          do (let ((rem (- work-limit (ledger-total ledger))))
               (funcall step job (if quantum (min quantum rem) rem))))
    (let ((complete-p (row-job-bound-complete-p job description-limit)))
      (when (and replay-p complete-p) (setf (row-job-completed-bound job) description-limit))
      (let ((msg (make-message
                  :call-id (row-job-call-id job)
                  :claim (cond ((not complete-p) :cutoff) (replay-p :replay-complete) (t :bounded-exhaustion))
                  :evidence (list* :description-limit description-limit :completed-bound (row-job-completed-bound job)
                                   :work (ledger-total ledger) :phase (row-job-phase job)
                                   :syntax-coverage (if replay-p :listed-expressions :grammar)
                                   :encoding-version +encoding-version+ :tariff-version +tariff-version+ evidence))))
        (push msg (row-job-messages job))
        msg))))

(defun enter-rule-setup (job)
  (let ((lib (search-job-library job)))
    (if lib (setf (search-job-phase job) :rule-setup (search-job-debt job) (rewrite-library-setup-work lib))
        (setf (search-job-phase job) :enumerate))))

(defun start-search (frame language &key (call-id (incf *next-call-id*)) (run-weight 0) row-budget laws diagnostics
                                        (expressions nil supplied-p))
  "Enumerate typed expressions or replay EXPRESSIONS against FRAME."
  (assert (equal (schema-inputs (frame-schema frame)) (language-inputs language)))
  (assert (and (realp run-weight) (>= run-weight 0)))
  (assert (or (null row-budget) (and (integerp row-budget) (plusp row-budget))))
  (setf frame (snapshot-frame frame) language (snapshot-language language))
  (let* ((lib (when laws (as-rewrite-library laws :domain (language-domain language))))
         (q (proposal-queue expressions language))
         (job (%make-search-job :call-id call-id :frame frame :language language
                                :mode (if supplied-p :replay :enumeration)
                                :enumerator (unless supplied-p
                                              (make-enumerator language (schema-available-inputs (frame-schema frame))))
                                :queue q :proposals (copy-list q) :run-weight run-weight :row-budget row-budget
                                :library lib :diagnostics diagnostics
                                :completed-bound (language-header-size language (schema-target (frame-schema frame))))))
    (if supplied-p
        (let ((n (length expressions)))
          (setf (search-job-phase job) :proposal-setup
                (search-job-debt job) (+ 1 (* n (1+ (integer-length n)))
                                          (reduce #'+ expressions :key #'syntax-work :initial-value 0))))
        (enter-rule-setup job))
    job))

(defun candidate-score (c rw) (+ (candidate-size c) (* rw (candidate-run-work c))))

(defun reject-candidate (job &optional witnessed-p)
  (when (search-job-diagnostics job)
    (push (make-message :call-id (search-job-call-id job) :claim :counterexample
                        :evidence (list :row (row-key (first (search-job-rows job)))
                                        :inputs (copy-tree (row-known (first (search-job-rows job))))
                                        :expression (search-job-expression job) :phase (search-job-phase job)
                                        :status (evaluation-status (search-job-evaluation job))
                                        :value (search-job-predicted job) :error (evaluation-error (search-job-evaluation job))))
          (search-job-messages job)))
  (when (and witnessed-p (search-job-library job))
    (setf (gethash (search-job-normal-form job) (search-job-rejection-cache job))
          (list :row (row-key (first (search-job-rows job))) :value (search-job-predicted job))))
  (incf (search-job-rejected job))
  (setf (search-job-phase job) :enumerate))

(defun accept-candidate (job)
  (let ((c (make-candidate :expression (search-job-expression job)
                           :size (description-size (search-job-expression job) (language-inputs (search-job-language job)))
                           :run-work (search-job-run-work job) :discovery-work (ledger-total (search-job-ledger job)))))
    (push c (search-job-results job))
    (when (or (null (search-job-best job))
              (< (candidate-score c (search-job-run-weight job))
                 (candidate-score (search-job-best job) (search-job-run-weight job))))
      (setf (search-job-best job) c))
    (push (make-message :call-id (search-job-call-id job) :claim :candidate :evidence c) (search-job-messages job))
    (setf (search-job-phase job) :enumerate)))

(defun admit-search-candidate (job type)
  (cond ((or (not (equal type (row-job-target job)))
             (not (expression-respects-availability-p (row-job-expression job) (frame-schema (row-job-frame job)))))
         :enumerate)
        (t (setf (search-job-resolved-rows job) 0 (search-job-run-work job) 0)
           (clrhash (search-job-row-values job))
           (if (search-job-library job) :rewrite-start :row))))

(defun consume-search-outcome (job state)
  (let ((rlim (search-job-row-budget job)))
    (ecase (evaluation-status state)
      (:error (reject-candidate job))
      (:unresolved (incf (search-job-run-work job) (evaluation-work state)) (next-row job))
      (:value (incf (search-job-run-work job) (evaluation-work state))
              (setf (search-job-predicted job) (evaluation-value state) (search-job-phase job) :requirement))
      (:unknown (when (and rlim (>= (evaluation-work state) rlim)) (reject-candidate job))))))

(defun finish-search-candidate (job)
  (if (>= (search-job-resolved-rows job) (frame-min-resolved-rows (search-job-frame job)))
      (accept-candidate job) (reject-candidate job)))

(defun rewrite-filter-step (job budget)
  (let ((ledger (search-job-ledger job)))
    (ecase (search-job-phase job)
      (:rule-setup (pay-debt (search-job-debt job) budget ledger :rule-setup)
                   (when (zerop (search-job-debt job)) (setf (search-job-phase job) :enumerate)))
      (:rewrite-start (charge ledger :scheduling)
                      (setf (search-job-rewriting job)
                            (start-rewriting (search-job-expression job) (language-inputs (search-job-language job))
                                             (search-job-library job))
                            (search-job-phase job) :rewrite))
      (:rewrite (let ((st (advance-rewriting (search-job-rewriting job) budget ledger)))
                  (when (eq :complete (rewriting-status st))
                    (setf (search-job-normal-form job) (rewriting-value st)
                          (search-job-debt job) (syntax-work (rewriting-value st)) (search-job-phase job) :reuse))))
      (:reuse (pay-debt (search-job-debt job) budget ledger :equality-cache)
              (when (zerop (search-job-debt job))
                (if (gethash (search-job-normal-form job) (search-job-rejection-cache job))
                    (progn (incf (search-job-reused-rejections job)) (reject-candidate job))
                    (setf (search-job-phase job) :row)))))))

(defun search-step (job &optional (budget 1))
  (assert (and (integerp budget) (plusp budget)))
  (let ((ledger (search-job-ledger job)) (row (first (search-job-rows job))) (rlim (search-job-row-budget job)))
    (case (search-job-phase job)
      (:proposal-setup (pay-debt (search-job-debt job) budget ledger :proposal-setup)
                       (when (zerop (search-job-debt job)) (enter-rule-setup job)))
      ((:rule-setup :rewrite-start :rewrite :reuse) (rewrite-filter-step job budget))
      (:requirement (charge ledger :scheduling)
                    (setf (search-job-evaluation job)
                          (start-evaluation (row-requirement row) (list (cons 0 (row-job-target job)))
                                            (list (search-job-predicted job)))
                          (search-job-phase job) :check))
      (:check (let ((st (advance-accounted-evaluation (search-job-evaluation job) budget ledger :checking :validation)))
                (case (evaluation-status st)
                  (:error (reject-candidate job))
                  (:unresolved (next-row job))
                  (:value (cond ((not (eq t (evaluation-value st))) (reject-candidate job t))
                                ((frame-hard-edges (search-job-frame job))
                                 (setf (gethash (row-key row) (search-job-row-values job)) (search-job-predicted job)
                                       (search-job-phase job) :edge-check))
                                (t (when (constrained-row-p row) (incf (search-job-resolved-rows job))) (next-row job)))))))
      (:edge-check (charge ledger :checking)
                   (if (hard-edges-satisfied-for-row-p (row-key row) (search-job-predicted job)
                                                       (frame-hard-edges (search-job-frame job))
                                                       (search-job-row-values job))
                       (progn (when (constrained-row-p row) (incf (search-job-resolved-rows job))) (next-row job))
                       (reject-candidate job t)))
      (t (when (and rlim (eq :evaluate (search-job-phase job)))
           (setf budget (min budget (max 1 (- rlim (evaluation-work (search-job-evaluation job)))))))
         (row-job-step job budget #'admit-search-candidate #'consume-search-outcome #'finish-search-candidate)))))

(defun search-bound-complete-p (job bound) (row-job-bound-complete-p job bound))

(defun resume-search (job description-limit work-limit &key quantum)
  "Absolute cumulative work limit and total packet-bit bound."
  (resume-row-job job #'search-step description-limit work-limit quantum
                  :language-version (language-version (search-job-language job))))

;;; Empirical Observations & Equivalence Buckets
(defstruct (observation-scope (:constructor %make-observation-scope))
  id frame language pairs anchors (respect-availability-p nil) (library *knowledge-library*)
  (equality :typed-value) (evidence :replayed-observations)
  (simulator-version +simulator-version+) (encoding-version +encoding-version+) (tariff-version +tariff-version+))

(defun make-observation-scope (frame language &key (id (incf *next-call-id*)) (edges nil edges-p)
                                                   (pairs (frame-pairs frame) pairs-p)
                                                   (anchors (frame-anchors frame) anchors-p)
                                                   respect-availability-p (library *knowledge-library*))
  "Freeze the observed inputs and language. EDGES/PAIRS/ANCHORS refer to row keys."
  (assert (frame-rows frame) () "An empirical scope needs observations")
  (assert (equal (schema-inputs (frame-schema frame)) (language-inputs language)))
  (let* ((owned (cond (edges-p (derive-frame frame :edges edges))
                      ((or pairs-p anchors-p) (derive-frame frame :pairs pairs :anchors anchors))
                      (t (snapshot-frame frame))))
         (rows (frame-rows owned))
         (epairs (if edges-p (frame-pairs owned) pairs))
         (eanchors (if edges-p (frame-anchors owned) anchors)))
    (assert (or (null eanchors) (>= (length eanchors) 2)))
    (assert (= (length eanchors) (length (remove-duplicates eanchors :test #'equal))))
    (flet ((idx (k) (or (position k rows :key #'row-key :test #'equal) (error "Unknown observation key ~S" k))))
      (dolist (p epairs) (assert (and (= (length p) 2) (not (equal (first p) (second p))))))
      (dolist (k eanchors) (idx k)
              (when epairs (assert (some (lambda (p) (or (equal k (first p)) (equal k (second p)))) epairs))))
      (%make-observation-scope
       :id id :frame owned :language (snapshot-language language)
       :pairs (mapcar (lambda (p) (mapcar #'idx p)) epairs) :anchors (mapcar #'idx eanchors)
       :respect-availability-p (not (null respect-availability-p)) :library (or library *knowledge-library*)))))

(defstruct observation-outcome status value error (work 0))
(defstruct observed-expression scope expression type (status :unknown) values outcomes (run-work 0) error failed-key)
(defstruct observation-bucket scope type values members invariant-p informative-p counterexample
  (pair-bits 0) (anchor-bits 0) (residual-bits 0))

(defun relational-linkage-residual (frame outcomes &key row-residuals (type (schema-target (frame-schema frame)))
                                                        (metric (frame-metric frame))
                                                        (library *knowledge-library*) ledger)
  "Price relational obligations from (frame-pairs frame) and (frame-anchors frame) in bits."
  (let ((pairs (frame-pairs frame)) (anchors (frame-anchors frame)))
    (when (and (null pairs) (null anchors))
      (return-from relational-linkage-residual (values nil 0 0 0 nil)))
    (let ((ktbl (make-hash-table :test #'equal)) (charged (make-hash-table :test #'equal))
          entries (pbits 0) (abits 0) wdec)
      (loop for row in (frame-rows frame) for item in outcomes for ridx from 0
            for key = (row-key row) for ov = (assoc key row-residuals :test #'equal)
            do (multiple-value-bind (vp val)
                   (cond (ov (if (eq :unknown (cdr ov)) (values nil nil) (values t (cdr ov))))
                         ((observation-outcome-p item) (values (eq :value (observation-outcome-status item))
                                                               (observation-outcome-value item)))
                         (t (values t item)))
                 (setf (gethash key ktbl) (list ridx (not (null ov)) vp val))))
      (loop for pair in pairs for pidx from 0
            for ia = (gethash (first pair) ktbl) for ib = (gethash (second pair) ktbl)
            when (and ia ib) do
              (destructuring-bind (va val-a) (cddr ia)
                (destructuring-bind (vb val-b) (cddr ib)
                  (unless (and va vb (equal val-a val-b))
                    (multiple-value-bind (pkt sb minfo)
                        (if (and va vb) (correction val-a val-b type t metric library ledger)
                            (values :error (cond (va (value-bit-size val-a type)) (vb (value-bit-size val-b type))
                                                 (t (1+ (type-bit-size type)))) nil))
                      (when (and (consp minfo) (eq :metric-decoder (first minfo)) (null wdec))
                        (setf wdec (second minfo)))
                      (setf (gethash (second pair) charged) t)
                      (unless va (setf (gethash (first pair) charged) t))
                      (push (cons (list :pair (first pair) (second pair)) pkt) entries)
                      (incf pbits (+ (positive-bit-size (1+ pidx)) sb)))))))
      (when anchors
        (let (seen (mstep (minimum-disambiguation-bit-size type)))
          (dolist (ak anchors)
            (let ((info (gethash ak ktbl)))
              (when info
                (if (and (third info) (not (member (fourth info) seen :test #'equal)))
                    (push (fourth info) seen)
                    (dolist (mk (pair-connected-component ak pairs))
                      (let ((mi (gethash mk ktbl)))
                        (when (and mi (not (second mi)) (not (gethash mk charged)))
                          (setf (gethash mk charged) t)
                          (push (cons (list :anchor mk) :disambiguate) entries)
                          (incf abits (+ (positive-bit-size (1+ (first mi))) mstep)))))))))))
      (values (nreverse entries) (+ pbits abits) pbits abits wdec))))

(defun observed-agreement-p (l r)
  "True when two complete observation records in the same scope produced identical values."
  (and l r (eq (observed-expression-scope l) (observed-expression-scope r))
       (eq (observed-expression-status l) :complete) (eq (observed-expression-status r) :complete)
       (equal (observed-expression-type l) (observed-expression-type r))
       (equal (observed-expression-values l) (observed-expression-values r))))

(defstruct (observation-job (:include row-job) (:constructor %make-observation-job))
  scope current (outputs nil) retain-outcomes-p (outcomes nil) records buckets (pending-linkage nil)
  (record-index (make-hash-table :test #'equal)) (bucket-index (make-hash-table :test #'equal)))

(defun start-observation-search (scope &key (expressions nil supplied-p) retain-outcomes)
  (let* ((lang (observation-scope-language scope)) (frame (observation-scope-frame scope))
         (resp (observation-scope-respect-availability-p scope))
         (rq (proposal-queue expressions lang))
         (q (if resp (remove-if-not (lambda (e) (expression-respects-availability-p e (frame-schema frame))) rq) rq))
         (counted (member (first (remove-duplicates expressions :test #'equal)) q :test #'equal)))
    (%make-observation-job
     :call-id (observation-scope-id scope) :scope scope :frame frame :language lang
     :retain-outcomes-p (not (null retain-outcomes)) :mode (if supplied-p :replay :enumeration)
     :enumerator (unless supplied-p
                   (make-enumerator lang (if resp (schema-available-inputs (frame-schema frame)) (language-inputs lang))))
     :queue q :completed-bound (if supplied-p 0 (language-header-size lang (schema-target (frame-schema frame))))
     :phase :setup
     :debt (+ (length counted) (length (observation-scope-pairs scope)) (length (observation-scope-anchors scope))
              (loop for r in (frame-rows frame)
                    sum (1+ (loop for v in (row-known r) for s in (language-inputs lang) sum (value-work v (cdr s)))))))))

(defun find-observation (job expression) (gethash expression (observation-job-record-index job)))

(defun observation-invariants (job)
  (remove-if-not #'observation-bucket-informative-p (reverse (observation-job-buckets job))))

(defun classify-observation-bucket (bucket &optional precomputed)
  (let* ((scope (observation-bucket-scope bucket))
         (vals (coerce (observation-bucket-values bucket) 'vector))
         (pairs (observation-scope-pairs scope)) (anchors (observation-scope-anchors scope))
         (failed (find-if (lambda (p) (not (equal (aref vals (first p)) (aref vals (second p))))) pairs)))
    (setf (observation-bucket-invariant-p bucket) (and pairs (null failed))
          (observation-bucket-informative-p bucket)
          (and pairs (null failed) anchors
               (not (every (lambda (i) (equal (aref vals i) (aref vals (first anchors)))) (rest anchors)))))
    (when failed
      (let ((rows (frame-rows (observation-scope-frame scope))))
        (setf (observation-bucket-counterexample bucket)
              (list :before-key (row-key (nth (first failed) rows)) :after-key (row-key (nth (second failed) rows))
                    :before-value (aref vals (first failed)) :after-value (aref vals (second failed))))))
    (multiple-value-bind (es tot pb ab)
        (if precomputed (values-list precomputed)
            (relational-linkage-residual (observation-scope-frame scope) (observation-bucket-values bucket)
                                         :type (observation-bucket-type bucket) :library (observation-scope-library scope)))
      (declare (ignore es))
      (setf (observation-bucket-pair-bits bucket) pb (observation-bucket-anchor-bits bucket) ab
            (observation-bucket-residual-bits bucket) tot)))
  bucket)

(defun finish-observation (job)
  (let* ((rec (observation-job-current job)) (scope (observation-job-scope job))
         (key (list (observed-expression-type rec) (observed-expression-values rec)))
         (pre (prog1 (observation-job-pending-linkage job) (setf (observation-job-pending-linkage job) nil))))
    (push rec (observation-job-records job))
    (setf (gethash (observed-expression-expression rec) (observation-job-record-index job)) rec)
    (when (eq (observed-expression-status rec) :complete)
      (let ((bkt (gethash key (observation-job-bucket-index job))))
        (unless bkt
          (setf bkt (classify-observation-bucket (make-observation-bucket :scope scope :type (first key) :values (second key)) pre)
                (gethash key (observation-job-bucket-index job)) bkt)
          (push bkt (observation-job-buckets job)))
        (push rec (observation-bucket-members bkt))
        (when (observation-bucket-informative-p bkt)
          (push (make-message :call-id (observation-scope-id scope) :claim :observed-invariant :evidence rec)
                (observation-job-messages job)))))
    (setf (observation-job-phase job) :enumerate)))

(defun prepare-observation-index (job)
  (let* ((rec (observation-job-current job)) (scope (observation-job-scope job))
         (frame (observation-scope-frame scope)) (vals (nreverse (observation-job-outputs job))) (priv (make-ledger)))
    (setf (observed-expression-values rec) vals (observed-expression-outcomes rec) (nreverse (observation-job-outcomes job))
          (observation-job-outputs job) nil (observation-job-outcomes job) nil (observation-job-pending-linkage job) nil)
    (when (and (eq (observed-expression-status rec) :complete)
               (or (observation-scope-pairs scope) (observation-scope-anchors scope))
               (not (gethash (list (observed-expression-type rec) vals) (observation-job-bucket-index job))))
      (multiple-value-bind (es tot pb ab)
          (relational-linkage-residual frame vals :type (observed-expression-type rec)
                                       :metric (frame-metric frame) :library (observation-scope-library scope) :ledger priv)
        (setf (observation-job-pending-linkage job) (list es tot pb ab))))
    (setf (observation-job-phase job) :index
          (observation-job-debt job)
          (+ 1 (loop for v in vals sum (value-work v (observed-expression-type rec)))
             (* 2 (length (observation-scope-pairs scope))) (length (observation-scope-anchors scope))
             (ledger-total priv)))))

(defun admit-observation (job type)
  (setf (observation-job-current job)
        (make-observed-expression :scope (observation-job-scope job) :expression (observation-job-expression job) :type type))
  (if (or (eq :replay (observation-job-mode job)) (equal type (row-job-target job))) :row :enumerate))

(defun note-observation-failure (job state)
  (let ((rec (observation-job-current job)))
    (unless (member (observed-expression-status rec) '(:error :unresolved))
      (setf (observed-expression-status rec) (evaluation-status state)
            (observed-expression-error rec) (evaluation-error state)
            (observed-expression-failed-key rec) (row-key (first (observation-job-rows job)))))))

(defun consume-observation-outcome (job state)
  (let ((rec (observation-job-current job)) (st (evaluation-status state)))
    (unless (eq :unknown st)
      (incf (observed-expression-run-work rec) (evaluation-work state))
      (cond ((observation-job-retain-outcomes-p job)
             (setf (observation-job-phase job) :outcome
                   (observation-job-debt job) (+ 1 (if (eq :value st) (value-work (evaluation-value state)
                                                                                 (observed-expression-type rec)) 0))))
            ((eq :value st) (push (evaluation-value state) (observation-job-outputs job)) (next-row job))
            (t (note-observation-failure job state) (prepare-observation-index job))))))

(defun finish-observation-rows (job)
  (let ((rec (observation-job-current job)))
    (unless (eq :error (observed-expression-status rec)) (setf (observed-expression-status rec) :complete))
    (prepare-observation-index job)))

(defun observation-step (job budget)
  (assert (and (integerp budget) (plusp budget)))
  (let ((ledger (observation-job-ledger job)))
    (case (observation-job-phase job)
      (:setup (pay-debt (observation-job-debt job) budget ledger :setup)
              (when (zerop (observation-job-debt job)) (setf (observation-job-phase job) :enumerate)))
      (:outcome (pay-debt (observation-job-debt job) budget ledger :outcomes)
                (when (zerop (observation-job-debt job))
                  (let ((st (observation-job-evaluation job)))
                    (push (make-observation-outcome :status (evaluation-status st) :value (evaluation-value st)
                                                    :error (evaluation-error st) :work (evaluation-work st))
                          (observation-job-outcomes job))
                    (if (eq :value (evaluation-status st))
                        (push (evaluation-value st) (observation-job-outputs job))
                        (note-observation-failure job st))
                    (next-row job))))
      (:index (pay-debt (observation-job-debt job) budget ledger :indexing)
              (when (zerop (observation-job-debt job)) (finish-observation job)))
      (t (row-job-step job budget #'admit-observation #'consume-observation-outcome #'finish-observation-rows)))))

(defun observation-bound-complete-p (job bound) (row-job-bound-complete-p job bound))

(defun resume-observation-search (job description-limit work-limit &key quantum)
  (resume-row-job job #'observation-step description-limit work-limit quantum :scope (observation-job-scope job)))
