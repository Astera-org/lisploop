(in-package #:lisploop)

(defun best-composed-lifting-model (decoder child-id candidates bindings parent-inputs &optional ledger)
  "Compose each candidate child expression with DECODER and BINDINGS and return
the composed parent model with minimum total description size S."
  (let ((best-model nil)
        (best-candidate nil)
        (best-bits nil))
    (dolist (cand candidates)
      (let* ((expr (if (candidate-p cand) (candidate-expression cand) cand))
             (composed (compose-model decoder child-id expr bindings ledger))
             (bits (description-size composed parent-inputs)))
        (when (or (null best-bits) (< bits best-bits))
          (setf best-model composed
                best-candidate cand
                best-bits bits))))
    (values best-model best-candidate best-bits)))

(defun run-m5-supplied-lift-and-repetitions ()
  (let ((field (gf 7))
        (acquisition (make-ledger))
        (work (make-ledger)))
    (format t "~%M5 / Part 1 / GF(7) supplied context lift y_{j,t} = a_j + iota(t), a_0=1, a_1=3.~%")
    (multiple-value-bind (frame decoder r-to-j row-labels records)
        (gf7-lifting-fixture :offsets '(1 3) :steps 7 :repetitions 1 :ledger acquisition)
      (declare (ignore row-labels))
      (let* ((parent-inputs (schema-inputs (frame-schema frame)))
             (bindings (list (cons 3 r-to-j)))
             (child (pullback-frame frame decoder 9 field bindings work))
             (child-inputs (schema-inputs (frame-schema child)))
             (language (make-language field child-inputs))
             (job (start-search child language :call-id :m5-supplied-child))
             (target-linear (app (op :+ field) (lit field 1)
                                 (app (op :* field) (lit field 2) (var 3 field))))
             (bound (description-size target-linear child-inputs)))
        (assert (equal (list (cons 3 field)) child-inputs))
        (assert (null (frame-conflict-p child :ledger work)))
        (assert (eq :bounded-exhaustion (message-claim (resume-search job bound 10000000))))
        (assert (search-job-best job))
        (multiple-value-bind (composed-best chosen-cand composed-bits)
            (best-composed-lifting-model decoder 9 (search-job-results job) bindings parent-inputs work)
          (let* ((direct-child (candidate-expression (search-job-best job)))
                 (direct-composed (compose-model decoder 9 direct-child bindings work))
                 (parent-lookup (lookup-model frame acquisition))
                 (targets (lit (sequence-type field) (mapcar #'fourth records)))
                 (replay-work (replay-model composed-best frame work)))
            (assert (= (replay-model direct-composed frame work)
                       (replay-model direct-composed frame)))
            (format t "Child receives only j in GF(7); discovers ~D offset predictors (smallest child ~S, best composed child ~S).~%"
                    (length (search-job-results job)) direct-child (candidate-expression chosen-cand))
            (report-size "Child offset predictor a_j" direct-child child-inputs)
            (report-size "Supplied context map r->j" r-to-j '((0 . :int)))
            (report-size "Composed lifted model d((r,t), a_{r->j})" composed-best parent-inputs)
            (report-size "Unfactored parent lookup (r,t)->y" parent-lookup parent-inputs)
            (report-size "Literal target sequence (ordered whole-object)" targets nil)
            (format t "Reassembled parent replays all ~D occurrences: lifted S=~D bits (W_run=~D) vs lookup S=~D bits (W_run=~D).~%"
                    (length (frame-rows frame)) composed-bits replay-work
                    (description-size parent-lookup parent-inputs)
                    (replay-model parent-lookup frame acquisition))
            (report-ledger "M5 Part 1 child search" (search-job-ledger job))
            (report-ledger "M5 Part 1 pullback/composition/replay" work)
            (report-ledger "M5 Part 1 fixture/baselines" acquisition))))))
  ;; Repetition compression sweep across 1, 2, 4, 8 repetitions (14, 28, 56, 112 rows)
  (format t "~%M5 / Part 1B / Repetition compression sweep (steps=7, repetitions=1,2,4,8):~%")
  (let ((field (gf 7))
        (prev-saving 0))
    (dolist (reps '(1 2 4 8))
      (let ((rep-ledger (make-ledger)))
        (multiple-value-bind (frame decoder r-to-j row-labels records)
            (gf7-lifting-fixture :offsets '(1 3) :steps 7 :repetitions reps :ledger rep-ledger)
          (declare (ignore row-labels))
          (let* ((parent-inputs (schema-inputs (frame-schema frame)))
                 (bindings (list (cons 3 r-to-j)))
                 (child (pullback-frame frame decoder 9 field bindings rep-ledger))
                 (child-inputs (schema-inputs (frame-schema child)))
                 (job (start-search child (make-language field child-inputs)))
                 (bound (description-size (app (op :+ field) (lit field 1)
                                               (app (op :* field) (lit field 2) (var 3 field)))
                                          child-inputs)))
            (assert (eq :bounded-exhaustion (message-claim (resume-search job bound 10000000))))
            (multiple-value-bind (lifted-model chosen-cand lifted-bits)
                (best-composed-lifting-model decoder 9 (search-job-results job) bindings parent-inputs rep-ledger)
              (declare (ignore chosen-cand))
              (let* ((lookup (lookup-model frame rep-ledger))
                     (lookup-bits (description-size lookup parent-inputs))
                     (seq-values (mapcar #'fourth records))
                     (seq-lit (lit (sequence-type field) seq-values))
                     (seq-lit-bits (description-size seq-lit nil))
                     (saving (- lookup-bits lifted-bits)))
                (assert (= (length records) (length (frame-rows frame))))
                (assert (plusp (replay-model lifted-model frame rep-ledger)))
                (assert (> saving prev-saving))
                (setf prev-saving saving)
                (format t "  reps=~D (~3D rows): lifted S=~3D bits | parent-lookup S=~4D bits (saved ~3D bits) | literal-seq S=~3D bits.~%"
                        reps (length records) lifted-bits lookup-bits saving seq-lit-bits)))))))))

(defun run-m5-contradictory-t-only-control ()
  (let ((field (gf 7))
        (work (make-ledger)))
    (format t "~%M5 / Part 2 / Contradictory t-only control, unavailable-key check, and paid context restoration.~%")
    (multiple-value-bind (frame decoder r-to-j row-labels records)
        (gf7-lifting-fixture :offsets '(1 3) :steps 7 :repetitions 1 :ledger work)
      ;; 1. Restrict child to input t only: identical t requires offsets 1 and 3 simultaneously.
      (let* ((t-only-bindings (list (cons 3 (var 1 :int))))
             (bad-child (pullback-frame frame decoder 9 field t-only-bindings work))
             (bad-inputs (schema-inputs (frame-schema bad-child)))
             (conflict (frame-conflict-p bad-child :ledger work))
             (bad-job (start-search bad-child (make-language field bad-inputs) :call-id :m5-t-only))
             (bound (+ (header-size bad-inputs field) 18)))
        (assert conflict)
        (assert (eq :incompatible-rows (frame-conflict-kind conflict)))
        (assert (eq :bounded-exhaustion (message-claim (resume-search bad-job bound 1000000))))
        (assert (null (search-job-results bad-job)))
        (format t "t-only child pullback conflict detected (~S on keys ~S); bounded exhaustion returns 0 predictors.~%"
                (frame-conflict-kind conflict) (frame-conflict-keys conflict)))
      ;; 2. Verify that a t-only label table is contradictory and that an encoded r->j map
      ;;    cannot repair a t-only parent frame lacking input r (var 0).
      (let* ((t-label-frame (context-label-frame frame row-labels
                                                 :bindings (list (cons 1 (var 1 :int)))
                                                 :label-type field :ledger work))
             (t-label-conflict (frame-conflict-p t-label-frame :ledger work))
             (t-only-parent (orient-observations (list :int :int field) records '(1) '(2)
                                                 :lookup-p t :ledger work))
             (t-only-lookup-rejected-p
               (handler-case (progn (lookup-model t-label-frame work) nil)
                 (error () t)))
             (missing-r-key-rejected-p
               (handler-case (progn (pullback-frame t-only-parent decoder 9 field
                                                    (list (cons 3 r-to-j)) work)
                                    nil)
                 (error () t))))
        (assert (and t-label-conflict (eq :incompatible-rows (frame-conflict-kind t-label-conflict))))
        (assert t-only-lookup-rejected-p)
        (assert missing-r-key-rejected-p)
        (format t "Controls verified: t-only label table rejected as inconsistent; r->j map rejected when parent lacks r.~%"))
      ;; 3. Restore context via paid lookup-model map r->j using parent's available r.
      (let* ((restored-label-frame (context-label-frame frame row-labels
                                                        :bindings (list (cons 0 (var 0 :int)))
                                                        :label-type field :ledger work))
             (paid-r-to-j (lookup-model restored-label-frame work))
             (restored-bindings (list (cons 3 paid-r-to-j)))
             (restored-child (pullback-frame frame decoder 9 field restored-bindings work))
             (child-inputs (schema-inputs (frame-schema restored-child)))
             (job (start-search restored-child (make-language field child-inputs)))
             (bound (description-size (app (op :+ field) (lit field 1)
                                           (app (op :* field) (lit field 2) (var 3 field)))
                                      child-inputs)))
        (assert (null (frame-conflict-p restored-child :ledger work)))
        (assert (eq :bounded-exhaustion (message-claim (resume-search job bound 10000000))))
        (multiple-value-bind (restored-model chosen-cand restored-bits)
            (best-composed-lifting-model decoder 9 (search-job-results job)
                                         restored-bindings (schema-inputs (frame-schema frame)) work)
          (declare (ignore chosen-cand))
          (let ((replay-work (replay-model restored-model frame work)))
            (format t "Restored context via paid r->j map (S=~D bits): child recovers a_j, composed S=~D bits, W_run=~D.~%"
                    (description-size paid-r-to-j '((0 . :int))) restored-bits replay-work)
            (report-ledger "M5 Part 2 controls & restoration" work)))))))

(defun run-m5-hard-em-discovery-and-deployment ()
  (let ((field (gf 7))
        (work (make-ledger)))
    (format t "~%M5 / Part 3 / Unsupervised Hard-EM fiber discovery (infer-fibers) and selector deployment.~%")
    (multiple-value-bind (frame decoder supplied-r-to-j true-labels records)
        (gf7-lifting-fixture :offsets '(1 3) :steps 7 :repetitions 2 :ledger work)
      (declare (ignore supplied-r-to-j records))
      ;; 1. Discover & certify the GF(7) right-addition solver from M4, propagate child requirements,
      ;;    and also verify Hard-EM directly on raw pulled-back predicates without solver propagation.
      (let* ((raw-child (pullback-frame frame decoder 9 field (list (cons 0 (var 0 :int))) work))
             (plus-rel (observe-arithmetic-relation field :+ '(0 1 2 3 4 5 6)))
             (plus-solver (validate-arithmetic-solver (discover-arithmetic-solver plus-rel 1 '(0 1 2 3 4 5 6))))
             (prop (propagate-arithmetic-child frame decoder 9 (list (cons 0 (var 0 :int))) plus-solver work)))
        (assert (certified-solve-discovery-p plus-solver))
        (assert (= (length (frame-rows frame)) (propagation-narrowed prop)))
        (multiple-value-bind (raw-classes raw-labels)
            (infer-fibers raw-child work)
          (multiple-value-bind (classes discovered-labels refined-frame part)
              (infer-fibers (propagation-frame prop) work)
            (declare (ignore refined-frame))
            (assert (= 2 (length raw-classes)))
            (assert (= 2 (length classes)))
            (assert (equal raw-labels discovered-labels))
            (assert (equal true-labels discovered-labels))
            (assert (equal (frame-rows (propagation-frame prop)) (reassemble-partition part)))
            (format t "Hard-EM infer-fibers recovered ~D latent fiber classes ~S matching all ~D occurrences.~%"
                    (length classes)
                    (mapcar #'fiber-class-requirement classes)
                    (length discovered-labels))
            ;; 2. Deployment Path A: Paid context labels addressed by available r (lookup-model)
            (let* ((label-frame (context-label-frame frame discovered-labels
                                                     :bindings (list (cons 0 (var 0 :int)))
                                                     :label-type field :ledger work))
                   (paid-map (lookup-model label-frame work))
                   (paid-bindings (list (cons 3 paid-map)))
                   (paid-child (pullback-frame frame decoder 9 field paid-bindings work))
                   (child-inputs (schema-inputs (frame-schema paid-child)))
                   (job (start-search paid-child (make-language field child-inputs)))
                   (bound (description-size (app (op :+ field) (lit field 1)
                                                 (app (op :* field) (lit field 2) (var 3 field)))
                                            child-inputs)))
              (assert (eq :bounded-exhaustion (message-claim (resume-search job bound 10000000))))
              (multiple-value-bind (deployed-paid chosen-cand deployed-bits)
                  (best-composed-lifting-model decoder 9 (search-job-results job)
                                               paid-bindings (schema-inputs (frame-schema frame)) work)
                (declare (ignore chosen-cand))
                (format t "  Deployed Path A (paid r->j lookup): S=~D bits, W_run=~D across all ~D rows.~%"
                        deployed-bits (replay-model deployed-paid frame work) (length (frame-rows frame)))))
            ;; 3. Deployment Path B: Computable intensional selector via condense-heuristic
            ;;    When the parent exposes a regime feature in GF(7), condense-heuristic synthesizes
            ;;    an intensional selector expression without storing a per-occurrence table.
            (let* ((regime-records
                     (loop for row in (frame-rows frame)
                           for j in discovered-labels
                           collect (list (row-key row) j (second (row-known row))
                                         (first (extract-allowed-values (row-requirement row))))))
                   (regime-frame (orient-observations (list field :int field) regime-records '(0 1) '(2)
                                                      :lookup-p t :ledger work))
                   (regime-label-frame (context-label-frame regime-frame discovered-labels
                                                            :bindings (list (cons 0 (var 0 field)))
                                                            :label-type field :ledger work))
                   (selector-lang (make-language field (list (cons 0 field))
                                                 :operators (list (op :+ field)) :literals '(0 1)))
                   (heuristic (condense-heuristic regime-label-frame selector-lang :ledger work))
                   (selector-expr (heuristic-program heuristic))
                   (sel-bindings (list (cons 3 selector-expr)))
                   (sel-child (pullback-frame regime-frame decoder 9 field sel-bindings work))
                   (sel-inputs (schema-inputs (frame-schema sel-child)))
                   (sel-job (start-search sel-child (make-language field sel-inputs)))
                   (sel-bound (description-size (app (op :+ field) (lit field 1)
                                                     (app (op :+ field) (var 3 field) (var 3 field)))
                                                sel-inputs)))
              (assert (heuristic-exact-p heuristic))
              (assert (eq :bounded-exhaustion (message-claim (resume-search sel-job sel-bound 1000000))))
              (let* ((sel-child-model (candidate-expression (search-job-best sel-job)))
                     (sel-composed (compose-model decoder 9 sel-child-model sel-bindings work)))
                (format t "  Deployed Path B (condensed selector ~S): S=~D bits (0 residual bits), W_run=~D.~%"
                        selector-expr
                        (description-size sel-composed (schema-inputs (frame-schema regime-frame)))
                        (replay-model sel-composed regime-frame work))))))
        (report-ledger "M5 Part 3 Hard-EM discovery & deployment" work)))))

(defun run-m5-integer-lifting-and-tentative-propagation ()
  (let ((work (make-ledger)))
    (format t "~%M5 / Part 4 / Integer lifting y_{j,t} = a_j + t, tentative propagation, and Hard-EM discovery (:INT).~%")
    (multiple-value-bind (frame decoder supplied-r-to-j true-labels)
        (integer-lifting-fixture :offsets '(1 3) :steps 7 :repetitions 2 :ledger work)
      (declare (ignore supplied-r-to-j))
      (let* ((raw-child (pullback-frame frame decoder 9 :int (list (cons 0 (var 0 :int))) work))
             (samples '(-4 -3 -2 -1 0 1 2 3 4))
             (plus-rel (observe-arithmetic-relation :int :+ samples))
             (plus-solver (discover-arithmetic-solver plus-rel 1 samples :literals '(-1 0 1)))
             (_ (integer-solver-held-out plus-solver))
             (prop (propagate-arithmetic-child frame decoder 9 (list (cons 0 (var 0 :int))) plus-solver work)))
        (declare (ignore _))
        (assert (not (certified-solve-discovery-p plus-solver)))
        (assert (eq :conjecture (law-validation-status (solve-discovery-validation plus-solver))))
        (assert (= 0 (propagation-narrowed prop)))
        (assert (= 28 (propagation-suggested prop)))
        (assert (= 0 (propagation-rejected prop)))
        (multiple-value-bind (raw-classes raw-labels) (infer-fibers raw-child work)
          (multiple-value-bind (classes discovered-labels) (infer-fibers (propagation-frame prop) work)
            (assert (= 2 (length raw-classes)))
            (assert (= 2 (length classes)))
            (assert (equal true-labels raw-labels))
            (assert (equal true-labels discovered-labels))
            (let* ((label-frame (context-label-frame frame discovered-labels
                                                     :bindings (list (cons 0 (var 0 :int)))
                                                     :label-type :int :ledger work))
                   (paid-map (lookup-model label-frame work))
                   (bindings (list (cons 3 paid-map)))
                   (child-prop (propagate-arithmetic-child frame decoder 9 bindings plus-solver work))
                   (child-inputs (schema-inputs (frame-schema (propagation-frame child-prop))))
                   (child-lang (make-language :int child-inputs :literals '(0 1 2 3)))
                   (bound (description-size (app (op :+ :int) (lit :int 1)
                                                 (app (op :+ :int) (var 3 :int) (var 3 :int)))
                                            child-inputs))
                   (psearch (start-propagation-search child-prop child-lang)))
              (resume-propagation-search psearch bound 10000000)
              (assert (propagation-search-best psearch))
              (multiple-value-bind (deployed-int chosen-cand deployed-bits)
                  (best-composed-lifting-model decoder 9 (propagation-search-results psearch)
                                               bindings (schema-inputs (frame-schema frame)) work)
                (declare (ignore chosen-cand))
                (let ((lookup-bits (description-size (lookup-model frame work) (schema-inputs (frame-schema frame)))))
                  (assert (< deployed-bits lookup-bits))
                  (format t "Integer Hard-EM + tentative propagation recovered ~D classes ~S -> lifted S=~D bits (vs lookup S=~D bits), W_run=~D.~%"
                          (length classes)
                          (mapcar #'fiber-class-requirement classes)
                          deployed-bits lookup-bits
                          (replay-model deployed-int frame work)))))))
        (report-ledger "M5 Part 4 integer lifting & tentative propagation" work)))))

(defun run-m5 ()
  (run-m5-supplied-lift-and-repetitions)
  (run-m5-contradictory-t-only-control)
  (run-m5-hard-em-discovery-and-deployment)
  (run-m5-integer-lifting-and-tentative-propagation))
