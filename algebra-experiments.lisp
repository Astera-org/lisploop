(in-package #:lisploop)

(defun algebra-job-work (job)
  (etypecase job
    (search-job (ledger-total (search-job-ledger job)))
    (observation-job (ledger-total (observation-job-ledger job)))
    (law-validation (ledger-total (law-validation-ledger job)))))

(defun solve-acquisition-work (discovery)
  (+ (ledger-total (solve-discovery-ledger discovery))
     (reduce #'+ (append (list (solve-discovery-observations discovery) (solve-discovery-recovery discovery)
                               (solve-discovery-search discovery))
                         (solve-discovery-guard-searches discovery)
                         (remove nil (list (solve-discovery-validation discovery) (solve-discovery-uniqueness discovery))))
             :key #'algebra-job-work)))

(defun relation-acquisition-work (relation)
  (+ (ledger-total (arithmetic-relation-ledger relation))
     (algebra-job-work (arithmetic-relation-observations relation))
     (algebra-job-work (arithmetic-relation-guard-search relation))))

(defun arithmetic-parent-fixture (relation position values ledger)
  "A separate batch hides h(b)=b+1 behind the supplied arithmetic decoder."
  (let* ((domain (arithmetic-relation-domain relation)) (operator (arithmetic-relation-operator relation))
         (hidden (app (op :+ domain) (var 1 domain) (lit domain 1)))
         (oracle (arithmetic-application operator position (var 0 domain) hidden))
         (job (observe-arithmetic-values domain operator values 100000000 oracle))
         (records (arithmetic-forward-records job ledger))
         (parent (orient-observations (list domain domain domain) records '(0 1) '(2) :ledger ledger)))
    (values parent (arithmetic-application operator position (var 0 domain) (var 9 domain))
            (list (cons 3 (var 1 domain))) job)))

(defun replay-arithmetic-parent (model frame ledger)
  (let ((inputs (schema-inputs (frame-schema frame))))
    (dolist (row (frame-rows frame))
      (let ((run (run-algebra-program model inputs (row-known row) ledger :parent-replay)))
        (assert (eq :value (evaluation-status run)))
        (let ((check (check-allowed (row-allowed row) (evaluation-value run) :ledger ledger)))
          (assert (and (eq :value (evaluation-status check)) (evaluation-value check))))))))

(defun compare-arithmetic-propagation (discovery values)
  (let* ((relation (solve-discovery-relation discovery)) (domain (arithmetic-relation-domain relation))
         (acquisition (make-ledger)) (original-work (make-ledger)) (propagation-work (make-ledger)))
    (multiple-value-bind (parent decoder bindings observations)
        (arithmetic-parent-fixture relation (solve-discovery-position discovery) values acquisition)
      (let* ((original (pullback-frame parent decoder 9 domain bindings original-work))
             (propagation (propagate-arithmetic-child parent decoder 9 bindings discovery propagation-work))
             (inputs (schema-inputs (frame-schema original)))
             (language (make-language domain inputs :operators (list (op :+ domain) (op :* domain))
                                       :literals (if (eq domain :int) '(-1 0 1) :all)))
             (plain (start-search original language)) (propagated (start-search (propagation-frame propagation) language))
             (bound (+ (header-size inputs domain) 16)))
        (dolist (job (list plain propagated))
          (assert (eq :bounded-exhaustion (message-claim (resume-search job bound 10000000)))))
        (assert (search-job-best plain))
        (assert (equal (mapcar #'candidate-expression (search-job-results plain))
                       (mapcar #'candidate-expression (search-job-results propagated))))
        (let* ((composition (make-ledger))
               (model (compose-model decoder 9 (candidate-expression (search-job-best propagated)) bindings composition)))
          (replay-arithmetic-parent (decode-model (encode-model model (schema-inputs (frame-schema parent)))) parent composition)
          (values propagation plain propagated original-work propagation-work
                  (+ (ledger-total acquisition) (algebra-job-work observations)) composition))))))

(defun integer-solver-held-out (discovery)
  "Fresh forward observations and query checks; no universal integer certificate."
  (let* ((relation (solve-discovery-relation discovery)) (operator (arithmetic-relation-operator relation))
         (n (ash 1 64)) (values (list (- n) -17 -1 0 1 17 n))
         (ledger (make-ledger)) (observations (observe-arithmetic-values :int operator values 100000000))
         (record (first (observation-job-records observations)))
         (support (mapcar (lambda (outcome) (eq :value (observation-outcome-status outcome))) (observed-expression-outcomes record)))
         (definedness (search-membership-frame (support-frame (observation-job-scope observations) support ledger) :int
                                               :work-limit 100000000 :expressions (list (arithmetic-relation-guard relation))))
         (fresh (copy-arithmetic-relation relation))
         (position (solve-discovery-position discovery)))
    (setf (arithmetic-relation-records fresh) (arithmetic-forward-records observations ledger))
    (let* ((queries (orient-arithmetic-requirements fresh position values ledger))
           (samples (remove-duplicates (mapcar #'row-known (frame-rows queries)) :test #'equal))
           (unique-samples
             (append (loop for row in (frame-rows (solve-discovery-frame discovery)) append
                       (loop for z from -4 to 4 collect (append (row-known row) (list z))))
                     (loop for record in (arithmetic-relation-records fresh)
                           collect (list (nth (1+ (- 1 position)) record) (fourth record) (nth (1+ position) record))))))
      (validate-arithmetic-solver discovery :samples samples :uniqueness-samples unique-samples)
      (assert (eq :conjecture (law-validation-status (solve-discovery-validation discovery))))
      (assert (not (certified-solve-discovery-p discovery)))
      (+ (ledger-total ledger) (algebra-job-work observations) (algebra-job-work definedness)))))

(defun report-arithmetic-discovery (discovery label)
  (let* ((domain (arithmetic-relation-domain (solve-discovery-relation discovery))) (inputs (arithmetic-inputs domain))
         (q (solve-discovery-witness discovery)) (guard (solve-discovery-guard discovery)))
    (format t "  ~A: q=~S~%    guard=~S~%" label q guard)
    (format t "    q S=~D; guard S=~D; covered=~D/~D; candidates=~D; acquisition including validation=~D.~%"
            (description-size q inputs) (description-size guard inputs)
            (length (frame-rows (search-job-frame (solve-discovery-search discovery))))
            (length (frame-rows (solve-discovery-frame discovery)))
            (length (solve-discovery-proposals discovery)) (solve-acquisition-work discovery))
    (format t "    witness=~S; whole-fiber equivalence=~S; singleton propagation licensed=~S.~%"
            (law-validation-status (solve-discovery-validation discovery))
            (law-validation-status (solve-discovery-uniqueness discovery)) (certified-solve-discovery-p discovery))
    (format t "    source programs=~D; forward requirement replay=~D; witness core search=~D; guard stages=~D; data/proposals=~D; validation=~D.~%"
            (algebra-job-work (solve-discovery-observations discovery)) (algebra-job-work (solve-discovery-recovery discovery))
            (algebra-job-work (solve-discovery-search discovery))
            (reduce #'+ (solve-discovery-guard-searches discovery) :key #'algebra-job-work)
            (ledger-total (solve-discovery-ledger discovery))
            (+ (algebra-job-work (solve-discovery-validation discovery)) (algebra-job-work (solve-discovery-uniqueness discovery))))))

(defun addition-oracle-control (discovery)
  "An explicitly supplied control, called only AFTER unseeded bootstrap discovery."
  (let* ((domain (arithmetic-relation-domain (solve-discovery-relation discovery)))
         (inputs (arithmetic-inputs domain))
         (oracle (app (op :+ domain) (var 1 domain)
                      (app (op :* domain) (lit domain (if (eq domain :int) -1 (1- (second domain)))) (var 0 domain))))
         (job (start-search (solve-discovery-frame discovery) (make-language domain inputs :operators nil :literals nil)
                            :expressions (list oracle))))
    (assert (eq :replay-complete (message-claim (resume-search job (description-size oracle inputs) 100000000))))
    (assert (search-job-best job))
    job))

(defun run-m4 ()
  (format t "~%M4 / all arithmetic operators, both operand positions. No inverse-value enumeration.~%")
  (format t "Forward tables are reused; query requirements remain predicates. Maximum observed witness coverage is a supplied proposal prior.~%")
  (dolist (domain (list (gf 5) (gf 7) :int))
    (let* ((values (if (eq domain :int) '(-4 -3 -2 -1 0 1 2 3 4) (loop for i below (second domain) collect i)))
           (literals (if (eq domain :int) '(-1 0 1) :all)) (discoveries nil)
           (source-work 0) (solve-work 0) (fresh-work 0))
      (format t "~%Domain ~S; arithmetic grammar +,-,*,/; body bound 16; literals ~S; Boolean guard body bound 35, literal 0.~%" domain literals)
      (dolist (name '(:+ :- :* :/))
        (let ((relation (observe-arithmetic-relation domain name values)))
          (incf source-work (relation-acquisition-work relation))
          (format t "~%Forward ~S: ~D executions, ~D defined; learned domain guard ~S; acquisition ~D (shared by both orientations).~%"
                  name (expt (length values) 2) (length (arithmetic-relation-records relation))
                  (arithmetic-relation-guard relation) (relation-acquisition-work relation))
          (dotimes (position 2)
            (let ((discovery (discover-arithmetic-solver relation position values :literals literals)))
              (if (eq domain :int) (incf fresh-work (integer-solver-held-out discovery))
                  (progn (validate-arithmetic-solver discovery) (assert (certified-solve-discovery-p discovery))))
              (incf solve-work (solve-acquisition-work discovery))
              (push discovery discoveries)
              (report-arithmetic-discovery discovery (format nil "unknown operand ~D" position))
              (multiple-value-bind (propagation plain propagated original-work propagation-work acquisition composition)
                  (compare-arithmetic-propagation discovery (if (eq domain :int) '(-2 -1 0 1 2) values))
                (format t "    Parent batch: ~D singleton / ~D retained predicates; child search ~D -> ~D; pullback ~D -> propagation setup ~D; batch acquisition ~D; composition/replay ~D.~%"
                        (propagation-narrowed propagation) (propagation-retained propagation)
                        (algebra-job-work plain) (algebra-job-work propagated)
                        (ledger-total original-work) (ledger-total propagation-work) acquisition (ledger-total composition)))))
          (when (eq name :+)
            (let ((bootstrap (discover-arithmetic-solver relation 1 values :operators '(:+ :*) :literals literals :body-bound 24)))
              (if (eq domain :int) (incf fresh-work (integer-solver-held-out bootstrap))
                  (progn (validate-arithmetic-solver bootstrap) (assert (certified-solve-discovery-p bootstrap))))
              (incf solve-work (solve-acquisition-work bootstrap))
              (report-arithmetic-discovery bootstrap "original addition bootstrap: +/* only, body bound 24")
              (format t "    Supplied oracle replay after discovery: ~D units (separate positive control).~%"
                      (algebra-job-work (addition-oracle-control bootstrap)))))))
      (let* ((ledger (make-ledger)) (laws (mapcar #'solve-witness-law (nreverse discoveries)))
             (corpus (make-law-corpus laws ledger)))
        (multiple-value-bind (pattern substitutions) (anti-unify (mapcar #'law-statement laws) (arithmetic-inputs domain) ledger)
          (format t "~%AU on eight learned guarded witness statements; supplied alignment, no new mathematical evidence.~%")
          (report-quoted-au-constructor corpus pattern substitutions)
          (report-ledger "  AU/corpus preparation" ledger)))
      (format t "~%Domain totals: shared forward/definedness acquisition=~D; nine solver discoveries/validations=~D; extra held-out acquisition=~D.~%"
              source-work solve-work fresh-work)))
  (format t "Finite certificates license exact guarded singleton propagation. Integer evidence remains sampled; all other fibers retain predicates.~%"))
