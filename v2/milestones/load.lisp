;;; Load the external milestone experiment drivers on top of the synthesis kernel.
;;; The kernel (../load.lisp) never calls into milestones/.
(let ((here (make-pathname :name nil :type nil :defaults *load-truename*)))
  (unless (and (find-package '#:lisploop)
               (fboundp (find-symbol "START-SYNTHESIS" '#:lisploop)))
    (load (merge-pathnames "../load.lisp" here)))
  (export
   (mapcar (lambda (name) (intern name '#:lisploop))
           '(;; milestones/corpus.lisp
             "PATTERNS-ISOMORPHIC-P" "PATTERN-HOLE-COUNTS"
             "SUBTREE-AT-PATH" "REPLACE-AT-PATH"
             "TREE-OCCURRENCE" "TREE-OCCURRENCE-P"
             "TREE-OCCURRENCE-TREE-INDEX" "TREE-OCCURRENCE-PATH" "TREE-OCCURRENCE-TERM"
             "TREE-OCCURRENCE-SORT" "TREE-OCCURRENCE-SIGNATURE" "COLLECT-TREE-OCCURRENCES"
             "TREE-CORPUS" "MAKE-TREE-CORPUS" "DECODE-TREE-CORPUS"
             "TREE-CORPUS-DOMAIN" "TREE-CORPUS-INPUTS" "TREE-CORPUS-SORT"
             "TREE-CORPUS-TREES" "TREE-CORPUS-PACKET" "TREE-CORPUS-FRAME"
             "CORPUS-ABSTRACTION-MODEL"
             "SUBEXPRESSION-ABSTRACTION" "SUBEXPRESSION-ABSTRACTION-P"
             "SUBEXPRESSION-ABSTRACTION-KIND" "SUBEXPRESSION-ABSTRACTION-PATTERN"
             "SUBEXPRESSION-ABSTRACTION-SUBSTITUTIONS" "SUBEXPRESSION-ABSTRACTION-PATHS"
             "SUBEXPRESSION-ABSTRACTION-MODEL" "SUBEXPRESSION-ABSTRACTION-BITS"
             "SUBEXPRESSION-ABSTRACTION-LITERAL-BITS" "SUBEXPRESSION-ABSTRACTION-GAIN"
             "SUBEXPRESSION-ABSTRACTION-STRUCTURAL-SCORE"
             "DISCOVER-SUBEXPRESSION-ABSTRACTIONS"
             "LAW-CORPUS" "MAKE-LAW-CORPUS" "DECODE-LAW-CORPUS"
             "LAW-CORPUS-LAWS" "LAW-CORPUS-PACKET" "LAW-CORPUS-FRAME"
             "LAW-TEMPLATE-GROUP" "LAW-TEMPLATE-GROUP-POSITIONS"
             "LAW-TEMPLATE-GROUP-PATTERN" "LAW-TEMPLATE-GROUP-SUBSTITUTIONS"
             "PROPOSE-LAW-COMPRESSIONS"
             ;; milestones/propagation-search.lisp
             "PROPAGATION-SEARCH" "START-PROPAGATION-SEARCH" "RESUME-PROPAGATION-SEARCH"
             "PROPAGATION-SEARCH-RESULTS" "PROPAGATION-SEARCH-BEST"
             "PROPAGATION-SEARCH-LEDGER" "PROPAGATION-SEARCH-FIRST-WORK"
             ;; milestones/views.lisp
             "PARTITION-VIEW-PROPOSAL" "PARTITION-VIEW-PROPOSAL-P"
             "PARTITION-VIEW-PROPOSAL-KIND" "PARTITION-VIEW-PROPOSAL-GUARD"
             "PARTITION-VIEW-PROPOSAL-PART-MODELS" "PARTITION-VIEW-PROPOSAL-MODEL"
             "PARTITION-VIEW-PROPOSAL-CONFLICT" "PARTITION-VIEW-PROPOSAL-BITS"
             "PARTITION-VIEW-PROPOSAL-RUN-WORK"
             "EVALUATE-GUARD-PARTITION" "SYNTHESIZE-SUPPLIED-PARTITION-VIEW" "DISCOVER-PARTITION-VIEWS"
             ;; milestones/algebra-discovery.lisp
             "OBSERVED-SUPPORT"
             "GUARD-PROBLEM" "GUARD-PROBLEM-SCOPE" "GUARD-PROBLEM-SUPPORT"
             "GUARD-PROBLEM-FRAME" "GUARD-PROBLEM-EQUATIONS"
             "PROPOSE-GUARD-PROBLEMS" "START-GUARD-SEARCH" "PROPOSE-GUARDED-LAWS"
             "OBSERVE-ARITHMETIC-RELATION" "DISCOVER-ARITHMETIC-SOLVER"
             "ARITHMETIC-RELATION" "ARITHMETIC-RELATION-GUARD" "ARITHMETIC-RELATION-RECORDS"
             "SOLVE-DISCOVERY" "SOLVE-DISCOVERY-FRAME" "SOLVE-DISCOVERY-WITNESS" "SOLVE-DISCOVERY-GUARD"
             "SOLVE-DISCOVERY-VALIDATION" "SOLVE-DISCOVERY-UNIQUENESS"
             "VALIDATE-ARITHMETIC-SOLVER" "CERTIFIED-SOLVE-DISCOVERY-P"
             "PREPARE-PROPAGATOR-LIBRARY" "DISCOVERY-PROPAGATOR-LIBRARY"
             ;; milestones/dependency-search.lisp
             "DEPENDENCY-SEARCH" "START-DEPENDENCY-SEARCH" "RESUME-DEPENDENCY-SEARCH"
             "DEPENDENCY-SEARCH-SYNTHESIS" "DEPENDENCY-SEARCH-FEATURES" "DEPENDENCY-SEARCH-LEDGER"))
   '#:lisploop)
  (dolist (name '("corpus" "propagation-search" "views" "algebra-discovery" "dependency-search"))
    (load (merge-pathnames (make-pathname :name name :type "lisp") here))))
