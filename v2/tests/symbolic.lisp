(in-package #:lisploop)

(defun symbolic-error-p (model &optional inputs values)
  (eq :error (evaluation-status (evaluate model inputs values))))

(deftest quoted-syntax-types-codec-and-no-evaluation
  (dolist (domain (list :int (gf 5)))
    (let* ((scope (list (cons 99 domain))) (code (code-type scope domain))
           (x (var 99 domain)) (zero (lit domain 0))
           (bad (app (op :/ domain) (lit domain 1) zero))
           (sum (app (op :+ domain) x zero))
           (operator-code (code-type scope (operator-type (op :+ domain)))))
      (dolist (term (list x zero bad sum))
        (let ((quoted (lit code term)))
          (check-codec-roundtrip quoted nil)
          (check (equal term (result quoted)))
          (check (equal term (result (decode-model (encode-model quoted)))))))
      (check (symbolic-error-p bad scope '(0)))
      (check-codec-roundtrip (lit operator-code (op :+ domain)) nil)
      (raises (lit code (var 0 domain)))
      (raises (lit code (lit :bool t)))
      (raises (lit code (hole 99 domain)))
      (raises (lit code #'identity))
      (raises (lit operator-code (op := domain)))
      (raises (op :eval code))
      (raises (op :funcall code))
      (check (not (value-p sum (code-type nil domain))))))
  (raises (code-type '((0 . :int) (0 . :int)) :int))
  (raises (code-type '((-1 . :int)) :int))
  (raises (code-type nil '(:fn (:int) :unknown)))
  (let ((old (encode-model (lit :int 0))))
    (setf (subseq old 0 5) #*01110)
    (raises (decode-model old))))

(deftest symbolic-inspection-construction-and-failure-boundaries
  (let* ((scope '((7 . :int))) (code (code-type scope :int))
         (bool-code (code-type scope :bool)) (x (var 7 :int)) (one (lit :int 1))
         (plus (op :+ :int)) (source (app plus x one))
         (operator-code (code-type scope (operator-type plus)))
         (quoted (lit code source))
         (child-op (op :code-child (tuple-type code code)))
         (operator (app (op :code-operator operator-code) quoted))
         (args (app (op :tuple (tuple-type code code))
                    (app child-op quoted (lit :int 0)) (app child-op quoted (lit :int 1))))
         (rebuilt (app (op :code-apply operator-code) operator args)))
    (check (equal source (result rebuilt)))
    (check-codec-roundtrip rebuilt nil)
    (loop for term in (list x one source) for kind from 0 do
      (check (= kind (result (app (op :code-kind code) (lit code term))))))
    (check (= 3 (result (app (op :code-kind operator-code) (lit operator-code plus)))))
    (dolist (index (list -1 2 (ash 1 128)))
      (check (symbolic-error-p (app child-op quoted (lit :int index)))))
    (check (symbolic-error-p (app child-op (lit code x) (lit :int 0))))
    (check (symbolic-error-p (app (op :code-child (tuple-type code bool-code)) quoted (lit :int 0))))
    (check (symbolic-error-p (app (op :code-operator operator-code) (lit code one))))
    (raises (op :code-child (tuple-type code (code-type nil :int))))
    (raises (expression-type (app (op :code-apply operator-code) (lit operator-code plus)
                                  (lit (tuple-type code) (list one)))))
    (check (equal one (result (app (op :if code) (lit :bool nil)
                                   (app child-op quoted (lit :int -1)) (lit code one)))))))

(deftest symbolic-matching-substitution-and-quotation-scope
  (let* ((parameters '((0 . :int) (1 . :int))) (scope '((7 . :int)))
         (pattern-type (code-type parameters :int)) (source-type (code-type scope :int))
         (x (var 7 :int)) (zero (lit :int 0))
         (pattern (app (op :+ :int) (var 0 :int) (var 1 :int)))
         (source (app (op :+ :int) x zero))
         (p (lit pattern-type pattern)) (s (lit source-type source))
         (bind-op (op :code-bind (tuple-type pattern-type source-type source-type)))
         (bindings-type (tuple-type source-type source-type))
         (bindings (app (op :tuple bindings-type) (app bind-op p s (lit :int 0))
                                                   (app bind-op p s (lit :int 1))))
         (rebuilt (app (op :code-subst (tuple-type pattern-type bindings-type source-type)) p bindings)))
    (check (eq t (result (app (op :code-match (tuple-type pattern-type source-type)) p s))))
    (check (equal source (result rebuilt)))
    (check-codec-roundtrip rebuilt nil)
    (check (symbolic-error-p (app bind-op p s (lit :int 2))))
    (check (symbolic-error-p (app bind-op p (lit source-type x) (lit :int 0))))
    (let ((repeated (lit pattern-type (app (op :+ :int) (var 0 :int) (var 0 :int)))))
      (check (null (result (app (op :code-match (tuple-type pattern-type source-type)) repeated s))))
      (check (eq t (result (app (op :code-match (tuple-type pattern-type source-type))
                                repeated (lit source-type (app (op :+ :int) x x))))))))
  (let* ((scope '((0 . :int) (1 . :int))) (code (code-type scope :int))
         (a (var 0 :int)) (b (var 1 :int)) (plus (op :+ :int))
         (model (app (op :code-subst (tuple-type code (tuple-type code code) code))
                     (lit code (app plus a b)) (lit (tuple-type code code) (list b a)))))
    (check (equal (app plus b a) (result model))))
  (let* ((inner (code-type '((0 . :int)) :int))
         (template-type (code-type '((0 . :int)) inner))
         (result-type (code-type nil inner)) (argument (code-type nil :int))
         (term (lit inner (var 0 :int)))
         (model (app (op :code-subst (tuple-type template-type (tuple-type argument) result-type))
                     (lit template-type term) (lit (tuple-type argument) (list (lit :int 42))))))
    (check-codec-roundtrip model nil)
    (check (equal term (result model)))))

(deftest symbolic-au-lowers-operator-and-repeated-holes
  (let ((sources (list (app (op :+ :int) (lit :int 2) (lit :int 2))
                       (app (op :* :int) (lit :int 3) (lit :int 3)))))
    (multiple-value-bind (pattern substitutions) (anti-unify sources)
      (multiple-value-bind (model inputs) (compile-au-constructor pattern nil)
        (check (= 2 (length inputs)))
        (check-codec-roundtrip model inputs)
        (loop for source in sources for bindings in substitutions do
          (let ((values (mapcar (lambda (input) (cdr (assoc (car input) bindings))) inputs)))
            (check (equal source (result model inputs values)))
            (check (equal source (result (decode-model (encode-model model inputs)) inputs values)))))
        (let* ((code (expression-type model inputs))
               (frame (make-frame (make-schema :inputs inputs :target code)
                                  (loop for source in sources for bindings in substitutions for i from 0 collect
                                    (make-row :key i :known (mapcar (lambda (input) (cdr (assoc (car input) bindings))) inputs)
                                              :requirement (set-requirement code (list source))))))
               (job (start-search frame (make-language :int inputs :operators nil :literals nil) :expressions (list model))))
          (check (eq :replay-complete (message-claim (resume-search job (description-size model inputs) 1000000))))
          (check (= 1 (length (search-job-results job)))))))))

(deftest symbolic-grammar-enumerates-and-snapshots-typed-constants
  (let* ((code (code-type '((7 . :int)) :int)) (inputs (list (cons 0 code)))
         (operator (op :code-child (tuple-type code code)))
         (x (var 7 :int)) (zero (lit :int 0))
         (frame (simple-frame code inputs (list (list (list (app (op :+ :int) x zero)) x)
                                                (list (list (app (op :+ :int) zero x)) zero))))
         (constants (list (lit code zero)))
         (language (make-language :int inputs :operators (list operator) :literals '(0 1) :constants constants))
         (oracle (app operator (var 0 code) (lit :int 0)))
         (bound (description-size oracle inputs))
         (job (start-search frame language))
         (leaves (list (var 0 code) (lit :int 0) (lit :int 1) (lit code zero)))
         (reference (reference-typed-trees leaves (list operator) 1 inputs bound)))
    (check (eq :bounded-exhaustion (message-claim (resume-search job bound 2000000))))
    (check (equal oracle (candidate-expression (search-job-best job))))
    (check (same-set-p (enumerated-expressions job) reference))
    (let ((scope (make-observation-scope frame language)))
      (setf (second (first (language-constants language))) (lit :int 99))
      (check (equal (list (lit code zero)) (language-constants (observation-scope-language scope))))))
  (let* ((type (tuple-type)) (model (app (op :tuple type)))
         (job (start-search (simple-frame type nil '((nil nil)))
                            (make-language :int nil :operators (list (op :tuple type)) :literals nil))))
    (check (eq :bounded-exhaustion (message-claim (resume-search job (description-size model) 100000))))
    (check (equal model (candidate-expression (search-job-best job)))))
  (let* ((language (make-language :int '((0 . :bool)) :operators nil :literals '(0)
                                  :constants (list (lit :int 0) (lit :int 1) (lit :bool t) (lit :int 1))))
         (job (start-search (simple-frame :int '((0 . :bool)) '(((t) 1))) language)))
    (check (eq :bounded-exhaustion
               (message-claim (resume-search job (description-size (lit :int 1) '((0 . :bool))) 100000))))
    (check (same-set-p (enumerated-expressions job)
                       (list (var 0 :bool) (lit :int 0) (lit :int 1) (lit :bool nil) (lit :bool t))))))

(defun code-transform-fixture (domain)
  (let* ((scope (list (cons 99 domain))) (code (code-type scope domain))
         (x (var 99 domain)) (zero (lit domain 0)) (one (lit domain 1))
         (plus (op :+ domain)) (mul (op :* domain))
         (partial (app (op :/ domain) one zero))
         (positive (list x (lit domain 2) (app mul x one)))
         (negative (list x zero (app mul x zero) (app plus x one) (app plus partial zero)))
         (rows (append (loop for term in positive collect (list (app plus term zero) term))
                       (loop for term in negative collect (list term term))))
         (pattern-type (code-type (list (cons 7 domain)) domain))
         (pattern (lit pattern-type (app plus (var 7 domain) zero)))
         (source (var 0 code))
         (child (app (op :code-child (tuple-type code code)) source (var 1 :int)))
         (decoder (app (op :if code)
                       (app (op :code-match (tuple-type pattern-type code)) pattern source)
                       (app (op :if code) (app (op :code-total code) child) child source) source)))
    (values (make-frame (make-schema :inputs (list (cons 0 code)) :target code)
                        (loop for (source target) in rows for i from 0 collect
                          (make-row :key i :known (list source) :requirement (set-requirement code (list target)))))
            decoder scope)))

(deftest symbolic-pullback-learns-a-checked-transformation
  (dolist (domain (list :int (gf 5) (gf 7)))
    (multiple-value-bind (parent decoder scope) (code-transform-fixture domain)
      (let* ((ledger (make-ledger))
             (child (pullback-frame parent decoder 1 :int nil ledger))
             (language (make-language :int nil :operators nil :literals '(0 1 -1)))
             (job (start-search child language))
             (bound (description-size (lit :int 1))))
        (check (eq :bounded-exhaustion (message-claim (resume-search job bound 1000000))))
        (check (equal (lit :int 0) (candidate-expression (search-job-best job))))
        (let* ((model (compose-model decoder 1 (candidate-expression (search-job-best job)) nil ledger))
               (inputs (schema-inputs (frame-schema parent)))
               (checked (start-search parent (make-language :int inputs :operators nil :literals nil) :expressions (list model))))
          (check-codec-roundtrip model inputs)
          (check (eq :replay-complete (message-claim (resume-search checked (description-size model inputs) 1000000))))
          (check (= 1 (length (search-job-results checked))))
          (dolist (n (if (eq domain :int) (list -10 10 (ash 1 128)) '(0 1 3 4)))
            (let* ((term (app (op :* domain) (var 99 domain) (lit domain n)))
                   (source (app (op :+ domain) term (lit domain 0)))
                   (output (result model inputs (list source))))
              (check (equal term output))
              (dolist (x (if (eq domain :int) '(-2 0 3) '(0 1 2 3 4)))
                (check (= (result source scope (list x)) (result output scope (list x))))))))))))

(deftest symbolic-vm-continuations-cover-copying-and-errors
  (let* ((code (code-type nil :int)) (value (lit :int (ash 1 128)))
         (source (app (op :+ :int) value value)) (quoted (lit code source))
         (child (op :code-child (tuple-type code code)))
         (template-type (code-type '((0 . :int)) :int))
         (template (app (op :* :int) (var 0 :int) (var 0 :int)))
         (models (list (app child quoted (lit :int 0)) (app child quoted (lit :int -1))
                       (app (op :code-subst (tuple-type template-type (tuple-type code) code))
                            (lit template-type template) (lit (tuple-type code) (list source)))
                       (app (op :code-less code) (lit code value) quoted))))
    (dolist (model models)
      (check-codec-roundtrip model nil)
      (multiple-value-bind (whole)
          (check-evaluation-resumption model nil nil :budget 10000000)
        (check (member (evaluation-status whole) '(:value :error)))))))

(deftest checked-rule-transformer-is-an-isolated-dsl-program
  (let* ((domain (gf 5)) (parameters (list (cons 0 domain))) (x (var 0 domain))
         (one (lit domain 1)) (zero (lit domain 0))
         (guard (bool-not (app (op := domain) x zero)))
         (validation (checked-law (make-law domain parameters (app (op :/ domain) x x) one :guard guard)))
         (library (prepare-rewrite-library (list validation) domain))
         (scope (list (cons 99 domain))) (actual (var 99 domain))
         (source (app (op :/ domain) actual actual))
         (assumption (bool-not (app (op := domain) actual zero))))
    (multiple-value-bind (model inputs) (compile-rule-transformer (first (rewrite-library-rules library)) scope)
      (check-codec-roundtrip model inputs)
      (check (equal source (result model inputs (list source nil))))
      (check (equal one (result model inputs (list source (list assumption)))))
      (check (equal source (result model inputs (list source (list (app (op := domain) actual zero))))))
      (let* ((roundtrip (decode-model (encode-model model inputs)))
             (partial (app (op :/ domain) one zero))
             (bad (app (op :/ domain) partial partial))
             (bad-assumption (bool-not (app (op := domain) partial zero))))
        (check (equal bad (result roundtrip inputs (list bad (list bad-assumption))))))
      (multiple-value-bind (batch)
          (check-evaluation-resumption model inputs (list source (list assumption)) :budget 1000000)
        (check (equal one (evaluation-value batch)))))))
