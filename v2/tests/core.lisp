(in-package #:lisploop2)

;;; Contracts of the store core. These are the test contracts that plan section 9 names as an
;;; asset independent of the code, restated for the store: budget obedience and resumption
;;; parity, agreement of the two evaluators, and the identities of the change of space.

(defparameter *int-env* '((x . :int) (y . :int) (z . :int) (xs . (:seq :int)) (b . :bool)))

(defun pt (sexp &optional (env *int-env*)) (parse-term sexp env))
(defun val (sexp env &optional (types *int-env*)) (values (run-term (parse-term sexp types) env)))

(deftest test-cells
  (check (cell= 3 3))
  (check (not (cell= 3 4)))
  (check (cell= (vector 1 2 (vector 3)) (vector 1 2 (vector 3))))
  (check (not (cell= (vector 1 2) (vector 1 2 3))))
  (check (not (cell= (vector) nil)) "the empty sequence is not false")
  (check (cell= (list 1 t) (list 1 t)))
  (check (cell= (make-fault '/ '(1 0)) (make-fault 'at '(2))) "faults are equal whatever their detail")
  (check (not (cell= (make-fault '/ '(1 0)) *fuel-out*)) "a fault is not a cut-off")
  (check (not (cell= (make-pending '(f 1)) (make-pending '(f 2)))))
  (check (cell= (make-pending '(f 1)) (make-pending '(f 1))))
  (check (= (cell-hash (vector 1 2)) (cell-hash (vector 1 2))))
  (check (= (cell-hash (make-fault '/ '(1 0))) (cell-hash (make-fault 'at '(2)))))
  (check (col= (vector 1 (vector 2) nil) (vector 1 (vector 2) nil)))
  (check (= (col-hash (vector 1 (vector 2) nil)) (col-hash (vector 1 (vector 2) nil)))))

(deftest test-types
  (check-equal '((?a . :int)) (match-type '(:seq ?a) '(:seq :int) nil))
  (check-equal :fail (match-type '(?a ?a) '(:int :bool) nil))
  (check-equal :fail (match-type '?n :bool nil))
  (check-equal '((?n :gf 3)) (match-type '?n '(:gf 3) nil))
  (check (value-of-type-p (vector 1 2) '(:seq :int)))
  (check (not (value-of-type-p (vector 1 t) '(:seq :int))))
  (check (not (value-of-type-p 3 '(:gf 3))))
  (check (value-of-type-p (list 1 nil) '(:tuple :int :bool))))

(deftest test-terms
  (check (eq (pt '(+ x (* y 2))) (pt '(+ x (* y 2)))) "a term is stored once")
  (check (not (eq (pt '(+ x y)) (pt '(+ y x)))))
  (check-equal 5 (term-size (pt '(+ x (* y 2)))))
  (check-equal :int (term-type (pt '(at xs (+ x 1)))))
  (check-equal '(:seq :int) (term-type (pt '(tabulate x (lambda (i) (* i i))))))
  (check-equal '(:seq :bool) (term-type (pt '(tabulate x (lambda (i) (< i y))))))
  (check-equal '(+ x (* y 2)) (term->sexp (pt '(+ x (* y 2)))))
  (dolist (sexp '((if (< x y) (- y x) 0)
                  (fold 0 (lambda (acc e) (+ acc e)) xs)
                  (tabulate (length xs) (lambda (i) (at xs (- (- (length xs) i) 1))))
                  (try (/ x y) 0)
                  (= b (< x 1))
                  (where (length xs) (lambda (j) (= (at xs j) x)))))
    (check (equal sexp (term->sexp (pt sexp))) (format nil "~s does not print as written" sexp)))
  (check-equal (list (var 'x :int) (var 'xs '(:seq :int)))
               (term-variables (pt '(tabulate x (lambda (i) (+ (at xs i) x))))))
  (check-equal (pt '(+ (* y y) 1)) (substitute-term (pt '(+ x 1)) (list (cons (var 'x :int) (pt '(* y y))))))
  ;; a numeric literal takes the type of its context
  (let ((env `((a . ,(gf 5)))))
    (check-equal (gf 5) (term-type (parse-term '(+ a 3) env)))
    (check-equal (gf 5) (term-type (second (term-args (parse-term '(+ a 3) env)))))))

(deftest test-evaluator
  (let ((env `((x . 5) (y . -2) (z . 0) (xs . ,(vector 3 4 10)) (b . t))))
    (check-equal 1 (val '(+ x (* y 2)) env))
    (check-equal -2 (val '(/ x y) env) "integer division truncates")
    (check-equal -1 (val '(mod x y) env) "mod takes the sign of the divisor")
    (check (fault-p (val '(/ x z) env)))
    (check (fault-p (val '(mod x z) env)))
    (check (fault-p (val '(at xs 3) env)))
    (check (fault-p (val '(at xs (- 0 1)) env)))
    (check (fault-p (val '(+ 1 (at xs 3)) env)) "a fault passes through a strict operator")
    (check-equal 7 (val '(if b 7 (/ x z)) env) "the branch not taken is not evaluated")
    (check-equal 9 (val '(try (/ x z) 9) env))
    (check-equal 2 (val '(try (- x 3) 9) env))
    (check-equal (vector 10 4 3) (val '(tabulate (length xs) (lambda (i) (at xs (- (- (length xs) i) 1)))) env))
    (check (fault-p (val '(tabulate (length xs) (lambda (i) (at xs (+ i 1)))) env))
           "a sequence cannot hold a fault, so the whole sequence fails")
    (check-equal (vector) (val '(tabulate z (lambda (i) i)) env))
    (check (fault-p (val '(tabulate y (lambda (i) i)) env)))
    (check-equal 17 (val '(fold 0 (lambda (acc e) (+ acc e)) xs) env))
    (check-equal (vector 3 7 17) (val '(scan 0 (lambda (acc e) (+ acc e)) xs) env))
    (check-equal (vector 1 2) (val '(where (length xs) (lambda (j) (< 3 (at xs j)))) env))
    (check-equal 3 (val '(length xs) env))
    ;; a function-valued input
    (let ((types (append '((f . (:fn (:int :int) :int))) *int-env*))
          (env (acons 'f (primitive-fnval '- :int :int) env)))
      (check-equal 7 (val '(call f x y) env types))
      (check-equal (vector 1 6) (val '(tabulate (- (length xs) 1) (lambda (i) (call f (at xs (+ i 1)) (at xs i))))
                                     env types)))))

(deftest test-fields
  (let* ((types `((a . ,(gf 3)) (c . ,(gf 3))))
         (table (loop for a below 3 collect
                  (loop for c below 3 collect (values (run-term (parse-term '(/ a c) types)
                                                                `((a . ,a) (c . ,c))))))))
    (check (every #'fault-p (mapcar #'first table)) "division by zero fails in a field")
    (check-equal '((0 0) (1 2) (2 1)) (mapcar #'rest table))
    (check-equal 1 (values (run-term (parse-term '(* 2 2) nil (gf 3)) nil)))
    (check-equal 2 (values (run-term (parse-term '(- a c) types) '((a . 0) (c . 1)))))))

(deftest test-metering
  (let ((env `((x . 5) (y . -2) (z . 0) (xs . ,(vector 3 4 10)) (b . t))))
    (check-equal 2 (nth-value 1 (run-term (pt '(+ x (* y 2))) env)) "one unit per application")
    (check-equal 1 (nth-value 1 (run-term (pt '(if b 7 (/ x z))) env)))
    (check (fuel-out-p (run-term (pt '(fold 0 (lambda (acc e) (+ acc e)) xs)) env :fuel 3)))
    (check (not (status-p (run-term (pt '(fold 0 (lambda (acc e) (+ acc e)) xs)) env :fuel 7))))
    (check-equal 7 (nth-value 1 (run-term (pt '(fold 0 (lambda (acc e) (+ acc e)) xs)) env)))
    ;; TRY does not hide a cut-off
    (check (fuel-out-p (run-term (pt '(try (fold 0 (lambda (acc e) (+ acc e)) xs) 0)) env :fuel 3)))))

(deftest test-ledger
  (let ((ledger (make-ledger)))
    (charge ledger :a 3) (charge ledger :b 2) (charge ledger :a 1)
    (check-equal 6 (ledger-total ledger))
    (check-equal 4 (ledger-count ledger :a))
    (check-equal :cut (with-work-limit (ledger 5 :cut) (charge ledger :a 4) (charge ledger :a 4) :finished))
    (check-equal 11 (ledger-total ledger) "a cut-off charges exactly up to the limit")
    (let ((debt 10))
      (check-equal 4 (pay-debt debt 4 ledger :c))
      (check-equal 6 debt)
      (check-equal 6 (pay-debt debt 100 ledger :c))
      (check-equal 0 debt))))

(deftest test-spaces
  (let* ((space (make-space 3))
         (xs (vector (vector 3 1 4) (vector) (vector 2 2)))
         (k (vector 10 20 30)))
    (multiple-value-bind (positions index) (explode space (map 'simple-vector #'length xs))
      (check-equal 5 (space-n positions))
      (check-equal (vector 0 1 2 0 1) index)
      (check-equal (vector 0 0 0 2 2) (space-pmap positions))
      (check-equal (vector 10 10 10 30 30) (reindex positions k))
      ;; unnesting a sequence and collecting its elements gives the sequence back
      (check (col= xs (collect positions (element-column (reindex positions xs) index))))
      (check (fault-p (svref (element-column (reindex positions xs) index 1) 2))))
    (let ((sub (subspace space (vector t nil t))))
      (check-equal 2 (space-n sub))
      (check-equal (vector 10 30) (reindex sub k)))))

(deftest test-dependency
  ;; plan section 5.3: with c = a + b, the column b is a function of a and c
  (let* ((rows (loop for a from -3 to 3 append (loop for b from -3 to 3 collect (list a b))))
         (n (length rows))
         (a (map 'simple-vector #'first rows)) (b (map 'simple-vector #'second rows))
         (sum (map 'simple-vector #'+ a b)) (product (map 'simple-vector #'* a b)))
    (check-equal 1 (nth-value 1 (dependency b (list a sum) n)))
    (check (< (nth-value 1 (dependency b (list sum) n)) 1) "the sum alone does not determine b")
    ;; with c = a * b, b is determined by a and c exactly on the rows where a is not zero
    (multiple-value-bind (mask share) (dependency b (list a product) n)
      (check-equal 6/7 share)
      (check (every (lambda (m av) (eq m (/= av 0))) mask a)))
    (multiple-value-bind (groups count) (group-rows (list a) n)
      (check-equal 7 count)
      (check (every (lambda (g av) (= g (+ av 3))) groups a)))))

(deftest test-enumeration
  (let* ((rows (xyz-rows 32 7))
         (whole (rows-bank rows '(x y z) '(+ * -) :constants '(0 1)))
         (ledger (make-ledger)))
    (check-equal :done (enumerate whole 6 ledger most-positive-fixnum))
    (check-equal 6 (bank-done whole))
    (check-equal (* 32 (bank-candidates whole)) (ledger-total ledger) "one unit per cell")
    (check-equal (+ 5 (bank-candidates whole))
                 (+ (bank-size whole) (bank-collisions whole) (bank-dropped whole)))
    ;; every class keeps the smallest term that denotes its column: classes appear in size order
    (check (every (lambda (a b) (<= (cls-size a) (cls-size b))) (bank-all whole) (subseq (bank-all whole) 1)))
    (check (every (lambda (c) (= (cls-size c) (term-size (cls-term c)))) (bank-all whole)))
    ;; x + y and y + x are one class (plan section 5.3)
    (let ((c (lookup whole (map 'simple-vector (lambda (r) (+ (first r) (second r))) rows))))
      (check (and c (= 3 (cls-size c)))))
    ;; resumption parity: any slicing of the budget gives the same bank and the same total work
    (dolist (slice '(1 7 100 1000 33333))
      (let ((sliced (rows-bank rows '(x y z) '(+ * -) :constants '(0 1))) (l2 (make-ledger)))
        (loop for status = (enumerate sliced 6 l2 slice)
              do (check (member status '(:done :cutoff)))
              until (eq status :done))
        (check-equal (ledger-total ledger) (ledger-total l2))
        (check (and (= (bank-size whole) (bank-size sliced))
                    (every (lambda (a b) (and (eq (cls-term a) (cls-term b)) (col= (cls-col a) (cls-col b))))
                           (bank-all whole) (bank-all sliced)))
               (format nil "slices of ~d give a different bank" slice))))
    ;; budget obedience: a call never charges more than its budget
    (let ((bank (rows-bank rows '(x y z) '(+ * -) :constants '(0 1))) (l3 (make-ledger)))
      (dotimes (k 50)
        (let ((before (ledger-total l3)))
          (enumerate bank 6 l3 77)
          (check (<= (- (ledger-total l3) before) 77)))))
    ;; a hook stops the enumeration, which can then go on
    (let ((bank (rows-bank rows '(x y z) '(+ * -) :constants '(0 1))) (l4 (make-ledger))
          (target (map 'simple-vector (lambda (r) (* (first r) (+ (second r) 1))) rows)))
      (setf (bank-on-new bank) (lambda (c) (and (col= (cls-col c) target) c)))
      (let ((found (enumerate bank 6 l4 most-positive-fixnum)))
        (check (cls-p found))
        (check-equal 5 (cls-size found)))
      (setf (bank-on-new bank) nil)
      (check-equal :done (enumerate bank 6 l4 most-positive-fixnum))
      (check-equal (ledger-total ledger) (ledger-total l4))
      (check-equal (bank-size whole) (bank-size bank)))))

(deftest test-evaluators-agree
  ;; the column a class holds equals the row-by-row value of its term, for every operator
  (let* ((rows (xyz-rows 24 3 :lo -4 :hi 4))
         (bank (rows-bank rows '(x y z) '(+ * - / mod < = if try) :constants '(0 1 2)))
         (ledger (make-ledger)) (cells 0) (bad 0) (faults 0))
    (enumerate bank 5 ledger most-positive-fixnum)
    (loop for c across (bank-all bank)
          do (loop for row in rows for r from 0
                   do (let ((cell (svref (cls-col c) r)))
                        (incf cells)
                        (when (fault-p cell) (incf faults))
                        (unless (cell= cell (run-term (cls-term c) (pairlis '(x y z) row)))
                          (incf bad)))))
    (check (> cells 10000))
    (check (> faults 100) "the comparison covers failing cells")
    (check-equal 0 bad)
    ;; TERM-COLUMN, which evaluates a given term on a space, agrees as well
    (let ((leaves (loop for name in '(x y z) for k from 0
                        collect (cons name (map 'simple-vector (lambda (r) (nth k r)) rows)))))
      (dolist (sexp '((+ (* x y) (- z 1)) (if (< x y) (/ x z) (mod y x)) (try (/ x (- y z)) 0)))
        (let ((term (pt sexp)))
          (multiple-value-bind (column work) (term-column term (bank-space bank) leaves)
            (check (plusp work))
            (check (every (lambda (cell row) (cell= cell (run-term term (pairlis '(x y z) row))))
                          column rows))))))))
