;;;; probe-primitives.lisp -- the primitives of the "full grammar" as the v2 VM runs them:
;;;; (1) the signature the kernel computes for each operator at the types the sixteen specs use;
;;;; (2) the status and value of small expressions that exercise each rule and each error condition.
(load (merge-pathnames "x3-common.lisp" (make-pathname :name nil :type nil :defaults *load-truename*)))
(in-package #:lisploop)

(defparameter *seq* (sequence-type :int))
(defparameter *seq2* (sequence-type *seq*))
(defparameter *tup* (tuple-type :int :int))
(defparameter *bin* (code-type '((0 . :int) (1 . :int)) :int))
(defparameter *prd* (code-type '((0 . :int)) :bool))

(format t "~&=== signatures: operator @ type parameter : (argument types) -> result ===~%")
(dolist (spec `((:+ :int) (:- :int) (:* :int) (:/ :int) (:mod :int) (:< :int)
                (:= :int) (:= ,*seq*) (:= ,*tup*) (:= ,*bin*) (:= ,*prd*)
                (:if :int) (:if :bool) (:if ,*seq*) (:if ,*tup*) (:if ,*bin*) (:if ,*prd*)
                (:cons :int) (:tail :int) (:length :int) (:concat :int) (:at ,*seq*)
                (:tuple ,*tup*) (:at ,(tuple-type *tup* :int))
                (:code-eval ,*bin*) (:code-eval ,*prd*)
                (:cons ,*seq*)))
  (let* ((o (apply #'op spec)) (sig (operator-type o)))
    (format t "  ~(~12A~) @ ~(~40S~) : ~(~S~) -> ~(~S~)~%" (first spec) (second spec) (second sig) (third sig))))

(defun i (v) (lit :int v))
(defun s (v) (lit *seq* v))
(defun probe (label expr &key (budget 1000000))
  (let ((run (evaluate expr nil nil :budget budget)))
    (format t "  ~44A -> ~(~A~)~@[ ~S~]~@[  [~A]~]  work ~D~%" label (evaluation-status run)
            (and (eq :value (evaluation-status run)) (list (evaluation-value run)))
            (evaluation-error run) (evaluation-work run))))

(let ((*closure-evaluation* nil)
      (sub (term `(- ,(var 0 :int) ,(var 1 :int))))
      (add (term `(+ ,(var 0 :int) ,(var 1 :int)))))
  (format t "~&=== behaviour (a value is shown in a list, so (NIL) is the value nil) ===~%")
  (probe "(+ 3 4)" (app (op :+ :int) (i 3) (i 4)))
  (probe "(- 3 4)" (app (op :- :int) (i 3) (i 4)))
  (probe "(* 100000000000 100000000000)" (app (op :* :int) (i 100000000000) (i 100000000000)))
  (probe "(/ 7 2)" (app (op :/ :int) (i 7) (i 2)))
  (probe "(/ -7 2)" (app (op :/ :int) (i -7) (i 2)))
  (probe "(/ 7 -2)" (app (op :/ :int) (i 7) (i -2)))
  (probe "(/ 7 0)" (app (op :/ :int) (i 7) (i 0)))
  (probe "(mod 7 3)" (app (op :mod :int) (i 7) (i 3)))
  (probe "(mod -7 3)" (app (op :mod :int) (i -7) (i 3)))
  (probe "(mod 7 -3)" (app (op :mod :int) (i 7) (i -3)))
  (probe "(mod 7 0)" (app (op :mod :int) (i 7) (i 0)))
  (probe "(< 1 2)" (app (op :< :int) (i 1) (i 2)))
  (probe "(< 2 2)" (app (op :< :int) (i 2) (i 2)))
  (probe "(= 2 2) at :int" (app (op := :int) (i 2) (i 2)))
  (probe "(= (1 2) (1 2)) at (:seq :int)" (app (op := *seq*) (s '(1 2)) (s '(1 2))))
  (probe "(= (1 2) (1 3))" (app (op := *seq*) (s '(1 2)) (s '(1 3))))
  (probe "(= () ()) at (:seq :int)" (app (op := *seq*) (s '()) (s '())))
  (probe "(= (tuple 1 2) (tuple 1 2))" (app (op := *tup*) (lit *tup* '(1 2)) (lit *tup* '(1 2))))
  (probe "(= '(- x0 x1) '(- x0 x1)) at code type" (app (op := *bin*) (lit *bin* sub) (lit *bin* sub)))
  (probe "(= '(- x0 x1) '(+ x0 x1)) at code type" (app (op := *bin*) (lit *bin* sub) (lit *bin* add)))
  (probe "(if t 1 (/ 1 0))   lazy" (app (op :if :int) (lit :bool t) (i 1) (app (op :/ :int) (i 1) (i 0))))
  (probe "(if nil 1 2)" (app (op :if :int) (lit :bool nil) (i 1) (i 2)))
  (probe "(if (/ 1 0 ...) ..) error in the test" (app (op :if :int) (app (op :< :int) (app (op :/ :int) (i 1) (i 0)) (i 1)) (i 1) (i 2)))
  (probe "(+ 1 (/ 1 0))      strict" (app (op :+ :int) (i 1) (app (op :/ :int) (i 1) (i 0))))
  (probe "(cons 1 ())" (app (op :cons :int) (i 1) (s '())))
  (probe "(cons 1 (2 3))" (app (op :cons :int) (i 1) (s '(2 3))))
  (probe "(tail (1 2 3))" (app (op :tail :int) (s '(1 2 3))))
  (probe "(tail (1))" (app (op :tail :int) (s '(1))))
  (probe "(tail ())" (app (op :tail :int) (s '())))
  (probe "(length ())" (app (op :length :int) (s '())))
  (probe "(length (5 6 7))" (app (op :length :int) (s '(5 6 7))))
  (probe "(concat ((1 2) () (3)))" (app (op :concat :int) (lit *seq2* '((1 2) () (3)))))
  (probe "(concat ())" (app (op :concat :int) (lit *seq2* '())))
  (probe "(concat (cons (1 2) ((0))))" (app (op :concat :int) (app (op :cons *seq*) (s '(1 2)) (lit *seq2* '((0))))))
  (probe "(at (5 6 7) 0)" (app (op :at *seq*) (s '(5 6 7)) (i 0)))
  (probe "(at (5 6 7) 2)" (app (op :at *seq*) (s '(5 6 7)) (i 2)))
  (probe "(at (5 6 7) 3)" (app (op :at *seq*) (s '(5 6 7)) (i 3)))
  (probe "(at (5 6 7) -1)" (app (op :at *seq*) (s '(5 6 7)) (i -1)))
  (probe "(at () 0)" (app (op :at *seq*) (s '()) (i 0)))
  (probe "(tuple 1 2)" (app (op :tuple *tup*) (i 1) (i 2)))
  (probe "(at (tuple 4 9) 1)" (app (op :at (tuple-type *tup* :int)) (app (op :tuple *tup*) (i 4) (i 9)) (i 1)))
  (probe "(at (tuple 4 9) 2)" (app (op :at (tuple-type *tup* :int)) (app (op :tuple *tup*) (i 4) (i 9)) (i 2)))
  (probe "(code-eval '(- x0 x1) 5 3)" (app (op :code-eval *bin*) (lit *bin* sub) (i 5) (i 3)))
  (probe "(code-eval '(< 0 x0) -2)" (app (op :code-eval *prd*) (lit *prd* (term `(< 0 ,(var 0 :int)))) (i -2)))
  (probe "(code-eval '(/ x0 x1) 1 0)  error inside" (app (op :code-eval *bin*) (lit *bin* (term `(/ ,(var 0 :int) ,(var 1 :int)))) (i 1) (i 0)))
  (probe "(+ 3 4) with an evaluation budget of 2 units" (app (op :+ :int) (i 3) (i 4)) :budget 2))
