;;;; heldout-dump.lisp -- loaded AFTER vr/run/tg-probe-r1.lisp and vr/run/r1-spec.lisp (unmodified copies of
;;;; plan_v2c_audit/verify-review/).  Writes x3-heldout.lisp: for each of the sixteen specs, the generator
;;;; as data, the oracle's source text, and the 200 held-out rows that the prototype's VERIFY uses
;;;; (GEN-EXAMPLES task 999 200 12), with the oracle's output.
;;;; Function and predicate arguments are written as the kernel's code terms, (code (params) body),
;;;; exactly as in x3-specs.lisp; the mapping from the prototype's names is the one in
;;;; verify-review/xref-kernel.lisp:14-17.
(in-package :tg)

(defparameter *x3-out* (second (member "--out" sb-ext:*posix-argv* :test #'string=)))
(defparameter *x3-src* (second (member "--src" sb-ext:*posix-argv* :test #'string=)))

(defparameter *x3-order*
  '("copy" "inc-all" "dbl-all" "sum-all" "len-all" "prd-all" "foldl" "filter" "map-adjacent"
    "positions" "scan" "shift-seq" "seq-corr" "best-shift" "argmax-corr" "last-or"))

(defparameter *x3-code*
  '((+ . (code (x0 x1) (+ x0 x1))) (- . (code (x0 x1) (- x0 x1))) (* . (code (x0 x1) (* x0 x1)))
    (pos . (code (x0) (< 0 x0))) (even . (code (x0) (= (* (/ x0 2) 2) x0))) (neg . (code (x0) (< x0 0)))))

(defparameter *x3-refs*
  '(("copy" r-copy) ("inc-all" r-inc-all) ("dbl-all" r-dbl-all) ("sum-all" r-sum-all) ("len-all" r-len-all)
    ("prd-all" r-prd-all) ("positions" r-positions) ("scan" r-scan) ("shift-seq" r-shift-seq)
    ("filter" r-filter pred-fn) ("map-adjacent" r-map-adjacent) ("foldl" r-foldl) ("last-or" r-last-or)
    ("seq-corr" r-seq-corr) ("best-shift" r-best-shift r-seq-corr)
    ("argmax-corr" r-argmax-corr r-best-shift r-seq-corr)))

(defun x3-defun-sources ()
  "name -> source text of each (defun name ...) form in r1-spec.lisp, as it stands in that file."
  (let ((tab (make-hash-table :test 'eq))
        (text (with-open-file (in *x3-src*)
                (let ((s (make-string (file-length in))))
                  (subseq s 0 (read-sequence s in))))))
    (with-input-from-string (in text)
      (let ((*package* (find-package :tg)))
        (loop
          (let ((start (progn (peek-char t in nil nil) (file-position in)))
                (form (read in nil :eof)))
            (when (eq form :eof) (return))
            (when (and (consp form) (eq (first form) 'defun))
              ;; START may sit on comment lines that precede the form; begin at the form itself.
              (setf (gethash (second form) tab)
                    (string-trim '(#\Newline #\Space)
                                 (subseq text (search "(defun" text :start2 start) (file-position in)))))))))
    tab))

(defun x3-val (v)
  (let ((hit (and (symbolp v) v (assoc v *x3-code*)))) (if hit (cdr hit) v)))

(defun x3-emit (out v)
  "Print V with () for the empty list, so an empty sequence does not read like a Boolean."
  (cond ((null v) (write-string "()" out))
        ((consp v) (write-char #\( out)
         (loop for (x . more) on v do (x3-emit out x) (when more (write-char #\Space out)))
         (write-char #\) out))
        (t (prin1 v out))))

(defun x3-generator (task)
  (loop for (name kind lo hi) in (task-ins task) for i from 0
        collect (ecase kind
                  (:seq (list (intern (format nil "X~d" i) :tg) :seq :length '(0 12) :element '(-5 9)
                              :draw "length = 0 + random(13); then that many elements, each -5 + random(15), in order"))
                  (:int (list (intern (format nil "X~d" i) :tg) :int :range (list lo hi)
                              :draw (format nil "~d + random(~d)" lo (1+ (- hi lo)))))
                  (:code (list (intern (format nil "X~d" i) :tg) :code :choices
                               (list (cdr (assoc '+ *x3-code*)) (cdr (assoc '- *x3-code*)) (cdr (assoc '* *x3-code*)))
                               :draw "choices[random(3)]"))
                  (:pred (list (intern (format nil "X~d" i) :tg) :pred :choices
                               (list (cdr (assoc 'pos *x3-code*)) (cdr (assoc 'even *x3-code*))
                                     (cdr (assoc 'neg *x3-code*)))
                               :draw "choices[random(3)]")))))

(let ((*package* (find-package :tg)) (*print-pretty* nil) (*print-case* :downcase)
      (*print-right-margin* 1000000) (srcs (x3-defun-sources)))
  (with-open-file (out *x3-out* :direction :output :if-exists :supersede)
    (format out ";;;; x3-heldout.lisp -- held-out inputs and expected outputs for gate X3 (plan_v2c.md 11.2).~%")
    (format out ";;;; Generated by base-x3/heldout-dump.lisp from unmodified copies of~%")
    (format out ";;;; plan_v2c_audit/verify-review/{tg-probe-r1.lisp,r1-spec.lisp}: (gen-examples task 999 200 12).~%")
    (format out ";;;; One form per spec, in bootstrap order.  Plain data: integers, lists, keywords, plain symbols, strings.~%")
    (format out ";;;; A row is ((arg ...) expected), arguments in the kernel's parameter order x0 x1 ...~%")
    (format out ";;;; A sequence is a list of integers; () is the empty sequence.  best-shift returns a 2-tuple (c k), written as a list.~%")
    (format out ";;;; A function or predicate argument is (code (params) body): the kernel's quoted code term.~%")
    (format out ";;;; :generator gives, per parameter in order, how it is drawn.  One random state per spec, made by~%")
    (format out ";;;; (sb-ext:seed-random-state 999); the 200 examples are drawn one after another, parameters in order.~%")
    (format out ";;;; random(n) is SBCL's (random n state), uniform on 0..n-1.  The stream is SBCL's own (SBCL 2.6.4 here),~%")
    (format out ";;;; so the literal :rows below, not a re-implementation of the generator, are the reference.~%")
    (format out ";;;; :oracle-source is the text of the reference in verify-review/r1-spec.lisp; there a function argument~%")
    (format out ";;;; is a name (+ - *) applied with funcall, and a predicate is a name (pos even neg) mapped by pred-fn.~%")
    (dolist (name *x3-order*)
      (let* ((task (spec-task name))
             (exs (gen-examples task 999 200 12)))
        (format out "~%(:name ~a~% :seed 999 :count 200 :maxlen 12~% :returns ~s~% :generator ~s~% :oracle-source (~{~s~^~%                 ~})~% :rows ("
                name (ecase (task-out task) (:seq '(:seq :int)) (:int :int) (:tuple '(:tuple :int :int)))
                (x3-generator task)
                (mapcar (lambda (f) (gethash f srcs)) (rest (assoc name *x3-refs* :test #'string=))))
        (dolist (ex exs)
          (format out "~%  ")
          (x3-emit out (list (mapcar (lambda (c) (x3-val (cdr c))) (car ex)) (cdr ex))))
        (format out "))~%"))))
  (format t "wrote ~a~%" *x3-out*))
