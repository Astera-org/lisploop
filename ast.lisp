(in-package #:lisploop)

;;; Homoiconic S-expressions `(op arg1 arg2 ...)`, bidirectional typing, and O(1) metadata.

(defstruct (schema (:constructor %make-schema))
  (domain :int) inputs target (lookup-p nil) (availability nil))

(defstruct ast-meta
  kind id type value
  (non-var-bits 0 :type fixnum) (var-count 0 :type fixnum) (syntax-work 0 :type fixnum)
  (total-p nil :type boolean) free-vars)

(defvar *node-meta* (make-hash-table :test #'eq :weakness :key)
  "O(1) pointer-keyed metadata table for constructed S-expression nodes and symbols.")
(defvar *typed-symbol-pool* (make-hash-table :test #'equal)
  "Canonical pool of typed variable, operator, and hole symbols so EQUAL and EQ agree.")

(defun integer-width (value) (max 1 (integer-length (abs value))))

(defun gf (p)
  "Construct a prime-field type; composite moduli are rejected."
  (assert (and (integerp p) (>= p 2) (loop for d from 2 to (isqrt p) never (zerop (mod p d)))))
  (list :gf p))

(defun tuple-type (&rest types) (cons :tuple types))
(defun sequence-type (type) (list :seq type))
(defun function-sort-p (sort) (and (consp sort) (eq :fn (first sort))))
(defun input-alist (inputs)
  "Normalize INPUTS (a schema or alist) into its `(id . type)` association list."
  (if (schema-p inputs) (schema-inputs inputs) inputs))

(defun lex< (a b &rest keys)
  (dolist (key keys nil)
    (let* ((desc (and (consp key) (eq :desc (first key))))
           (fn (if desc (second key) key))
           (x (funcall fn a)) (y (funcall fn b)))
      (unless (= x y) (return (if desc (> x y) (< x y)))))))

(defun best-by (items &rest keys)
  (let ((best (first items)))
    (dolist (item (rest items) best) (when (apply #'lex< item best keys) (setf best item)))))

(defun valid-inputs-p (inputs)
  (and (listp inputs) (= (length inputs) (length (remove-duplicates inputs :key #'car :test #'equal)))
       (every (lambda (in) (and (consp in)
                                (or (and (integerp (car in)) (<= 0 (car in)))
                                    (and (symbolp (car in)) (not (null (car in)))))
                                (valid-type-p (cdr in))))
              inputs)))

(defun valid-sort-p (sort)
  (if (function-sort-p sort)
      (and (= 3 (length sort)) (listp (second sort)) (every #'valid-type-p (second sort)) (valid-type-p (third sort)))
      (valid-type-p sort)))

(defun code-type (inputs sort)
  "Quoted typed syntax in an explicit free-variable scope; never an executable closure."
  (let ((nin (input-alist inputs)))
    (assert (and (valid-inputs-p nin) (valid-sort-p sort)))
    (list :code (copy-tree nin) (copy-tree sort))))

(defun code-type-p (type) (and (consp type) (eq :code (first type))))
(defun seq-type-p (type) (and (consp type) (eq :seq (first type))))
(defun gf-type-p (type) (and (consp type) (eq :gf (first type))))
(defun tuple-type-p (type) (and (consp type) (eq :tuple (first type))))
(defun code-inputs (type) (second type))
(defun code-sort (type) (third type))

(defparameter +primitives+
  '((:+ ?n (?n ?n) ?n) (:* ?n (?n ?n) ?n) (:= ?t (?t ?t) :bool) (:tuple ?t _ ?t)
    (:member ?t (?t (:seq ?t)) :bool) (:lookup (:tuple ?k ?v) (?k (:seq (:tuple ?k ?v))) ?v)
    (:gather ?t ((:seq ?t) (:seq :int)) (:seq ?t)) (:- ?n (?n ?n) ?n) (:/ ?n (?n ?n) ?n)
    (:if ?t (:bool ?t ?t) ?t) (:concat ?t ((:seq (:seq ?t))) (:seq ?t))
    (:code-kind ?c (?c) :int) (:code-child ?t (_ :int) _) (:code-operator ?t (_) _)
    (:code-apply ?t (?t _) _) (:code-match ?t (_ _) :bool) (:code-bind ?t (_ _ :int) _)
    (:code-subst ?t (_ _) _) (:code-total ?e (?e) :bool) (:code-less ?e (?e ?e) :bool)
    (:at ?t (?t :int) _) (:cons ?t (?t (:seq ?t)) (:seq ?t)) (:tail ?t ((:seq ?t)) (:seq ?t))
    (:length ?t ((:seq ?t)) :int) (:< :int (:int :int) :bool) (:code-eval ?t (?t . _) _))
  "Primitive operators in opcode order: (name parameter argument-types result-type).")

(defparameter +operator-names+ (mapcar #'first +primitives+))

(defun primitive-pattern (name) (rest (assoc name +primitives+)))

(defun pattern-variables (pattern)
  (cond ((consp pattern) (union (pattern-variables (car pattern)) (pattern-variables (cdr pattern))))
        ((or (null pattern) (keywordp pattern)) nil)
        (t (list pattern))))

(defun signature-pattern (name)
  (let ((pat (primitive-pattern name))) (unless (member '_ (pattern-variables pat)) pat)))

(defun match-type-pattern (pattern type &optional bindings)
  (cond ((eq pattern '_) bindings)
        ((consp pattern) (assert (consp type))
         (match-type-pattern (cdr pattern) (cdr type) (match-type-pattern (car pattern) (car type) bindings)))
        ((or (null pattern) (keywordp pattern)) (assert (eq pattern type)) bindings)
        ((assoc pattern bindings) (assert (equal type (cdr (assoc pattern bindings)))) bindings)
        (t (assert (case pattern (?n (or (eq type :int) (gf-type-p type)))
                         (?c (code-type-p type)) (?e (expression-code-p type)) (otherwise t)))
           (acons pattern type bindings))))

(defun encoded-variable (name)
  (let* ((pat (primitive-pattern name))
         (free (set-difference (pattern-variables (first pat)) (pattern-variables (third pat)))))
    (assert (null (rest free))) (first free)))

(defun operator-encoded-type (name type)
  (let ((v (encoded-variable name)))
    (and v (cdr (assoc v (match-type-pattern (first (primitive-pattern name)) type))))))

(defun operator-decoded-type (name result read-type)
  (let ((pat (primitive-pattern name)) (v (encoded-variable name)))
    (if pat (sublis (match-type-pattern (third pat) result (and v (list (cons v (funcall read-type))))) (first pat))
        result)))

(defstruct (function-definition (:constructor %make-function-definition))
  name inputs return-type body oracle-table total-p conditional-code-params)

(defun function-definition-code-type (def)
  (code-type (function-definition-inputs def) (function-definition-return-type def)))

(defun code-parameters (def)
  (remove-if-not #'code-type-p (function-definition-inputs def) :key #'cdr))

(defvar *function-definitions* (make-hash-table :test #'eq))
(defvar *registered-function-names* nil)
(defvar *function-library-version* 0)
(defvar *de-novo-function-counter* 0)

(defun canonical-op-name (name) (if (keywordp name) name (intern (symbol-name name) :keyword)))

(defun keyword-id (control &rest arguments) (intern (apply #'format nil control arguments) :keyword))

(defun de-novo-function-name (&optional (index *de-novo-function-counter*))
  "Short alphabetic de novo function symbol (:FA, :FB, ..., :FZ, :FAA, ...)."
  (assert (and (integerp index) (not (minusp index))))
  (let (chars (n index))
    (loop (multiple-value-bind (q r) (floor n 26)
            (push (code-char (+ (char-code #\A) r)) chars)
            (if (zerop q) (return) (setf n (1- q)))))
    (intern (concatenate 'string "F" chars) :keyword)))

(defun next-function-name ()
  "Allocate the next unused de novo function keyword symbol."
  (loop (let ((c (de-novo-function-name *de-novo-function-counter*)))
          (incf *de-novo-function-counter*)
          (unless (or (member c +operator-names+) (member c *registered-function-names*)) (return c)))))

(defun find-function-definition (name) (gethash (canonical-op-name name) *function-definitions*))
(defun defined-function-p (name) (not (null (find-function-definition name))))
(defun all-operator-names () (append +operator-names+ *registered-function-names*))
(defun operator-index (name) (position (canonical-op-name name) (all-operator-names)))
(defun operator-by-index (index) (nth index (all-operator-names)))

(defun homogeneous-tuple-type-p (type)
  (and (tuple-type-p type) (rest type) (every #'valid-type-p (rest type))
       (every (lambda (p) (equal p (second type))) (cddr type))))

(defun normalize-at-container-type (type)
  (assert (valid-type-p type))
  (if (or (seq-type-p type) (homogeneous-tuple-type-p type)) type (sequence-type type)))

(defun at-container-element-type (type) (second (normalize-at-container-type type)))

(defun valid-type-p (type)
  (or (member type '(:int :bool))
      (and (consp type)
           (case (first type)
             (:gf (and (= (length type) 2) (integerp (second type)) (>= (second type) 2) (equal type (gf (second type)))))
             (:tuple (every #'valid-type-p (rest type)))
             (:seq (and (= (length type) 2) (valid-type-p (second type))))
             (:code (and (= 3 (length type)) (valid-inputs-p (code-inputs type)) (valid-sort-p (code-sort type))))))))

(defun infer-domain-from-types (types)
  (dolist (tp types :int)
    (when (gf-type-p tp) (return tp))
    (when (and (consp tp) (member (first tp) '(:tuple :seq)))
      (let ((sub (infer-domain-from-types (rest tp)))) (unless (eq sub :int) (return sub))))))

(defun type-work (type)
  "Structural tariff weight of TYPE."
  (if (atom type) 1
      (1+ (ecase (first type)
            (:gf (integer-width (second type)))
            (:tuple (reduce #'+ (rest type) :key #'type-work :initial-value 0))
            (:seq (type-work (second type)))
            (:code (+ (loop for i in (code-inputs type)
                            sum (+ (integer-width (if (integerp (car i)) (car i) 0)) (type-work (cdr i))))
                      (type-work (code-sort type))))
            (:fn (+ (reduce #'+ (second type) :key #'type-work :initial-value 0) (type-work (third type))))))))

(defun value-work (value type)
  "Structural tariff weight of runtime VALUE at TYPE."
  (if (eq value :unresolved) 1
      (1+ (case type (:int (1+ (integer-width value))) (:bool 1)
                (otherwise (ecase (first type)
                             (:gf (integer-width (1- (second type))))
                             (:tuple (loop for x in value for p in (rest type) sum (value-work x p)))
                             (:seq (loop for x in value sum (value-work x (second type))))
                             (:code (syntax-work value))))))))

(defun signed-code (value) (if (minusp value) (* -2 value) (1+ (* 2 value))))
(defun decode-signed-code (value) (if (oddp value) (/ (1- value) 2) (- (/ value 2))))

(defun positive-bit-size (value)
  (assert (plusp value))
  (let* ((w (integer-length value)) (lw (integer-length w)))
    (+ (1- lw) lw (1- w))))

(defun value-bit-size (value type)
  "The bits `emit-bit-value` writes, computed directly for fast candidate scoring."
  (case type
    (:int (positive-bit-size (signed-code value))) (:bool 1)
    (otherwise (ecase (first type)
                 (:gf (integer-length (1- (second type))))
                 (:tuple (loop for x in value for p in (rest type) sum (value-bit-size x p)))
                 (:seq (+ (positive-bit-size (1+ (length value))) (loop for x in value sum (value-bit-size x (second type)))))
                 (:code (if (function-sort-p (code-sort type))
                            (let ((m (ensure-ast-meta value)))
                              (+ (operator-name-bit-size (ast-meta-id m)) (type-bit-size (ast-meta-type m))))
                            (body-size value (code-inputs type))))))))

(defun expression-code-p (type) (and (code-type-p type) (not (function-sort-p (code-sort type)))))
(defun same-code-scope-p (l r) (and (code-type-p l) (code-type-p r) (equal (code-inputs l) (code-inputs r))))
(defun code-subst-code-binding-p (bt out-ct in-t) (and (same-code-scope-p bt out-ct) (equal (code-sort bt) in-t)))

(defun compute-operator-signature (name type)
  (assert (valid-type-p type))
  (flet ((sig (in out) (list :fn in out)))
    (case name
      (:tuple (assert (tuple-type-p type)) (sig (rest type) type))
      (:at (sig (list type :int) (at-container-element-type type)))
      (:code-eval (assert (expression-code-p type)) (sig (cons type (mapcar #'cdr (code-inputs type))) (code-sort type)))
      ((:code-operator :code-apply)
       (assert (and (code-type-p type) (function-sort-p (code-sort type))))
       (let* ((s (code-sort type)) (sc (code-inputs type)) (res (code-type sc (third s))))
         (if (eq name :code-operator) (sig (list res) type)
             (sig (list type (apply #'tuple-type (mapcar (lambda (a) (code-type sc a)) (second s)))) res))))
      ((:code-child :code-match :code-bind :code-subst)
       (assert (and (tuple-type-p type) (member (length type) '(3 4))))
       (let ((a (second type)) (b (third type)) (c (fourth type)))
         (assert (expression-code-p a))
         (ecase name
           (:code-child (assert (and (null c) (expression-code-p b) (same-code-scope-p a b))) (sig (list a :int) b))
           (:code-match (assert (and (null c) (expression-code-p b) (equal (code-sort a) (code-sort b)))) (sig (list a b) :bool))
           (:code-bind (assert (and (expression-code-p b) (expression-code-p c) (same-code-scope-p b c)
                                    (equal (code-sort a) (code-sort b)))) (sig (list a b :int) c))
           (:code-subst (assert (and (tuple-type-p b) (expression-code-p c) (equal (code-sort a) (code-sort c))
                                     (= (length (rest b)) (length (code-inputs a)))
                                     (every (lambda (bd in) (or (code-subst-code-binding-p bd c (cdr in)) (equal bd (cdr in))))
                                            (rest b) (code-inputs a))))
                        (sig (list a b) c)))))
      (otherwise (let ((pat (signature-pattern name)))
                   (cond (pat (let ((b (match-type-pattern (first pat) type)))
                                (sig (sublis b (second pat)) (sublis b (third pat)))))
                         ((and (expression-code-p type) (member name *registered-function-names*))
                          (sig (mapcar #'cdr (code-inputs type)) (code-sort type)))
                         (t (error "Unknown primitive ~S" name))))))))

(defun normalize-operator-type (kname type)
  (cond ((eq kname :at) (normalize-at-container-type type))
        ((defined-function-p kname)
         (let* ((def (find-function-definition kname)) (ct (function-definition-code-type def)))
           (assert (or (null type) (equal type ct) (equal type (function-definition-return-type def)))
                   () "Incompatible type ~S for function ~S" type kname)
           ct))
        (t type)))

(defun pool-symbol (key name meta)
  (let ((sym (make-symbol name)))
    (setf (gethash sym *node-meta*) meta (gethash key *typed-symbol-pool*) sym) sym))

(defun op (name &optional type)
  "Construct a monomorphic operator symbol (e.g. +, *, =, or defined :fa)."
  (let* ((kn (canonical-op-name name)) (nt (normalize-operator-type kn type))
         (key (list :op kn nt)) (ex (gethash key *typed-symbol-pool*)))
    (if (and ex (primitive-pattern kn)) ex
        (let ((sig (compute-operator-signature kn nt)) (oh (+ 2 (operator-bit-size kn nt))))
          (if ex (let ((m (gethash ex *node-meta*)))
                   (when m (setf (ast-meta-non-var-bits m) oh (ast-meta-value m) sig)) ex)
              (pool-symbol key (symbol-name kn)
                           (make-ast-meta :kind :op :id kn :type (copy-tree nt) :value sig
                                          :non-var-bits oh :var-count 0
                                          :syntax-work (1+ (if (or (defined-function-p kn) (member kn *registered-function-names*))
                                                               1 (type-work nt)))
                                          :total-p t :free-vars nil)))))))

(defun operator-p (term) (let ((m (and (symbolp term) (gethash term *node-meta*)))) (and m (eq :op (ast-meta-kind m)))))
(defun operator-meta (op) (let ((m (gethash op *node-meta*))) (assert (and m (eq :op (ast-meta-kind m)))) m))
(defun operator-name (op) (ast-meta-id (operator-meta op)))
(defun operator-operand-type (op) (ast-meta-type (operator-meta op)))
(defun operator-type (op) (ast-meta-value (operator-meta op)))
(defun application-overhead (op) (ast-meta-non-var-bits (operator-meta op)))

(defun pooled-leaf (kind prefix id type)
  (assert (and (integerp id) (not (minusp id))))
  (let ((key (list kind id type)) (var-p (eq kind :var)))
    (or (gethash key *typed-symbol-pool*)
        (pool-symbol key (format nil "~A~D" prefix id)
                     (make-ast-meta :kind kind :id id :type (copy-tree type) :non-var-bits 2
                                    :var-count (if var-p 1 0) :syntax-work (+ 1 (integer-width id) (type-work type))
                                    :total-p t :free-vars (and var-p (list id)))))))

(defun var (id type) "Construct a typed variable symbol." (assert (valid-type-p type)) (pooled-leaf :var "X" id type))
(defun hole (id type) "Construct a typed pattern hole symbol." (assert (valid-sort-p type)) (pooled-leaf :hole "?" id type))
(defun hole-p (term) (let ((m (and (symbolp term) (gethash term *node-meta*)))) (and m (eq :hole (ast-meta-kind m)))))

(defun value-p (value type)
  "Check whether VALUE belongs to domain/type TYPE."
  (case type
    (:int (integerp value))
    (:bool (or (eq value t) (null value)))
    (otherwise
     (and (consp type)
          (case (first type)
            (:gf (and (integerp value) (<= 0 value) (< value (second type))))
            (:tuple (and (listp value) (= (length value) (length (rest type))) (every #'value-p value (rest type))))
            (:seq (and (listp value) (every (lambda (v) (value-p v (second type))) value)))
            (:code (handler-case (equal (code-sort type)
                                        (if (function-sort-p (code-sort type))
                                            (operator-type value) (expression-type value (code-inputs type))))
                     (error () nil))))))))

(defun quote-symbol (type)
  (let ((k (list :quote type)))
    (or (gethash k *typed-symbol-pool*) (pool-symbol k "QUOTE" (make-ast-meta :kind :quote :type (copy-tree type))))))

(defun compute-lit-meta (type value)
  (make-ast-meta :kind :lit :type (copy-tree type) :value value :non-var-bits (+ 2 (value-bit-size value type))
                 :var-count 0 :syntax-work (+ 1 (type-work type) (value-work value type)) :total-p t :free-vars nil))

(defun lit (type value)
  "Construct a literal S-expression `(QUOTE value)` carrying O(1) ast-meta."
  (assert (and (valid-type-p type) (value-p value type)))
  (let* ((v (copy-tree value)) (n (list (quote-symbol type) v)))
    (setf (gethash n *node-meta*) (compute-lit-meta type v)) n))

(defun provably-total-code-arg-p (expr &optional allow-open-code-p)
  (let ((m (ensure-ast-meta expr)))
    (or (and allow-open-code-p (member (ast-meta-kind m) '(:var :hole)))
        (and (eq :lit (ast-meta-kind m)) (provably-total-p (ast-meta-value m)))
        (and (eq :app (ast-meta-kind m)) (eq :code-subst (ast-meta-id m))
             (or allow-open-code-p (ast-meta-total-p m))
             (let ((t-arg (second expr)) (tup-arg (third expr)))
               (and (lit-p t-arg) (provably-total-p (ast-value t-arg)) (app-of-p tup-arg :tuple)
                    (every (lambda (b) (if (code-type-p (ast-type b))
                                           (provably-total-code-arg-p b allow-open-code-p)
                                           (or allow-open-code-p (provably-total-p b))))
                           (rest tup-arg))))))))

(defun non-empty-seq-expr-p (expr &optional non-empty-vars)
  (let ((m (ensure-ast-meta expr)))
    (case (ast-meta-kind m)
      (:lit (not (null (ast-meta-value m))))
      (:var (and non-empty-vars (member (ast-meta-id m) non-empty-vars :test #'eql)))
      (:app (or (eq :cons (ast-meta-id m))
                (and (eq :if (ast-meta-id m))
                     (multiple-value-bind (tv ev) (branch-non-empty-vars (second expr) non-empty-vars)
                       (and (non-empty-seq-expr-p (third expr) tv)
                            (non-empty-seq-expr-p (fourth expr) ev)))))))))

(defun operator-step-total-p (op-name args code-total-fn &optional non-empty-vars)
  (case op-name
    (:/ (and (lit-p (second args)) (not (zerop (ast-value (second args))))))
    (:at (and (lit-p (second args))
              (let ((i (ast-value (second args))) (c (first args)) (ct (ast-type (first args))))
                (and (integerp i) (<= 0 i)
                     (cond ((tuple-type-p ct) (< i (length (rest ct))))
                           ((lit-p c) (< i (length (ast-value c))))
                           ((zerop i) (non-empty-seq-expr-p c non-empty-vars)) (t nil))))))
    (:tail (non-empty-seq-expr-p (first args) non-empty-vars))
    (:code-eval (funcall code-total-fn (first args)))
    ((:lookup :gather :code-child :code-operator :code-bind) nil)
    (otherwise (let ((def (find-function-definition op-name)))
                 (or (null def) (function-definition-total-p def)
                     (and (function-definition-conditional-code-params def)
                          (every (lambda (pidx) (and (< pidx (length args)) (funcall code-total-fn (nth pidx args))))
                                 (function-definition-conditional-code-params def))))))))

(defun empty-sequence-guard-var-id (cond-expr &optional seq-param-ids)
  (let ((m (ensure-ast-meta cond-expr)))
    (when (and (eq :app (ast-meta-kind m)) (eq := (ast-meta-id m)))
      (flet ((g (v e) (let ((vm (ensure-ast-meta v)) (em (ensure-ast-meta e)))
                        (and (eq :var (ast-meta-kind vm)) (seq-type-p (ast-meta-type vm))
                             (or (null seq-param-ids) (member (ast-meta-id vm) seq-param-ids))
                             (eq :lit (ast-meta-kind em)) (null (ast-meta-value em)) (ast-meta-id vm)))))
        (or (g (second cond-expr) (third cond-expr)) (g (third cond-expr) (second cond-expr)))))))

(defun branch-non-empty-vars (cond-expr non-empty-vars &optional seq-param-ids)
  (let ((id (empty-sequence-guard-var-id cond-expr seq-param-ids)))
    (if id (values (remove id non-empty-vars) (adjoin id non-empty-vars))
        (values non-empty-vars non-empty-vars))))

(defun expr-total-under-non-empty-p (expr non-empty-vars)
  (let ((m (ensure-ast-meta expr)))
    (or (ast-meta-total-p m)
        (case (ast-meta-kind m)
          ((:lit :var) t)
          (:app (let ((on (ast-meta-id m)) (args (rest expr)))
                  (and on (if (eq :if on)
                              (multiple-value-bind (tv ev) (branch-non-empty-vars (first args) non-empty-vars)
                                (and (expr-total-under-non-empty-p (first args) non-empty-vars)
                                     (expr-total-under-non-empty-p (second args) tv)
                                     (expr-total-under-non-empty-p (third args) ev)))
                              (and (every (lambda (a) (expr-total-under-non-empty-p a non-empty-vars)) args)
                                   (operator-step-total-p on args #'provably-total-code-arg-p non-empty-vars))))))))))

(defun compute-app-meta (operator arguments)
  (let* ((om (ensure-ast-meta operator))
         (sig (if (eq :hole (ast-meta-kind om)) (ast-meta-type om) (ast-meta-value om)))
         (cms (mapcar #'ensure-ast-meta arguments))
         (on (when (eq :op (ast-meta-kind om)) (ast-meta-id om)))
         (total-p (and (eq :op (ast-meta-kind om))
                       (if (eq :if on)
                           (and (ast-meta-total-p (first cms))
                                (if (eq :lit (ast-meta-kind (first cms)))
                                    (ast-meta-total-p (if (ast-meta-value (first cms)) (second cms) (third cms)))
                                    (and (ast-meta-total-p (second cms))
                                         (or (ast-meta-total-p (third cms))
                                             (let ((ev (nth-value 1 (branch-non-empty-vars (first arguments) nil))))
                                               (and ev (expr-total-under-non-empty-p (third arguments) ev)))))))
                           (and (every #'ast-meta-total-p cms)
                                (operator-step-total-p on arguments #'provably-total-code-arg-p))))))
    (make-ast-meta :kind :app :id on :type (third sig)
                   :non-var-bits (+ (if (eq :op (ast-meta-kind om)) (ast-meta-non-var-bits om) 2)
                                    (reduce #'+ cms :key #'ast-meta-non-var-bits :initial-value 0))
                   :var-count (reduce #'+ cms :key #'ast-meta-var-count :initial-value 0)
                   :syntax-work (+ 1 (ast-meta-syntax-work om) (reduce #'+ cms :key #'ast-meta-syntax-work :initial-value 0))
                   :total-p (not (null total-p))
                   :free-vars (remove-duplicates (loop for m in cms append (copy-list (ast-meta-free-vars m)))))))

(defun analyze-function-body-totality (name inputs body)
  (when (null body) (return-from analyze-function-body-totality (values nil nil)))
  (let ((seq-ids (loop for (id . tp) in inputs when (seq-type-p tp) collect id))
        dec-id calls cparams)
    (labels ((csafe-p (arg)
               (or (provably-total-code-arg-p arg)
                   (and (var-p arg) (let ((pos (position (ast-id arg) inputs :key #'car :test #'eql)))
                                      (when pos (pushnew pos cparams) t)))
                   (and (app-of-p arg :code-subst) (lit-p (second arg)) (provably-total-p (ast-value (second arg)))
                        (app-of-p (third arg) :tuple)
                        (every (lambda (b) (if (code-type-p (ast-type b)) (csafe-p b) t)) (rest (third arg))))))
             (walk (expr ne-vars)
               (case (ast-kind expr)
                 ((:lit :var) t)
                 (:app (let* ((on (and (operator-p (first expr)) (operator-name (first expr)))) (args (rest expr)))
                         (cond ((null on) nil)
                               ((eq on :if)
                                (destructuring-bind (c y n) args
                                  (multiple-value-bind (tv ev) (branch-non-empty-vars c ne-vars seq-ids)
                                    (and (walk c ne-vars) (walk y tv) (walk n ev)))))
                               ((eq on name)
                                (and (every (lambda (a) (walk a ne-vars)) args)
                                     (let ((mid (loop for (id . nil) in inputs for a in args
                                                      when (and (member id ne-vars :test #'eql) (app-p a)
                                                                (eq :tail (operator-name (first a)))
                                                                (var-p (second a)) (eql id (ast-id (second a))))
                                                        return id)))
                                       (and mid (or (null dec-id) (eql dec-id mid))
                                            (progn (setf dec-id mid) (push args calls) t)))))
                               (t (and (every (lambda (a) (walk a ne-vars)) args)
                                       (operator-step-total-p on args #'csafe-p ne-vars)))))))))
      (when (walk body nil)
        (loop (let ((prev (length cparams)))
                (dolist (pos (copy-list cparams))
                  (dolist (cargs calls)
                    (unless (and (< pos (length cargs)) (csafe-p (nth pos cargs)))
                      (return-from analyze-function-body-totality (values nil nil)))))
                (when (= (length cparams) prev) (return))))
        (let ((sorted (sort (copy-list cparams) #'<)))
          (return-from analyze-function-body-totality (values (null sorted) sorted))))
      (values nil nil))))

(defun invalidate-app-meta ()
  (maphash (lambda (n m) (when (and (consp n) (eq :app (ast-meta-kind m))) (remhash n *node-meta*))) *node-meta*))

(defun app (operator &rest arguments)
  "Construct a homoiconic application `(op arg1 arg2 ...)` with O(1) cached metadata."
  (let ((om (and (symbolp operator) (gethash operator *node-meta*))))
    (assert (and om (member (ast-meta-kind om) '(:op :hole))))
    (let ((node (cons operator (copy-list arguments))))
      (setf (gethash node *node-meta*) (compute-app-meta operator arguments))
      node)))

(defun ensure-ast-meta (expression)
  (or (gethash expression *node-meta*)
      (when (and (consp expression) (symbolp (first expression)))
        (let ((hm (gethash (first expression) *node-meta*)))
          (when hm (setf (gethash expression *node-meta*)
                         (ecase (ast-meta-kind hm)
                           (:quote (compute-lit-meta (ast-meta-type hm) (second expression)))
                           ((:op :hole) (compute-app-meta (first expression) (rest expression))))))))
      (error "Not a valid AST node: ~S" expression)))

(defun ast-kind (expr) (let ((m (ignore-errors (ensure-ast-meta expr)))) (and m (ast-meta-kind m))))
(defun ast-id (expr) (ast-meta-id (ensure-ast-meta expr)))
(defun ast-type (expr) (ast-meta-type (ensure-ast-meta expr)))
(defun ast-value (expr) (ast-meta-value (ensure-ast-meta expr)))
(defun var-p (term) (eq :var (ast-kind term)))
(defun lit-p (term) (eq :lit (ast-kind term)))
(defun app-p (term) (eq :app (ast-kind term)))
(defun app-of-p (term name) "True when TERM applies the operator named NAME." (and (app-p term) (eq name (ast-id term))))
(defun bool-not (expr) (app (op :if :bool) expr (lit :bool nil) (lit :bool t)))
(defun bool-and (l r) (app (op :if :bool) l r (lit :bool nil)))
(defun syntax-work (expr) "O(1) cached structural AST/type visits and raw payload bits." (ast-meta-syntax-work (ensure-ast-meta expr)))
(defun provably-total-p (expr) "O(1) cached conservative structural definedness." (ast-meta-total-p (ensure-ast-meta expr)))
(defun free-vars (expr) "O(1) cached list of free variable IDs." (copy-list (ast-meta-free-vars (ensure-ast-meta expr))))

(defun rank-le-p (a b &optional le)
  (or (equal a b) (eq a :bottom) (eq b :top) (and (realp a) (realp b) (<= a b))
      (when le (let ((vis (list a)) (q (list a)))
                 (loop while q for cur = (pop q) when (equal cur b) do (return t)
                       do (dolist (e le)
                            (when (and (equal (car e) cur) (not (member (cdr e) vis :test #'equal)))
                              (push (cdr e) vis) (push (cdr e) q))))))))

(defun rank-lt-p (a b &optional le) (and (rank-le-p a b le) (not (rank-le-p b a le))))

(defun normalize-availability-preorder (avail inputs)
  (when avail
    (let* ((plist-p (and (consp avail) (member (first avail) '(:ranks :target :le))))
           (raw (if plist-p (getf avail :ranks) avail)))
      (list :ranks (loop for (id . r) in raw when (assoc id inputs :test #'equal) collect (cons id (copy-tree r)))
            :target (when plist-p (copy-tree (getf avail :target)))
            :le (when plist-p (copy-tree (getf avail :le)))))))

(defun availability-rank (id avail)
  (let ((e (and avail (assoc id (getf avail :ranks) :test #'equal)))) (if e (cdr e) :bottom)))

(defun schema-available-inputs (schema)
  "Return subset of `schema-inputs` whose preorder rank strictly precedes `:target` (or all inputs if unset)."
  (let* ((inps (schema-inputs schema)) (avail (schema-availability schema)) (tgt (and avail (getf avail :target))))
    (if (null tgt) inps
        (let ((le (getf avail :le)))
          (loop for s in inps when (rank-lt-p (availability-rank (car s) avail) tgt le) collect s)))))

(defun expression-respects-availability-p (expression schema)
  "True when every free variable of EXPRESSION is available under SCHEMA's availability preorder."
  (let ((avail (schema-availability schema)))
    (or (null (and avail (getf avail :target)))
        (let ((allowed (schema-available-inputs schema)))
          (every (lambda (id) (assoc id allowed :test #'equal)) (free-vars expression))))))

(defun schema-maximal-availability-id (schema)
  "Return an input ID from `(schema-inputs schema)` of maximal rank in the availability preorder."
  (let* ((inps (schema-inputs schema)) (avail (schema-availability schema))
         (le (and avail (getf avail :le))) (best (car (last inps))))
    (when avail (dolist (s (reverse inps))
                  (when (rank-lt-p (availability-rank (car best) avail) (availability-rank (car s) avail) le)
                    (setf best s))))
    (car best)))

(defun project-schema-availability (avail bindings &key new-target-id drop-ids)
  (when avail
    (let* ((le (getf avail :le)) (otgt (getf avail :target))
           (ntgt (cond ((and new-target-id (assoc new-target-id (getf avail :ranks) :test #'equal))
                        (availability-rank new-target-id avail))
                       (otgt otgt) (new-target-id :top)))
           (ranks (if bindings
                      (loop for (cid . expr) in bindings for fvs = (free-vars expr) when fvs
                            collect (let* ((vr (mapcar (lambda (id) (availability-rank id avail)) fvs))
                                           (pk (or (find-if (lambda (r) (and ntgt (not (rank-lt-p r ntgt le)))) vr)
                                                   (first vr))))
                                      (dolist (r vr) (when (rank-lt-p pk r le) (setf pk r)))
                                      (cons cid (copy-tree pk))))
                      (loop for (id . r) in (getf avail :ranks)
                            unless (member id drop-ids :test #'equal) collect (cons id (copy-tree r))))))
      (list :ranks ranks :target (copy-tree ntgt) :le (copy-tree le)))))

(defun canonicalize-schema-availability (schema)
  (let ((avail (schema-availability schema)) (inps (schema-inputs schema)))
    (when avail
      (list :ranks (loop for (id . nil) in inps for pos from 0
                         for e = (assoc id (getf avail :ranks) :test #'equal)
                         when e collect (cons pos (cdr e)))
            :target (getf avail :target) :le (getf avail :le)))))

(defun make-schema (&key domain inputs (target :int) lookup-p availability)
  (%make-schema :domain (or domain (infer-domain-from-types (cons target (mapcar #'cdr inputs))))
                :inputs (copy-tree inputs) :target (copy-tree target) :lookup-p lookup-p
                :availability (normalize-availability-preorder availability inputs)))

(defun infer-exprs-inputs (exprs)
  "Extract the ((var-id . type) ...) alist from all `var` nodes appearing in EXPRS."
  (let (inputs)
    (labels ((walk (n)
               (cond ((var-p n) (unless (assoc (ast-id n) inputs) (push (cons (ast-id n) (ast-type n)) inputs)))
                     ((app-p n) (dolist (a (rest n)) (walk a))))))
      (dolist (e exprs) (walk e))
      (sort inputs #'< :key #'car))))

(defun body-size (expression inputs)
  "Prefix-coded body bit length of EXPRESSION in variable scope INPUTS."
  (let* ((nin (input-alist inputs)) (m (ensure-ast-meta expression)))
    (expression-type expression nin)
    (+ (ast-meta-non-var-bits m) (* (ast-meta-var-count m) (integer-length (max 0 (1- (length nin))))))))

(defun expression-type (expression &optional inputs (allow-holes nil))
  "Validate syntax and variable scope, returning the expression's monomorphic type."
  (let ((nin (input-alist inputs)) (m (ignore-errors (ensure-ast-meta expression))))
    (assert m () "Not an expression: ~S" expression)
    (ecase (ast-meta-kind m)
      (:lit (assert (and (valid-type-p (ast-meta-type m)) (value-p (ast-meta-value m) (ast-meta-type m))))
            (ast-meta-type m))
      (:var (let ((b (assoc (ast-meta-id m) nin)))
              (assert (and b (equal (cdr b) (ast-meta-type m)))) (ast-meta-type m)))
      (:hole (assert allow-holes) (ast-meta-type m))
      (:app (let* ((om (ensure-ast-meta (first expression)))
                   (sig (if (and allow-holes (eq :hole (ast-meta-kind om)))
                            (ast-meta-type om)
                            (progn (assert (eq :op (ast-meta-kind om))) (ast-meta-value om))))
                   (actual (mapcar (lambda (e) (expression-type e nin allow-holes)) (rest expression))))
              (assert (and (eq :fn (first sig)) (equal actual (second sig))))
              (third sig))))))

(defun map-ast (function tree &key code root-first)
  "Rebuild TREE, replacing nodes as FUNCTION directs; unchanged subtrees share structure."
  (labels ((map-parts (node meta)
             (case (ast-meta-kind meta)
               (:app (let ((parts (mapcar #'walk node))) (if (every #'eq parts node) node (apply #'app parts))))
               (:lit (let ((tp (ast-meta-type meta)) (v (ast-meta-value meta)))
                       (if (and code (code-type-p tp))
                           (let ((in (walk v))) (if (eq in v) node (lit tp in))) node)))
               (t node)))
           (walk (node)
             (let ((meta (ignore-errors (ensure-ast-meta node))))
               (cond ((null meta) node)
                     (root-first (or (funcall function node meta) (map-parts node meta)))
                     (t (let ((r (map-parts node meta)))
                          (or (funcall function r (if (eq r node) meta (ensure-ast-meta r))) r)))))))
    (walk tree)))

(defun instantiate (tree substitutions &optional (tag :hole))
  "Simultaneous AST substitution on homoiconic S-expressions; literals are boundaries."
  (map-ast (lambda (node m) (declare (ignore node))
             (and (eq tag (ast-meta-kind m)) (cdr (assoc (ast-meta-id m) substitutions))))
           tree))

(defun bind-inputs (inputs values) (mapcar (lambda (s v) (cons (car s) v)) (input-alist inputs) values))
(defun identity-bindings (inputs) (mapcar (lambda (s) (cons (car s) (var (car s) (cdr s)))) (input-alist inputs)))
(defun literal-bindings (inputs values)
  (loop for s in (input-alist inputs) for v in values unless (eq v :unresolved) collect (cons (car s) (lit (cdr s) v))))
(defun next-child-id (inputs) (let ((nin (input-alist inputs))) (if nin (1+ (reduce #'max nin :key #'car)) 0)))

(defun rename-function-calls (expr from-name to-target &optional extra-args)
  "Replace applications of FROM-NAME in EXPR with TO-TARGET, optionally appending EXTRA-ARGS."
  (let ((kf (and from-name (canonical-op-name from-name)))
        (top (when (operator-p to-target) to-target))
        (kt (when (and to-target (not (operator-p to-target))) (canonical-op-name to-target))))
    (flet ((ren () (map-ast (lambda (node m)
                              (when (and (eq :app (ast-meta-kind m)) (eq kf (ast-meta-id m)))
                                (apply #'app (or top (if (defined-function-p kt) (op kt)
                                                         (op kt (operator-operand-type (first node)))))
                                       (append (rest node) extra-args))))
                            expr :code t)))
      (cond ((or (null kf) (and kt (eq kf kt) (null extra-args))) expr)
            ((and kt (not (defined-function-p kt)) (not (member kt *registered-function-names*)))
             (let ((*registered-function-names* (append *registered-function-names* (list kt)))) (ren)))
            (t (ren))))))

(defun ast->sexp (expr)
  "Convert an in-memory AST into a canonical self-typed S-expression without uninterned symbols."
  (when expr
    (let ((m (ensure-ast-meta expr)))
      (ecase (ast-meta-kind m)
        (:var (list :var (ast-meta-id m) (copy-tree (ast-meta-type m))))
        (:hole (list :hole (ast-meta-id m) (copy-tree (ast-meta-type m))))
        (:op (list :op (ast-meta-id m) (copy-tree (ast-meta-type m))))
        (:lit (let ((tp (ast-meta-type m)) (v (ast-meta-value m)))
                (list :lit (copy-tree tp) (if (code-type-p tp) (ast->sexp v) (copy-tree v)))))
        (:app (list* :app (ast->sexp (first expr)) (mapcar #'ast->sexp (rest expr))))))))

(defun sexp->ast (sexp)
  "Reconstruct an in-memory pooled, metadata-cached AST from an `ast->sexp` form."
  (when sexp
    (assert (and (consp sexp) (keywordp (first sexp))))
    (ecase (first sexp)
      (:var (var (second sexp) (third sexp)))
      (:hole (hole (second sexp) (third sexp)))
      (:op (let ((kn (canonical-op-name (second sexp))) (ot (third sexp)))
             (if (defined-function-p kn) (op kn)
                 (if (and (code-type-p ot) (not (member kn +operator-names+)))
                     (let ((*registered-function-names*
                             (if (member kn *registered-function-names*) *registered-function-names*
                                 (append *registered-function-names* (list kn)))))
                       (op kn ot))
                     (op kn ot)))))
      (:lit (let ((tp (second sexp)) (rv (third sexp)))
              (lit tp (if (code-type-p tp) (sexp->ast rv) rv))))
      (:app (apply #'app (sexp->ast (second sexp)) (mapcar #'sexp->ast (cddr sexp)))))))

(defun walk-typed-ast (expression scope visitor)
  "Visit AST nodes with their lexical input schema; quotation starts a fresh scope."
  (when expression
    (funcall visitor expression scope)
    (case (ast-kind expression)
      (:app (dolist (p expression) (walk-typed-ast p scope visitor)))
      (:lit (when (code-type-p (ast-type expression))
              (walk-typed-ast (ast-value expression) (code-inputs (ast-type expression)) visitor)))))
  expression)

(defun operator-parameter-from-pattern (name types expected)
  (destructuring-bind (&optional param args res) (primitive-pattern name)
    (let (bindings)
      (flet ((learn (p tp) (when tp (setf bindings (or (ignore-errors (match-type-pattern p tp bindings)) bindings)))))
        (loop for (p) on args for tp in types do (learn p tp))
        (learn res expected)
        (let ((tp (sublis bindings param))) (and (valid-type-p tp) tp))))))

(defun operator-parameter-from-arguments (name types expected)
  (flet ((tuple-of (&rest parts) (and (notany #'null parts) (apply #'tuple-type parts))))
    (case name
      (:tuple (apply #'tuple-of types))
      (:code-match (tuple-of (first types) (second types)))
      (:code-child (tuple-of (first types) expected))
      ((:code-bind :code-subst) (tuple-of (first types) (second types) expected))
      (:code-operator expected)
      (otherwise (operator-parameter-from-pattern name types expected)))))

(defun term (form &optional expected)
  "Build a typed AST from FORM, inferring each operator's type parameter from its arguments."
  (flet ((node-p (x) (and x (or (symbolp x) (consp x)) (ignore-errors (ensure-ast-meta x))))
         (literal (v) (assert expected () "The literal ~S needs a type from its context." v) (lit expected v)))
    (cond ((node-p form) form)
          ((eq form t) (lit :bool t))
          ((atom form) (literal form))
          ((eq 'quote (first form)) (literal (second form)))
          (t (let* ((head (first form)) (hm (node-p head))
                    (name (cond ((null hm) (canonical-op-name head)) ((eq :op (ast-meta-kind hm)) (ast-meta-id hm))))
                    (decl (cond ((and hm (eq :hole (ast-meta-kind hm))) (second (ast-meta-type hm)))
                                (hm (second (ast-meta-value hm)))
                                ((defined-function-p name) (second (operator-type (op name))))))
                    (built (loop for raw in (rest form) for i from 0
                                 collect (cond (decl (term raw (nth i decl)))
                                               ((and (eq name :if) (zerop i)) (term raw :bool))
                                               (t (ignore-errors (term raw))))))
                    (op (cond (hm head) (decl (op name))
                              (t (let ((p (operator-parameter-from-arguments
                                           name (mapcar (lambda (n) (and n (ast-type n))) built) expected)))
                                   (assert p () "Cannot infer the type of ~S in ~S." head form)
                                   (op name p)))))
                    (wanted (or decl (second (operator-type op))))
                    (args (loop for n in built for raw in (rest form) for tp in wanted collect (or n (term raw tp)))))
               (assert (and (= (length args) (length wanted))
                            (every (lambda (n tp) (equal tp (ast-type n))) args wanted))
                       () "Ill-typed arguments in ~S: wanted ~S." form wanted)
               (apply #'app op args))))))
