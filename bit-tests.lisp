(in-package #:lisploop)

(defun check-bit-roundtrip (expression inputs)
  (let ((bits (encode-bit-model expression inputs)))
    (check (= (length bits) (bit-description-size expression inputs)))
    (multiple-value-bind (decoded schema) (decode-bit-model bits)
      (check (equal expression decoded)) (check (equal inputs schema)))
    (raises (decode-bit-model (subseq bits 0 (1- (length bits)))))
    (raises (decode-bit-model (concatenate 'bit-vector bits #*0)))))

(deftest bit-codec-roundtrip-and-boundaries
  (let* ((inputs '((0 . :int) (1 . :int))) (a (var 0 :int)) (b (var 1 :int)))
    (check (= 23 (bit-header-size inputs :int)))
    (check (= 31 (bit-description-size (app (op :+ :int) a b) inputs)))
    (check (equalp #*10000001 (subseq (encode-bit-model (app (op :+ :int) a b) inputs) 23)))
    (loop for n in '(0 1 -1 2 -2 3 -3 4 -4) for size in '(3 6 6 7 7 7 7 10 10) do
      (check (= size (- (bit-description-size (lit :int n) inputs) 23))))
    (dolist (n (append '(0 -1 1) (loop for width in '(7 8 31 32 256 257) append
                                 (list (1- (ash 1 width)) (ash 1 width) (- (ash 1 width))))))
      (check-bit-roundtrip (lit :int n) inputs))
    (dolist (expression (list a (app (op :+ :int) a b) (app (op := :int) a b)
                              (app (op :member :int) a (lit (sequence-type :int) '(-1 0 1)))
                              (app (op :tuple (tuple-type :int :bool)) a (lit :bool nil))
                              (app (op :gather :int) (lit (sequence-type :int) '(4 5 6))
                                   (lit (sequence-type :index) '(2 0 2)))
                              (lit (tuple-type (tuple-type) (sequence-type :bool)) '(nil (t nil)))))
      (check-bit-roundtrip expression inputs)))
  (multiple-value-bind (frame oracle) (gf5-fixture)
    (check-bit-roundtrip oracle (schema-inputs (frame-schema frame)))
    (check-bit-roundtrip (lookup-model frame) (schema-inputs (frame-schema frame))))
  (dolist (prime '(2 5 7 257))
    (check-bit-roundtrip (lit (gf prime) (1- prime)) nil))
  (check-bit-roundtrip (var 99 :int) '((99 . :int)))
  (raises (decode-bit-model #*))
  ;; Same zero under the wider profile is decodable but not canonical.
  (let* ((bits (encode-bit-model (lit :int 0) nil))
         (header (1- (bit-header-size nil :int)))
         (noncanonical (concatenate 'bit-vector (subseq bits 0 header) #*1 #*0011)))
    (raises (decode-bit-model noncanonical)))
  ;; Three GF(5) payload bits have unused values 5..7.
  (let ((bits (encode-bit-model (lit (gf 5) 0) nil)))
    (setf (subseq bits (- (length bits) 3)) #*111)
    (raises (decode-bit-model bits))))

(defun reference-node-trees (leaves operators applications)
  "Enumerate by application count, independently of the size-indexed search."
  (if (zerop applications) leaves
      (loop for left-count below applications append
        (loop for left in (reference-node-trees leaves operators left-count) append
          (loop for right in (reference-node-trees leaves operators (- applications 1 left-count)) append
            (loop for operator in operators collect (app operator left right)))))))

(deftest bit-enumerator-complete-tiny-grammars
  (dolist (domain (list :int (gf 2) (gf 5)))
    (let* ((inputs (list (cons 0 domain) (cons 1 domain)))
           (language (make-language domain inputs :cost-model :bits-v2))
           (bound (+ (bit-header-size inputs domain) (if (eq domain :int) 8 15)))
           (leaves (append (list (var 0 domain) (var 1 domain))
                           (loop for n from (if (eq domain :int) -3 0)
                                 to (if (eq domain :int) 3 (1- (second domain))) collect (lit domain n))))
           (reference (remove-if (lambda (expression) (> (bit-description-size expression inputs) bound))
                                  (loop for count from 0 to (if (eq domain :int) 1 2) append
                                    (reference-node-trees leaves (language-operators language) count))))
           (frame (probe-frame domain inputs '((0 0) (0 1) (1 0) (1 1))))
           (job (start-observation-search (make-observation-scope frame language))))
      (check (eq :bounded-exhaustion (message-claim (resume-observation-search job bound 1000000))))
      (check (= (length reference) (length (observation-job-records job))))
      (check (null (set-exclusive-or reference
                                     (mapcar #'observed-expression-expression (observation-job-records job))
                                     :test #'equal)))
      (dolist (expression reference)
        (check-bit-roundtrip expression inputs)
        (check (equal (observed-expression-values (find-observation job expression))
                       (loop for row in (frame-rows frame) collect
                         (if (eq domain :int)
                             (integer-reference-value expression (mapcar #'cons '(0 1) (row-known row)))
                             (reference-value expression (mapcar #'cons '(0 1) (row-known row))
                                              (second domain)))))))
      (when (eq domain :int) (check (= 27 (length reference)))))))

(deftest bit-literal-ranges-and-vocabulary
  (let* ((language (make-language :int nil :operators nil :cost-model :bits-v2))
         (header (bit-header-size nil :int)))
    ;; All magnitudes with <= 10 bits; include code-length gaps and sign boundaries.
    (loop for payload from 1 to 16 do
      (let ((expected (loop for n from -511 to 511
                            when (= (+ header 2 payload) (length (encode-bit-model (lit :int n) nil))) collect n))
            (actual nil))
        (dotimes (pass 2)
          (multiple-value-bind (lo hi) (language-literal-range language (+ header 2 payload) pass)
            (loop for n from lo to hi do (push (if (= pass 1) (- n) n) actual))))
        (check (equal (sort actual #'<) expected)))))
  (let* ((language (make-language :int nil :operators nil :literals '(0 -1 1) :cost-model :bits-v2))
         (job (start-observation-search (make-observation-scope (probe-frame :int nil '(nil)) language)))
         (bound (language-expression-size language (lit :int 1))))
    (resume-observation-search job (1- bound) 100000)
    (check (= 1 (length (observation-job-records job))))
    (resume-observation-search job bound 100000)
    (check (= 3 (length (observation-job-records job))))))

(deftest bit-replay-extension-and-errors
  (let* ((inputs '((0 . :int))) (language (make-language :int inputs :cost-model :bits-v2))
         (scope (make-observation-scope (probe-frame :int inputs '((0) (1))) language))
         (x (var 0 :int)) (square (app (op :* :int) x x))
         (entry (tuple-type :int :int))
         (missing (app (op :lookup entry) x (lit (sequence-type entry) nil)))
         (job (start-observation-search scope :expressions (list missing square x))))
    (let ((message (resume-observation-search job (bit-description-size x inputs) 100000)))
      (check (eq :replay-complete (message-claim message)))
      (check (eq :bits-v2 (getf (message-evidence message) :cost-model))))
    (check (= 1 (length (observation-job-records job))))
    (check (null (find-observation job square)))
    (resume-observation-search job (bit-description-size square inputs) 100000)
    (check (= 2 (length (observation-job-records job))))
    (check (observed-agreement-p (find-observation job x) (find-observation job square)))
    (resume-observation-search job (bit-description-size missing inputs) 100000)
    (check (eq :error (observed-expression-status (find-observation job missing))))
    (check (= 1 (length (observation-job-buckets job))))
    (check (not (observed-agreement-p (find-observation job missing) (find-observation job missing))))))

(deftest bit-m1-resume-and-work-parity
  (multiple-value-bind (frame oracle) (gf5-fixture)
    (let* ((inputs (schema-inputs (frame-schema frame)))
           (language (make-language (gf 5) inputs :cost-model :bits-v2))
           (unit (start-search frame language :call-id :bit-m1))
           (batch (start-search frame language :call-id :bit-m1))
           (sum (app (op :+ (gf 5)) (var 0 (gf 5)) (var 1 (gf 5)))))
      (dolist (job (list unit batch))
        (resume-search job (language-expression-size language sum) 100000)
        (check (null (search-job-best job))))
      (dolist (limit '(100001 100100 101000 110000 200000 1000000))
        (resume-search unit (language-expression-size language oracle) limit :quantum 1)
        (resume-search batch (language-expression-size language oracle) limit)
        (check (equalp unit batch))
        (check (<= (ledger-total (search-job-ledger batch)) limit)))
      (check (= (language-expression-size language oracle) (search-job-completed-bound batch)))
      (let* ((best (search-job-best batch))
             (model (candidate-expression best)))
        (check (= 51 (candidate-size best)))
        (check (= 2000 (candidate-run-work best)))
        (check (= (candidate-run-work best) (replay-model (decode-bit-model (encode-bit-model model inputs)) frame)))))))

(deftest bit-m2-integers-fresh-scope-and-budget-parity
  (multiple-value-bind (transitions anchors) (integer-transition-fixture)
    (multiple-value-bind (frame pairs) (transition-probes transitions :int)
      (let* ((inputs (schema-inputs (frame-schema frame)))
             (language (make-language :int inputs :cost-model :bits-v2))
             (scope (make-observation-scope frame language :pairs pairs :anchors anchors))
             (unit (start-observation-search scope)) (batch (start-observation-search scope))
             (sum (app (op :+ :int) (var 0 :int) (var 1 :int)))
             (bound (language-expression-size language sum)))
        (dolist (limit '(0 1 100 1000 10000 100000))
          (resume-observation-search unit bound limit :quantum 1)
          (resume-observation-search batch bound limit)
          (check (equalp unit batch)))
        (check (= 27 (length (observation-job-records batch))))
        (check (= 1 (length (observation-invariants batch))))
        (check (= 2 (length (observation-bucket-members (first (observation-invariants batch))))))
        (check (not (observation-bucket-informative-p (bucket-for batch (lit :int 0)))))
        (loop for shift in '(-1 -2) do
          (multiple-value-bind (fresh starts) (integer-transition-fixture :starts (integer-held-out-starts)
                                                                         :steps 1 :shift-b shift)
            (multiple-value-bind (probes links) (transition-probes fresh :int)
              (let* ((replay-scope (make-observation-scope probes language :pairs links :anchors starts))
                     (expressions (mapcar #'observed-expression-expression
                                          (observation-bucket-members (first (observation-invariants batch)))))
                     (replay (start-observation-search replay-scope :expressions expressions)))
                (check (eq :replay-complete (message-claim (resume-observation-search replay bound 100000))))
                (check (eq (= shift -1) (not (null (observation-invariants replay)))))
                (check (equal (mapcar (lambda (row) (apply #'+ (row-known row))) (frame-rows probes))
                               (observed-expression-values (find-observation replay sum)))))))))))
  (let* ((language (make-language :int '((0 . :int)) :cost-model :bits-v2))
         (x (var 0 :int)) (square (app (op :* :int) x x))
         (bound (language-expression-size language square))
         (old (start-observation-search
               (make-observation-scope (probe-frame :int '((0 . :int)) '((0) (1))) language))))
    (resume-observation-search old bound 100000)
    (check (observed-agreement-p (find-observation old x) (find-observation old square)))
    (let* ((values (list -1 0 1 2 (ash 1 256) (1+ (ash 1 256))))
           (scope (make-observation-scope (probe-frame :int '((0 . :int)) (mapcar #'list values)) language))
           (unit (start-observation-search scope)) (batch (start-observation-search scope)))
      (dolist (limit '(100 1000 10000 65000 66000 100000 200000))
        (resume-observation-search unit bound limit :quantum 1)
        (resume-observation-search batch bound limit)
        (check (equalp unit batch)))
      (check (= bound (observation-job-completed-bound batch)))
      (check (not (observed-agreement-p (find-observation batch x) (find-observation batch square))))
      (check (equal (mapcar (lambda (n) (* n n)) values)
                     (observed-expression-values (find-observation batch square)))))))
