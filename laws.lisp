(in-package #:lisploop)

;;; Laws, validation, checked rewriting, solver certification, and requirement propagation.

(defstruct (law (:constructor %make-law)) domain inputs equation guard origin)

(defun law-lhs (law) (second (law-equation law)))
(defun law-rhs (law) (third (law-equation law)))

(defun law-type-p (type domain)
  "True when TYPE is DOMAIN, :BOOL, or a valid tuple of law types in DOMAIN."
  (and (valid-type-p type)
       (or (equal type domain) (eq type :bool)
           (and (tuple-type-p type) (every (lambda (part) (law-type-p part domain)) (rest type))))))

(defun rewrite-scope-type-p (type domain)
  "True when TYPE is a valid input type in a law or rewrite scope over DOMAIN."
  (and (valid-type-p type)
       (or (law-type-p type domain)
           (and (seq-type-p type) (rewrite-scope-type-p (second type) domain))
           (and (tuple-type-p type) (every (lambda (part) (rewrite-scope-type-p part domain)) (rest type))))))

(defun finite-type-p (type)
  "True when TYPE is a finite enumerable type (:BOOL, (:GF p), or a tuple thereof)."
  (and (valid-type-p type)
       (or (eq type :bool) (gf-type-p type)
           (and (tuple-type-p type) (every #'finite-type-p (rest type))))))

(defun make-law (domain inputs left right &key (guard (lit :bool t)) origin)
  (assert (or (eq domain :int) (gf-type-p domain)))
  (assert (= (length inputs) (length (remove-duplicates inputs :key #'car))))
  (assert (every (lambda (input) (rewrite-scope-type-p (cdr input) domain)) inputs))
  (let ((type (expression-type left inputs)))
    (assert (and (equal type (expression-type right inputs)) (rewrite-scope-type-p type domain)
                 (eq :bool (expression-type guard inputs))))
    (%make-law :domain (copy-tree domain) :inputs (copy-tree inputs)
               :equation (copy-tree (term `(= ,left ,right)))
               :guard (copy-tree guard) :origin (copy-tree origin))))

(defun law-statement (law) (term `(if ,(law-guard law) ,(law-equation law) t)))

(defun law-snapshot (law)
  (list (copy-tree (law-domain law)) (encode-model (law-equation law) (law-inputs law))
        (encode-model (law-guard law) (law-inputs law))
        :typed-value +simulator-version+ +encoding-version+ +tariff-version+
        (expression-dependencies (list (law-equation law) (law-guard law)))))

(defstruct (law-certificate (:constructor %make-law-certificate))
  snapshot (evidence :exhaustive-finite-domain) assignments active work)

(defstruct (law-validation (:constructor %make-law-validation))
  law snapshot (status :unknown) (phase :setup) (debt 0) (ledger (make-ledger))
  exhaustive-p samples (index 0) (count 0) (active 0) values evaluation certificate counterexample)

(defun finite-type-cardinality (type)
  (cond ((eq type :bool) 2)
        ((gf-type-p type) (second type))
        ((tuple-type-p type) (reduce #'* (rest type) :key #'finite-type-cardinality :initial-value 1))
        (t (error "No exhaustive validator for ~S" type))))

(defun unrank-finite-value (type index)
  (cond ((eq type :bool) (multiple-value-bind (q r) (floor index 2) (values (= r 1) q)))
        ((gf-type-p type) (multiple-value-bind (q r) (floor index (second type)) (values r q)))
        ((tuple-type-p type)
         (let ((cursor index))
           (values (mapcar (lambda (part)
                             (multiple-value-bind (val next) (unrank-finite-value part cursor)
                               (setf cursor next) val))
                           (rest type))
                   cursor)))
        (t (error "No exhaustive validator for ~S" type))))

(defun inputs-tuple-type (inputs)
  "The tuple type whose values are the assignments to INPUTS."
  (cons :tuple (mapcar #'cdr inputs)))

(defun start-law-validation (law &key (samples nil supplied-p))
  "Exhaust finite types, or test explicit assignments. Samples NEVER certify a law."
  (let* ((snapshot (law-snapshot law))
         (copy (make-law (law-domain law) (law-inputs law) (law-lhs law) (law-rhs law)
                         :guard (law-guard law) :origin (law-origin law)))
         (count (if supplied-p (length samples) (finite-type-cardinality (inputs-tuple-type (law-inputs law))))))
    (dolist (values samples)
      (assert (= (length values) (length (law-inputs law))))
      (assert (every (lambda (value input) (value-p value (cdr input))) values (law-inputs law))))
    (%make-law-validation
     :law copy :snapshot snapshot
     :debt (+ (syntax-work (law-equation law)) (syntax-work (law-guard law))
              (loop for vals in samples sum
                (loop for v in vals for in in (law-inputs law) sum (value-work v (cdr in)))))
     :exhaustive-p (not supplied-p) :samples (copy-tree samples) :count count)))

(defun law-assignment (inputs &optional (index 0))
  "The INDEX-th assignment to INPUTS in the order an exhaustive validation visits them."
  (values (unrank-finite-value (inputs-tuple-type inputs) index)))

(defun finish-law-validation (state)
  (assert (equalp (law-validation-snapshot state) (law-snapshot (law-validation-law state)))
          () "Law changed during validation")
  (setf (law-validation-status state)
        (cond ((zerop (law-validation-active state)) :vacuous)
              ((law-validation-exhaustive-p state) :validated)
              (t :conjecture)))
  (when (eq :validated (law-validation-status state))
    (setf (law-validation-certificate state)
          (%make-law-certificate :snapshot (copy-tree (law-validation-snapshot state))
                                 :assignments (law-validation-count state)
                                 :active (law-validation-active state)
                                 :work (ledger-total (law-validation-ledger state))))))

(defun law-validation-step (state budget)
  (let ((law (law-validation-law state)) (ledger (law-validation-ledger state)))
    (case (law-validation-phase state)
      (:setup
       (pay-debt (law-validation-debt state) budget ledger :law-setup)
       (when (zerop (law-validation-debt state)) (setf (law-validation-phase state) :row)))
      (:row
       (charge ledger :validation-scheduling)
       (if (= (law-validation-index state) (law-validation-count state))
           (finish-law-validation state)
           (setf (law-validation-values state)
                 (if (law-validation-exhaustive-p state)
                     (law-assignment (law-inputs law) (law-validation-index state))
                     (nth (law-validation-index state) (law-validation-samples state)))
                 (law-validation-evaluation state)
                 (start-evaluation (law-guard law) (law-inputs law) (law-validation-values state))
                 (law-validation-phase state) :guard)))
      (otherwise
       (let ((ev (law-validation-evaluation state)))
         (advance-accounted-evaluation ev budget ledger :law-checking :validation-error)
         (cond ((eq :unknown (evaluation-status ev)))
               ((or (eq :error (evaluation-status ev))
                    (and (eq :equation (law-validation-phase state)) (not (evaluation-value ev))))
                (setf (law-validation-status state) :refuted
                      (law-validation-counterexample state)
                      (list :inputs (copy-tree (law-validation-values state)) :phase (law-validation-phase state)
                            :status (evaluation-status ev) :error (evaluation-error ev))))
               ((and (eq :guard (law-validation-phase state)) (evaluation-value ev))
                (incf (law-validation-active state))
                (setf (law-validation-evaluation state)
                      (start-evaluation (law-equation law) (law-inputs law) (law-validation-values state))
                      (law-validation-phase state) :equation))
               (t (incf (law-validation-index state)) (setf (law-validation-phase state) :row))))))))

(defun resume-law-validation (state work-limit &key quantum)
  (assert (and (integerp work-limit) (>= work-limit 0)))
  (assert (or (null quantum) (and (integerp quantum) (plusp quantum))))
  (loop while (and (eq :unknown (law-validation-status state))
                   (< (ledger-total (law-validation-ledger state)) work-limit))
        for remaining = (- work-limit (ledger-total (law-validation-ledger state)))
        do (law-validation-step state (if quantum (min quantum remaining) remaining)))
  state)

(defun validate-law (law work-limit sampled-p samples)
  (resume-law-validation (if sampled-p (start-law-validation law :samples samples) (start-law-validation law))
                         work-limit))

(defun retype-type (type old-domain new-domain)
  (cond ((equal type old-domain) (copy-tree new-domain))
        ((consp type) (cons (retype-type (car type) old-domain new-domain) (retype-type (cdr type) old-domain new-domain)))
        (t type)))

(defun retype-value (value new-type)
  (cond ((and (gf-type-p new-type) (integerp value)) (mod value (second new-type)))
        ((and (tuple-type-p new-type) (listp value)) (mapcar #'retype-value value (rest new-type)))
        ((and (seq-type-p new-type) (listp value))
         (mapcar (lambda (item) (retype-value item (second new-type))) value))
        (t value)))

(defun retype-expr (expr old-domain new-domain)
  (ecase (ast-kind expr)
    (:var (var (ast-id expr) (retype-type (ast-type expr) old-domain new-domain)))
    (:lit (let ((nt (retype-type (ast-type expr) old-domain new-domain)))
            (lit nt (if (code-type-p nt) (retype-expr (ast-value expr) old-domain new-domain)
                        (retype-value (ast-value expr) nt)))))
    (:op (op (operator-name expr) (retype-type (operator-operand-type expr) old-domain new-domain)))
    (:hole (hole (ast-id expr) (retype-type (ast-type expr) old-domain new-domain)))
    (:app (let ((new-op (retype-expr (first expr) old-domain new-domain)))
            (if (operator-p new-op)
                (apply #'app new-op (mapcar (lambda (arg exp-t)
                                              (if (and (eq old-domain :int) (equal exp-t :int))
                                                  (copy-tree arg)
                                                  (retype-expr arg old-domain new-domain)))
                                            (rest expr) (second (operator-type new-op))))
                (apply #'app new-op (mapcar (lambda (arg) (retype-expr arg old-domain new-domain)) (rest expr))))))))

(defun retype-law (law domain)
  "A new conjecture in another domain; no certificate transfers with the syntax."
  (let* ((old (law-domain law))
         (new-inputs (mapcar (lambda (in) (cons (car in) (retype-type (cdr in) old domain))) (law-inputs law))))
    (make-law domain new-inputs (retype-expr (law-lhs law) old domain) (retype-expr (law-rhs law) old domain)
              :guard (retype-expr (law-guard law) old domain) :origin (list :retyped-from old))))

(defun type-slug (type)
  "Compact uppercase string slug for TYPE used in polymorphic combinator names."
  (cond ((symbolp type) (symbol-name type))
        ((gf-type-p type) (format nil "GF~D" (second type)))
        ((seq-type-p type) (format nil "SEQ-~A" (type-slug (second type))))
        ((tuple-type-p type) (format nil "TUPLE~{-~A~}" (mapcar #'type-slug (rest type))))
        (t (format nil "~A" type))))

(defun propose-observed-laws (job &key (guard (lit :bool t)) ledger)
  "Propose a spanning set of equalities per complete output bucket, not certificates."
  (let* ((scope (observation-job-scope job)) (lang (observation-scope-language scope))
         (inputs (language-inputs lang)) laws)
    (dolist (bucket (reverse (observation-job-buckets job)) (nreverse laws))
      (let* ((members (reverse (observation-bucket-members bucket)))
             (first (observed-expression-expression (first members))))
        (dolist (member (rest members))
          (let ((other (observed-expression-expression member)))
            (charge ledger :law-proposal (+ (syntax-work first) (syntax-work other) (syntax-work guard)))
            (push (make-law (language-domain lang) inputs other first :guard guard
                            :origin (list :observed-scope (observation-scope-id scope)
                                          :evidence :replayed-observations))
                  laws)))))))

;;; Rewrite Library & S-Expression Normalizer
(defstruct (rewrite-rule (:constructor %make-rewrite-rule)) inputs pattern replacement guard)

(defstruct (rewrite-library (:constructor %make-rewrite-library))
  domain (%rules nil :read-only t) (setup-work 0)
  (versions (vm-versions) :read-only t)
  (program-cache (make-hash-table :test #'equal) :read-only t))

(defun rewrite-library-rules (library)
  "Inspection copies; changing these cannot change the frozen library or its cache."
  (mapcar (lambda (r)
            (%make-rewrite-rule :inputs (copy-tree (rewrite-rule-inputs r))
                                :pattern (copy-tree (rewrite-rule-pattern r))
                                :replacement (copy-tree (rewrite-rule-replacement r))
                                :guard (copy-tree (rewrite-rule-guard r))))
          (rewrite-library-%rules library)))

(defun law-rewrite-rules (inputs equation guard)
  (destructuring-bind (left right) (rest equation)
    (loop for (from to) in (list (list left right) (list right left))
          when (and (app-p from) (subsetp (append (free-vars to) (free-vars guard)) (free-vars from)))
            collect (%make-rewrite-rule
                     :inputs (copy-tree (remove-if-not (lambda (in) (member (car in) (free-vars from))) inputs))
                     :pattern (copy-tree from) :replacement (copy-tree to) :guard (copy-tree guard)))))

(defun freeze-rewrite-library (domain statements)
  (%make-rewrite-library
   :domain (copy-tree domain)
   :%rules (loop for s in statements append (apply #'law-rewrite-rules s))
   :setup-work (loop for (nil eq g) in statements sum (+ (syntax-work eq) (syntax-work g)))))

(defun prepare-rewrite-library (validations domain)
  "Freeze checked rules. Integer samples, modified laws and cross-domain reuse fail."
  (freeze-rewrite-library
   domain
   (loop for v in validations for law = (law-validation-law v) for cert = (law-validation-certificate v)
         do (assert (and cert (eq :validated (law-validation-status v)) (equal domain (law-domain law))
                         (eq :exhaustive-finite-domain (law-certificate-evidence cert))
                         (equalp (law-certificate-snapshot cert) (law-snapshot law)))
                    () "Rewrite requires unchanged, current, exhaustive evidence in this domain")
         collect (list (law-inputs law) (law-equation law) (law-guard law)))))

(defun compile-rule-transformer (rule inputs)
  (let* ((params (rewrite-rule-inputs rule)) (sort (expression-type (rewrite-rule-pattern rule) params))
         (stype (code-type inputs sort)) (gtype (code-type inputs :bool))
         (ptype (code-type params sort)) (source (var 0 stype)) (assumptions (var 1 (sequence-type gtype)))
         (pat (lit ptype (rewrite-rule-pattern rule)))
         (bindings (loop for p in params collect (term `(code-bind ,pat ,source ,(car p)) (code-type inputs (cdr p)))))
         (btuple (term `(tuple ,@bindings))))
    (flet ((fill-tmpl (expr type)
             (term `(code-subst ,(lit (code-type params (code-sort type)) expr) ,btuple) type)))
      (let* ((rep (fill-tmpl (rewrite-rule-replacement rule) stype))
             (g (fill-tmpl (rewrite-rule-guard rule) gtype))
             (est (term `(if (= ,g ',(lit :bool t)) t (member ,g ,assumptions))))
             (res (term `(if ,est (if (code-less ,rep ,source) ,rep ,source) ,source))))
        (dolist (b (reverse bindings)) (setf res (term `(if (code-total ,b) ,res ,source))))
        (values (term `(if (code-match ,pat ,source) ,res ,source))
                (list (cons 0 stype) (cons 1 (sequence-type gtype))))))))

(defstruct (rewriting (:constructor %make-rewriting))
  inputs library programs pending-programs cache-key evaluation attempt tasks stack (setup-work 0)
  (debt 0) (work 0) (steps 0) (status :unknown) value)

(defun start-rewriting (expression inputs library)
  (let ((library (if (knowledge-library-p library)
                     (or (as-rewrite-library library :domain (infer-domain-from-types (mapcar #'cdr inputs)))
                         (error "No validated rewrite rules in knowledge library"))
                     library)))
    (assert (equal (rewrite-library-versions library) (vm-versions)) () "Stale rewrite library")
    (expression-type expression inputs)
    (assert (every (lambda (in) (rewrite-scope-type-p (cdr in) (rewrite-library-domain library))) inputs))
    (let* ((scope (copy-tree inputs)) (key (list (vm-versions) scope))
           (lwork (+ 1 (length (first key))
                     (loop for in in scope sum (+ (integer-width (car in)) (type-work (cdr in)))))))
      (multiple-value-bind (programs present-p) (gethash key (rewrite-library-program-cache library))
        (let ((pending (unless present-p
                         (loop for rule in (rewrite-library-%rules library) collect
                           (multiple-value-bind (m s) (compile-rule-transformer rule scope) (list rule m s))))))
          (%make-rewriting
           :inputs scope :library library :programs programs :pending-programs pending :cache-key key
           :setup-work (+ lwork (reduce #'+ pending :key (lambda (e) (syntax-work (second e))) :initial-value 0))
           :tasks (list (list :setup nil nil) (list :walk expression nil))))))))

(defun prepare-next-rewrite-program (state)
  (let ((entry (first (rewriting-pending-programs state))))
    (if entry
        (setf (rewriting-evaluation state) (start-program-validation (second entry) (third entry)))
        (setf (gethash (rewriting-cache-key state) (rewrite-library-program-cache (rewriting-library state)))
              (rewriting-programs state)))))

(defun rewriting-push-try (state expression assumptions)
  (push (list :try expression assumptions
              (remove-if-not (lambda (r) (equal (first expression) (first (rewrite-rule-pattern r))))
                             (rewrite-library-%rules (rewriting-library state))))
        (rewriting-tasks state)))

(defun execute-rewrite-task (state task)
  (destructuring-bind (kind expr assumptions &rest extra) task
    (ecase kind
      (:setup (prepare-next-rewrite-program state))
      (:walk (if (app-p expr)
                 (if (eq :if (operator-name (first expr)))
                     (progn (push (list :choose expr assumptions) (rewriting-tasks state))
                            (push (list :walk (second expr) assumptions) (rewriting-tasks state)))
                     (progn (push (list :rebuild expr assumptions) (rewriting-tasks state))
                            (dolist (c (reverse (rest expr))) (push (list :walk c assumptions) (rewriting-tasks state)))))
                 (push expr (rewriting-stack state))))
      (:choose (let ((cond (pop (rewriting-stack state))) (args (rest expr)))
                 (push (list :finish-if expr assumptions cond) (rewriting-tasks state))
                 (push (list :walk (third args) (cons (bool-not cond) assumptions)) (rewriting-tasks state))
                 (push (list :walk (second args) (cons cond assumptions)) (rewriting-tasks state))))
      (:finish-if (let ((no (pop (rewriting-stack state))) (yes (pop (rewriting-stack state))))
                    (rewriting-push-try state (app (first expr) (first extra) yes no) assumptions)))
      (:rebuild (rewriting-push-try
                 state (apply #'app (first expr)
                              (nreverse (loop repeat (length (rest expr)) collect (pop (rewriting-stack state)))))
                 assumptions))
      (:try (let ((rules (first extra)))
              (if (null rules) (push expr (rewriting-stack state))
                  (let ((prog (assoc (first rules) (rewriting-programs state))))
                    (setf (rewriting-attempt state) task
                          (rewriting-evaluation state) (start-validated-evaluation (cdr prog) (list expr assumptions))))))))))

(defun finish-rewrite-evaluation (state)
  (let ((ev (rewriting-evaluation state)))
    (when (eq :error (evaluation-status ev)) (error "Compiled rewrite failed: ~A" (evaluation-error ev)))
    (when (eq :value (evaluation-status ev))
      (when (rewriting-pending-programs state)
        (let ((entry (pop (rewriting-pending-programs state))))
          (push (cons (first entry) (evaluation-value ev)) (rewriting-programs state)))
        (setf (rewriting-evaluation state) nil)
        (when (null (rewriting-pending-programs state))
          (setf (rewriting-programs state) (nreverse (rewriting-programs state))))
        (prepare-next-rewrite-program state)
        (return-from finish-rewrite-evaluation))
      (destructuring-bind (kind expr assumptions rules) (rewriting-attempt state)
        (declare (ignore kind))
        (let ((rep (evaluation-value ev)))
          (if (equal rep expr)
              (push (list :try expr assumptions (rest rules)) (rewriting-tasks state))
              (progn (incf (rewriting-steps state)) (push (list :walk rep assumptions) (rewriting-tasks state))))))
      (setf (rewriting-evaluation state) nil (rewriting-attempt state) nil))))

(defun advance-rewriting (state budget &optional ledger)
  (assert (and (integerp budget) (>= budget 0)))
  (loop while (and (plusp budget) (eq :unknown (rewriting-status state))) do
    (if (rewriting-evaluation state)
        (multiple-value-bind (ev spent)
            (advance-accounted-evaluation (rewriting-evaluation state) budget ledger :rewriting :rewriting)
          (declare (ignore ev))
          (decf budget spent) (incf (rewriting-work state) spent) (finish-rewrite-evaluation state))
        (progn
          (when (zerop (rewriting-debt state))
            (setf (rewriting-debt state) (if (eq :setup (caar (rewriting-tasks state)))
                                             (rewriting-setup-work state) 1)))
          (let ((spent (pay-debt (rewriting-debt state) budget ledger :rewriting)))
            (decf budget spent) (incf (rewriting-work state) spent))
          (when (zerop (rewriting-debt state)) (execute-rewrite-task state (pop (rewriting-tasks state))))))
    (unless (or (rewriting-tasks state) (rewriting-evaluation state))
      (assert (= 1 (length (rewriting-stack state))))
      (setf (rewriting-status state) :complete (rewriting-value state) (first (rewriting-stack state)))))
  state)

;;; M4 Solver Discovery & Arithmetic Relations
(defconstant +completion-work+ 100000000
  "Work allowed to a job that is run to completion in one call; reaching it is a cutoff.")

(defstruct arithmetic-relation domain operator observations records guard exhaustive-p)
(defstruct solve-discovery relation position frame observations witness guard ledger validation uniqueness)

(defun arithmetic-inputs (domain &optional (count 2)) (loop for id below count collect (cons id domain)))

(defun arithmetic-application (operator position known unknown)
  (assert (member position '(0 1)))
  (if (zerop position) (app operator unknown known) (app operator known unknown)))

(defun literal-conditional (condition yes no)
  (if (lit-p condition) (if (ast-value condition) yes no) (term `(if ,condition ,yes ,no))))

(defun arithmetic-definedness (relation position known unknown)
  (let ((args (if (zerop position) (list unknown known) (list known unknown))))
    (instantiate (arithmetic-relation-guard relation) (list (cons 0 (first args)) (cons 1 (second args))) :var)))

(defun arithmetic-requirement (relation position)
  "R(k,c,z): a Boolean predicate describing the complete defined forward fiber."
  (let* ((d (arithmetic-relation-domain relation)) (k (var 0 d)) (c (var 1 d)) (z (var 2 d)))
    (literal-conditional (arithmetic-definedness relation position k z)
                         (term `(= ,(arithmetic-application (arithmetic-relation-operator relation) position k z) ,c))
                         (lit :bool nil))))

(defun solve-witness-law (discovery)
  (let* ((rel (solve-discovery-relation discovery)) (d (arithmetic-relation-domain rel)))
    (make-law d (arithmetic-inputs d)
              (instantiate (arithmetic-requirement rel (solve-discovery-position discovery))
                           (list (cons 2 (solve-discovery-witness discovery))) :var)
              (lit :bool t) :guard (solve-discovery-guard discovery))))

(defun solve-uniqueness-law (discovery)
  (let* ((rel (solve-discovery-relation discovery)) (d (arithmetic-relation-domain rel)))
    (make-law d (arithmetic-inputs d 3)
              (arithmetic-requirement rel (solve-discovery-position discovery))
              (term `(= ,(var 2 d) ,(solve-discovery-witness discovery)))
              :guard (solve-discovery-guard discovery))))

(defun validate-arithmetic-solver (discovery &key (samples nil samples-p)
                                               (uniqueness-samples nil uniqueness-samples-p)
                                               (work-limit +completion-work+))
  (let* ((rel (solve-discovery-relation discovery)) (pos (solve-discovery-position discovery))
         (exh-p (finite-type-p (arithmetic-relation-domain rel))))
    (setf (solve-discovery-validation discovery)
          (validate-law (solve-witness-law discovery) work-limit (or samples-p (not exh-p))
                        (cond (samples-p samples)
                              ((not exh-p) (remove-duplicates (mapcar #'row-known (frame-rows (solve-discovery-frame discovery)))
                                                              :test #'equal))))
          (solve-discovery-uniqueness discovery)
          (validate-law (solve-uniqueness-law discovery) work-limit (or uniqueness-samples-p (not exh-p))
                        (cond (uniqueness-samples-p uniqueness-samples)
                              ((not exh-p) (loop for rec in (arithmetic-relation-records rel)
                                                 collect (list (nth (1+ (- 1 pos)) rec) (fourth rec) (nth (1+ pos) rec)))))))
    discovery))

(defun certified-solve-discovery-p (discovery)
  (and (arithmetic-relation-exhaustive-p (solve-discovery-relation discovery))
       (loop for state in (list (solve-discovery-validation discovery) (solve-discovery-uniqueness discovery))
             for expected in (list (solve-witness-law discovery) (solve-uniqueness-law discovery))
             always (and state (eq :validated (law-validation-status state)) (law-validation-certificate state)
                         (equalp (law-certificate-snapshot (law-validation-certificate state)) (law-snapshot expected))))))

(defun finish-accounted-evaluation (state ledger category error-msg &optional require-value-p)
  (advance-accounted-evaluation state +completion-work+ ledger category category)
  (assert (if require-value-p (eq :value (evaluation-status state)) (not (eq :unknown (evaluation-status state))))
          () error-msg)
  state)

(defun run-algebra-program (model inputs values ledger category)
  (finish-accounted-evaluation (start-evaluation model inputs values) ledger category "Algebra evaluation cutoff"))

;;; Checker-AST Propagation (Dual-Grade Propagators)
(defstruct propagation frame original fallback (narrowed 0) (suggested 0) (retained 0) (rejected 0) (ambiguous 0))
(defstruct arithmetic-propagator domain operator position witness guard certified-p unique-p inputs context-map source source-snapshot)
(defstruct propagator-library rules (unfold-constructors-p nil) (versions (vm-versions)) (matchers (make-hash-table :test #'equal)))

(defun current-witness-conjecture-p (discovery)
  (let ((v (solve-discovery-validation discovery)))
    (and v (eq :conjecture (law-validation-status v))
         (equalp (law-validation-snapshot v) (law-snapshot (solve-witness-law discovery))))))

(defun solve-discovery-solver-arguments (discovery)
  (let* ((rel (solve-discovery-relation discovery)) (domain (arithmetic-relation-domain rel))
         (cert (certified-solve-discovery-p discovery)) (uniq (solve-discovery-uniqueness discovery))
         (ledger (solve-discovery-ledger discovery)))
    (list (arithmetic-relation-operator rel) :domain domain :inputs (arithmetic-inputs domain) :target domain
          :position (solve-discovery-position discovery) :witness (solve-discovery-witness discovery)
          :guard (solve-discovery-guard discovery) :attested-p cert
          :unique-p (or cert (and uniq (member (law-validation-status uniq) '(:conjecture :validated)) t))
          :work (and ledger (ledger-total ledger)))))

(defun prepare-propagator-library (discoveries ledger)
  "Freeze certified field rules and current integer witness conjectures."
  (let (rules)
    (dolist (d discoveries)
      (destructuring-bind (op &key domain position witness guard attested-p unique-p &allow-other-keys)
          (solve-discovery-solver-arguments d)
        (charge ledger :propagator-library (+ (syntax-work (law-statement (solve-witness-law d)))
                                              (syntax-work (law-statement (solve-uniqueness-law d)))))
        (when (or attested-p (and (eq domain :int) (current-witness-conjecture-p d)))
          (push (make-arithmetic-propagator :domain (copy-tree domain) :operator op :position position
                                            :witness (copy-tree witness) :guard (copy-tree guard)
                                            :certified-p attested-p :unique-p unique-p)
                rules))))
    (make-propagator-library :rules (nreverse rules))))

(defun prepare-propagation-program (model inputs ledger category)
  (evaluation-value (finish-accounted-evaluation (start-program-validation model inputs)
                                                 ledger category "Propagation preparation unresolved" t)))

(defun evaluate-propagation-program (program values ledger category)
  (finish-accounted-evaluation (start-validated-evaluation program values) ledger category "Propagation evaluation unresolved"))

(defun knowledge-entry->propagator-rule (entry snapshot)
  "Convert `:solver` ENTRY (with current STATEMENT SNAPSHOT) into an `arithmetic-propagator` rule."
  (let ((meta (knowledge-entry-metadata entry))
        (op (sexp->ast (getf (knowledge-entry-metadata entry) :operator)))
        (inputs (knowledge-entry-inputs entry)))
    (when (and op (knowledge-entry-expression entry))
      (make-arithmetic-propagator
       :domain (copy-tree (knowledge-entry-domain entry)) :operator op :position (getf meta :position)
       :witness (knowledge-entry-expression entry) :guard (knowledge-entry-guard entry)
       :certified-p (knowledge-evidence-current-p entry :witness snapshot)
       :unique-p (knowledge-evidence-current-p entry :uniqueness snapshot)
       :context-map (getf meta :context-map) :source entry :source-snapshot snapshot
       :inputs (unless (equal inputs (arithmetic-inputs (knowledge-entry-domain entry))) (copy-tree inputs))))))

(defun knowledge-library-propagator-library (klib)
  (let* ((entries (active-knowledge-entries-of-kind :solver klib))
         (unfold-p (not (null (some (lambda (e) (eq :anti-unify (getf (knowledge-entry-metadata e) :solver-op)))
                                    (active-knowledge-entries-of-kind :metric-decoder klib)))))
         (snapshots (mapcar #'knowledge-statement-snapshot entries))
         (key (list (knowledge-library-version klib) (vm-versions) unfold-p
                    (loop for e in entries for s in snapshots collect (list s (copy-tree (knowledge-entry-certificate e))))))
         (cache (knowledge-library-propagator-libraries klib)))
    (when (or entries unfold-p)
      (or (gethash key cache)
          (let ((rules (loop for e in entries for s in snapshots for r = (knowledge-entry->propagator-rule e s) when r collect r)))
            (when (or rules unfold-p)
              (setf (gethash key cache)
                    (make-propagator-library :rules rules :unfold-constructors-p unfold-p :versions (vm-versions)))))))))

(defun as-propagator-library (sources &optional (ledger (make-ledger)))
  "Merge SOURCES (`solve-discovery`, `propagator-library`, `knowledge-library`, or lists thereof)."
  (cond
    ((propagator-library-p sources)
     (assert (equal (propagator-library-versions sources) (vm-versions)) () "Stale propagator library") sources)
    ((knowledge-library-p sources) (knowledge-library-propagator-library sources))
    (t (let (discoveries rules unfold-p)
         (dolist (src (if (listp sources) sources (list sources)))
           (etypecase src
             (null nil)
             (solve-discovery (push src discoveries))
             (propagator-library
              (assert (equal (propagator-library-versions src) (vm-versions)) () "Stale propagator library")
              (when (propagator-library-unfold-constructors-p src) (setf unfold-p t))
              (setf rules (append rules (propagator-library-rules src))))
             (knowledge-library
              (let ((plib (knowledge-library-propagator-library src)))
                (when plib
                  (when (propagator-library-unfold-constructors-p plib) (setf unfold-p t))
                  (setf rules (append rules (propagator-library-rules plib))))))))
         (when (or discoveries rules unfold-p)
           (let ((lib (prepare-propagator-library (nreverse discoveries) ledger)))
             (setf (propagator-library-rules lib) (append rules (propagator-library-rules lib))
                   (propagator-library-unfold-constructors-p lib) unfold-p)
             lib))))))

(defun propagator-program (library rule slot ledger)
  (let ((key (list rule slot)) (cache (propagator-library-matchers library)))
    (or (gethash key cache)
        (setf (gethash key cache)
              (prepare-propagation-program
               (if (eq slot :guard) (arithmetic-propagator-guard rule) (arithmetic-propagator-witness rule))
               (or (arithmetic-propagator-inputs rule) (arithmetic-inputs (arithmetic-propagator-domain rule)))
               ledger :propagation-preparation)))))

(defun extract-equality-target (conjunct)
  (multiple-value-bind (term term-type lit-node) (match-literal-equality conjunct :singleton-member-p t)
    (declare (ignore term-type))
    (when term (values term lit-node))))

(defun propagator-evidence (rule)
  (let ((src (arithmetic-propagator-source rule)))
    (if src
        (let ((snap (knowledge-statement-snapshot src)))
          (if (equalp snap (arithmetic-propagator-source-snapshot rule))
              (values (knowledge-evidence-current-p src :witness snap)
                      (knowledge-evidence-current-p src :uniqueness snap))
              (values nil nil)))
        (values (arithmetic-propagator-certified-p rule) (arithmetic-propagator-unique-p rule)))))

(defun propagator-certified-current-p (rule &optional (obligation :witness))
  (multiple-value-bind (certified unique) (propagator-evidence rule)
    (if (eq obligation :witness) certified unique)))

(defun solver-positions (position) (cond ((eq position :unary) '(0)) ((listp position) position) (t (list position))))

(defun solver-context-map (operator position)
  (append (loop for i below (length (second (operator-type operator)))
                unless (member i (solver-positions position)) collect (list :argument i))
          (list :target)))

(defun solver-context-types (operator context-map)
  (let ((sig (operator-type operator)))
    (loop for item in context-map for id from 0
          collect (cons id (if (eq item :target) (third sig) (nth (second item) (second sig)))))))

(defun solver-forward-expression (operator position context-map context witness)
  (let* ((positions (solver-positions position)) (types (second (operator-type operator)))
         (uvals (if (= 1 (length positions)) (list witness) witness)))
    (apply #'app operator
           (loop for type in types for i from 0 for p = (position i positions)
                 collect (lit type (if p (nth p uvals)
                                       (nth (position (list :argument i) context-map :test #'equal) context)))))))

(defun solver-context-values (rule term target ledger)
  (let ((mapping (or (arithmetic-propagator-context-map rule)
                     (solver-context-map (first term) (arithmetic-propagator-position rule)))))
    (assert (member :target mapping))
    (let ((runs (loop for item in mapping
                      for expr = (if (eq item :target) target (nth (second item) (rest term)))
                      collect (and expr (run-algebra-program expr nil nil ledger :propagation-context)))))
      (when (every (lambda (r) (and r (eq :value (evaluation-status r)))) runs)
        (values (mapcar #'evaluation-value runs) mapping)))))

(defun run-learned-solver (library rule context ledger)
  (let ((guard (evaluate-propagation-program (propagator-program library rule :guard ledger) context ledger :propagation-guard)))
    (when (and (eq :value (evaluation-status guard)) (evaluation-value guard))
      (let ((w (evaluate-propagation-program (propagator-program library rule :witness ledger) context ledger :propagation-witness)))
        (when (eq :value (evaluation-status w)) (values (evaluation-value w) t))))))

(defun witness-replays-p (rule term target mapping context value ledger)
  "True when TERM's operator, applied to CONTEXT and VALUE, evaluates to TARGET."
  (let ((check (run-algebra-program
                (solver-forward-expression (first term) (arithmetic-propagator-position rule) mapping context value)
                nil nil ledger :propagation-verification)))
    (and (eq :value (evaluation-status check)) (equal (ast-value target) (evaluation-value check)))))

(defun solved-conjunct (rule term value)
  (let ((positions (solver-positions (arithmetic-propagator-position rule))))
    (reduce #'bool-and (loop for pos in positions for part in (if (rest positions) value (list value))
                             collect (term `(= ,(nth pos (rest term)) ',part)))
            :from-end t)))

(defun solve-learned-equality (conjunct library ledger certified-p result)
  (multiple-value-bind (term target) (extract-equality-target conjunct)
    (let ((open (and term (app-p term)
                     (loop for arg in (rest term) for i from 0
                           when (or (free-vars arg) (pattern-has-holes-p arg)) collect i))))
      (when open
        (dolist (rule (propagator-library-rules library))
          (charge ledger :propagator-dispatch (+ 1 (syntax-work (arithmetic-propagator-operator rule))))
          (when (and (equal (first term) (arithmetic-propagator-operator rule))
                     (null (set-exclusive-or open (solver-positions (arithmetic-propagator-position rule)))))
            (multiple-value-bind (ctx mapping) (solver-context-values rule term target ledger)
              (multiple-value-bind (val ok) (and ctx (run-learned-solver library rule ctx ledger))
                (cond ((not ok))
                      ((or (funcall certified-p rule) (witness-replays-p rule term target mapping ctx val ledger))
                       (return (values (solved-conjunct rule term val) rule)))
                      (t (incf (propagation-rejected result))))))))))))

(defun ast-vars-to-holes (expr allowed-vars)
  (cond ((var-p expr)
         (let ((spec (assoc (ast-id expr) allowed-vars :test #'eql)))
           (if (and spec (equal (cdr spec) (ast-type expr))) (hole (ast-id expr) (ast-type expr)) expr)))
        ((app-p expr)
         (apply #'app (ast-vars-to-holes (first expr) allowed-vars)
                (mapcar (lambda (a) (ast-vars-to-holes a allowed-vars)) (rest expr))))
        (t expr)))

(defun unfold-constructor-equality (conjunct ledger)
  "Invert injective constructor equalities over `:tuple`, `:code-apply`, and closed-template `:code-subst`."
  (multiple-value-bind (term target) (extract-equality-target conjunct)
    (when (and term (app-p term) (lit-p target) (operator-p (first term))
               (or (free-vars term) (pattern-has-holes-p term)))
      (let ((tval (ast-value target)) (ttype (ast-type target)))
        (case (operator-name (first term))
          (:tuple
           (let ((args (rest term)))
             (if (and (tuple-type-p ttype) (listp tval) (= (length args) (length tval)) (= (length args) (length (rest ttype))))
                 (if (null args) (lit :bool t)
                     (reduce #'bool-and (loop for a in args for v in tval for tp in (rest ttype)
                                              collect (app (op := tp) a (lit tp v)))
                             :from-end t))
                 (lit :bool nil))))
          (:code-apply
           (destructuring-bind (ft tt) (second (operator-type (first term)))
             (if (and (app-p tval) (value-p (first tval) ft) (value-p (rest tval) tt))
                 (bool-and (app (op := ft) (second term) (lit ft (first tval)))
                           (app (op := tt) (third term) (lit tt (rest tval))))
                 (lit :bool nil))))
          (:code-subst
           (let ((tmpl-expr (second term)) (tup-expr (third term)))
             (when (and (lit-p tmpl-expr) (code-type-p (ast-type tmpl-expr))
                        (not (pattern-has-holes-p (ast-value tmpl-expr))))
               (let* ((sub-in (code-inputs (ast-type tmpl-expr)))
                      (sig (operator-type (first term))) (tup-type (second (second sig)))
                      (out-type (third sig)) (out-in (code-inputs out-type))
                      (pat (ast-vars-to-holes (ast-value tmpl-expr) sub-in)))
                 (when (equal (term-sort pat out-in) (code-sort out-type))
                   (multiple-value-bind (subs ok-p) (match-pattern pat tval out-in ledger)
                     (if (not ok-p) (lit :bool nil)
                         (let (constraints lvals (all-used-p t) (tup-app-p (app-of-p tup-expr :tuple)))
                           (loop for (id . in-t) in sub-in for i from 0 for b-t in (rest tup-type)
                                 for cb-p = (code-subst-code-binding-p b-t out-type in-t)
                                 for entry = (assoc id subs :test #'eql) do
                                   (if (null entry)
                                       (progn (setf all-used-p nil)
                                              (unless (and tup-app-p (provably-total-p (nth i (rest tup-expr))))
                                                (return-from unfold-constructor-equality nil)))
                                       (let* ((m (cdr entry))
                                              (ok (if cb-p (value-p m b-t)
                                                      (and (lit-p m) (equal (ast-type m) in-t) (value-p (ast-value m) b-t))))
                                              (mv (when ok (if cb-p m (ast-value m)))))
                                         (unless ok (return-from unfold-constructor-equality (lit :bool nil)))
                                         (push mv lvals)
                                         (when tup-app-p
                                           (push (app (op := b-t) (nth i (rest tup-expr)) (lit b-t mv)) constraints)))))
                           (cond (tup-app-p (if constraints (reduce #'bool-and (nreverse constraints) :from-end t) (lit :bool t)))
                                 (all-used-p (app (op := tup-type) tup-expr (lit tup-type (nreverse lvals))))))))))))))))))

(defun conserved-expression-sensitive-p (expr target-id obs-frame &optional ledger)
  "True when EXPR genuinely depends on TARGET-ID across resolved rows of OBS-FRAME."
  (when (member target-id (free-vars expr) :test #'equal)
    (let* ((inputs (schema-inputs (frame-schema obs-frame)))
           (pos (position target-id inputs :key #'car :test #'equal))
           (ttype (and pos (cdr (nth pos inputs)))))
      (when pos
        (let* ((rows (remove-if (lambda (r) (member :unresolved (row-known r))) (frame-rows obs-frame)))
               (obs (remove-duplicates (mapcar (lambda (r) (nth pos (row-known r))) rows) :test #'equal))
               (probes (remove-duplicates
                        (append obs (cond ((eq ttype :int) '(0 1 -1 2 7))
                                          ((gf-type-p ttype) (loop for v below (min (second ttype) 7) collect v))
                                          ((eq ttype :bool) '(nil t))
                                          ((seq-type-p ttype)
                                           (let ((d (default-value-for-type (second ttype))))
                                             (list '() (list d) (list d d))))))
                        :test #'equal)))
          (dolist (row rows nil)
            (let* ((known (row-known row)) (orig (nth pos known))
                   (run0 (evaluate expr inputs known :ledger ledger)))
              (when (eq :value (evaluation-status run0))
                (dolist (alt probes)
                  (unless (equal alt orig)
                    (let ((run1 (evaluate expr inputs (loop for v in known for i from 0 collect (if (= i pos) alt v))
                                          :ledger ledger)))
                      (when (and (eq :value (evaluation-status run1))
                                 (not (equal (evaluation-value run0) (evaluation-value run1))))
                        (return-from conserved-expression-sensitive-p t)))))))))))))

(defun simplify-symbolic-expr (expr inputs &optional ledger)
  (flet ((lit-val-p (n val) (and (lit-p n) (equal (ast-value n) val))))
    (let ((rebuilt (map-ast
                    (lambda (node meta)
                      (declare (ignore meta))
                      (let* ((f (if (null (free-vars node)) (fold-constants node :ledger ledger :budget 500) node))
                             (s (if (and (app-p f) (operator-p (first f)))
                                    (let ((a (rest f)))
                                      (case (operator-name (first f))
                                        (:+ (cond ((lit-val-p (first a) 0) (second a)) ((lit-val-p (second a) 0) (first a)) (t f)))
                                        (:- (if (lit-val-p (second a) 0) (first a) f))
                                        (:* (cond ((lit-val-p (first a) 1) (second a)) ((lit-val-p (second a) 1) (first a)) (t f)))
                                        (otherwise f)))
                                    f)))
                        (unless (equal s node) s)))
                    expr)))
      (if (ignore-errors (expression-type rebuilt inputs)) rebuilt expr))))

(defun solve-equality-symbolically (equation target-id target-type source
                                    &key inputs sample-knowns (allow-tentative-p t) (max-steps 32) ledger)
  "Algebraically unwind EQUATION for TARGET-ID into a closed-form AST over the remaining inputs."
  (declare (ignore target-type))
  (when (app-of-p equation :=)
    (let* ((eff-inputs (input-alist (or inputs (infer-exprs-inputs (list equation)))))
           (library (as-propagator-library source ledger))
           (rules (when library (propagator-library-rules library)))
           (lhs (second equation)) (rhs (third equation)) (certified-p t))
      (labels ((has-target-p (n) (not (null (member target-id (free-vars n) :test #'equal))))
               (eval-all-samples (expr ok-fn)
                 (every (lambda (k) (let ((r (evaluate expr eff-inputs k :ledger ledger)))
                                      (and (eq :value (evaluation-status r)) (funcall ok-fn (evaluation-value r)))))
                        sample-knowns))
               (guard-valid-p (rule ctx-exprs ctx-in)
                 (let ((g (instantiate (arithmetic-propagator-guard rule)
                                       (mapcar (lambda (s e) (cons (car s) e)) ctx-in ctx-exprs) :var)))
                   (cond ((null (free-vars g))
                          (let ((f (fold-constants g :ledger ledger :budget 500))) (and (lit-p f) (eq t (ast-value f)))))
                         (sample-knowns (eval-all-samples g (lambda (v) (eq t v)))))))
               (try-rule-step (term other-side)
                 (dolist (rule rules nil)
                   (let ((positions (solver-positions (arithmetic-propagator-position rule))) (args (rest term)))
                     (when (and (equal (first term) (arithmetic-propagator-operator rule)) (= 1 (length positions)))
                       (let* ((pos (first positions)) (unknown-arg (nth pos args)))
                         (when (and (has-target-p unknown-arg)
                                    (loop for arg in args for i from 0 always (or (= i pos) (not (has-target-p arg)))))
                           (multiple-value-bind (rcert runiq) (propagator-evidence rule)
                             (when (and (or rcert allow-tentative-p) runiq)
                               (let* ((mapping (or (arithmetic-propagator-context-map rule) (solver-context-map (first term) pos)))
                                      (ctx-in (or (arithmetic-propagator-inputs rule) (solver-context-types (first term) mapping)))
                                      (ctx-exprs (loop for it in mapping collect (if (eq it :target) other-side (nth (second it) args)))))
                                 (when (guard-valid-p rule ctx-exprs ctx-in)
                                   (let ((next-rhs (simplify-symbolic-expr
                                                    (instantiate (arithmetic-propagator-witness rule)
                                                                 (mapcar (lambda (s e) (cons (car s) e)) ctx-in ctx-exprs) :var)
                                                    eff-inputs ledger)))
                                     (unless rcert (setf certified-p nil))
                                     (return (values unknown-arg next-rhs t))))))))))))))
        (when (and (has-target-p (term `(= ,lhs ,rhs))) (not (and (has-target-p lhs) (has-target-p rhs))))
          (when (has-target-p rhs) (rotatef lhs rhs))
          (loop repeat max-steps do
            (when (and (var-p lhs) (equal target-id (ast-id lhs)) (not (has-target-p rhs)))
              (let ((final (simplify-symbolic-expr rhs eff-inputs ledger)))
                (when (or (null sample-knowns)
                          (eval-all-samples (app (op := (ast-type final))
                                                 (instantiate (second equation) (list (cons target-id final)) :var)
                                                 (instantiate (third equation) (list (cons target-id final)) :var))
                                            (lambda (v) (eq t v))))
                  (return-from solve-equality-symbolically (values final certified-p)))))
            (unless (app-p lhs) (return nil))
            (multiple-value-bind (nl nr ok-p) (try-rule-step lhs rhs)
              (cond (ok-p (setf lhs nl rhs nr))
                    ((and (app-of-p lhs :tuple) (app-of-p rhs :tuple) (= (length (rest lhs)) (length (rest rhs))))
                     (let ((idx (position-if #'has-target-p (rest lhs))))
                       (unless (and idx (= 1 (count-if #'has-target-p (rest lhs)))) (return nil))
                       (setf lhs (nth idx (rest lhs)) rhs (nth idx (rest rhs)))))
                    (t (return nil))))))))))

(defun propagate-requirements (frame source ledger)
  "Rewrite top-level conjuncts `(= (op ...) 'c)` in FRAME using SOURCE's learned guards and witnesses."
  (let ((library (as-propagator-library source ledger))
        (result (make-propagation :frame frame :original frame))
        settled)
    (labels ((evidence (rule)
               (values-list (cdr (or (assoc rule settled)
                                     (first (push (cons rule (multiple-value-list (propagator-evidence rule))) settled))))))
             (narrow (row)
               (let ((certified t) changed (unique t) (unfold-p (propagator-library-unfold-constructors-p library))
                     (queue (extract-conjuncts (row-requirement row))) kept)
                 (loop while queue for cur = (pop queue) do
                   (multiple-value-bind (next rule) (solve-learned-equality cur library ledger #'evidence result)
                     (let ((unfolded (when (and (null next) unfold-p) (unfold-constructor-equality cur ledger))))
                       (cond (next (multiple-value-bind (rc ru) (evidence rule)
                                     (setf changed t certified (and certified rc) unique (and unique ru)))
                                   (setf queue (append (extract-conjuncts next) queue)))
                             (unfolded (setf changed t)
                                       (cond ((unsatisfiable-requirement-p unfolded)
                                              (setf kept (list (lit :bool nil)) queue nil) (return))
                                             ((not (unconstrained-requirement-p unfolded))
                                              (setf queue (append (extract-conjuncts unfolded) queue)))))
                             (t (let ((c (if (and changed (null (free-vars cur)))
                                             (fold-constants cur :ledger ledger :budget 500) cur)))
                                  (cond ((unsatisfiable-requirement-p c)
                                         (setf kept (list (lit :bool nil)) queue nil) (return))
                                        ((not (unconstrained-requirement-p c)) (push c kept)))))))))
                 (if (not changed) (progn (incf (propagation-retained result)) row)
                     (let ((req (reduce #'bool-and (or (nreverse kept) (list (lit :bool t))) :from-end t)))
                       (if certified (incf (propagation-narrowed result)) (incf (propagation-suggested result)))
                       (unless unique (incf (propagation-ambiguous result)))
                       (charge ledger :propagation-frame (syntax-work req))
                       (make-row :key (row-key row) :known (row-known row) :requirement req))))))
      (if (null library) (setf (propagation-retained result) (length (frame-rows frame)))
          (progn (setf (propagation-frame result) (derive-frame frame :rows (mapcar #'narrow (frame-rows frame))))
                 (when (or (plusp (propagation-suggested result)) (plusp (propagation-ambiguous result)))
                   (setf (propagation-fallback result) frame))))
      result)))

;;; Persistent Knowledge Library: Laws, Solvers, and Functors
(defun collect-expression-operators (expr)
  (let (ops)
    (labels ((walk (n) (when (app-p n) (when (operator-p (first n)) (pushnew (operator-name (first n)) ops :test #'eq))
                             (dolist (a (rest n)) (walk a)))))
      (walk expr) (nreverse ops))))

(defun as-rewrite-library (source &key domain)
  "Coerce SOURCE into a version-fresh `rewrite-library` for DOMAIN."
  (cond ((null source) nil)
        ((rewrite-library-p source) source)
        ((knowledge-library-p source)
         (let* ((laws (remove-if-not (lambda (e) (knowledge-evidence-current-p e :equivalence))
                                     (active-knowledge-entries-of-kind :law source)))
                (eff-dom (or domain (and laws (knowledge-entry-domain (first laws))) :int))
                (d-entries (remove-if-not (lambda (e) (equal eff-dom (knowledge-entry-domain e))) laws)))
           (when d-entries
             (let ((key (list eff-dom (knowledge-library-version source) (vm-versions)
                              (mapcar #'knowledge-statement-snapshot d-entries)))
                   (cache (knowledge-library-rewrite-libraries source)))
               (or (gethash key cache)
                   (let ((lib (freeze-rewrite-library
                               eff-dom (loop for e in d-entries when (app-of-p (knowledge-entry-expression e) :=)
                                             collect (list (knowledge-entry-inputs e) (knowledge-entry-expression e)
                                                           (knowledge-entry-guard e))))))
                     (when (rewrite-library-%rules lib) (setf (gethash key cache) lib))))))))
        ((listp source)
         (prepare-rewrite-library source (or domain (and source (law-validation-p (first source))
                                                         (law-domain (law-validation-law (first source))))
                                             :int)))))

(defun register-knowledge-law (law-or-validation &key id (library *knowledge-library*) status edges metadata ledger)
  "Register a `law` or `law-validation` into LIBRARY as a `:law` `knowledge-entry`."
  (let* ((val (and (law-validation-p law-or-validation) law-or-validation))
         (law (if val (law-validation-law val) law-or-validation))
         (cert (and val (law-validation-certificate val)))
         (eq-ast (law-equation law)) (guard (law-guard law)) (inputs (law-inputs law))
         (entry (make-knowledge-entry
                 :id id :kind :law :domain (law-domain law) :inputs inputs :target :bool
                 :expression eq-ast :guard guard
                 :status (or status (if val (law-validation-status val) :conjecture))
                 :bits (+ (body-size eq-ast inputs) (body-size guard inputs))
                 :work (if val (ledger-total (law-validation-ledger val)) (+ (syntax-work eq-ast) (syntax-work guard)))
                 :edges (append (loop for name in (collect-expression-operators eq-ast)
                                      unless (eq := name) collect (list :governs name))
                                (copy-tree edges))
                 :metadata (append (when (law-origin law) (list :origin (copy-tree (law-origin law)))) (copy-tree metadata))
                 :library library)))
    (when (and cert (eq :validated (law-validation-status val)) (equalp (law-certificate-snapshot cert) (law-snapshot law)))
      (attest-knowledge-entry entry :exhaustive '(:equivalence)))
    (register-knowledge-entry entry :library library :ledger ledger)))

(defun knowledge-entry->law (entry)
  (let ((eq-ast (knowledge-entry-expression entry)))
    (assert (app-of-p eq-ast :=))
    (make-law (knowledge-entry-domain entry) (knowledge-entry-inputs entry)
              (second eq-ast) (third eq-ast) :guard (knowledge-entry-guard entry))))

(defun retype-knowledge-laws (library new-domain &key (validate-p t) (samples nil samples-p)
                                                   (work-limit 1000000) ledger)
  "Retype active `:law` entries in LIBRARY from their source domain to NEW-DOMAIN."
  (let (created)
    (dolist (entry (active-knowledge-entries-of-kind :law library) (nreverse created))
      (let ((nl (and (not (equal new-domain (knowledge-entry-domain entry)))
                     (ignore-errors (retype-law (knowledge-entry->law entry) new-domain)))))
        (flet ((reg (lv &rest keys)
                 (push (apply #'register-knowledge-law lv :library library
                              :edges (list (list :retyped-from (knowledge-entry-id entry))) :ledger ledger keys)
                       created)))
          (cond ((null nl))
                ((some (lambda (ex) (and (equal new-domain (knowledge-entry-domain ex))
                                         (equal (law-equation nl) (knowledge-entry-expression ex))
                                         (equal (law-guard nl) (knowledge-entry-guard ex))))
                       (knowledge-entries-of-kind :law library)))
                (validate-p (let ((fin (validate-law nl work-limit (or samples-p (not (finite-type-p new-domain))) samples)))
                              (charge ledger :law-checking (ledger-total (law-validation-ledger fin)))
                              (when (member (law-validation-status fin) '(:validated :conjecture)) (reg fin))))
                (t (reg nl :status :conjecture))))))))

(define-knowledge-kind :law
  (:priority 30)
  (:validate (entry library)
    (declare (ignore library))
    (let ((expr (knowledge-entry-expression entry)) (inputs (knowledge-entry-inputs entry)))
      (assert (and (app-of-p expr :=) (eq :bool (expression-type expr inputs))
                   (eq :bool (expression-type (knowledge-entry-guard entry) inputs))))))
  (:install (entry library ledger) (declare (ignore entry ledger)) (clrhash (knowledge-library-rewrite-libraries library)))
  (:consume (entry context ledger) (consume-entry-executable entry context ledger :guarded-p t :guard-default '(t . t))))

(defun validate-solver-shape (entry)
  (let* ((meta (knowledge-entry-metadata entry)) (op (sexp->ast (getf meta :operator)))
         (types (second (operator-type op))) (positions (solver-positions (getf meta :position)))
         (mapping (or (getf meta :context-map) (solver-context-map op positions)))
         (expected (solver-context-map op positions)) (utypes (mapcar (lambda (p) (nth p types)) positions)))
    (assert (and positions (every (lambda (p) (and (integerp p) (<= 0 p) (< p (length types)))) positions)
                 (= (length positions) (length (remove-duplicates positions)))))
    (assert (and (= (length mapping) (length expected)) (null (set-exclusive-or mapping expected :test #'equal))))
    (assert (equal (mapcar #'cdr (knowledge-entry-inputs entry)) (mapcar #'cdr (solver-context-types op mapping))))
    (assert (equal (knowledge-entry-target entry) (if (= 1 (length positions)) (first utypes) (cons :tuple utypes))))
    (assert (equal (knowledge-entry-target entry)
                   (expression-type (knowledge-entry-expression entry) (knowledge-entry-inputs entry))))))

(defun solver-context-replay-status (guard witness inputs operator position mapping context expected ledger &optional (budget 1000000))
  "Evaluate GUARD and WITNESS on CONTEXT and verify forward replay to EXPECTED.
Returns `:inactive` (guard false), `witness-val` as secondary value on `:active`, or `:fail`."
  (let ((eff-budget (or budget 1000000))
        (grun (evaluate guard inputs context :budget (or budget 1000000) :ledger ledger)))
    (cond ((not (eq :value (evaluation-status grun))) :fail)
          ((not (evaluation-value grun)) :inactive)
          (t (let ((wrun (evaluate witness inputs context :budget eff-budget :ledger ledger)))
               (if (not (eq :value (evaluation-status wrun))) :fail
                   (let* ((w (evaluation-value wrun))
                          (frun (evaluate (solver-forward-expression operator position mapping context w)
                                          nil nil :budget eff-budget :ledger ledger)))
                     (if (and (eq :value (evaluation-status frun)) (equal expected (evaluation-value frun)))
                         (values :active w) :fail))))))))

(defun certify-solver-entry (entry ledger &key trusted-p)
  "Check finite fibers exhaustively; unbounded certification requires an explicit axiom."
  (validate-solver-shape entry)
  (let* ((meta (knowledge-entry-metadata entry)) (op (sexp->ast (getf meta :operator)))
         (pos (getf meta :position)) (mapping (or (getf meta :context-map) (solver-context-map op pos)))
         (inputs (knowledge-entry-inputs entry)) (target (knowledge-entry-target entry))
         (unique (getf meta :unique-p)) (obligations (if unique '(:witness :uniqueness) '(:witness)))
         (count (and (every #'finite-type-p (cons target (mapcar #'cdr inputs)))
                     (finite-type-cardinality (inputs-tuple-type inputs)))))
    (when trusted-p (return-from certify-solver-entry (attest-knowledge-entry entry :trusted-axiom obligations)))
    (when (and count (<= (* (finite-type-cardinality target) count) 65536))
      (let ((active 0) (tidx (position :target mapping)) (guard (knowledge-entry-guard entry))
            (wit (knowledge-entry-expression entry)))
        (dotimes (index count)
          (let* ((ctx (law-assignment inputs index)) (exp (nth tidx ctx)))
            (multiple-value-bind (st w)
                (solver-context-replay-status guard wit inputs op pos mapping ctx exp ledger nil)
              (when (eq st :fail) (return-from certify-solver-entry nil))
              (when (eq st :active)
                (incf active)
                (when unique
                  (dotimes (i (finite-type-cardinality target))
                    (let* ((alt (unrank-finite-value target i))
                           (run (evaluate (solver-forward-expression op pos mapping ctx alt) nil nil :ledger ledger)))
                      (when (and (eq :value (evaluation-status run)) (equal exp (evaluation-value run))
                                 (not (equal w alt)))
                        (return-from certify-solver-entry nil)))))))))
        (when (plusp active) (attest-knowledge-entry entry :exhaustive obligations))))))

(defun register-knowledge-solver (operator &rest arguments
                                  &key id (library *knowledge-library*) domain inputs target
                                    position witness guard certified-p trusted-p attested-p
                                    context-map (unique-p t) status work edges metadata ledger)
  "Register WITNESS, under GUARD, as a `:solver` `knowledge-entry` inverting OPERATOR at POSITION."
  (when (solve-discovery-p operator)
    (when (and (null (solve-discovery-validation operator))
               (arithmetic-relation-exhaustive-p (solve-discovery-relation operator)))
      (validate-arithmetic-solver operator))
    (return-from register-knowledge-solver
      (apply #'register-knowledge-solver (append (solve-discovery-solver-arguments operator) arguments))))
  (let* ((operator (cond ((operator-p operator) operator)
                         ((defined-function-p (canonical-op-name operator)) (op (canonical-op-name operator)))
                         (t (op (canonical-op-name operator) (or domain :int)))))
         (name (operator-name operator)) (position (or position :unary))
         (context-map (or context-map (solver-context-map operator position)))
         (inputs (or inputs (solver-context-types operator context-map)))
         (guard (or guard (lit :bool t)))
         (entry (make-knowledge-entry
                 :id id :kind :solver
                 :domain (or domain (infer-domain-from-types
                                     (cons (third (operator-type operator)) (second (operator-type operator)))))
                 :inputs inputs :target (or target (expression-type witness inputs))
                 :expression witness :guard guard
                 :status (or status (if (or certified-p attested-p) :validated :conjecture))
                 :bits (+ (body-size witness inputs) (body-size guard inputs))
                 :work (or work (+ (syntax-work witness) (syntax-work guard)))
                 :edges (cons (list :inverts name position) (copy-tree edges))
                 :metadata (append (list :operator (ast->sexp operator) :operator-name name
                                         :position position :context-map context-map
                                         :certified-p (or certified-p attested-p) :unique-p unique-p)
                                   (copy-tree metadata))
                 :library library)))
    (cond (attested-p (attest-knowledge-entry entry :exhaustive '(:witness :uniqueness)))
          ((or certified-p trusted-p) (certify-solver-entry entry ledger :trusted-p trusted-p)))
    (unless (knowledge-evidence-current-p entry :witness)
      (setf (knowledge-entry-status entry) :conjecture
            (getf (knowledge-entry-metadata entry) :certified-p) nil))
    (register-knowledge-entry entry :library library :ledger ledger)))

(defun evaluate-guarded-entry (entry context ledger) (consume-entry-executable entry context ledger :guarded-p t))

(defun solver-entry-signature (meta)
  (let* ((op-ast (sexp->ast (getf meta :operator)))
         (op-name (or (getf meta :operator-name) (and op-ast (operator-name op-ast))))
         (pos (getf meta :position))
         (mapping (or (getf meta :context-map) (and op-ast (solver-context-map op-ast pos)))))
    (values op-name pos mapping)))

(defun induce-cross-prime-solvers (library &key (ledger (make-ledger)) (sample-ints '(-3 -1 0 1 2 3 5)))
  "Anti-unify aligned `(:gf p)` `:solver` entries across `>= 2` primes into parametric `:int` solvers."
  (let ((eff-lib (or library *knowledge-library*)) (groups (make-hash-table :test #'equal)) induced)
    (labels ((sample-vals (tp)
               (cond ((eq tp :int) sample-ints) ((eq tp :bool) '(nil t))
                     ((seq-type-p tp) (let ((vs (subseq (sample-vals (second tp)) 0 2))) (list nil (list (first vs)) vs)))
                     ((tuple-type-p tp) (list (mapcar (lambda (pt) (first (sample-vals pt))) (rest tp))
                                              (mapcar (lambda (pt) (or (second (sample-vals pt)) (first (sample-vals pt)))) (rest tp))))))
             (sample-tuples (inputs &optional (cap 125))
               (let ((per-in (mapcar (lambda (s) (let ((vs (sample-vals (cdr s))))
                                                   (if (and (> (length inputs) 2) (> (length vs) 5)) (subseq vs 0 5) vs)))
                                     inputs)))
                 (when (every #'identity per-in)
                   (let ((all (cartesian-product-lists per-in)))
                     (subseq all 0 (min cap (length all))))))))
      (dolist (e (active-knowledge-entries-of-kind :solver eff-lib))
        (let ((dom (knowledge-entry-domain e)))
          (when (gf-type-p dom)
            (multiple-value-bind (op-name pos mapping) (solver-entry-signature (knowledge-entry-metadata e))
              (when (and op-name pos mapping)
                (push e (gethash (list op-name (solver-positions pos) mapping
                                       (mapcar (lambda (s) (cons (car s) (retype-type (cdr s) dom :int))) (knowledge-entry-inputs e))
                                       (retype-type (knowledge-entry-target e) dom :int))
                                 groups)))))))
      (with-knowledge-library (eff-lib)
        (maphash
         (lambda (key raw-group)
           (let* ((group (reverse raw-group))
                  (primes (remove-duplicates (mapcar (lambda (e) (second (knowledge-entry-domain e))) group) :test #'eql)))
             (when (>= (length primes) 2)
               (destructuring-bind (op-name positions mapping int-in int-tgt) key
                 (let* ((rep-pos (getf (knowledge-entry-metadata (first group)) :position))
                        (sid (keyword-id "CROSS-PRIME/~A-~A" op-name
                                         (if (listp rep-pos) (format nil "~{~D~^-~}" rep-pos) rep-pos)))
                        (int-op (cond ((member op-name +operator-names+) (ignore-errors (op op-name :int)))
                                      ((defined-function-p op-name) (op op-name)))))
                   (when (and int-op (null (find-knowledge-entry sid eff-lib))
                              (equal (mapcar #'cdr int-in) (ignore-errors (mapcar #'cdr (solver-context-types int-op mapping)))))
                     (let ((ws (loop for e in group collect (ignore-errors (retype-expr (knowledge-entry-expression e) (knowledge-entry-domain e) :int))))
                           (gs (loop for e in group collect (ignore-errors (retype-expr (knowledge-entry-guard e) (knowledge-entry-domain e) :int)))))
                       (when (and (every (lambda (w) (and w (equal int-tgt (ignore-errors (expression-type w int-in))))) ws)
                                  (every (lambda (g) (and g (eq :bool (ignore-errors (expression-type g int-in))))) gs))
                         (let ((lw (nth-value 0 (anti-unify ws int-in ledger :operator-holes-p nil)))
                               (lg (nth-value 0 (anti-unify gs int-in ledger :operator-holes-p nil))))
                           (when (and (not (pattern-has-holes-p lw)) (not (pattern-has-holes-p lg))
                                      (equal int-tgt (ignore-errors (expression-type lw int-in)))
                                      (eq :bool (ignore-errors (expression-type lg int-in)))
                                      (not (some (lambda (s)
                                                   (multiple-value-bind (son spos smap) (solver-entry-signature (knowledge-entry-metadata s))
                                                     (and (equal :int (knowledge-entry-domain s)) (eq op-name son)
                                                          (equal positions (solver-positions spos)) (equal mapping smap)
                                                          (equal lw (knowledge-entry-expression s)) (equal lg (knowledge-entry-guard s)))))
                                                 (active-knowledge-entries-of-kind :solver eff-lib))))
                             (let ((active 0) (ok-p t) (tidx (position :target mapping)))
                               (dolist (ctx (sample-tuples int-in))
                                 (let ((st (solver-context-replay-status lg lw int-in int-op rep-pos mapping ctx (nth tidx ctx) ledger 2000)))
                                   (when (eq st :fail) (setf ok-p nil) (return))
                                   (when (eq st :active) (incf active))))
                               (when (and ok-p (>= active 2))
                                 (push (register-knowledge-solver
                                        int-op :id sid :library eff-lib :domain :int :inputs int-in :target int-tgt
                                        :position rep-pos :context-map mapping :witness lw :guard lg
                                        :status :conjecture :certified-p nil
                                        :unique-p (every (lambda (e) (getf (knowledge-entry-metadata e) :unique-p)) group)
                                        :edges (list (cons :retyped-from (mapcar #'knowledge-entry-id group)))
                                        :metadata (list :origin :cross-prime-au :source-primes (sort (copy-list primes) #'<))
                                        :ledger ledger)
                                       induced)))))))))))))
         groups)))
    (nreverse induced)))

(define-knowledge-kind :solver
  (:priority 35)
  (:validate (entry library) (declare (ignore library))
    (validate-solver-shape entry)
    (assert (eq :bool (expression-type (knowledge-entry-guard entry) (knowledge-entry-inputs entry)))))
  (:install (entry library ledger) (declare (ignore entry ledger)) (clrhash (knowledge-library-propagator-libraries library)))
  (:consume (entry context ledger)
    (when (= (length context) (length (knowledge-entry-inputs entry))) (evaluate-guarded-entry entry context ledger)))
  (:consolidate (entries library ledger) (declare (ignore entries)) (induce-cross-prime-solvers library :ledger ledger)))
