(defvar *v2* (second sb-ext:*posix-argv*))
(load (merge-pathnames "load.lisp" *v2*))
(in-package #:lisploop)
(let* ((idx-code (code-type '((0 . :int)) :int))
       (f (var 0 idx-code)))
  (handler-bind ((error (lambda (e)
                          (format t "~&ERROR: ~A~%" (remove #\Newline (princ-to-string e)))
                          (let ((n 0))
                            (sb-debug:map-backtrace
                             (lambda (fr)
                               (when (< (incf n) 14)
                                 (format t "  ~A~%" (ignore-errors (sb-debug::frame-call fr)))))))
                          (sb-ext:exit :code 0 :abort t))))
    (format t "~&constructing (tabulate '3 F) with F a code VARIABLE ...~%")
    (let ((e (app (op :tabulate :int) (lit :int 3) f)))
      (format t "constructed ok: ~S~%" e)
      (format t "provably-total-p => ~S~%" (provably-total-p e)))))
