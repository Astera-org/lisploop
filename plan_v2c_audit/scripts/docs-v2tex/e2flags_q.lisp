(defvar *v2* (second sb-ext:*posix-argv*))
(load (merge-pathnames "load.lisp" *v2*))
(in-package #:lisploop)
(defun bench-frame (workload)
  (let* ((field (gf 5))
         (inputs (list (cons 0 field) (cons 1 field)))
         (a (var 0 field)) (b (var 1 field))
         (planted (cond ((string= workload "linear") (term `(* 2 ,b)))
                        ((string= workload "quadratic") (term `(* ,b (+ ,b 2))))
                        ((string= workload "quartic") (term `(* (* ,b ,b) (* ,b ,b))))))
         (oracle (term `(+ ,a ,planted)))
         (records (loop for x below 5 append
                    (loop for y below 5 collect
                      (let ((run (evaluate oracle inputs (list x y))))
                        (list (+ (* x 5) y) x y (evaluation-value run)))))))
    (values (orient-observations (list field field field) records '(0 1) '(2))
            (description-size oracle inputs))))
(defun run-case (workload bound &rest flags)
  (handler-case
      (multiple-value-bind (frame oracle-size) (bench-frame workload)
        (declare (ignorable oracle-size))
        (let* ((job (apply #'start-search frame (make-language (gf 5) (schema-inputs (frame-schema frame)))
                           :call-id (gensym) flags))
               (t0 (get-internal-real-time))
               (status :cut))
          (loop
            (let* ((work (ledger-total (search-job-ledger job)))
                   (outcome (resume-search job bound (+ work 1000000))))
              (when (eq :bounded-exhaustion (message-claim outcome)) (setf status :complete) (return))
              (when (> (ledger-total (search-job-ledger job)) 400000000) (return))))
          (let ((best (search-job-best job)))
            (format t "~&~9A bound=~D flags=~S~%   status=~S wall=~,2Fs work=~D retained=~D successes=~D rejected=~D~%   best=~S bits=~A~%"
                    workload bound flags status
                    (/ (- (get-internal-real-time) t0) (float internal-time-units-per-second))
                    (ledger-total (search-job-ledger job))
                    (loop for b being the hash-values of (enumerator-buckets (search-job-enumerator job)) sum (length b))
                    (length (search-job-results job)) (search-job-rejected job)
                    (and best (candidate-expression best)) (and best (candidate-size best))))))
    (error (e) (format t "~&~9A bound=~D flags=~S~%   ERROR: ~A~%" workload bound flags (remove #\Newline (princ-to-string e))))))
(dolist (w (quote (("quartic" 77))))
  (run-case (first w) (second w))
  (run-case (first w) (second w) :prune-behaviors-p t)
  (run-case (first w) (second w) :columnar-p t)
  (run-case (first w) (second w) :prune-behaviors-p t :columnar-p t))
