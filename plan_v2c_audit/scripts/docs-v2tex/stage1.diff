+          always (or (not active-p)
+                     (let ((run (evaluate guard inputs (row-known row) :budget 500 :ledger ledger)))
+                       (and (eq :value (evaluation-status run))
+                            (eq (not (null (evaluation-value run))) (not (null hit-p)))
+                            (or (not hit-p)
