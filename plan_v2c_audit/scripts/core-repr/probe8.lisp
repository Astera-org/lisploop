;;; probe8.lisp — cost of AST construction with the weak EQ metadata table (v1).
(load "/home/tlh24/lisploop/load.lisp")
(in-package #:lisploop)
(defun ms (start) (round (* 1000 (- (get-internal-real-time) start)) internal-time-units-per-second))
(let ((x (var 0 :int)) (keep nil))
  (dolist (n '(250000 500000 1000000 2000000))
    (let ((start (get-internal-real-time))
          (gc0 sb-ext:*gc-run-time*))
      (dotimes (i n)
        (push (app (op :+ :int) x (lit :int (mod i 1000))) keep))
      (format t "~&built ~8D live (+ x 'k) nodes [2 metas each]: ~6D ms total, ~6D ms in GC; node-meta table count=~D~%"
              n (ms start)
              (round (* 1000 (- sb-ext:*gc-run-time* gc0)) internal-time-units-per-second)
              (hash-table-count *node-meta*))))
  ;; transient nodes (garbage): does the weak table shrink?
  (setf keep nil)
  (sb-ext:gc :full t)
  (format t "~&after dropping all and full GC: node-meta count=~D~%" (hash-table-count *node-meta*))
  (let ((start (get-internal-real-time)) (gc0 sb-ext:*gc-run-time*))
    (dotimes (i 2000000) (app (op :+ :int) x (lit :int (mod i 1000))))
    (format t "built 2000000 transient nodes: ~D ms total, ~D ms in GC; table count=~D~%"
            (ms start) (round (* 1000 (- sb-ext:*gc-run-time* gc0)) internal-time-units-per-second)
            (hash-table-count *node-meta*)))
  ;; cost of copy-tree'd AST re-validation (derive-row copies requirements)
  (let* ((big (reduce (lambda (acc i) (app (op :+ :int) acc (app (op :* :int) x (lit :int i))))
                      (loop for i from 1 to 2000 collect i) :initial-value x))
         (start (get-internal-real-time)))
    (dotimes (k 200) (ensure-ast-meta (copy-tree big)))
    (format t "200 x (ensure-ast-meta (copy-tree <4000-app term>)): ~D ms~%" (ms start))
    (setf start (get-internal-real-time))
    (dotimes (k 200) (body-size big (list (cons 0 :int))))
    (format t "200 x body-size on the same cached term (docstring says O(1)): ~D ms~%" (ms start))))
