;;; probe3.lisp — does SBCL's EQUAL hashing distinguish kernel ASTs?
(load "/home/tlh24/lisploop/load.lisp")
(in-package #:lisploop)
(let ((x (var 0 :int)))
  (flet ((mk (i) (app (op :+ :int) (app (op :* :int) x (lit :int i)) x))
         (ms (start) (round (* 1000 (- (get-internal-real-time) start)) internal-time-units-per-second)))
    (format t "internal-time-units-per-second = ~D~%" internal-time-units-per-second)
    (let ((sx (make-hash-table)) (eh (make-hash-table)))
      (dotimes (i 2000)
        (setf (gethash (sxhash (mk i)) sx) t)
        (setf (gethash (sb-impl::equal-hash (mk i)) eh) t))
      (format t "distinct sxhash: ~D   distinct sb-impl::equal-hash: ~D (of 2000)~%"
              (hash-table-count sx) (hash-table-count eh)))
    (dolist (n '(5000 10000 20000 40000))
      (let* ((terms (loop for i below n collect (mk i)))
             (table (make-hash-table :test #'equal))
             (start (get-internal-real-time)))
        (dolist (term terms) (setf (gethash term table) t))
        (dolist (term terms) (gethash term table))
        (format t "n=~6D equal-table insert+lookup ~6D ms~%" n (ms start))))
    ;; A deeper family: differ only at depth ~8.
    (flet ((deep (i) (let ((acc (lit :int i)))
                       (dotimes (k 8 acc) (setf acc (app (op :+ :int) x acc))))))
      (let ((sx (make-hash-table)))
        (dotimes (i 2000) (setf (gethash (sxhash (deep i)) sx) t))
        (format t "depth-8 family: distinct sxhash ~D of 2000~%" (hash-table-count sx)))
      (dolist (n '(5000 10000 20000))
        (let* ((terms (loop for i below n collect (deep i)))
               (table (make-hash-table :test #'equal))
               (start (get-internal-real-time)))
          (dolist (term terms) (setf (gethash term table) t))
          (dolist (term terms) (gethash term table))
          (format t "depth-8 family n=~6D equal-table insert+lookup ~6D ms~%" n (ms start)))))
    ;; Rows keyed by (known requirement) lists, as lift-frame's SEEN table does.
    (let* ((seq (sequence-type :int)))
      (dolist (n '(2000 4000 8000))
        (let* ((keys (loop for i below n
                           collect (list (list (loop for k below 6 collect k) i)
                                         (term `(= ,(var 0 :int) ,i)))))
               (table (make-hash-table :test #'equal))
               (start (get-internal-real-time)))
          (dolist (key keys) (setf (gethash key table) t))
          (format t "(known requirement) keys n=~5D insert ~6D ms~%" n (ms start)))))))
