;;; probe6.lisp — v2 Stage-1 opcodes, each step isolated.
(load "/home/tlh24/lisploop/v2/load.lisp")
(in-package #:lisploop)
(defmacro show (label form)
  `(format t "~&~A~%   => ~S~%" ,label (handler-case (multiple-value-list ,form)
                                          (error (c) (list :HOST-ERROR (let ((s (princ-to-string c))) (subseq s 0 (min 240 (length s)))))))))
(defun run (expr &optional inputs values (budget 100000))
  (let ((e (evaluate expr inputs values :budget budget)))
    (list (evaluation-status e) (evaluation-value e) (evaluation-error e) (evaluation-work e))))
(defparameter *seq* (sequence-type :int))
(defparameter *xs* (var 0 *seq*))
(defparameter *ins* (list (cons 0 *seq*)))
(defparameter *idx-code* (code-type '((0 . :int)) :int))

;; reverse via tabulate + code-subst closing over xs (guarded variant so the body is total by itself)
(show "reverse: construct (tabulate (length xs) (code-subst '(at x1 (- (- (length x1) 1) x0)) (tuple 'x0 xs)))"
      (let* ((rev-code-type (code-type (list (cons 0 :int) (cons 1 *seq*)) :int))
             (body (term `(at ,(var 1 *seq*) (- (- (length ,(var 1 *seq*)) 1) ,(var 0 :int)))))
             (subst (term `(code-subst ,(lit rev-code-type body) (tuple ,(lit *idx-code* (var 0 :int)) ,*xs*)) *idx-code*))
             (rev (app (op :tabulate :int) (term `(length ,*xs*)) subst)))
        (list (run rev *ins* '((5 6 7))) :total (provably-total-p rev) :bits (body-size rev *ins*))))
(show "squares: (tabulate (length xs) '(* j j)) on (5 6 7)"
      (let ((sq (app (op :tabulate :int) (term `(length ,*xs*)) (lit *idx-code* (term `(* ,(var 0 :int) ,(var 0 :int)))))))
        (list (run sq *ins* '((5 6 7))) :total (provably-total-p sq) :bits (body-size sq *ins*)
              :closure (and (expression-closure sq *ins*) t))))
(show "index array feeding access: (gather xs (tabulate 2 '(+ j 1))) on (5 6 7)"
      (let ((g (term `(gather ,*xs* ,(app (op :tabulate :int) (lit :int 2) (lit *idx-code* (term `(+ ,(var 0 :int) 1))))))))
        (list (run g *ins* '((5 6 7))) :total (provably-total-p g))))
(show "prefix sums: (evolve xs 0 '(+ s a)) on (1 2 3 4)"
      (let* ((step (code-type (list (cons 0 :int) (cons 1 :int)) :int))
             (scan (app (op :evolve (tuple-type :int :int)) *xs* (lit :int 0)
                        (lit step (term `(+ ,(var 0 :int) ,(var 1 :int)))))))
        (list (run scan *ins* '((1 2 3 4))) :total (provably-total-p scan) :bits (body-size scan *ins*))))
(show "(code-anti-unify '(+ x 1) '(+ x 2)) into scope ((0 . int) (1 . int))"
      (let* ((in (code-type '((0 . :int)) :int))
             (out (code-type '((0 . :int) (1 . :int)) :int))
             (au (app (op :code-anti-unify (tuple-type in out))
                      (lit in (term `(+ ,(var 0 :int) 1))) (lit in (term `(+ ,(var 0 :int) 2))))))
        (list (run au) :total (provably-total-p au))))
(show "(code-anti-unify '(+ x 1) '(* x 2))  [different heads]"
      (let* ((in (code-type '((0 . :int)) :int))
             (out (code-type '((0 . :int) (1 . :int)) :int))
             (au (app (op :code-anti-unify (tuple-type in out))
                      (lit in (term `(+ ,(var 0 :int) 1))) (lit in (term `(* ,(var 0 :int) 2))))))
        (run au)))
(let ((in (code-type '((0 . :int)) :int)))
  (show "(code-arity '(+ x 1))" (run (app (op :code-arity in) (lit in (term `(+ ,(var 0 :int) 1))))))
  (show "(code-quote 5)" (run (app (op :code-quote in) (lit :int 5))))
  (show "(code-value '5)" (run (app (op :code-value in) (lit in (lit :int 5)))))
  (show "(code-var 0)" (run (app (op :code-var in) (lit :int 0))))
  (show "(code-var-id 'x0)" (run (app (op :code-var-id in) (lit in (var 0 :int))))))
(show "v2 pullback through (gather x0 Z): folded requirement + allowed values"
      (let* ((src '(10 20 30 20)) (z (var 9 *seq*))
             (parent (make-frame (make-schema :inputs (list (cons 0 *seq*)) :target *seq*)
                                 (list (make-row :key 0 :known (list src)
                                                 :requirement (set-requirement *seq* (list '(20 10)))))))
             (decoder (term `(gather ,(var 0 *seq*) ,z)))
             (child (pullback-frame parent decoder 9 *seq* (identity-bindings (list (cons 0 *seq*)))))
             (folded (fold-constants (row-requirement (first (frame-rows child))) :contract :necessary)))
        (list folded (extract-allowed-values folded))))
(show "v2 lift-frame through (tabulate 4 F) with target (0 1 4 9)"
      (let* ((fz (var 9 *idx-code*))
             (parent (make-frame (make-schema :inputs nil :target *seq*)
                                 (list (make-row :key 0 :known nil
                                                 :requirement (set-requirement *seq* (list '(0 1 4 9)))))))
             (decoder (app (op :tabulate :int) (lit :int 4) fz)))
        (multiple-value-bind (lifted coupled reserve) (lift-frame parent decoder 9 *idx-code*)
          (list :inputs (schema-inputs (frame-schema lifted)) :target (schema-target (frame-schema lifted))
                :rows (mapcar (lambda (r) (list (row-key r) (row-known r) (row-requirement r))) (frame-rows lifted))
                :coupled coupled :reserve reserve))))
(show "v2 lift-frame through (evolve '(1 2 3 4) 0 F) with target (1 3 6 10)"
      (let* ((step (code-type (list (cons 0 :int) (cons 1 :int)) :int))
             (fz (var 9 step))
             (parent (make-frame (make-schema :inputs nil :target *seq*)
                                 (list (make-row :key 0 :known nil
                                                 :requirement (set-requirement *seq* (list '(1 3 6 10)))))))
             (decoder (app (op :evolve (tuple-type :int :int)) (lit *seq* '(1 2 3 4)) (lit :int 0) fz)))
        (multiple-value-bind (lifted coupled reserve) (lift-frame parent decoder 9 step)
          (list :inputs (schema-inputs (frame-schema lifted)) :target (schema-target (frame-schema lifted))
                :rows (mapcar (lambda (r) (list (row-key r) (row-known r) (row-requirement r))) (frame-rows lifted))
                :coupled coupled :reserve reserve))))
