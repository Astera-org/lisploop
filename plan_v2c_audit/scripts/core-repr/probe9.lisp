;;; probe9.lisp — transient AST garbage through the weak table; copy-tree revalidation; body-size.
(load "/home/tlh24/lisploop/load.lisp")
(in-package #:lisploop)
(defun ms (start) (round (* 1000 (- (get-internal-real-time) start)) internal-time-units-per-second))
(let ((x (var 0 :int)))
  (dolist (n '(500000 1000000 2000000 4000000))
    (let ((start (get-internal-real-time)) (gc0 sb-ext:*gc-run-time*))
      (dotimes (i n) (app (op :+ :int) x (lit :int (mod i 1000))))
      (format t "~&built ~8D transient (+ x 'k) nodes: ~6D ms total, ~6D ms in GC; node-meta count now ~D~%"
              n (ms start) (round (* 1000 (- sb-ext:*gc-run-time* gc0)) internal-time-units-per-second)
              (hash-table-count *node-meta*))))
  (let* ((big (reduce (lambda (acc i) (app (op :+ :int) acc (app (op :* :int) x (lit :int i))))
                      (loop for i from 1 to 2000 collect i) :initial-value x))
         (start (get-internal-real-time)))
    (format t "big term: syntax-work=~D body-size=~D bits~%" (syntax-work big) (body-size big (list (cons 0 :int))))
    (dotimes (k 100) (ensure-ast-meta (copy-tree big)))
    (format t "100 x (ensure-ast-meta (copy-tree <6000-node term>)): ~D ms~%" (ms start))
    (setf start (get-internal-real-time))
    (dotimes (k 100) (body-size big (list (cons 0 :int))))
    (format t "100 x body-size on the same *cached* term: ~D ms  (docstring: O(1))~%" (ms start))
    (setf start (get-internal-real-time))
    (dotimes (k 100) (ast-meta-non-var-bits (ensure-ast-meta big)))
    (format t "100 x cached meta read: ~D ms~%" (ms start))
    (setf start (get-internal-real-time))
    (dotimes (k 100) (instantiate big (list (cons 0 (lit :int 5))) :var))
    (format t "100 x instantiate x:=5 (rebuilds whole term + metas): ~D ms~%" (ms start))))
