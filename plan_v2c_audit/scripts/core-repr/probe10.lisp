;;; probe10.lisp — frame construction / derivation / pullback scaling in rows (v1).
(load "/home/tlh24/lisploop/load.lisp")
(in-package #:lisploop)
(defun ms (start) (round (* 1000 (- (get-internal-real-time) start)) internal-time-units-per-second))
(dolist (n '(250 500 1000 2000 4000))
  (let* ((examples (loop for i below n collect (list (list i (* 2 i)) (+ (* 3 i) 1))))
         (inputs '((0 . :int) (1 . :int)))
         (start (get-internal-real-time))
         (frame (simple-frame :int inputs examples))
         (t-make (ms start)))
    (setf start (get-internal-real-time))
    (let ((snap (snapshot-frame frame)))
      (declare (ignorable snap))
      (let ((t-snap (ms start)))
        (setf start (get-internal-real-time))
        (let* ((decoder (term `(+ ,(var 0 :int) ,(var 9 :int))))
               (child (pullback-frame frame decoder 9 :int (identity-bindings inputs)))
               (t-pull (ms start)))
          (setf start (get-internal-real-time))
          (multiple-value-bind (conflict folded) (frame-conflict-p child)
            (declare (ignore conflict folded))
            (let ((t-fold (ms start)))
              (setf start (get-internal-real-time))
              (canonical-row-order frame)
              (format t "~&rows=~5D  simple-frame ~5D ms | snapshot ~5D ms | pullback ~5D ms | frame-conflict-p(fold) ~5D ms | canonical-row-order ~5D ms~%"
                      n t-make t-snap t-pull t-fold (ms start)))))))))
