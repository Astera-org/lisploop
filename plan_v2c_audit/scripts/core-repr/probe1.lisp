;;; probe1.lisp — read-only probes of the v1 kernel's term identity, VM outcomes, indices.
;;; Usage: sbcl --script probe1.lisp <root-dir>
(defvar *root* (or (second sb-ext:*posix-argv*) "/home/tlh24/lisploop/"))
(load (concatenate 'string *root* "load.lisp"))
(in-package #:lisploop)

(defmacro show (label form)
  `(format t "~&~A~%   => ~S~%" ,label (handler-case (multiple-value-list ,form)
                                          (error (c) (list :HOST-ERROR (princ-to-string c))))))

(format t "~&===== A. TERM IDENTITY =====~%")
(let* ((x (var 0 :int))
       (t1 (app (op :+ :int) x (lit :int 1)))
       (t2 (app (op :+ :int) x (lit :int 1))))
  (show "eq two separately built (+ x0 1)" (eq t1 t2))
  (show "equal two separately built (+ x0 1)" (equal t1 t2))
  (show "eq (var 0 :int) (var 0 :int)" (eq (var 0 :int) (var 0 :int)))
  (show "eq (var 0 :int) (var 0 (:seq :int))" (eq (var 0 :int) (var 0 (sequence-type :int))))
  (show "equal (var 0 :int) (var 0 (:seq :int)) [same printed name X0]"
        (equal (var 0 :int) (var 0 (sequence-type :int))))
  (show "eq (lit :int 1) (lit :int 1)" (eq (lit :int 1) (lit :int 1)))
  (show "equal (lit :int 1) (lit :int 1)" (equal (lit :int 1) (lit :int 1)))
  (show "equal (lit :int 1) (lit (gf 5) 1)" (equal (lit :int 1) (lit (gf 5) 1)))
  (show "printed form of t1" (prin1-to-string t1))
  (show "type of t1 (lisp)" (type-of t1))
  (show "meta of t1" (ensure-ast-meta t1))
  (show "copy-tree t1 is an AST w/ rebuilt meta" (ast-kind (copy-tree t1)))
  (show "subterm sharing: (eq (second t1) (second t2))  [the var]" (eq (second t1) (second t2)))
  (show "subterm sharing: (eq (third t1) (third t2))  [the literal]" (eq (third t1) (third t2)))
  (show "sxhash equal for x0:int vs x0:(seq int)"
        (= (sxhash (var 0 :int)) (sxhash (var 0 (sequence-type :int)))))
  ;; sxhash quality on deep terms: build 2000 distinct terms differing only deep down.
  (let ((hashes (make-hash-table)) (n 2000))
    (dotimes (i n)
      (let ((deep (app (op :+ :int) (app (op :* :int) (app (op :+ :int) (app (op :* :int) x (lit :int i)) x) x) x)))
        (setf (gethash (sxhash deep) hashes) t)))
    (show "distinct sxhash values among 2000 terms differing at depth 4" (hash-table-count hashes)))
  (let ((hashes (make-hash-table)) (n 2000))
    (dotimes (i n)
      (let ((shallow (app (op :+ :int) x (lit :int i))))
        (setf (gethash (sxhash shallow) hashes) t)))
    (show "distinct sxhash values among 2000 terms differing at depth 1" (hash-table-count hashes))))

(format t "~&===== B. VM OUTCOMES =====~%")
(flet ((run (expr inputs values &optional (budget 1000000))
         (let ((e (evaluate expr inputs values :budget budget)))
           (list :status (evaluation-status e) :value (evaluation-value e)
                 :error (evaluation-error e) :work (evaluation-work e)
                 :tasks-left (length (evaluation-tasks e))))))
  (let* ((ins (list (cons 0 :int) (cons 1 :int)))
         (x (var 0 :int)) (y (var 1 :int))
         (div (term `(/ ,x ,y))))
    (show "(/ x y) on (6 3)" (run div ins '(6 3)))
    (show "(/ x y) on (6 0)  [crash]" (run div ins '(6 0)))
    (show "(/ x y) on (6 3) budget 3 [cutoff]" (run div ins '(6 3) 3))
    (show "(/ x y) on (:unresolved 3)" (run div ins '(:unresolved 3)))
    (show "(/ x y) on (6 3) with wrong type value" (run div ins '(6 (1 2))))
    (let ((*closure-evaluation* nil))
      (show "(/ x y) on (6 0) interpreted" (run div ins '(6 0)))
      (let ((e (evaluate div ins '(6 3) :budget 3)))
        (show "interpreted cutoff: status/tasks" (list (evaluation-status e) (evaluation-tasks e) (evaluation-stack e)))
        (advance-evaluation e 1000)
        (show "resumed after cutoff" (list (evaluation-status e) (evaluation-value e) (evaluation-work e))))))
  (let* ((seq (sequence-type :int))
         (ins (list (cons 0 seq) (cons 1 :int)))
         (xs (var 0 seq)) (i (var 1 :int)))
    (show "(tail xs) on ()" (run (term `(tail ,xs)) ins '(() 0)))
    (show "(at xs i) on ((5 6 7) 1)" (run (term `(at ,xs ,i)) ins '((5 6 7) 1)))
    (show "(at xs i) on ((5 6 7) 9)" (run (term `(at ,xs ,i)) ins '((5 6 7) 9)))
    (show "provably-total-p (at xs i)" (provably-total-p (term `(at ,xs ,i))))
    (show "provably-total-p (at xs 0)" (provably-total-p (term `(at ,xs 0))))
    (show "provably-total-p (if (< 0 (length xs)) (at xs 0) 0)"
          (provably-total-p (term `(if (< 0 (length ,xs)) (at ,xs 0) 0) :int)))
    (show "provably-total-p (if (< i (length xs)) (at xs i) 0)  [variable index guarded]"
          (provably-total-p (term `(if (< ,i (length ,xs)) (if (< -1 ,i) (at ,xs ,i) 0) 0) :int))))
  ;; Non-terminating definition.
  (with-knowledge-library ((make-knowledge-library))
    (let* ((ins (list (cons 0 :int)))
           (def (define-function :spin ins :int (lambda (self) (app self (var 0 :int))))))
      (show "define-function :spin total-p" (function-definition-total-p def))
      (show "run (spin 1) budget 5000" (run (term `(,(op :spin) 1)) nil nil 5000))
      (let ((e (evaluate (term `(,(op :spin) 1)) nil nil :budget 5000)))
        (show "task-list length after 5000 units of (spin 1) [no TCO => grows]" (length (evaluation-tasks e)))))
    (let* ((seq (sequence-type :int))
           (ins (list (cons 0 seq)))
           (def (define-function :sum ins :int
                  (lambda (self)
                    (term `(if (= ,(var 0 seq) ,(lit seq nil)) 0
                               (+ (at ,(var 0 seq) 0) (,self (tail ,(var 0 seq)))))
                          :int)))))
      (show "define-function :sum total-p" (function-definition-total-p def))
      (show "run (sum '(1 2 3))" (run (term `(,(op :sum) ,(lit seq '(1 2 3)))) nil nil)))))

(format t "~&===== C. INDICES =====~%")
(show "v1 has :iota?" (and (member :iota +operator-names+) t))
(show "number of primitives" (length +operator-names+))
(show "primitives" +operator-names+)
(let* ((seq (sequence-type :int))
       (src '(10 20 30 20))
       (z (var 9 seq))
       ;; parent frame: no inputs, target seq, single row requiring (20 10)
       (parent (make-frame (make-schema :inputs (list (cons 0 seq)) :target seq)
                           (list (make-row :key 0 :known (list src)
                                           :requirement (set-requirement seq (list '(20 10)))))))
       (decoder (term `(gather ,(var 0 seq) ,z)))
       (child (pullback-frame parent decoder 9 seq (identity-bindings (list (cons 0 seq))))))
  (show "child requirement after pullback through (gather x0 Z)" (row-requirement (first (frame-rows child))))
  (let ((folded (fold-constants (row-requirement (first (frame-rows child))) :contract :necessary)))
    (show "folded :necessary" folded)
    (show "extract-allowed-values of folded" (extract-allowed-values folded)))
  (show "check-requirement on Z=(1 0)" (let ((e (check-requirement (row-requirement (first (frame-rows child))) '(1 0) :type seq)))
                                         (list (evaluation-status e) (evaluation-value e))))
  (show "check-requirement on Z=(3 0)" (let ((e (check-requirement (row-requirement (first (frame-rows child))) '(3 0) :type seq)))
                                         (list (evaluation-status e) (evaluation-value e))))
  (show "check-requirement on Z=(7 0) [index out of range => crash]"
        (let ((e (check-requirement (row-requirement (first (frame-rows child))) '(7 0) :type seq)))
          (list (evaluation-status e) (evaluation-value e) (evaluation-error e)))))

(format t "~&===== D. RESIDUAL PRICES =====~%")
(show "correction 3->5 :int" (correction 3 5 :int))
(show "correction 3->3 :int" (correction 3 3 :int))
(show "correction 3->4 (gf 5)" (correction 3 4 (gf 5)))
(show "correction (1 2 3)->(1 2 4) seq int" (correction '(1 2 3) '(1 2 4) (sequence-type :int)))
(show "correction (1 2 3)->(1 2 3 9) seq int" (correction '(1 2 3) '(1 2 3 9) (sequence-type :int)))
(show "correction (1 t)->(2 t) tuple" (correction '(1 t) '(2 t) (tuple-type :int :bool)))
(show "correction with predicted-p nil" (correction nil 5 :int nil))
(show "value-bit-size 5 :int" (value-bit-size 5 :int))
(let* ((ins (list (cons 0 :int)))
       (ct (code-type ins :int))
       (a (term `(+ ,(var 0 :int) 1)))
       (b (term `(+ ,(var 0 :int) 2))))
  (show "correction code (+ x 1) -> (+ x 2)" (correction a b ct))
  (show "value-bit-size of code (+ x 2)" (value-bit-size b ct)))

(format t "~&===== E. OPCODE BITS =====~%")
(dolist (name '(:+ :if :at :code-eval :mod :lookup :gather :cons))
  (format t "~&  ~S name-bits=~D~%" name (operator-name-bit-size name)))
(show "description-size (+ x0 1) over ((0 . :int))" (description-size (term `(+ ,(var 0 :int) 1)) (list (cons 0 :int))))
(show "body-size (+ x0 1)" (body-size (term `(+ ,(var 0 :int) 1)) (list (cons 0 :int))))
