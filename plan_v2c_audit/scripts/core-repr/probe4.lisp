;;; probe4.lisp — v2 Stage-1 opcodes: index generation, lift, in-language AU, index pullback.
(load "/home/tlh24/lisploop/v2/load.lisp")
(in-package #:lisploop)

(defmacro show (label form)
  `(format t "~&~A~%   => ~S~%" ,label (handler-case (multiple-value-list ,form)
                                          (error (c) (list :HOST-ERROR (subseq (princ-to-string c) 0 (min 300 (length (princ-to-string c)))))))))

(defun run (expr &optional inputs values (budget 100000))
  (let ((e (evaluate expr inputs values :budget budget)))
    (list (evaluation-status e) (evaluation-value e) (evaluation-error e) (evaluation-work e))))

(handler-case
    (let* ((seq (sequence-type :int))
           (xs (var 0 seq))
           (ins (list (cons 0 seq)))
           (idx-code (code-type '((0 . :int)) :int)))
      ;; reverse via tabulate with code-subst closing over xs
      (let* ((rev-code-type (code-type (list (cons 0 :int) (cons 1 seq)) :int))
             (body (term `(at ,(var 1 seq) (- (- (length ,(var 1 seq)) 1) ,(var 0 :int)))))
             (subst (term `(code-subst ,(lit rev-code-type body)
                                       (tuple ,(lit idx-code (var 0 :int)) ,xs))
                          idx-code))
             (rev (app (op :tabulate :int) (term `(length ,xs)) subst)))
        (show "reverse via tabulate+code-subst on (5 6 7)" (run rev ins '((5 6 7))))
        (show "reverse on ()" (run rev ins '(())))
        (show "total-p of that reverse" (provably-total-p rev))
        (show "body-size of that reverse (bits)" (body-size rev ins))
        (show "closure available for reverse? (expression-closure)" (and (expression-closure rev ins) t)))
      (let* ((step (code-type (list (cons 0 :int) (cons 1 :int)) :int))
             (scan (app (op :evolve (tuple-type :int :int)) xs (lit :int 0)
                        (lit step (term `(+ ,(var 0 :int) ,(var 1 :int)))))))
        (show "prefix sums via (evolve xs 0 '(+ s a)) on (1 2 3 4)" (run scan ins '((1 2 3 4))))
        (show "total-p scan" (provably-total-p scan))
        (show "body-size scan" (body-size scan ins)))
      ;; in-language anti-unification
      (let* ((in (code-type '((0 . :int)) :int))
             (out (code-type '((0 . :int) (1 . :int)) :int))
             (a (lit in (term `(+ ,(var 0 :int) 1))))
             (b (lit in (term `(+ ,(var 0 :int) 2))))
             (au (app (op :code-anti-unify (tuple-type in out)) a b)))
        (show "(code-anti-unify '(+ x 1) '(+ x 2))" (run au))
        (show "total-p of code-anti-unify" (provably-total-p au)))
      (let* ((in (code-type '((0 . :int)) :int)))
        (show "(code-arity '(+ x 1))" (run (app (op :code-arity in) (lit in (term `(+ ,(var 0 :int) 1))))))
        (show "(code-quote 5)" (run (app (op :code-quote in) (lit :int 5))))
        (show "(code-value '5)" (run (app (op :code-value in) (lit in (lit :int 5)))))
        (show "(code-var 0)" (run (app (op :code-var in) (lit :int 0)))))
      ;; pullback through gather: the 'lifted index frame'
      (let* ((src '(10 20 30 20))
             (z (var 9 seq))
             (parent (make-frame (make-schema :inputs (list (cons 0 seq)) :target seq)
                                 (list (make-row :key 0 :known (list src)
                                                 :requirement (set-requirement seq (list '(20 10)))))))
             (decoder (term `(gather ,(var 0 seq) ,z)))
             (child (pullback-frame parent decoder 9 seq (identity-bindings (list (cons 0 seq)))))
             (folded (fold-constants (row-requirement (first (frame-rows child))) :contract :necessary)))
        (show "v2: folded child requirement through (gather x0 Z)" folded)
        (show "v2: extract-allowed-values" (extract-allowed-values folded)))
      ;; pullback through tabulate: requirement on a code-valued child
      (let* ((fz (var 9 idx-code))
             (parent (make-frame (make-schema :inputs nil :target seq)
                                 (list (make-row :key 0 :known nil
                                                 :requirement (set-requirement seq (list '(0 1 4 9)))))))
             (decoder (app (op :tabulate :int) (lit :int 4) fz)))
        (multiple-value-bind (lifted coupled reserve) (lift-frame parent decoder 9 idx-code)
          (show "v2: lift-frame through (tabulate 4 F): child schema inputs/target"
                (list (schema-inputs (frame-schema lifted)) (schema-target (frame-schema lifted))))
          (show "v2: lifted rows (key known requirement)"
                (mapcar (lambda (r) (list (row-key r) (row-known r) (row-requirement r))) (frame-rows lifted)))
          (show "coupled / reserve" (list coupled reserve)))))
  (error (c) (format t "~&TOP-LEVEL ERROR: ~A~%" c)))
