;;; probe2.lisp — (a) equal-hash scaling on ASTs (v1), (b) v2 Stage-1 opcodes.
;;; Usage: sbcl --script probe2.lisp <root-dir> [v2]
(defvar *root* (or (second sb-ext:*posix-argv*) "/home/tlh24/lisploop/"))
(defvar cl-user::*v2p* (third sb-ext:*posix-argv*))
(load (concatenate 'string *root* "load.lisp"))
(in-package #:lisploop)

(defmacro show (label form)
  `(format t "~&~A~%   => ~S~%" ,label (handler-case (multiple-value-list ,form)
                                          (error (c) (list :HOST-ERROR (princ-to-string c))))))

(format t "~&===== EQUAL-HASH SCALING ON ASTs =====~%")
(let ((x (var 0 :int)))
  (dolist (n '(1000 2000 4000 8000))
    (let* ((terms (loop for i below n collect (app (op :+ :int) (app (op :* :int) x (lit :int i)) x)))
           (table (make-hash-table :test #'equal))
           (start (get-internal-real-time)))
      (dolist (term terms) (setf (gethash term table) t))
      (dolist (term terms) (gethash term table))
      (format t "~&  n=~5D distinct terms, equal-table insert+lookup: ~6D ms~%" n
              (round (* 1000 (- (get-internal-real-time) start)) internal-time-units-per-second))))
  ;; Compare: same keys via their portable printed form (a string hashes fully).
  (dolist (n '(1000 8000))
    (let* ((terms (loop for i below n collect (app (op :+ :int) (app (op :* :int) x (lit :int i)) x)))
           (table (make-hash-table :test #'equal))
           (start (get-internal-real-time)))
      (dolist (term terms) (setf (gethash (prin1-to-string (ast->sexp term)) table) t))
      (format t "~&  n=~5D string-keyed table insert: ~6D ms~%" n
              (round (* 1000 (- (get-internal-real-time) start)) internal-time-units-per-second)))))

(format t "~&===== repeated-subterms / anti-unify cost on a wide term =====~%")
(let* ((x (var 0 :int)))
  (dolist (n '(200 400 800 1600))
    (let* ((big (reduce (lambda (acc i) (app (op :+ :int) acc (app (op :* :int) x (lit :int i))))
                        (loop for i from 1 to n collect i) :initial-value x))
           (start (get-internal-real-time)))
      (repeated-subterms big)
      (format t "~&  repeated-subterms on left-nested sum of ~4D products: ~6D ms~%" n
              (round (* 1000 (- (get-internal-real-time) start)) internal-time-units-per-second)))))

(when cl-user::*v2p*
  (format t "~&===== V2 STAGE-1 OPCODES =====~%")
  (show "primitives" +operator-names+)
  (show "count" (length +operator-names+))
  (flet ((run (expr &optional inputs values (budget 100000))
           (let ((e (evaluate expr inputs values :budget budget)))
             (list (evaluation-status e) (evaluation-value e) (evaluation-error e) (evaluation-work e)))))
    (let* ((seq (sequence-type :int))
           (xs (var 0 seq))
           (ins (list (cons 0 seq)))
           (idx-code (code-type '((0 . :int)) :int)))
      (show "(iota 4)" (run (term `(iota 4))))
      (show "(iota (length xs)) on (5 6 7)" (run (term `(iota (length ,xs))) ins '((5 6 7))))
      (show "(gather xs (iota (length xs)))" (run (term `(gather ,xs (iota (length ,xs)))) ins '((5 6 7))))
      (show "total-p (gather xs (iota (length xs)))" (provably-total-p (term `(gather ,xs (iota (length ,xs))))))
      (show "(where 6 xs)" (run (term `(where 6 ,xs)) ins '((5 6 7 6))))
      (show "(tabulate 4 '(* j j))"
            (run (term `(tabulate 4 ,(lit idx-code (term `(* ,(var 0 :int) ,(var 0 :int))))))))
      ;; reverse via tabulate with code-subst closing over xs: index array computed, used to access data
      (let* ((rev-code-type (code-type (list (cons 0 :int) (cons 1 seq)) :int))
             (body (term `(at ,(var 1 seq) (- (- (length ,(var 1 seq)) 1) ,(var 0 :int)))))
             (rev (term `(tabulate (length ,xs)
                                   (code-subst ,(lit rev-code-type body)
                                               (tuple ,(lit idx-code (var 0 :int)) ,xs))))))
        (show "reverse via tabulate+code-subst on (5 6 7)" (run rev ins '((5 6 7))))
        (show "total-p of that reverse" (provably-total-p rev))
        (show "body-size of that reverse" (body-size rev ins)))
      (let* ((step (code-type (list (cons 0 :int) (cons 1 :int)) :int))
             (scan (term `(evolve ,xs 0 ,(lit step (term `(+ ,(var 0 :int) ,(var 1 :int))))))))
        (show "prefix sums via (evolve xs 0 '(+ s a)) on (1 2 3 4)" (run scan ins '((1 2 3 4))))
        (show "total-p scan" (provably-total-p scan)))
      ;; in-language anti-unification
      (let* ((in (code-type '((0 . :int)) :int))
             (out (code-type '((0 . :int) (1 . :int)) :int))
             (a (lit in (term `(+ ,(var 0 :int) 1))))
             (b (lit in (term `(+ ,(var 0 :int) 2))))
             (au (term `(code-anti-unify ,a ,b) out)))
        (show "(code-anti-unify '(+ x 1) '(+ x 2))" (run au))
        (show "total-p of code-anti-unify" (provably-total-p au)))
      ;; pullback through gather: the 'lifted index frame'
      (let* ((src '(10 20 30 20))
             (z (var 9 seq))
             (parent (make-frame (make-schema :inputs (list (cons 0 seq)) :target seq)
                                 (list (make-row :key 0 :known (list src)
                                                 :requirement (set-requirement seq (list '(20 10)))))))
             (decoder (term `(gather ,(var 0 seq) ,z)))
             (child (pullback-frame parent decoder 9 seq (identity-bindings (list (cons 0 seq)))))
             (folded (fold-constants (row-requirement (first (frame-rows child))) :contract :necessary)))
        (show "v2: folded child requirement through (gather x0 Z)" folded)
        (show "v2: extract-allowed-values" (extract-allowed-values folded))))))
