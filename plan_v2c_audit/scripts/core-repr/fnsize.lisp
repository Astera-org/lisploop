;;; fnsize.lisp — per-defun LOC and branch counts for kernel files (reads, does not load them).
(defpackage :scratch (:use :cl))
(in-package :scratch)
(defparameter *branchers* '("COND" "CASE" "ECASE" "TYPECASE" "IF" "WHEN" "UNLESS"))
(defun count-branches (form)
  ;; cond clauses + case clauses + if/when/unless count 1 each
  (cond ((atom form) 0)
        (t (let ((head (car form)) (n 0))
             (when (symbolp head)
               (let ((name (symbol-name head)))
                 (cond ((string= name "COND") (incf n (max 0 (1- (ignore-errors (list-length (cdr form)))))) (incf n))
                       ((member name '("CASE" "ECASE" "TYPECASE") :test #'string=)
                        (incf n (max 1 (1- (or (ignore-errors (list-length (cddr form))) 1)))))
                       ((member name '("IF" "WHEN" "UNLESS") :test #'string=) (incf n)))))
             (loop for sub on form
                   do (incf n (count-branches (car sub)))
                   while (consp (cdr sub)))
             n))))
(defun depth (form) (if (atom form) 0 (1+ (loop for sub on form maximize (depth (car sub)) while (consp (cdr sub))))))
(defun scan (path)
  (with-open-file (in path)
    (let ((*package* (find-package :scratch)) (results nil))
      (loop
        (let* ((start (progn (peek-char t in nil nil) (file-position in)))
               (form (handler-case (read in nil :eof) (error () :eof))))
          (when (eq form :eof) (return))
          (when (and (consp form) (symbolp (car form))
                     (member (symbol-name (car form)) '("DEFUN" "DEFMACRO") :test #'string=))
            (let ((end (file-position in)))
              (push (list (second form) start end (count-branches form) (depth form)) results)))))
      ;; convert char positions to line numbers
      (let ((text (with-open-file (in2 path) (let ((s (make-string (file-length in2)))) (subseq s 0 (read-sequence s in2))))))
        (flet ((line-of (pos) (1+ (count #\Newline text :end (min pos (length text))))))
          (mapcar (lambda (r) (destructuring-bind (name start end branches depth) r
                                (list name (line-of start) (line-of end) (1+ (- (line-of end) (line-of start))) branches depth)))
                  (nreverse results)))))))
(dolist (file (cdr sb-ext:*posix-argv*))
  (let* ((rows (scan file))
         (sorted (sort (copy-list rows) #'> :key #'fourth)))
    (format t "~&==== ~A: ~D defuns, ~D lines in defuns~%" file (length rows) (reduce #'+ rows :key #'fourth))
    (format t "  top by LOC:~%")
    (loop for (name start end loc branches depth) in (subseq sorted 0 (min 14 (length sorted)))
          do (format t "   ~40A L~4D-~4D  loc=~3D branches=~3D depth=~2D~%" name start end loc branches depth))
    (format t "  top by branches:~%")
    (loop for (name start end loc branches depth) in (subseq (sort (copy-list rows) #'> :key #'fifth) 0 (min 10 (length rows)))
          do (format t "   ~40A L~4D-~4D  loc=~3D branches=~3D depth=~2D~%" name start end loc branches depth))))
