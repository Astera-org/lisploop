;;; Read-only experiment 2: solver discovery traces (milestone path and battery/spec path),
;;; and how the observational enumerator scales with the description bound.
(load "/home/tlh24/lisploop/load.lisp")
(load "/home/tlh24/lisploop/milestones/load.lisp")
(in-package #:lisploop)

(defun ticks () (get-internal-real-time))
(defun secs (t0) (/ (float (- (get-internal-real-time) t0) 1d0) internal-time-units-per-second))

(defun short (ast)
  (labels ((p (x)
             (case (ast-kind x)
               (:var (format nil "x~D" (ast-id x)))
               (:lit (format nil "~S" (ast-value x)))
               (:app (format nil "(~(~A~)~{ ~A~})" (operator-name (first x)) (mapcar #'p (rest x))))
               (t (format nil "~S" x)))))
    (if ast (p ast) "NIL")))

(format t "~&===== C. Milestone path: observe-arithmetic-relation + discover-arithmetic-solver =====~%")
(dolist (domain (list (gf 5) (gf 7) :int))
  (let ((values (if (eq domain :int) '(-4 -3 -2 -1 0 1 2 3 4) (loop for i below (second domain) collect i))))
    (dolist (name '(:+ :* :/))
      (let* ((t0 (ticks))
             (relation (observe-arithmetic-relation domain name values))
             (t-rel (secs t0)))
        (dolist (position '(0 1))
          (let* ((t1 (ticks))
                 (discovery (discover-arithmetic-solver relation position values
                                                        :literals (if (eq domain :int) '(-1 0 1) :all)))
                 (t-disc (secs t1))
                 (obs (solve-discovery-observations discovery))
                 (t2 (ticks)))
            (if (eq domain :int)
                (validate-arithmetic-solver discovery)   ; samples = the frame rows / records
                (validate-arithmetic-solver discovery))
            (format t "~&~S ~S pos=~D: forward-guard=~A~%   witness=~A~%   guard=~A~%   candidates-enumerated=~D rows=~D discovery-ledger=~D obs-ledger=~D wall: relation=~,3Fs discover=~,3Fs validate=~,3Fs~%   witness-law=~S (assignments ~S active ~S) uniqueness-law=~S certified=~S~%"
                    domain name position (short (arithmetic-relation-guard relation))
                    (short (solve-discovery-witness discovery))
                    (short (solve-discovery-guard discovery))
                    (length (observation-job-records obs))
                    (length (frame-rows (solve-discovery-frame discovery)))
                    (ledger-total (solve-discovery-ledger discovery))
                    (ledger-total (observation-job-ledger obs))
                    t-rel t-disc (secs t2)
                    (law-validation-status (solve-discovery-validation discovery))
                    (law-validation-count (solve-discovery-validation discovery))
                    (law-validation-active (solve-discovery-validation discovery))
                    (law-validation-status (solve-discovery-uniqueness discovery))
                    (certified-solve-discovery-p discovery))))))))

(format t "~&===== D. Battery path: induce-conditional-solver from :spec rows (build-batteries.lisp:181-248) =====~%")
(let ((lib (make-knowledge-library)) (ledger (make-ledger))
      (*battery-directory* #P"/home/tlh24/lisploop/v2/library/"))
  (with-knowledge-library (lib)
    (load-battery :algebra :library lib :ledger ledger)
    (format t "algebra battery loaded: ~D laws; rewrite library for :int = ~S~%"
            (length (knowledge-entries-of-kind :law lib))
            (let ((r (as-rewrite-library lib :domain :int)))
              (and r (mapcar (lambda (rule) (format nil "~A -> ~A" (short (rewrite-rule-pattern rule)) (short (rewrite-rule-replacement rule))))
                             (rewrite-library-rules r)))))
    (let ((inps '((0 . :int) (1 . :int))))
      (dolist (case (list (list :+ 1 '(((2 5) 3) ((4 1) -3) ((-3 7) 10)) nil)
                          (list :* 1 '(((3 12) 4) ((-2 6) -3) ((5 0) 0) ((0 5) :none) ((0 0) :none)) t)
                          (list :/ 1 '(((12 4) 3) ((15 3) 5) ((-12 3) -4) ((0 4) :none) ((12 0) :none) ((0 0) :none)) t)))
        (destructuring-bind (name pos rows finite-unique) case
          (let* ((sid (keyword-id "X-SOLVE-~A-~D" name pos))
                 (spec (register-knowledge-spec (keyword-id "SPEC/~A" sid) inps :int rows
                                                :target-id sid :target-kind :solver
                                                :metadata (list :inverts (ast->sexp (op name :int)) :position pos
                                                                :unique-p nil :finite-unique-p finite-unique :certified-p nil)
                                                :library lib :ledger ledger))
                 (l2 (make-ledger))
                 (t0 (ticks))
                 (solver (first (induce-conditional-solvers (list spec) :library lib :ledger l2))))
            (format t "~&spec ~S pos ~D rows=~D -> witness=~A guard=~A aux=~A ledger=~D wall=~,3Fs~%   cert-method=~S obligations=~S status=~S unique-p=~S~%"
                    name pos (length rows) (short (knowledge-entry-expression solver))
                    (short (knowledge-entry-guard solver)) (short (knowledge-entry-auxiliary-code solver))
                    (ledger-total l2) (secs t0)
                    (getf (knowledge-entry-certificate solver) :method)
                    (getf (knowledge-entry-certificate solver) :obligations)
                    (knowledge-entry-status solver)
                    (getf (knowledge-entry-metadata solver) :unique-p)))))
      (let* ((l3 (make-ledger)) (t0 (ticks))
             (added (induce-law-solvers lib :ledger l3)))
        (format t "~&induce-law-solvers: added=~D ledger=~D wall=~,3Fs~%" (length added) (ledger-total l3) (secs t0))
        (dolist (s (knowledge-entries-of-kind :solver lib))
          (format t "   ~S: witness=~A cert=~S ~S current(witness/uniq)=~S/~S~%" (knowledge-entry-id s)
                  (short (knowledge-entry-expression s))
                  (getf (knowledge-entry-certificate s) :method)
                  (getf (knowledge-entry-certificate s) :obligations)
                  (knowledge-evidence-current-p s :witness)
                  (knowledge-evidence-current-p s :uniqueness)))))))

(format t "~&===== E. Scaling of exhaustive observational enumeration with the body bound =====~%")
(dolist (cfg (list (list (gf 5) 2 '(:+ :*)) (list (gf 5) 3 '(:+ :*)) (list (gf 5) 3 '(:+ :* :-)) (list (gf 7) 3 '(:+ :* :- :/))))
  (destructuring-bind (domain nvars ops) cfg
    (let* ((inputs (loop for i below nvars collect (cons i domain)))
           (rows (loop for i below (finite-type-cardinality (inputs-tuple-type inputs))
                       collect (law-assignment inputs i))))
      (dolist (slack '(24 34 44 54))
        (let* ((obs (start-observation-search
                     (make-observation-scope (probe-frame domain inputs rows)
                                             (make-language domain inputs
                                                            :operators (mapcar (lambda (n) (op n domain)) ops)
                                                            :literals nil))))
               (t0 (ticks))
               (msg (resume-observation-search obs (header-bound inputs domain slack) 3000000000))
               (dt (secs t0))
               (records (observation-job-records obs))
               (buckets (observation-job-buckets obs)))
          (format t "~&~S vars=~D ops=~S slack=~D: claim=~S exprs=~D complete=~D error=~D buckets=~D laws(spanning)=~D work=~D wall=~,2Fs~%"
                  domain nvars ops slack (message-claim msg) (length records)
                  (count :complete records :key #'observed-expression-status)
                  (count :error records :key #'observed-expression-status)
                  (length buckets)
                  (loop for b in buckets sum (1- (length (observation-bucket-members b))))
                  (ledger-total (observation-job-ledger obs)) dt)
          (finish-output)
          (when (> dt 150) (return)))))))
