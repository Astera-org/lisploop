;;; Read-only experiment: replicate bootstrap/build-batteries.lisp section 1b (observational law
;;; discovery over GF(3), retype to :int) with instrumentation; nothing is written to the repo.
(load "/home/tlh24/lisploop/load.lisp")
(in-package #:lisploop)

(defun now () (/ (get-internal-real-time) internal-time-units-per-second 1.0))

(defun show-law (law)
  (let ((e (knowledge-entry-expression law)))
    (format nil "~S = ~S" (ast->sexp (second e)) (ast->sexp (third e)))))

(defun short (ast)
  "Compact printer."
  (labels ((p (x)
             (case (ast-kind x)
               (:var (format nil "x~D" (ast-id x)))
               (:lit (format nil "~S" (ast-value x)))
               (:app (format nil "(~(~A~)~{ ~A~})" (operator-name (first x)) (mapcar #'p (rest x))))
               (t (format nil "~S" x)))))
    (p ast)))

(defun law-str (law)
  (let ((e (knowledge-entry-expression law)))
    (format nil "~A = ~A" (short (second e)) (short (third e)))))

(defun run-obs (name domain inputs ops literals slack work)
  (let* ((rows (loop for i below (finite-type-cardinality (inputs-tuple-type inputs))
                     collect (law-assignment inputs i)))
         (obs (start-observation-search
               (make-observation-scope (probe-frame domain inputs rows)
                                       (make-language domain inputs
                                                      :operators (mapcar (lambda (n) (op n domain)) ops)
                                                      :literals literals))))
         (t0 (now))
         (msg (resume-observation-search obs (header-bound inputs domain slack) work))
         (dt (- (now) t0))
         (records (observation-job-records obs))
         (buckets (observation-job-buckets obs))
         (laws (propose-observed-laws obs))
         (facts (remove-if-not #'law-operator-fact laws)))
    (format t "~&[~A] claim=~S rows=~D slack=~D work=~D (limit ~D) wall=~,3Fs~%   enumerated(target-type records)=~D complete=~D buckets=~D multi-member-buckets=~D~%   proposed-laws(spanning)=~D pass-law-operator-fact=~D~%"
            name (message-claim msg) (length rows) slack (ledger-total (observation-job-ledger obs)) work dt
            (length records)
            (count :complete records :key #'observed-expression-status)
            (length buckets)
            (count-if (lambda (b) (rest (observation-bucket-members b))) buckets)
            (length laws) (length facts))
    (values obs laws facts)))

(defun validate-all (laws)
  (let ((ok 0) (ref 0) (work 0))
    (dolist (law laws)
      (let ((val (resume-law-validation (start-law-validation law) 100000)))
        (incf work (ledger-total (law-validation-ledger val)))
        (case (law-validation-status val) (:validated (incf ok)) (:refuted (incf ref)))))
    (values ok ref work)))

(format t "~&===== A. The battery's own four observation jobs (bootstrap/build-batteries.lisp:120-150) =====~%")
(let* ((gf3 (gf 3))
       (in1 (list (cons 0 gf3)))
       (in2 (list (cons 0 gf3) (cons 1 gf3)))
       (in3 (list (cons 0 gf3) (cons 1 gf3) (cons 2 gf3)))
       (all-laws nil) (all-facts nil))
  (dolist (spec (list (list "obs1 1var {+,*} lits(0 1)" in1 '(:+ :*) '(0 1) 20 20000)
                      (list "obs2 2var {+,*} no-lits" in2 '(:+ :*) nil 24 40000)
                      (list "obs3+ 3var {+}" in3 '(:+) nil 44 80000)
                      (list "obs3* 3var {*}" in3 '(:*) nil 44 80000)))
    (destructuring-bind (name inputs ops lits slack work) spec
      (multiple-value-bind (obs laws facts) (run-obs name gf3 inputs ops lits slack work)
        (declare (ignore obs))
        (multiple-value-bind (ok ref vwork) (validate-all laws)
          (format t "   exhaustive GF(3) validation of ALL proposed: validated=~D refuted=~D work=~D~%" ok ref vwork))
        (format t "   proposed laws:~%")
        (dolist (law laws)
          (format t "     ~:[  ~;F ~] ~A   ~@[fact=~S~]~%" (law-operator-fact law) (law-str law) (law-operator-fact law)))
        (setf all-laws (append all-laws laws) all-facts (append all-facts facts)))))
  (format t "~&TOTAL proposed=~D kept-by-shape-filter=~D~%" (length all-laws) (length all-facts))
  ;; Transfer to :int exactly as the battery does.
  (format t "~&--- retype to :int and sample on residues (-3 -1 0 1 2 5) ---~%")
  (dolist (law all-facts)
    (let* ((val0 (resume-law-validation (start-law-validation law) 100000))
           (retyped (retype-law (law-validation-law val0) :int))
           (samples (residue-assignments (mapcar #'cdr (knowledge-entry-inputs retyped)) '(-3 -1 0 1 2 5)))
           (val (validate-law retyped 100000 t samples)))
      (format t "   ~A  GF3:~S assignments=~D work=~D | INT:~S samples=~D work=~D method=~S current=~S tested=~S~%"
              (law-str law) (law-validation-status val0)
              (getf (law-validation-certificate val0) :assignments)
              (ledger-total (law-validation-ledger val0))
              (law-validation-status val) (length samples)
              (ledger-total (law-validation-ledger val))
              (getf (knowledge-entry-certificate (law-validation-law val)) :method)
              (knowledge-evidence-current-p (law-validation-law val) :equivalence)
              (knowledge-evidence-tested-p (law-validation-law val) :equivalence))))
  ;; What happens to the GF(3) laws the shape filter throws away when retyped to :int?
  (format t "~&--- fate under :int sampling of the laws the shape filter DISCARDS ---~%")
  (let ((survive 0) (refuted 0) (err 0))
    (dolist (law (set-difference all-laws all-facts))
      (let ((retyped (ignore-errors (retype-law law :int))))
        (if (null retyped)
            (incf err)
            (let* ((samples (residue-assignments (mapcar #'cdr (knowledge-entry-inputs retyped)) '(-3 -1 0 1 2 5)))
                   (val (validate-law retyped 100000 t samples)))
              (case (law-validation-status val)
                (:conjecture (incf survive) (format t "     INT-survives: ~A~%" (law-str retyped)))
                (:refuted (incf refuted) (format t "     INT-refuted : ~A  cx=~S~%" (law-str retyped)
                                                 (getf (law-validation-counterexample val) :inputs))))))))
    (format t "   discarded laws: survive-on-int=~D refuted-on-int=~D retype-error=~D~%" survive refuted err)))

(format t "~&===== B. Is distributivity reachable?  3 vars, {+,*}, no literals, GF(3) and GF(5) =====~%")
(dolist (p '(3 5))
  (let* ((d (gf p))
         (in3 (list (cons 0 d) (cons 1 d) (cons 2 d)))
         (a (var 0 d)) (b (var 1 d)) (c (var 2 d))
         (lhs (term `(* ,a (+ ,b ,c))))
         (rhs (term `(+ (* ,a ,b) (* ,a ,c))))
         (need (max (body-size lhs in3) (body-size rhs in3))))
    (format t "~&GF(~D): body bits lhs=~D rhs=~D; header=~D~%" p (body-size lhs in3) (body-size rhs in3) (header-size in3 d))
    (dolist (work '(80000 2000000 50000000))
      (multiple-value-bind (obs laws facts) (run-obs (format nil "dist GF(~D) work-limit ~D" p work) d in3 '(:+ :*) nil need work)
        (declare (ignore facts))
        (let* ((l (find-observation obs lhs)) (r (find-observation obs rhs)))
          (format t "   lhs observed=~S rhs observed=~S same-bucket=~S~%"
                  (not (null l)) (not (null r)) (and l r (observed-agreement-p l r)))
          (when (and l r (observed-agreement-p l r))
            (let ((bucket (find-if (lambda (bk) (member l (observation-bucket-members bk))) (observation-job-buckets obs))))
              (format t "   bucket of a*(b+c) has ~D members; representative(first)=~A~%"
                      (length (observation-bucket-members bucket))
                      (short (observed-expression-expression (car (last (observation-bucket-members bucket))))))))
          (format t "   laws proposed=~D~%" (length laws)))))))
