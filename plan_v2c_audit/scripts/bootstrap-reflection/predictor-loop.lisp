;;;; Does the kernel's existing cross-job reflective loop (search-trace frame -> condensed
;;;; priority predictor -> node-priority) change the cost of its own bootstrap curriculum?
(defvar *args* (cdr (member "--" sb-ext:*posix-argv* :test #'string=)))
(defvar *v2-root* (pathname (concatenate 'string (first *args*) "/")))
(load (merge-pathnames "load.lisp" *v2-root*))
(load (merge-pathnames "bootstrap/recursion-schemas.lisp" *v2-root*))
(load (merge-pathnames "tests/support.lisp" *v2-root*))
(in-package #:lisploop)
(setf *print-pretty* nil)
(with-open-file (s (merge-pathnames "experiments/stage0-audit.lisp" cl-user::*v2-root*))
  (let ((*package* (find-package :lisploop)))
    (loop for form = (read s nil :eof) until (eq form :eof)
          do (when (and (consp form) (eq 'defun (first form))
                        (member (second form) '(collect-bootstrap-function-specs held-out-test-cases)))
               (eval form)))))

(defun run-curriculum (predictor)
  "Run the 16 function specs in curriculum order in one library; return ((id work job) ...)."
  (let ((out nil))
    (with-clean-kernel-state
      (dolist (item (collect-bootstrap-function-specs))
        (let* ((id (getf item :id)) (bname (getf item :battery)) (spec (getf item :spec))
               (meta (knowledge-entry-metadata spec))
               (inputs (knowledge-entry-inputs spec)) (target (knowledge-entry-target spec)))
          (when (and (eq id :foldl) (not (defined-function-p :map)))
            (load-battery :sequences :only '(:map :foldr) :check-examples-p nil))
          (let* ((frame (spec-entry-frame spec))
                 (lang (make-language :int inputs :operators (mapcar #'sexp->ast (getf meta :operators))
                                                  :literals (getf meta :literals)
                                                  :constants (mapcar #'sexp->ast (getf meta :constants))))
                 (bound (if (eq bname :seed-corpus) 90 130))
                 (keys (append (list :max-depth 2 :expanders (list (recursion-schema-expander)))
                               (when predictor (list :priority-predictor predictor))))
                 (job (if (eq id :argmax-corr)
                          (apply #'start-heuristic-synthesis frame lang bound keys)
                          (apply #'start-recursive-synthesis frame lang bound :self-name id
                                 :heuristic-budget 15000 keys))))
            (resume-synthesis job 350000 :stop-on-first t)
            (when (synthesis-job-best job) (commit-synthesis-job job :name id))
            (push (list id (ledger-total (synthesis-job-ledger job)) job (not (null (synthesis-job-best job)))) out)))))
    (nreverse out)))

(let* ((base (run-curriculum nil))
       (jobs (mapcar #'third base))
       (ledger (make-ledger))
       (trace (make-search-trace-frame jobs :ledger ledger)))
  (format t "~&baseline: ~D jobs, ~D nodes in total, ~D messages, ~D scheduling-trace entries, total work ~:D~%"
          (length jobs) (reduce #'+ jobs :key (lambda (j) (length (synthesis-job-nodes j))))
          (reduce #'+ jobs :key (lambda (j) (length (synthesis-job-messages j))))
          (reduce #'+ jobs :key (lambda (j) (length (synthesis-job-trace j))))
          (reduce #'+ base :key #'second))
  (format t "search-trace frame: ~D rows over 6 integer features -> clamped residual~%" (length (frame-rows trace)))
  (dolist (r (frame-rows trace))
    (format t "   features=~S target=~S~%" (row-known r) (row-singleton-value r)))
  (multiple-value-bind (fn model) (condense-search-heuristic trace :ledger ledger)
    (declare (ignore fn))
    (format t "condensed predictor: ~S~%   program-bits=~A residual-bits=~A exact=~A; condensation work=~:D~%"
            (and model (ast->sexp (heuristic-program model)))
            (and model (heuristic-program-bits model)) (and model (heuristic-residual-bits model))
            (and model (heuristic-exact-p model)) (ledger-total ledger))
    (when model
      (let ((with (run-curriculum model)))
        (format t "~&~14A ~12A ~12A ~8A~%" "spec" "work(base)" "work(pred)" "ratio")
        (loop for (id w nil ok) in base for (nil w2 nil ok2) in with
              do (format t "~14A ~12:D ~12:D ~8,3F ~A~%" id w w2 (/ w2 (max 1 w)) (if (eq ok ok2) "" "  <-- solved status changed")))
        (format t "TOTAL          ~12:D ~12:D ~8,3F~%" (reduce #'+ base :key #'second) (reduce #'+ with :key #'second)
                (/ (reduce #'+ with :key #'second) (reduce #'+ base :key #'second)))))))
