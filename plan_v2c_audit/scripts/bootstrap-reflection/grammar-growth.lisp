;;;; Flat-grammar library growth: the same specs under the "active library grammar" (every active
;;;; library function is an operator) as the loaded library grows. (scratch copy)
(defvar *args* (cdr (member "--" sb-ext:*posix-argv* :test #'string=)))
(defvar *v2-root* (pathname (concatenate 'string (first *args*) "/")))
(load (merge-pathnames "load.lisp" *v2-root*))
(load (merge-pathnames "bootstrap/recursion-schemas.lisp" *v2-root*))
(load (merge-pathnames "tests/support.lisp" *v2-root*))
(in-package #:lisploop)
(setf *print-pretty* nil)
(defun run (id battery preload label budget)
  (with-clean-kernel-state
    (funcall preload)
    (let* ((src (deserialize-knowledge-library (read-battery battery)))
           (spec (find-knowledge-entry (keyword-id "SPEC/~A" id) src))
           (meta (knowledge-entry-metadata spec))
           (inputs (knowledge-entry-inputs spec)) (target (knowledge-entry-target spec))
           (rows (with-knowledge-library (src) (spec-entry-rows spec)))
           (ops (active-library-spec-operators :int inputs target *knowledge-library* id))
           (lang (make-language :int inputs :operators ops
                                            :literals (remove-duplicates (append '(0 1 2) (getf meta :literals)))
                                            :constants (mapcar #'sexp->ast (getf meta :constants))))
           (job (start-recursive-synthesis (simple-frame target inputs rows) lang 154 :self-name id :max-depth 2
                                           :heuristic-budget 15000)))
      (resume-synthesis job budget :stop-on-first t)
      (format t "~&~10A library=~28A operators-in-grammar=~2D (library fns ~2D) -> ~6A work=~10:D~%"
              id label (length ops)
              (count-if (lambda (o) (defined-function-p (operator-name o))) ops)
              (if (synthesis-job-best job) "solved" "no") (ledger-total (synthesis-job-ledger job)))
      (finish-output))))
(defun seeds ()
  ;; six trivial first-order functions standing in for the seed corpus
  (let ((s (sequence-type :int)))
    (loop for (name ret body) in `((:copy ,s ,(var 0 s)) (:inc-all ,s ,(var 0 s)) (:dbl-all ,s ,(var 0 s))
                                   (:sum-all :int ,(lit :int 0)) (:len-all :int ,(term `(length ,(var 0 s)))) (:prd-all :int ,(lit :int 1)))
          do (define-function name (list (cons 0 s)) ret body))))
(dolist (spec '((:seq-corr :sequence-shift) (:filter :sequences) (:last-or :sequence-shift)))
  (destructuring-bind (id battery) spec
    (dolist (budget '(3500000))
      (run id battery (lambda ()) "empty" budget)
      (run id battery (lambda () (load-battery :sequences :only '(:map :foldr) :check-examples-p nil)) "map,foldr" budget)
      (run id battery (lambda () (load-battery :sequences :only (remove id '(:map :foldr :foldl :filter :map-adjacent :positions)) :check-examples-p nil))
           "sequences battery" budget)
      (run id battery (lambda () (load-battery :sequences :only (remove id '(:map :foldr :foldl :filter :map-adjacent :positions)) :check-examples-p nil)
                        (load-battery :scans :check-examples-p nil) (seeds))
           "sequences+scans+6 seeds" budget))))
