;;;; For every synthesis job of the bootstrap: how many bits of the answer were enumerated in a
;;;; leaf search versus supplied by the decoder skeleton(s) on the winning path. (scratch copy)
(defvar *root* (pathname (concatenate 'string (car (last sb-ext:*posix-argv*)) "/")))
(load (merge-pathnames "load.lisp" *root*))
(load (merge-pathnames "bootstrap/recursion-schemas.lisp" *root*))
(in-package #:lisploop)
(setf *print-pretty* nil)

(defun pp (x)
  (cond ((and (lit-p x) (code-type-p (ast-type x))) (list :code (pp (ast-value x))))
        ((lit-p x) (list 'quote (ast-value x)))
        ((var-p x) (intern (format nil "X~D" (ast-id x))))
        ((app-p x) (cons (if (operator-p (first x)) (operator-name (first x)) (pp (first x)))
                         (mapcar #'pp (rest x))))
        ((ignore-errors (eq :hole (ast-kind x))) (intern (format nil "?~D" (ast-id x))))
        (t x)))
(defun atoms (x) (cond ((null x) 0) ((atom x) 1) (t (+ (atoms (car x)) (atoms (cdr x))))))

(defvar *rows* nil)
(sb-int:encapsulate
 'resume-synthesis 'audit
 (lambda (fn job work-limit &rest keys)
   (prog1 (apply fn job work-limit keys)
     (let* ((best (synthesis-job-best job))
            (win (job-winning-node job))
            (root-frame (synthesis-node-frame (synthesis-job-root job)))
            (root-inputs (schema-inputs (frame-schema root-frame))))
       (when (and best win)
         (let* ((child-msg (find-if (lambda (m) (and (eq :child-candidate (message-claim m))
                                                     (eql (message-call-id m) (synthesis-node-id win))))
                                    (synthesis-job-messages job)))
                (child-cand (and child-msg (getf (message-evidence child-msg) :candidate)))
                (child-expr (and child-cand (candidate-expression child-cand)))
                (child-inputs (schema-inputs (frame-schema (synthesis-node-frame win))))
                (h (synthesis-node-heuristic win))
                (from-stage-a (and h child-expr (equal child-expr (heuristic-program h))))
                (root-expr (candidate-expression best))
                (root-bits (body-size root-expr root-inputs))
                (leaf-bits (and child-expr (ignore-errors (body-size child-expr child-inputs))))
                (chain (loop for cur = win then (synthesis-node-parent cur) while cur
                             for p = (synthesis-node-proposal cur)
                             when p collect (list (let ((n (decomposition-name p))) (if (consp n) (first n) n))
                                                  (pp (decomposition-decoder p))))))
           (push (list :self (or (synthesis-job-self-name job) :anon)
                       :work (ledger-total (synthesis-job-ledger job))
                       :root-bits root-bits :root-atoms (atoms (pp root-expr))
                       :leaf-bits leaf-bits :leaf-atoms (and child-expr (atoms (pp child-expr)))
                       :leaf (and child-expr (pp child-expr))
                       :leaf-from-stage-a from-stage-a
                       :leaf-inputs (length child-inputs)
                       :leaf-enum-work (let ((s (synthesis-node-search win))) (and s (ledger-total (search-job-ledger s))))
                       :chain chain :root (pp root-expr))
                 *rows*)))))))

(with-open-file (s (merge-pathnames "bootstrap/build-batteries.lisp" cl-user::*root*))
  (let ((*package* (find-package :lisploop)) (forms nil))
    (loop for form = (read s nil :eof) until (eq form :eof) do (push form forms))
    (setf forms (nreverse forms))
    (dolist (form (butlast (cddr forms))) (eval form))))
(setf *bootstrap-output-directory*
      (pathname "/tmp/claude-1000/-home-tlh24-lisploop/d1a4b558-b777-4749-af5d-51001946d6e1/scratchpad/bootstrap-reflection/out-library2/"))
(ensure-directories-exist *bootstrap-output-directory*)
(let ((*standard-output* (make-broadcast-stream)))
  (dolist (fn '(build-algebra-battery build-arithmetic-battery build-constructors-battery
                build-functors-battery build-sequences-and-descriptors-batteries
                build-scans-battery build-sequence-shift-battery))
    (funcall fn)))
(let ((tot-root 0) (tot-leaf 0))
  (dolist (r (reverse *rows*))
    (incf tot-root (getf r :root-bits)) (incf tot-leaf (or (getf r :leaf-bits) 0))
    (format t "~&~12A work=~7D answer=~3D bits/~3D atoms | leaf=~3A bits/~3A atoms (~D inputs, stageA=~A, enum-work=~A) | chain=~S~%     leaf: ~S~%     decoders: ~S~%"
            (getf r :self) (getf r :work) (getf r :root-bits) (getf r :root-atoms)
            (getf r :leaf-bits) (getf r :leaf-atoms) (getf r :leaf-inputs) (getf r :leaf-from-stage-a)
            (getf r :leaf-enum-work)
            (mapcar #'first (getf r :chain)) (getf r :leaf) (mapcar #'second (getf r :chain))))
  (format t "~&TOTAL answer body bits=~D leaf bits=~D~%" tot-root tot-leaf))
