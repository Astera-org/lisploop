;; Read each library packet as plain data and list top-level entries.
(defpackage #:lisploop (:use #:cl))
(defun sexp-size (x) (if (consp x) (+ (sexp-size (car x)) (sexp-size (cdr x))) (if x 1 0)))
(defun ops-of (x acc)
  (cond ((and (consp x) (eq (car x) :op)) (pushnew (second x) acc) acc)
        ((consp x) (ops-of (cdr x) (ops-of (car x) acc)))
        (t acc)))
(setf *print-pretty* nil)
(let ((dir (car (last sb-ext:*posix-argv*))) (tot 0) (grand (make-hash-table :test #'equal)))
  (dolist (name '("algebra" "arithmetic" "constructors" "functors" "sequences" "descriptors" "scans" "sequence-shift"))
    (let* ((path (format nil "~A/~A.sexp" dir name))
           (sexp (with-open-file (s path) (with-standard-io-syntax (let ((*package* (find-package :lisploop))) (read s)))))
           (plist (rest sexp))
           (entries (getf plist :entries)))
      (format t "~%## ~A  version=~S meta=~S fn-names=~S n=~D~%" name (getf plist :version) (getf plist :metadata) (getf plist :function-names) (length entries))
      (dolist (e entries)
        (incf tot)
        (let* ((kind (getf e :kind)) (md (getf e :metadata)))
          (incf (gethash (list name kind) grand 0))
          (format t "~A | ~S | ~S | bits=~S gain=~S work=~S | status=~S | cert=~S | origin=~S | nodes=~D | ops=~S | edges=~S~%"
                  name (getf e :id) kind (getf e :bits) (getf e :gain) (getf e :work) (getf e :status)
                  (let ((c (getf e :certificate))) (and c (getf (second c) :method)))
                  (getf md :origin)
                  (sexp-size (getf e :expression))
                  (sort (mapcar #'string (ops-of (getf e :expression) nil)) #'string<)
                  (remove-if (lambda (x) (member (first x) '(:governs))) (getf e :edges)))))))
  (format t "~%TOTAL ~D~%" tot)
  (maphash (lambda (k v) (format t "~S ~D~%" k v)) grand))
