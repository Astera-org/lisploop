;;;; Information budget of each :spec versus the entry it specifies. (reads the committed library)
(defvar *args* (cdr (member "--" sb-ext:*posix-argv* :test #'string=)))
(defvar *v2-root* (pathname (concatenate 'string (first *args*) "/")))
(load (merge-pathnames "load.lisp" *v2-root*))
(in-package #:lisploop)
(setf *print-pretty* nil)
(defun atoms (x) (cond ((null x) 0) ((atom x) 1) (t (+ (atoms (car x)) (atoms (cdr x))))))
(defun pp (x)
  (cond ((and (lit-p x) (code-type-p (ast-type x))) (list :code (pp (ast-value x))))
        ((lit-p x) (list 'quote (ast-value x)))
        ((var-p x) (intern (format nil "X~D" (ast-id x))))
        ((app-p x) (cons (if (operator-p (first x)) (operator-name (first x)) (pp (first x)))
                         (mapcar #'pp (rest x))))
        (t x)))
(defun ops-in (x acc)
  (cond ((and (lit-p x) (code-type-p (ast-type x))) (ops-in (ast-value x) acc))
        ((app-p x) (let ((acc (if (operator-p (first x)) (adjoin (operator-name (first x)) acc) acc)))
                     (dolist (a (rest x) acc) (setf acc (ops-in a acc)))))
        (t acc)))
(defun lits-in (x acc)
  (cond ((and (lit-p x) (code-type-p (ast-type x))) (lits-in (ast-value x) acc))
        ((lit-p x) (adjoin (ast-value x) acc :test #'equal))
        ((app-p x) (dolist (a (rest x) acc) (setf acc (lits-in a acc))))
        (t acc)))
(defun value-bits (v ty) (body-size (lit ty v) nil))
(defun log2-choose (n k) (if (or (< k 0) (> k n)) 0
                             (/ (log (/ (loop with r = 1 for i from 1 to k do (setf r (/ (* r (- n (- k i))) i)) finally (return r)) 1) 2) 1)))
(let ((tot-ex 0) (tot-ans 0) (tot-rows 0))
  (dolist (b '(:arithmetic :constructors :functors :sequences :scans :sequence-shift))
    (let ((lib (deserialize-knowledge-library (read-battery b))))
      (with-knowledge-library (lib)
        (dolist (sp (knowledge-entries-of-kind :spec lib))
          (let* ((meta (knowledge-entry-metadata sp))
                 (inputs (knowledge-entry-inputs sp)) (target (knowledge-entry-target sp))
                 (rows (spec-entry-rows sp))
                 (pos (remove :none rows :key #'second)) (neg (- (length rows) (length pos)))
                 (ex-bits (loop for (known expected) in rows
                                sum (+ (loop for v in known for (nil . ty) in inputs sum (value-bits v ty))
                                       (if (eq expected :none) 1 (value-bits expected target)))))
                 (ex-atoms (loop for (known expected) in rows
                                 sum (+ (loop for v in known for (nil . ty) in inputs
                                              sum (if (code-type-p ty) (atoms (pp v)) (max 1 (atoms v))))
                                        (if (eq expected :none) 1 (if (code-type-p target) (atoms (pp expected)) (max 1 (atoms expected)))))))
                 (w-ops (mapcar (lambda (s) (operator-name (sexp->ast s))) (getf meta :operators)))
                 (g-ops (mapcar (lambda (s) (operator-name (sexp->ast s))) (getf meta :guard-operators)))
                 (w-lits (getf meta :literals))
                 (consts (mapcar (lambda (s) (ast-value (sexp->ast s))) (getf meta :constants)))
                 (tid (second (first (knowledge-edges-from sp :specifies lib))))
                 (ent (find-knowledge-entry tid lib))
                 (expr (knowledge-entry-expression ent))
                 (guard (knowledge-entry-guard ent))
                 (a-ops (remove tid (ops-in expr nil)))
                 (a-ops+g (if (and guard (not (equal guard (lit :bool t)))) (ops-in guard a-ops) a-ops))
                 (a-lits (lits-in expr nil))
                 (generic (ignore-errors (active-library-spec-operators :int inputs target nil tid)))
                 (n-generic (length generic))
                 (k (length (remove-duplicates (getf meta :operators) :test #'equal)))
                 (sel-bits (if (and w-ops generic) (log2-choose (max n-generic k) k) 0)))
            (incf tot-ex ex-bits) (incf tot-ans (knowledge-entry-bits ent)) (incf tot-rows (length rows))
            (format t "~&~A | ~A | rows=~D (+~D/-~D) | example-bits=~D example-atoms=~D | whitelist-ops(~D)=~S lits=~S consts=~S guard-ops=~S | generic-grammar=~D select-bits=~,1F | answer bits=~D atoms=~D ops=~S lits=~S | distractor-ops=~S distractor-lits=~S | ops-not-whitelisted=~S~%"
                    b tid (length rows) (length pos) neg ex-bits ex-atoms
                    (length w-ops) w-ops w-lits consts g-ops n-generic sel-bits
                    (knowledge-entry-bits ent) (atoms (pp expr)) (sort (copy-list a-ops) #'string<) a-lits
                    (set-difference w-ops a-ops+g) (set-difference w-lits a-lits :test #'equal)
                    (set-difference a-ops w-ops)))))))
  (format t "~&TOTAL rows=~D example-bits=~D answer-bits=~D~%" tot-rows tot-ex tot-ans))
