;; Print each library entry's expression/guard in compact surface syntax (data-only reader).
(defpackage #:lisploop (:use #:cl))
(setf *print-pretty* nil *print-right-margin* 100000)
(defun pp (x)
  (cond ((atom x) x)
        ((eq (car x) :app) (cons (let ((o (second x))) (if (and (consp o) (eq (car o) :op)) (second o) (pp o)))
                                 (mapcar #'pp (cddr x))))
        ((eq (car x) :var) (intern (format nil "X~D" (second x))))
        ((eq (car x) :lit) (let ((v (third x)))
                             (if (and (consp (second x)) (eq (car (second x)) :code))
                                 (list :code (pp v))
                                 (list 'quote (pp v)))))
        ((eq (car x) :op) (second x))
        ((eq (car x) :hole) (intern (format nil "?~D" (second x))))
        (t (cons (pp (car x)) (pp (cdr x))))))
(let ((dir (car (last sb-ext:*posix-argv*))))
  (dolist (name '("algebra" "arithmetic" "constructors" "functors" "sequences" "descriptors" "scans" "sequence-shift"))
    (let* ((path (format nil "~A/~A.sexp" dir name))
           (sexp (with-open-file (s path) (with-standard-io-syntax (let ((*package* (find-package :lisploop))) (read s)))))
           (entries (getf (rest sexp) :entries)))
      (format t "~%## ~A~%" name)
      (dolist (e entries)
        (if (eq :spec (getf e :kind))
            (format t "SPEC ~S rows=~D inputs=~S target=~S meta=~S~%" (getf e :id) (length (second (getf e :residual)))
                    (getf e :inputs) (getf e :target)
                    (let ((m (copy-list (getf e :metadata)))) (pp m)))
            (format t "~S [~S] ~S -> ~S~%   expr:  ~S~%~@[   guard: ~S~%~]~@[   trig:  ~S~%~]~@[   aux:   ~S~%~]   meta: ~S~%"
                    (getf e :id) (getf e :kind) (mapcar #'cdr (getf e :inputs)) (getf e :target)
                    (pp (getf e :expression))
                    (let ((g (getf e :guard))) (and g (not (equal g '(:lit :bool t))) (pp g)))
                    (and (getf e :trigger) (pp (getf e :trigger)))
                    (and (getf e :auxiliary-code) (pp (getf e :auxiliary-code)))
                    (let ((m (copy-list (getf e :metadata)))) (remf m :dependencies) (remf m :descriptor-profile) (remf m :necessary-for) (pp m))))))))
