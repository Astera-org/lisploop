;;;; r1-variants2.lisp -- looking for the settings behind two review details that did not reproduce:
;;;; scan "11,298 candidates" and map-adjacent "size-19 impostor at level 7".  After tg-probe-r1.lisp,
;;;; r1-spec.lisp, r1-variants.lisp.  Also: held-out sets wider than the spec's parameter ranges.
(in-package :tg)
(defun trace-levels (name)
  (sb-int:encapsulate 'cover 'trace-level
                      (lambda (f bank y rows depth)
                        (let ((r (funcall f bank y rows depth)))
                          (when (= (length rows) (length y))
                            (format t "  after level ~d (cover depth ~d): ~d classes, ~d cand in this bank: ~a~%"
                                    (bank-done bank) depth (length (bank-all bank)) (bank-ncand bank)
                                    (if r (format nil "SPLIT tsize ~d bank-size ~d" (tsize r) (bank-size r)) "none")))
                          r)))
  (unwind-protect (solve-task (spec-task name) (spec-exs name) 10 30000000)
    (sb-int:unencapsulate 'cover 'trace-level)))
(defun solve-fold-f (task exs limit &key skip)
  "The probe's SOLVE-FOLD (tg-probe.lisp:472-495) with the :code inputs ALSO offered as leaves of the
   step bank (probe grid 7x7 x {+,-,*}), so that (call f acc x) is expressible; inits = 0, 1, integer inputs.
   SKIP: a step term to pass over (to see what comes next)."
  (let* ((grid (loop for fn in '(+ - *) append
                 (loop for a from -3 to 3 append (loop for x from -3 to 3 collect (list a x fn)))))
         (bank (new-bank (make-base :n (length grid)) *d-ops*)) (tried 0)
         (seqs (loop for s in (task-ins task) when (eq (second s) :seq) collect (first s)))
         (inits (append '(0 1) (loop for s in (task-ins task) when (eq (second s) :int) collect (first s)))))
    (add-leaf bank 'acc :int (map 'simple-vector #'first grid))
    (add-leaf bank 'x :int (map 'simple-vector #'second grid))
    (dolist (s (task-ins task))
      (when (eq (second s) :code) (add-leaf bank (first s) :code (map 'simple-vector #'third grid))))
    (dolist (k '(0 1)) (add-leaf bank k :int (make-array (length grid) :initial-element k)))
    (flet ((test (c)
             (when (and (eq (cls-type c) :int) (not (equal (cls-term c) skip)))
               (dolist (s seqs) (dolist (dir '(fold foldr)) (dolist (init inits)
                 (let ((prog `(,dir ,init (lambda (acc x) ,(cls-term c)) ,s)))
                   (incf tried)
                   (when (every (lambda (ex) (equal (cdr ex) (ev prog (car ex)))) exs)
                     (throw :stop prog)))))))))
      (let ((r (or (catch :stop (map nil #'test (bank-all bank)) nil)
                   (progn (setf (bank-on-new bank) #'test) (run bank 7 :limit limit)))))
        (tally bank)
        (push (format nil "~d fold programs tried, ~d step classes" tried (length (bank-all bank))) *note*)
        (and (consp r) r)))))

(defun variants2 ()
  (let ((*package* (find-package :tg)) (*print-pretty* nil) (*print-case* :downcase))
    (format t "=== scan: cumulative candidates per level (review: 11,298 in total) ===~%")
    (trace-levels "scan")
    (format t "~%=== map-adjacent under other settings (review: size-19 impostor, 29/200, accepted at level 7) ===~%")
    (let ((task (spec-task "map-adjacent")) (exs (spec-exs "map-adjacent")))
      (dolist (setting '((:max-size 7) (:max-size 8) (:max-size 9) (:max-size 10 :greedy t)
                         (:max-size 10 :limit 20000) (:max-size 10 :limit 22000) (:max-size 10 :limit 30000) (:max-size 10 :limit 50000)))
        (let ((*greedy* (getf setting :greedy)))
          (destructuring-bind (prog cand cells ms notes scan)
              (timed (lambda () (solve-task task exs (getf setting :max-size) (or (getf setting :limit) 30000000))))
            (declare (ignore cells ms notes scan))
            (format t "  ~34a cand ~7d held-out ~a/200 elem tsize ~a bank-size ~a~%     ~s~%" setting cand
                    (and prog (held-out task prog)) (and prog (tsize (elem-of prog))) (and prog (bank-size (elem-of prog))) prog)))))
    (format t "~%=== held-out sets wider than the spec rows' parameter ranges (programs found on the spec rows, default policy) ===~%")
    (dolist (spec '(("shift-seq" (k :int -3 15)) ("positions" (k :int -20 50)) ("scan" (a :int -50 50)) ("last-or" (d :int -50 50))))
      (destructuring-bind (name newin) spec
        (let* ((task (spec-task name)) (exs (spec-exs name))
               (prog (if (eq (task-out task) :seq)
                         (solve-task task exs 10 30000000)
                         (solve-fold task exs 3000000)))
               (wide (tk name (mapcar (lambda (in) (if (eq (first in) (first newin)) newin in)) (task-ins task))
                         (task-ref task) (task-out task))))
          (format t "  ~10a with ~a: ~a/200   ~s~%" name newin (held-out wide prog) prog))))
    (format t "~%=== foldl spec rows, fold path with f offered to the step bank (the review: '(- acc x) (size 3) beats (call f acc x) (size 4)') ===~%")
    (let ((task (spec-task "foldl")) (exs (spec-exs "foldl")))
      (report "fold + f leaf" task exs (lambda () (solve-fold-f task exs 3000000)))
      (report "same, skipping (- acc x)" task exs (lambda () (solve-fold-f task exs 3000000 :skip '(- acc x)))))
    (finish-output)))
