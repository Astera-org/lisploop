(in-package #:lisploop)

(defun discover-field-laws (p &key nonzero)
  (let* ((domain (gf p)) (inputs (if nonzero (list (cons 0 domain))
                                    (list (cons 0 domain) (cons 1 domain))))
         (values (if nonzero (loop for x from 1 below p collect (list x))
                     (loop for a below p append (loop for b below p collect (list a b)))))
         (frame (make-frame (make-schema :inputs inputs :target domain)
                             (loop for row in values for key from 0 collect
                               (make-row :key key :known row :allowed (predicate-allowed domain (lit :bool t))))))
         (language (make-language domain inputs
                                   :operators (mapcar (lambda (name) (op name domain))
                                                      (if nonzero '(:- :/ :*) '(:+ :*)))))
         (job (start-observation-search (make-observation-scope frame language)))
         (bound (+ (header-size inputs domain) (application-overhead (op :+ domain))
                   (* 2 (body-size (lit domain 0) inputs))))
         (proposal-work (make-ledger))
         (guard (if nonzero (negate-predicate (app (op := domain) (var 0 domain) (lit domain 0)))
                    (lit :bool t))))
    (assert (eq :bounded-exhaustion (message-claim (resume-observation-search job bound 2000000))))
    (let* ((laws (propose-observed-laws job :guard guard :ledger proposal-work))
           (validations (mapcar (lambda (law) (resume-law-validation (start-law-validation law) 1000000)) laws)))
      (assert (every (lambda (state) (eq :validated (law-validation-status state))) validations))
      (format t "GF(~D)~A: bound ~D; ~D expressions, ~D buckets, ~D proposed/validated laws.~%"
              p (if nonzero " nonzero discovery with supplied guard" " full grid") bound
              (length (observation-job-records job)) (length (observation-job-buckets job)) (length laws))
      (report-ledger "  Observation discovery" (observation-job-ledger job))
      (report-ledger "  Proposal construction" proposal-work)
      (format t "  Exhaustive validation work=~D; assignments/law=~D.~%"
              (reduce #'+ validations :key (lambda (s) (ledger-total (law-validation-ledger s))))
              (expt p (length inputs)))
      (values validations (+ (ledger-total (observation-job-ledger job)) (ledger-total proposal-work)
                              (reduce #'+ validations :key (lambda (s) (ledger-total (law-validation-ledger s)))))))))

(defun validation-for-equation (validations left right)
  (or (find-if (lambda (state)
                 (let ((sides (rest (law-equation (law-validation-law state)))))
                   (or (equal sides (list left right)) (equal sides (list right left))))) validations)
      (error "Required identity was not discovered")))

(defun discover-guarded-field-laws (p)
  "Joint discovery: enumerate expressions on the FULL field, then synthesize
one exact Boolean membership program per distinct proper agreement support."
  (let* ((domain (gf p)) (inputs (list (cons 0 domain)))
         (frame (make-frame (make-schema :inputs inputs :target domain)
                            (loop for x below p collect
                              (make-row :key x :known (list x)
                                        :allowed (predicate-allowed domain (lit :bool t))))))
         (language (make-language domain inputs :operators (mapcar (lambda (name) (op name domain)) '(:- :/ :*))))
         (observations (start-observation-search (make-observation-scope frame language) :retain-outcomes t))
         (bound (+ (header-size inputs domain) 6 (* 2 (body-size (lit domain 0) inputs))))
         (proposal-work (make-ledger))
         (guard-language (make-language domain inputs :operators (list (op := domain) (op :if :bool))))
         (searches nil) (validations nil))
    (assert (eq :bounded-exhaustion (message-claim (resume-observation-search observations bound 2000000))))
    (let ((problems (propose-guard-problems observations proposal-work)))
      (dolist (problem problems)
        (let ((search (start-guard-search problem guard-language)))
          (assert (eq :bounded-exhaustion (message-claim (resume-search search 54 2000000))))
          (push search searches)
          (dolist (law (propose-guarded-laws problem search proposal-work))
            (let ((validation (resume-law-validation (start-law-validation law) 2000000)))
              (assert (eq :validated (law-validation-status validation)))
              (push validation validations)))))
      (values (nreverse validations) observations problems (nreverse searches) proposal-work))))

(defun report-guard-discovery (p)
  (multiple-value-bind (validations observations problems searches proposals) (discover-guarded-field-laws p)
    (let* ((domain (gf p)) (inputs (language-inputs (observation-scope-language (observation-job-scope observations))))
           (x (var 0 domain)) (ratio (app (op :/ domain) x x)) (one (lit domain 1))
           (validation (validation-for-equation validations ratio one))
           (guard (law-guard (law-validation-law validation)))
           (safe (app (op :if domain) guard ratio (lit domain 0)))
           (library (prepare-rewrite-library (list validation) domain))
           (rewrite (start-rewriting safe inputs library))
           (guard-work (reduce #'+ searches :key (lambda (job) (ledger-total (search-job-ledger job)))))
           (validation-work (reduce #'+ validations :key (lambda (job) (ledger-total (law-validation-ledger job))))))
      (dotimes (value p)
        (let ((run (evaluate guard inputs (list value))))
          (assert (and (eq :value (evaluation-status run)) (eq (not (zerop value)) (evaluation-value run))))))
      (advance-rewriting rewrite 1000000)
      (assert (equal (rewriting-value rewrite) (app (op :if domain) guard one (lit domain 0))))
      (format t "~%Joint equation/guard discovery GF(~D), full domain including zero; no supplied equation or guard.~%" p)
      (format t "  ~D expressions (~D erroring); ~D proper supports / ~D pairs; ~D guards found at 54 bits; ~D validated laws.~%"
              (length (observation-job-records observations))
              (count :error (observation-job-records observations) :key #'observed-expression-status)
              (length problems) (reduce #'+ problems :key (lambda (problem) (length (guard-problem-equations problem))))
              (count-if #'search-job-best searches) (length validations))
      (format t "  Discovered x/x=1 guard: ~S; S=~D; active=~D/~D; guarded statement S=~D.~%"
              guard (description-size guard inputs) (law-certificate-active (law-validation-certificate validation)) p
              (description-size (law-statement (law-validation-law validation)) inputs))
      (report-ledger "  Full-row observations" (observation-job-ledger observations))
      (report-ledger "  Support grouping, child frames, and law proposals" proposals)
      (format t "  Guard searches=~D; independent validation=~D; acquisition total=~D.~%"
              guard-work validation-work
              (+ (ledger-total (observation-job-ledger observations)) (ledger-total proposals) guard-work validation-work))
      (format t "  Learned guard licenses the branch rewrite; rewrite work=~D, rule setup=~D (separate from acquisition).~%"
              (rewriting-work rewrite) (rewrite-library-setup-work library)))
    (report-law-compression validations (format nil "GF(~D) discovered guarded laws" p))))

(defun report-law-compression (validations label)
  "AU is a proposal source; START-SEARCH owns acceptance and objective selection."
  (let* ((ledger (make-ledger))
         (corpus (make-law-corpus (mapcar #'law-validation-law validations) ledger))
         (frame (law-corpus-frame corpus ledger)))
    (multiple-value-bind (models pattern substitutions groups) (propose-law-compressions corpus ledger)
      (format t "~%AU compression: ~A; ~D ordered statements, ~D shape groups.~%"
              label (length validations) (length groups))
      (format t "  Global AU pattern ~S~%" pattern)
      (format t "  Packet sizes: literal=~D; whole-packet dictionary=~D; global AU=~D; grouped AU=~D.~%"
              (description-size (first models)) (description-size (second models))
              (description-size (third models)) (description-size (fourth models)))
      (report-ledger "  Corpus/proposal construction" ledger)
      (report-quoted-au-constructor corpus pattern substitutions)
      (dolist (weight '(0 1))
        (let* ((job (start-search frame (make-language :int nil :operators nil :literals nil)
                                  :expressions models :run-weight weight))
               (bound (reduce #'max models :key #'description-size)))
          (assert (eq :replay-complete (message-claim (resume-search job bound 100000000))))
          (assert (= 4 (length (search-job-results job))))
          (let* ((best (search-job-best job))
                 (run (evaluate (decode-model (encode-model (candidate-expression best))) nil nil :budget 100000000))
                 (decoded (decode-law-corpus (evaluation-value run)))
                 (revalidated (mapcar (lambda (law) (resume-law-validation (start-law-validation law) 1000000)) decoded)))
            (assert (eq :value (evaluation-status run)))
            (assert (equalp (mapcar #'law-snapshot (law-corpus-laws corpus)) (mapcar #'law-snapshot decoded)))
            (assert (every (lambda (state) (eq :validated (law-validation-status state))) revalidated))
            (format t "  Core search lambda_run=~D: best S=~D, W_run=~D, J=~D; search work=~D.~%"
                    weight (candidate-size best) (candidate-run-work best) (candidate-score best weight)
                    (ledger-total (search-job-ledger job)))
            (format t "    Isolated decoded-model replay=~D; independent law revalidation=~D; exact corpus restored.~%"
                    (evaluation-work run)
                    (reduce #'+ revalidated :key (lambda (state) (ledger-total (law-validation-ledger state)))))))))))

(defun report-quoted-au-constructor (corpus pattern substitutions)
  "Functional reconstruction from explicit quoted inputs, not a storage score."
  (let ((ledger (make-ledger)))
    (multiple-value-bind (model inputs) (compile-au-constructor pattern (law-corpus-inputs corpus) ledger)
      (let* ((type (expression-type model inputs))
             (rows (loop for law in (law-corpus-laws corpus) for bindings in substitutions for key from 0
                         for values = (mapcar (lambda (input) (cdr (assoc (car input) bindings))) inputs)
                         for statement = (law-statement law)
                         for allowed = (finite-allowed type (list statement))
                         do (charge ledger :quoted-frame
                                    (+ (syntax-work (allowed-expression allowed))
                                       (loop for value in values for input in inputs sum (value-work value (cdr input)))))
                         collect (make-row :key key :known values :allowed allowed)))
             (frame (make-frame (make-schema :inputs inputs :target type) rows))
             (decoded (decode-model (encode-model model inputs)))
             (job (start-search frame (make-language :int inputs :operators nil :literals nil)
                                :expressions (list decoded))))
        (assert (equal decoded model))
        (assert (eq :replay-complete (message-claim (resume-search job (description-size model inputs) 100000000))))
        (assert (= 1 (length (search-job-results job))))
        (format t "  Quoted AU constructor: ~D explicit hole inputs; S=~D; W_run=~D over ~D statements.~%"
                (length inputs) (description-size model inputs)
                (candidate-run-work (search-job-best job)) (length rows))
        (report-ledger "    Constructor/quoted frame preparation (separate experiment)" ledger)
        (report-ledger "    Ordinary frame search/replay (separate experiment)" (search-job-ledger job))
        (format t "    Exact syntax/guards restored by code constructors; bindings are supplied inputs, not a full storage description.~%")))))

(defun report-symbolic-transformation-search ()
  (format t "~%Quoted-expression transformation through ordinary pullback, search, and composition.~%")
  (dolist (domain (list :int (gf 5) (gf 7)))
    (multiple-value-bind (parent decoder scope) (code-transform-fixture domain)
      (declare (ignore scope))
      (let* ((ledger (make-ledger))
             (child (pullback-frame parent decoder 1 :int nil ledger))
             (job (start-search child (make-language :int nil :operators nil :literals '(0 1 -1))))
             (bound (description-size (lit :int 1))))
        (assert (eq :bounded-exhaustion (message-claim (resume-search job bound 1000000))))
        (assert (equal (lit :int 0) (candidate-expression (search-job-best job))))
        (let* ((model (compose-model decoder 1 (candidate-expression (search-job-best job)) nil ledger))
               (inputs (schema-inputs (frame-schema parent)))
               (decoded (decode-model (encode-model model inputs)))
               (checked (start-search parent (make-language :int inputs :operators nil :literals nil)
                                      :expressions (list decoded))))
          (assert (eq :replay-complete (message-claim (resume-search checked (description-size model inputs) 1000000))))
          (assert (= 1 (length (search-job-results checked))))
          (format t "  ~S: selected child 0 at ~D bits; ~D parent rows; composed transformer S=~D, W_run=~D.~%"
                  domain bound (length (frame-rows parent)) (description-size model inputs)
                  (candidate-run-work (search-job-best checked)))
          (report-ledger "    Pullback/composition" ledger)
          (report-ledger "    Selector search" (search-job-ledger job))
          (report-ledger "    Complete parent replay" (search-job-ledger checked))))))
  (format t "  Supplied match/totality/constructor context; learned selector only. No integer-law certificate is inferred.~%"))

(defun run-m3 ()
  (format t "~%M3 / discovered equations, independent finite validation, and checked reuse.~%")
  (multiple-value-bind (five acquisition) (discover-field-laws 5)
    (let* ((domain (gf 5)) (a (var 0 domain)) (b (var 1 domain)) (plus (op :+ domain))
           (zero-law (validation-for-equation five (app plus a (lit domain 0)) a))
           (commute (validation-for-equation five (app plus a b) (app plus b a))))
      (dolist (state (list zero-law commute))
        (let ((law (law-validation-law state)))
          (format t "Recovered DSL law ~S; guarded statement S=~D bits.~%"
                  (law-equation law) (description-size (law-statement law) (law-inputs law)))))
      (discover-field-laws 7)
      (multiple-value-bind (frame oracle) (gf5-fixture)
        (let* ((inputs (schema-inputs (frame-schema frame))) (language (make-language domain inputs))
               (bound (description-size oracle inputs)) (plain (start-search frame language))
               (checked (start-search frame language :laws (list zero-law))))
          (dolist (job (list plain checked))
            (assert (eq :bounded-exhaustion (message-claim (resume-search job bound 5000000)))))
          (assert (equal (mapcar #'candidate-expression (search-job-results plain))
                         (mapcar #'candidate-expression (search-job-results checked))))
          (assert (= (retained-syntax-count plain) (retained-syntax-count checked)))
          (format t "Second search: y=a+2b, same ~D-bit bound, using only discovered a+0=a.~%" bound)
          (format t "  Both retain ~D trees and ~D solutions; ~D witnessed rejections reused.~%"
                  (retained-syntax-count checked) (length (search-job-results checked))
                  (search-job-reused-rejections checked))
          (report-ledger "  Plain search" (search-job-ledger plain))
          (report-ledger "  Checked search" (search-job-ledger checked))
          (let ((cache (rewrite-library-program-cache (search-job-library checked))))
            (format t "  Preparation retained: ~D schema bundle(s), ~D validated DSL transformer(s); each new source/assumption input is checked.~%"
                    (hash-table-count cache)
                    (loop for programs being the hash-values of cache sum (length programs))))
          (format t "  GF(5) acquisition/proposal/all-law validation=~D; acquisition plus checked reuse=~D.~%"
                  acquisition (+ acquisition (ledger-total (search-job-ledger checked)))))))
    (let* ((domain (gf 5)) (inputs (list (cons 0 domain))) (x (var 0 domain))
           (fifth (loop with tree = x repeat 4 do (setf tree (app (op :* domain) tree x)) finally (return tree)))
           (law (make-law domain inputs fifth x)))
      (dolist (target (list domain (gf 7) :int))
        (let* ((candidate (retype-law law target))
               (state (if (eq target :int) (start-law-validation candidate :samples '((0) (1) (2)))
                          (start-law-validation candidate))))
          (resume-law-validation state 1000000)
          (assert (eq (if (equal target domain) :validated :refuted) (law-validation-status state)))
          (format t "Supplied transfer control x^5=x in ~S: ~S, counterexample ~S, work ~D.~%"
                  target (law-validation-status state) (law-validation-counterexample state)
                  (ledger-total (law-validation-ledger state)))))))
  (multiple-value-bind (guarded work) (discover-field-laws 5 :nonzero t)
    (let* ((domain (gf 5)) (inputs (list (cons 0 domain))) (x (var 0 domain))
           (quotient (app (op :/ domain) x x)) (one (lit domain 1))
           (state (validation-for-equation guarded quotient one))
           (condition (app (op := domain) x (lit domain 0)))
           (model (app (op :if domain) condition (lit domain 0) quotient))
           (library (prepare-rewrite-library (list state) domain))
           (rewrite (start-rewriting model inputs library)))
      (advance-rewriting rewrite 1000000)
      (assert (eq :complete (rewriting-status rewrite)))
      (assert (equal (rewriting-value rewrite) (app (op :if domain) condition (lit domain 0) one)))
      (format t "Discovered guarded x/x=1; active assignments=~D; collection cost=~D.~%"
              (law-certificate-active (law-validation-certificate state)) work)
      (format t "  Lazy conditional rewrites to ~S; rewrite work ~D; rule setup ~D.~%"
              (rewriting-value rewrite) (rewriting-work rewrite) (rewrite-library-setup-work library))))
  (report-guard-discovery 5)
  (report-guard-discovery 7)
  (report-symbolic-transformation-search)
  (format t "Primitives and structural contexts are supplied; field runs discover equations and guards. M4 inversion learning is not run.~%"))
