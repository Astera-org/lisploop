(in-package #:lisploop)

(defvar *tests* nil)
(defvar *checks* 0)
(defmacro check (form)
  `(progn (incf *checks*) (unless ,form (error "Check failed: ~S" ',form))))
(defmacro raises (form)
  `(check (handler-case (progn ,form nil) (error () t))))
(defmacro deftest (name &body body)
  `(progn (defun ,name () ,@body) (push ',name *tests*)))
(defun result (expression &optional inputs values)
  (let ((state (evaluate expression inputs values)))
    (check (eq (evaluation-status state) :value))
    (evaluation-value state)))
(defun accepts (allowed value)
  (let ((state (check-allowed allowed value)))
    (check (eq (evaluation-status state) :value))
    (evaluation-value state)))
(defun simple-frame (type inputs examples &key lookup-p)
  (make-frame (make-schema :inputs inputs :target type :lookup-p lookup-p)
              (loop for (known target) in examples for key from 0 collect
                (make-row :key key :known known :allowed (finite-allowed type (list target))))))

(deftest domains-codec-and-runtime
  (let* ((field (gf 5))
         (expression (app (op :+ field) (lit field 4) (lit field 3))))
    (check (= 2 (result expression)))
    (check (equal expression (decode-model (encode-model expression))))
    (raises (gf 4))
    (raises (lit field 5))
    (raises (lit :int t))
    (raises (lit :index -1))
    (raises (expression-type (app (op :+ field) (lit :int 1) (lit field 1))))
    (raises (expression-type (var 0 :index) '((0 . :int))))
    (raises (decode-model "#.(error 0)"))
    (raises (decode-model "(0 0 1) (0 0 2)"))
    (raises (lit (sequence-type :int) (list #'identity)))
    (check (eq :error (evaluation-status (evaluate '(:app (:op :fetch :int) ()) nil nil))))
    (check (eq :error (evaluation-status (evaluate (var 1 field) nil nil))))
    (dolist (value '(0 -1 1234567890123456789012345678901234567890))
      (let ((literal (lit :int value)))
        (check (= value (result (decode-model (encode-model literal))))))))
  (dolist (literal (list (lit :bool nil) (lit :bool t)
                         (lit (sequence-type :bool) '(nil t nil))
                         (lit (tuple-type :int :bool) '(-2 nil))
                         (lit (sequence-type :int) nil)))
    (check (equal literal (decode-model (encode-model literal)))))
  (let* ((big (expt 2 160))
         (expression (app (op :* :int) (lit :int big) (lit :int big)))
         (whole (evaluate expression nil nil))
         (paused (evaluate expression nil nil :budget 1)))
    (check (eq :unknown (evaluation-status paused)))
    (check (null (evaluation-error paused)))
    (advance-evaluation paused 17)
    (check (eq :unknown (evaluation-status paused)))
    (loop while (eq :unknown (evaluation-status paused)) do (advance-evaluation paused 113))
    (check (= (* big big) (evaluation-value paused)))
    (check (= (evaluation-work whole) (evaluation-work paused)))
    (check (> (evaluation-work whole) (* 160 160)))))

(deftest isolated-reorientation-and-model-data
  (let* ((field (gf 5)) (types (list field field field))
         (records '((10 1 2 3) (20 4 3 2) (30 2 4 1)))
         (ledger (make-ledger))
         (frame (orient-observations types records '(0 2) '(1) :lookup-p t :ledger ledger))
         (inverse (app (op :+ field) (var 2 field)
                       (app (op :* field) (lit field 4) (var 0 field)))))
    (check (plusp (ledger-total ledger)))
    (check (null (assoc :simulation (ledger-counts ledger))))
    (check (plusp (replay-model inverse frame)))
    (check (equal '(1 3) (row-known (first (frame-rows frame)))))
    (check (eq :error (evaluation-status (evaluate (var 1 field)
                                                  (schema-inputs (frame-schema frame)) '(1 3)))))
    (let* ((lookup (lookup-model frame))
           (inputs (schema-inputs (frame-schema frame)))
           (encoded (encode-model lookup inputs))
           (known (mapcar #'row-known (frame-rows frame))))
      (check (> (description-size lookup inputs) (description-size inverse inputs)))
      (check (plusp (replay-model lookup frame)))
      ;; Only packet bits and declared arguments survive this isolated replay.
      (setf frame nil records nil)
      (check (equal '(2 3 4) (mapcar (lambda (values) (result (decode-model encoded) inputs values)) known)))
      (let ((indirect (instantiate lookup (list (cons 0 (var 99 field))) :var)))
        (check (eq :error (evaluation-status (evaluate indirect inputs '(1 3))))))))
  (let* ((frame (simple-frame :int '((0 . :int)) '(((1) 2) ((1) 3)) :lookup-p t)))
    (raises (lookup-model frame)))
  (raises (lookup-model (simple-frame :int '((0 . :int)) '(((1) 2)))))
  (let* ((allowed (predicate-allowed :int (app (op := :int) (var 0 :int) (lit :int 2))))
         (frame (make-frame (make-schema :inputs nil :target :int :lookup-p t)
                             (list (make-row :key 0 :known nil :allowed allowed)))))
    (raises (lookup-model frame)))
  (let ((frame (make-frame
                (make-schema :inputs '((0 . :int)) :target :int :lookup-p t)
                (list (make-row :key 1 :known '(7) :allowed (finite-allowed :int '(1 2)))
                      (make-row :key 2 :known '(7) :allowed (finite-allowed :int '(2 3)))))))
    (check (= 2 (result (lookup-model frame) '((0 . :int)) '(7)))))
  (raises (simple-frame :int '((0 . :int)) '(((1 2) 3)))))

(deftest joint-pullback-and-composition
  (let* ((field (gf 2)) (pair (tuple-type field field))
         (parent (simple-frame pair nil '((nil (0 0)))))
         (diagonal (app (op :tuple pair) (var 7 field) (var 7 field))))
    ;; Keep both alternatives joint, including when the child itself is a tuple.
    (setf (row-allowed (first (frame-rows parent))) (finite-allowed pair '((0 0) (1 1))))
    (let* ((child (pullback-frame parent (var 7 pair) 7 pair nil))
           (allowed (row-allowed (first (frame-rows child)))))
      (check (eq :unknown (allowed-values allowed)))
      (loop for a below 2 do (loop for b below 2 do
        (check (eq (= a b) (accepts allowed (list a b)))))))
    (let* ((child (pullback-frame parent diagonal 7 field nil))
           (allowed (row-allowed (first (frame-rows child)))))
      (check (accepts allowed 0))
      (check (accepts allowed 1)))
    (setf (row-allowed (first (frame-rows parent))) (finite-allowed pair '((0 1) (1 0))))
    (let* ((child (pullback-frame parent diagonal 7 field nil))
           (allowed (row-allowed (first (frame-rows child)))))
      (check (not (accepts allowed 0)))
      (check (not (accepts allowed 1)))))
  (multiple-value-bind (parent oracle) (gf5-fixture)
    (declare (ignore oracle))
    (let* ((field (gf 5))
           (decoder (app (op :+ field) (var 0 field) (var 9 field)))
           (bindings (list (cons 3 (var 1 field))))
           (child (pullback-frame parent decoder 9 field bindings))
           (child-program (app (op :* field) (lit field 2) (var 3 field)))
           (model (compose-model decoder 9 child-program bindings)))
      (check (plusp (replay-model child-program child)))
      (check (plusp (replay-model model parent)))
      (loop for prow in (frame-rows parent) for crow in (frame-rows child) do
        (loop for z below 5 do
          ;; Independent explicit fiber oracle: only in this finite contract check.
          (check (eq (= (mod (+ (first (row-known prow)) z) 5)
                         (first (allowed-values (row-allowed prow))))
                      (accepts (row-allowed crow) z)))))
      (raises (pullback-frame parent decoder 9 field (list (cons 3 (var 2 field)))))
      (raises (pullback-frame parent decoder 0 field bindings))))
  (let* ((field (gf 5))
         (parent (simple-frame field (list (cons 0 field)) '(((0) 0) ((0) 1))))
         (child (pullback-frame parent (app (op :* field) (var 0 field) (var 7 field))
                                7 field nil)))
    (loop for z below 5 do
      (check (accepts (row-allowed (first (frame-rows child))) z))
      (check (not (accepts (row-allowed (second (frame-rows child))) z))))))

(deftest views-preserve-occurrences
  (let* ((rows '((0 8) (1 2) (2 8) (3 2) (4 9)))
         (ledger (make-ledger))
         (partition (partition-rows rows '(1 0 1 0 1) ledger)))
    (check (equal rows (reassemble-partition partition ledger)))
    (check (= 5 (length (partition-positions partition))))
    (check (plusp (ledger-total ledger)))
    (let ((model (partition-model partition (tuple-type :index :int))))
      (check (equal rows (result (decode-model (encode-model model))))))
    (raises (partition-rows rows '(0 1)))
    (setf (partition-positions partition) '((0 0) (0 1) (2 0) (3 1) (4 0)))
    (raises (reassemble-partition partition)))
  (let ((values '(8 2 8 2 9 8)))
    (multiple-value-bind (representatives residual) (quotient-values values)
      (check (equal '(8 2 9) representatives))
      (check (equal '(0 1 0 1 2 0) residual))
      (check (equal values (restore-quotient representatives residual)))
      (let ((model (quotient-model :int representatives residual)))
        (check (equal values (result (decode-model (encode-model model))))))
      (check (not (equal values representatives)))
      (check (> (description-size (lit (tuple-type (sequence-type :int) (sequence-type :index))
                                       (list representatives residual)))
                 (description-size (lit (sequence-type :int) representatives))))
      (raises (restore-quotient representatives '(3))))))

(deftest syntax-replay-matching-and-au
  (let* ((signature (operator-type (op :+ :int)))
         (template (app (hole 0 signature) (hole 1 :int) (hole 1 :int)))
         (sources (list (app (op :+ :int) (lit :int 2) (lit :int 2))
                         (app (op :* :int) (lit :int 3) (lit :int 3)))))
    (loop for source in sources for operator in '(:+ :*) for value in '(2 3) do
      (let ((supplied (list (cons 0 (op operator :int)) (cons 1 (lit :int value)))))
        (check (equal source (instantiate template supplied))))
      (multiple-value-bind (substitutions matched) (match-pattern template source)
        (check matched)
        (check (equal source (instantiate template substitutions)))))
    (multiple-value-bind (pattern substitutions) (anti-unify sources)
      (check (equal template pattern))
      (loop for source in sources for substitution in substitutions do
        (check (equal source (instantiate pattern substitution)))))
    (check (not (nth-value 1 (match-pattern template
                                           (app (op :* :int) (lit :int 3) (lit :int 4))))))
    (multiple-value-bind (pattern substitutions)
        (anti-unify (list (first sources) (app (op :* :int) (lit :int 3) (lit :int 4))))
      (check (= 3 (length (first substitutions))))
      (check (not (equal (first (third pattern)) (second (third pattern))))))
    (check (not (nth-value 1 (match-pattern template
                                           (app (op := :int) (lit :int 2) (lit :int 2)))))))
  (multiple-value-bind (pattern substitutions) (anti-unify (list (lit :int 2) (lit :int 3)))
    (check (equal pattern (hole 0 :int)))
    (check (equal (instantiate pattern (second substitutions)) (lit :int 3))))
  (let ((sources (list (app (op := :int) (lit :int 1) (lit :int 1))
                       (app (op := (gf 5)) (lit (gf 5) 2) (lit (gf 5) 2)))))
    (check (equal (hole 0 :bool) (anti-unify sources))))
  (raises (anti-unify (list (lit :int 1) (lit (gf 5) 1)))))

(defun reference-one-application (domain inputs operators bound)
  "Independent exhaustive reference: this bound permits leaves and ONE binary app."
  (let* ((leaves (append (mapcar (lambda (spec) (var (car spec) (cdr spec))) inputs)
                          (loop for i below (second domain) collect (lit domain i))))
         (candidates (copy-list leaves)))
    (dolist (operator operators)
      (dolist (left leaves)
        (dolist (right leaves) (push (app operator left right) candidates))))
    (check (< bound (+ (header-size inputs domain)
                       (* 3 (reduce #'min leaves :key (lambda (e) (body-size e inputs)))) 10)))
    (remove-if (lambda (expression) (> (description-size expression inputs) bound)) candidates)))

(defun reference-value (expression inputs prime)
  (case (first expression)
    (:lit (third expression))
    (:var (cdr (assoc (second expression) inputs)))
    (:app
     (let ((a (reference-value (first (third expression)) inputs prime))
           (b (reference-value (second (third expression)) inputs prime)))
       (ecase (second (second expression))
         (:+ (mod (+ a b) prime)) (:* (mod (* a b) prime)))))))

(deftest independent-complete-tiny-bound
  (let* ((field (gf 2)) (inputs (list (cons 0 field)))
         (language (make-language field inputs))
         (frame (simple-frame field inputs '(((0) 0) ((1) 1))))
         (bound (description-size (app (op :+ field) (var 0 field) (lit field 0)) inputs))
         (reference (reference-one-application field inputs (language-operators language) bound))
         (job (start-search frame language))
         (message (resume-search job bound 100000)))
    (check (eq :bounded-exhaustion (message-claim message)))
    (check (= bound (search-job-completed-bound job)))
    (let ((actual nil))
      (maphash (lambda (key bucket) (declare (ignore key))
                 (setf actual (append actual (coerce bucket 'list))))
               (enumerator-buckets (search-job-enumerator job)))
      (check (= (length actual) (length reference)))
      (check (null (set-exclusive-or actual reference :test #'equal))))
    (let ((passing (remove-if-not
                    (lambda (expression)
                      (and (= 0 (reference-value expression '((0 . 0)) 2))
                           (= 1 (reference-value expression '((0 . 1)) 2)))) reference)))
      (check (null (set-exclusive-or passing (mapcar #'candidate-expression (search-job-results job))
                                     :test #'equal))))))

