    (finish-output)
    (funcall test)
    (format t "ok~%"))
  (format t "~&~D tests, ~D checks passed in ~,3F s.~%"
          (length *tests*) *checks*
          (/ (- (get-internal-real-time) start) internal-time-units-per-second)))
