(in-package #:lisploop)

(defvar *arithmetic-controls* (make-hash-table :test #'equal))
(defun arithmetic-controls (domain)
  (or (gethash domain *arithmetic-controls*)
      (setf (gethash domain *arithmetic-controls*)
            (loop with values = (if (eq domain :int) '(-4 -3 -2 -1 0 1 2 3 4)
                                    (loop for i below (second domain) collect i))
                  for name in '(:+ :- :* :/)
                  for relation = (observe-arithmetic-relation domain name values) append
                    (loop for position below 2
                          for discovery = (discover-arithmetic-solver relation position values :literals (if (eq domain :int) '(-1 0 1) :all))
                          do (if (eq domain :int) (integer-solver-held-out discovery) (validate-arithmetic-solver discovery))
                          collect discovery)))))

(defun arithmetic-control (domain name position)
  (find-if (lambda (d) (and (eq name (operator-name (arithmetic-relation-operator (solve-discovery-relation d))))
                            (= position (solve-discovery-position d)))) (arithmetic-controls domain)))

(defun independent-arithmetic (name a b domain)
  "Test oracle only: field reciprocals by exhaustive multiplication, not Euclid."
  (if (and (eq name :/) (zerop b)) (values nil nil)
      (values (if (eq domain :int)
                  (ecase name (:+ (+ a b)) (:- (- a b)) (:* (* a b)) (:/ (truncate a b)))
                  (mod (ecase name (:+ (+ a b)) (:- (- a b)) (:* (* a b))
                         (:/ (* a (loop for inverse below (second domain)
                                       when (= 1 (mod (* b inverse) (second domain))) return inverse)))) (second domain))) t)))

(defun accepted-arithmetic-value-p (requirement value)
  (let ((run (check-requirement requirement value)))
    (check (not (eq :unknown (evaluation-status run))))
    (and (eq :value (evaluation-status run)) (evaluation-value run))))

(deftest all-arithmetic-orientations-match-independent-field-reference
  (dolist (p '(5 7))
    (let ((domain (gf p)))
      (dolist (discovery (arithmetic-controls domain))
        (let* ((relation (solve-discovery-relation discovery)) (position (solve-discovery-position discovery))
               (name (operator-name (arithmetic-relation-operator relation)))
               (q (solve-discovery-witness discovery)) (guard (solve-discovery-guard discovery))
               (requirement (arithmetic-requirement relation position)) (inputs (arithmetic-inputs domain)))
          (check (certified-solve-discovery-p discovery))
          (check (eq :enumeration (observation-job-mode (solve-discovery-observations discovery))))
          (check (every (lambda (row) (eq :unknown (extract-allowed-values (row-requirement row))))
                        (frame-rows (solve-discovery-frame discovery))))
          (check-codec-roundtrip q inputs)
          (check-codec-roundtrip guard inputs)
          (dotimes (k p)
            (dotimes (c p)
              (let* ((active (result guard inputs (list k c)))
                     (expected (case name ((:+ :-) t) (:* (not (zerop k)))
                                      (:/ (if (zerop position) (not (zerop k)) (and (not (zerop k)) (not (zerop c)))))))
                     (witness (when active (result q inputs (list k c)))))
                (check (eq active expected))
                (when active
                  (multiple-value-bind (value defined)
                      (independent-arithmetic name (if (zerop position) witness k) (if (zerop position) k witness) domain)
                    (check defined) (check (= c value))))
                (dotimes (z p)
                  (multiple-value-bind (value defined)
                      (independent-arithmetic name (if (zerop position) z k) (if (zerop position) k z) domain)
                    (let ((accepted (result requirement (arithmetic-inputs domain 3) (list k c z))))
                      (check (eq accepted (and defined (= value c))))
                      (when active (check (eq accepted (= z witness)))))))))))))))

(deftest original-addition-bootstrap-and-separate-oracle
  (dolist (domain (list (gf 5) (gf 7) :int))
    (let* ((relation (solve-discovery-relation (arithmetic-control domain :+ 1)))
           (values (if (eq domain :int) '(-4 -3 -2 -1 0 1 2 3 4) (loop for i below (second domain) collect i)))
           (discovery (discover-arithmetic-solver relation 1 values :operators '(:+ :*)
                                                   :literals (if (eq domain :int) '(-1 0 1) :all) :body-bound 24))
           (language (observation-scope-language (observation-job-scope (solve-discovery-observations discovery)))))
      (check (equal '(:+ :*) (mapcar #'operator-name (language-operators language))))
      (check (eq :enumeration (observation-job-mode (solve-discovery-observations discovery))))
      (check (search-job-best (addition-oracle-control discovery)))
      (if (eq domain :int)
          (let ((n (ash 1 256)))
            (integer-solver-held-out discovery)
            (check (not (certified-solve-discovery-p discovery)))
            (dolist (values (list (list n (- n)) (list (- n) (+ n 3)) '(0 0) '(-9 17)))
              (check (= (second values) (+ (first values) (result (solve-discovery-witness discovery) (arithmetic-inputs domain) values))))))
          (progn (validate-arithmetic-solver discovery) (check (certified-solve-discovery-p discovery)))))))

(deftest zero-empty-and-multivalued-fibers-remain-predicates
  (let ((domain (gf 5)))
    (dolist (name '(:* :/))
      (let* ((discovery (arithmetic-control domain name 1))
             (decoder (app (op name domain) (var 0 domain) (var 9 domain)))
             (parent (make-frame (make-schema :inputs (arithmetic-inputs domain) :target domain)
                                 (list (make-row :key :many :known '(0 3) :requirement (set-requirement domain '(0)))
                                       (make-row :key :empty :known '(0 4) :requirement (set-requirement domain '(1)))
                                       (make-row :key :one :known '(1 4) :requirement (set-requirement domain '(2)))
                                       (make-row :key :set :known '(1 0) :requirement (set-requirement domain '(0 1)))
                                       (make-row :key :none :known '(1 2) :requirement (set-requirement domain nil)))))
             (bindings (list (cons 3 (var 1 domain))))
             (raw (pullback-frame parent decoder 9 domain bindings))
             (result (propagate-arithmetic-child parent decoder 9 bindings discovery (make-ledger)))
             (rows (frame-rows (propagation-frame result))))
        (check (= 1 (propagation-narrowed result)))
        (check (= 4 (propagation-retained result)))
        (check (equal '((3) (4) (4) (0) (2)) (mapcar #'row-known rows)))
        (check (equal (list (cons 3 domain)) (schema-inputs (frame-schema (propagation-frame result)))))
        (loop for before in (frame-rows raw) for after in rows do
          (dotimes (z 5)
            (check (eq (accepted-arithmetic-value-p (row-requirement before) z) (accepted-arithmetic-value-p (row-requirement after) z)))))
        (check (= (if (eq name :*) 5 4)
                  (loop for z below 5 count (accepted-arithmetic-value-p (row-requirement (first rows)) z))))
        (check (loop for z below 5 never (accepted-arithmetic-value-p (row-requirement (second rows)) z)))
        (let* ((frame (make-frame (frame-schema (propagation-frame result)) (list (second rows))))
               (job (start-search frame (make-language domain (schema-inputs (frame-schema frame)) :operators nil))))
          (check (eq :bounded-exhaustion (message-claim (resume-search job (+ (header-size (schema-inputs (frame-schema frame)) domain) 5) 100000))))
          (check (null (search-job-best job))))
        (let ((duplicates (remove-if-not (lambda (row) (equal '(0 0) (row-known row))) (frame-rows (solve-discovery-frame discovery)))))
          (check (> (length duplicates) 1))
          (check (every (lambda (row) (eq :unknown (extract-allowed-values (row-requirement row)))) duplicates)))))))

(deftest certified-propagators-preserve-entire-field-child-frames
  (dolist (domain (list (gf 5) (gf 7)))
    (dolist (discovery (arithmetic-controls domain))
      (multiple-value-bind (propagation plain propagated original-work propagation-work acquisition composition)
          (compare-arithmetic-propagation discovery (loop for i below (second domain) collect i))
        (declare (ignore acquisition composition))
        (check (plusp (propagation-narrowed propagation)))
        (check (plusp (ledger-total propagation-work)))
        (check (plusp (ledger-total original-work)))
        (check (equal (mapcar (lambda (c) (list (candidate-expression c) (candidate-size c) (candidate-run-work c))) (search-job-results plain))
                      (mapcar (lambda (c) (list (candidate-expression c) (candidate-size c) (candidate-run-work c))) (search-job-results propagated))))
        (loop for before in (frame-rows (search-job-frame plain)) for after in (frame-rows (propagation-frame propagation)) do
          (check (equal (row-key before) (row-key after)))
          (check (equal (row-known before) (row-known after)))
          (dotimes (z (second domain))
            (check (eq (accepted-arithmetic-value-p (row-requirement before) z) (accepted-arithmetic-value-p (row-requirement after) z)))))))))

(deftest integer-witnesses-divisibility-and-division-counterexamples
  (dolist (discovery (arithmetic-controls :int))
    (let ((name (operator-name (arithmetic-relation-operator (solve-discovery-relation discovery)))))
      (check (eq :conjecture (law-validation-status (solve-discovery-validation discovery))))
      (check (eq (if (eq name :/) :refuted :conjecture) (law-validation-status (solve-discovery-uniqueness discovery))))
      (check (not (certified-solve-discovery-p discovery)))
      (multiple-value-bind (propagation plain propagated)
          (compare-arithmetic-propagation discovery '(-2 -1 0 1 2))
        (check (zerop (propagation-narrowed propagation)))
        (check (plusp (propagation-suggested propagation)))
        (check (equalp (search-job-frame plain) (propagation-fallback propagation)))
        (check (typep propagated 'propagation-search))
        (check (null (set-exclusive-or (search-job-results plain) (propagation-search-results propagated)
                                      :key #'candidate-expression :test #'equal)))
        (when (search-job-results (propagation-search-primary propagated))
          (check (plusp (cdr (assoc :forward-replay (ledger-counts (propagation-search-ledger propagated))))))))))
  (let* ((multiplication (arithmetic-control :int :* 1)) (n (ash 1 128))
         (guard (solve-discovery-guard multiplication)))
    (dolist (case (list (list '(2 3) nil) (list '(2 4) t) (list '(-2 4) t) (list '(2 0) t)
                       (list '(0 0) nil) (list (list (1+ n) (* 3 (1+ n))) t) (list (list (1+ n) (1+ (* 3 (1+ n)))) nil)))
      (check (eq (second case) (result guard (arithmetic-inputs :int) (first case)))))
  (dolist (position '(0 1))
    (let* ((discovery (arithmetic-control :int :/ position))
           (query (if (zerop position) '(2 1) '(4 1)))
           (q (result (solve-discovery-witness discovery) (arithmetic-inputs :int) query))
           (other 3))
      (check (result (solve-discovery-guard discovery) (arithmetic-inputs :int) query))
      (check (/= q other))
      (dolist (z (list q other))
        (check (result (arithmetic-requirement (solve-discovery-relation discovery) position) (arithmetic-inputs :int 3) (append query (list z)))))))))

(deftest solver-certificates-and-bounds-do-not-overclaim
  (let* ((original (arithmetic-control (gf 5) :* 1)) (changed (copy-solve-discovery original)))
    (setf (solve-discovery-witness changed) (lit (gf 5) 0))
    (check (not (certified-solve-discovery-p changed)))
    (setf (solve-discovery-witness changed) (solve-discovery-witness original)
          (solve-discovery-guard changed) (lit :bool t))
    (check (not (certified-solve-discovery-p changed)))
    (validate-arithmetic-solver changed)
    (check (eq :refuted (law-validation-status (solve-discovery-validation changed))))
    (check (not (certified-solve-discovery-p changed)))
    (raises (discover-arithmetic-solver (solve-discovery-relation original) 1 '(0 1 2 3 4) :work-limit 1)))
  (let* ((original (arithmetic-control :int :+ 1)) (overfit (copy-solve-discovery original)))
    (validate-arithmetic-solver overfit :samples nil :uniqueness-samples nil)
    (check (eq :vacuous (law-validation-status (solve-discovery-validation overfit))))
    (check (eq :vacuous (law-validation-status (solve-discovery-uniqueness overfit))))
    (check (not (certified-solve-discovery-p overfit)))
    (setf (solve-discovery-witness overfit) (var 1 :int) (solve-discovery-guard overfit) (lit :bool t))
    (validate-arithmetic-solver overfit :samples '((0 2) (0 -2)) :uniqueness-samples '((0 2 2) (0 -2 -2)))
    (check (eq :conjecture (law-validation-status (solve-discovery-validation overfit))))
    (check (not (certified-solve-discovery-p overfit)))
    (validate-arithmetic-solver overfit :samples '((1 2)) :uniqueness-samples '((1 2 1)))
    (check (eq :refuted (law-validation-status (solve-discovery-validation overfit))))))

(deftest repeated-grid-occurrences-and-incomplete-forward-evidence
  (let* ((domain (gf 3)) (relation (observe-arithmetic-relation domain :+ '(0 0 1)))
         (source (observation-scope-frame (observation-job-scope (arithmetic-relation-observations relation)))))
    (check (= 9 (length (frame-rows source))))
    (check (= 9 (length (remove-duplicates (mapcar #'row-key (frame-rows source)) :test #'equal))))
    (check (not (arithmetic-relation-exhaustive-p relation)))
    (let* ((discovery (discover-arithmetic-solver relation 1 '(0 0 1)))
           (rows (frame-rows (solve-discovery-frame discovery))))
      (check (= 18 (length rows)))
      (check (= 18 (length (remove-duplicates (mapcar #'row-key rows) :test #'equal))))
      (check (= 8 (count '(0 0) rows :key #'row-known :test #'equal)))
      (validate-arithmetic-solver discovery)
      (check (eq :validated (law-validation-status (solve-discovery-validation discovery))))
      (check (eq :validated (law-validation-status (solve-discovery-uniqueness discovery))))
      ;; The law is about R, whose learned forward definedness still needs evidence.
      (check (not (certified-solve-discovery-p discovery)))
      (multiple-value-bind (propagation plain propagated)
          (compare-arithmetic-propagation discovery '(0 1 2))
        (check (zerop (propagation-narrowed propagation)))
        (check (equalp (search-job-frame plain) (search-job-frame propagated)))))))

(deftest au-reconstructs-the-actual-guarded-solver-families
  (dolist (domain (list (gf 5) (gf 7) :int))
    (let* ((scope (arithmetic-inputs domain))
           (statements (mapcar (lambda (d) (law-statement (solve-witness-law d))) (arithmetic-controls domain))))
      (multiple-value-bind (pattern substitutions) (anti-unify statements scope)
        (multiple-value-bind (model inputs) (compile-au-constructor pattern scope)
          (check-codec-roundtrip model inputs)
          (let* ((type (expression-type model inputs))
                 (frame (make-frame (make-schema :inputs inputs :target type)
                                    (loop for statement in statements for bindings in substitutions for key from 0 collect
                                      (make-row :key key :known (mapcar (lambda (input) (cdr (assoc (car input) bindings))) inputs)
                                                :requirement (set-requirement type (list statement))))))
                 (bad (lit type (lit :bool t)))
                 (job (start-search frame (make-language domain inputs :operators nil :literals nil)
                                    :expressions (list (decode-model (encode-model model inputs)) bad))))
            (check (eq :replay-complete (message-claim (resume-search job (max (description-size model inputs) (description-size bad inputs)) 1000000))))
            (check (= 1 (length (search-job-results job))))
            (check (equal model (candidate-expression (search-job-best job))))))))))
