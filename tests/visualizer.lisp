(load (merge-pathnames "../visualizer/export.lisp" *load-truename*))
(in-package #:lisploop-visualizer)

;;; Export must preserve correlated sets, empty sets, predicates and exact payloads.
(let* ((pair-type (tuple-type :int :int))
       (n (ash 1 256))
       (rows (list (make-row :key '("</script>" 0) :known (list n)
                             :allowed (finite-allowed pair-type '((0 0) (1 1))))
                   (make-row :key :empty :known (list (1+ n)) :allowed (finite-allowed pair-type nil))
                   (make-row :key :predicate :known (list n)
                             :allowed (predicate-allowed pair-type (lit :bool t)))))
       (frame (make-frame (make-schema :inputs '((7 . :int)) :target pair-type) rows))
       (before (sexp-text frame)) (data (frame-data frame))
       (exported-rows (gethash "rows" data))
       (allowed (gethash "allowed" (aref exported-rows 0)))
       (json (with-output-to-string (out) (write-json data out))))
  (assert (string= before (sexp-text frame)))
  (assert (equalp #(#("0" "0") #("1" "1")) (gethash "values" allowed)))
  (assert (equalp #() (gethash "values" (gethash "allowed" (aref exported-rows 1)))))
  (assert (eq :null (gethash "values" (gethash "allowed" (aref exported-rows 2)))))
  (assert (string= (format nil "~D" n) (aref (gethash "known" (aref exported-rows 0)) 0)))
  (assert (not (string= (aref (gethash "known" (aref exported-rows 0)) 0)
                        (aref (gethash "known" (aref exported-rows 1)) 0))))
  (assert (not (search "</script>" json)))
  (assert (search "\\u003C/script\\u003E" json)))

(let ((json (with-output-to-string (out)
              (write-json (object "text" (format nil "~A~%~C~C~C" "\"\\" #\Tab #\Return (code-char 0))
                                  "empty" #() "false" :false "null" :null) out))))
  (assert (search "\\\"\\\\\\u000A\\u0009\\u000D\\u0000" json))
  (assert (search "\"empty\":[]" json))
  (assert (search "\"false\":false" json))
  (assert (search "\"null\":null" json)))

;;; Account for the schema once and export the codec's actual bits, independent
;;; of the Lisp printer. These are the current results.md two-input examples.
(dolist (domain (list (gf 5) :int))
  (let* ((inputs (list (cons 0 domain) (cons 1 domain)))
         (sum (app (op :+ domain) (var 0 domain) (var 1 domain)))
         (packet (packet-text sum inputs)))
    (assert (= (if (eq domain :int) 35 50) (description-size sum inputs)))
    (assert (= (if (eq domain :int) 23 38) (header-size inputs domain)))
    (assert (= 12 (body-size sum inputs)))
    (assert (= (length packet) (+ (header-size inputs domain) (body-size sum inputs))))
    (multiple-value-bind (decoded decoded-inputs)
        (decode-model (map 'simple-bit-vector (lambda (c) (if (char= c #\1) 1 0)) packet))
      (assert (equal sum decoded))
      (assert (equal inputs decoded-inputs)))
    (let ((*print-base* 16) (*print-radix* t) (*print-pretty* t))
      (assert (string= packet (packet-text sum inputs))))))

;;; A long multiplication permits snapshots during construction and execution.
;;; Export does not charge, resume, reorder or otherwise modify the job state.
(let* ((domain :int) (inputs '((0 . :int))) (n (ash 1 256))
       (frame (make-frame (make-schema :inputs inputs :target domain)
                          (list (make-row :key :large :known (list n)
                                          :allowed (predicate-allowed domain (lit :bool t))))))
       (language (make-language domain inputs :literals '(0)))
       (square (app (op :* domain) (var 0 domain) (var 0 domain)))
       (job (start-observation-search (make-observation-scope frame language :id :snapshot)
                                      :expressions (list square))))
  (dolist (ceiling '(2 10 100 1000 1000000))
    (resume-observation-search job (description-size square inputs) ceiling)
    (let* ((before (sexp-text job)) (data (job-data job))
           (json (with-output-to-string (out) (write-json data out))))
      (assert (plusp (length json)))
      (assert (string= before (sexp-text job)))
      (assert (= 7 (gethash "encodingVersion" data)))
      (assert (= 7 (gethash "tariffVersion" data)))
      (loop for record across (gethash "records" data) do
        (assert (= (length (gethash "packet" record)) (gethash "size" record)))
        (assert (= (gethash "size" record) (+ (gethash "headerBits" record) (gethash "bodyBits" record)))))
      (if (< ceiling 1000000)
          (assert (zerop (length (gethash "buckets" data))))
          (progn
            (assert (= 1 (length (gethash "buckets" data))))
            (assert (string= (format nil "~D" (* n n))
                             (aref (gethash "values" (aref (gethash "records" data) 0)) 0))))))))

;;; Evaluation errors must retain their diagnostic without entering a bucket.
(let* ((field (gf 5)) (inputs (list (cons 0 field)))
       (frame (make-frame (make-schema :inputs inputs :target field)
                          (list (make-row :key :missing :known '(2)
                                          :allowed (predicate-allowed field (lit :bool t))))))
       (entry-type (tuple-type field field))
       (bad (app (op :lookup entry-type) (var 0 field) (lit (sequence-type entry-type) '((0 1)))))
       (job (start-observation-search (make-observation-scope frame (make-language field inputs))
                                      :expressions (list bad))))
  (resume-observation-search job 1000 1000000)
  (let* ((data (job-data job)) (record (aref (gethash "records" data) 0)))
    (assert (zerop (length (gethash "buckets" data))))
    (assert (string= "error" (gethash "status" record)))
    (assert (stringp (gethash "error" record)))
    (assert (string= ":MISSING" (gethash "failedKey" record)))))

;;; Quoted values display as syntax, including programs which would error if run.
(let* ((type (code-type '((99 . :int)) :int))
       (term (app (op :/ :int) (var 99 :int) (lit :int 0)))
       (frame (make-frame (make-schema :inputs (list (cons 0 type)) :target type)
                          (list (make-row :key :quoted :known (list term)
                                          :allowed (finite-allowed type (list term))))))
       (row (aref (gethash "rows" (frame-data frame)) 0)))
  (assert (string= (sexp-text term) (aref (gethash "known" row) 0)))
  (assert (string= (sexp-text term) (aref (gethash "values" (gethash "allowed" row)) 0))))

(format t "Visualizer exporter checks passed (joint targets, exact/quoted values, escaping, read-only snapshots, errors).~%")
