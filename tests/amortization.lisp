(in-package #:lisploop)

(defun validated-for-test (model inputs)
  (let ((state (advance-evaluation (start-program-validation model inputs) 1000000)))
    (check (eq :value (evaluation-status state)))
    (evaluation-value state)))

(deftest prepared-program-validation-boundaries-and-isolation
  (let* ((inputs (list (cons 0 :int)))
         (model (app (op :+ :int) (var 0 :int) (lit :int 1)))
         (snapshot (copy-tree model)) (work (syntax-work model))
         (unit (start-program-validation model inputs)) (batch (start-program-validation model inputs)))
    ;; Callers cannot change what is being validated, even while it is unpaid.
    (setf (car (first inputs)) 99 (second (second (rest model))) 7)
    (dolist (limit (list 0 1 (1- work) work))
      (loop while (< (evaluation-work unit) limit) do (advance-evaluation unit 1))
      (advance-evaluation batch (- limit (evaluation-work batch)))
      (check (equalp unit batch))
      (check (= limit (evaluation-work batch)))
      (check (eq (if (= limit work) :value :unknown) (evaluation-status batch)))
      (when (< limit work) (check (null (evaluation-value batch)))))
    (let ((program (evaluation-value batch)))
      (check (equal snapshot (validated-program-expression program)))
      (check (equal '((0 . :int)) (validated-program-inputs program)))
      (check (= 4 (evaluation-value (advance-evaluation (start-validated-evaluation program '(3)) 10000)))))
    (raises (start-validated-evaluation snapshot '(3))))
  ;; Invalid syntax, undeclared variables and duplicate schemas never mint evidence.
  (dolist (case (list (list (var 1 :int) '((0 . :int)))
                     (list (app (op :+ :int) (lit :int 0) (lit :bool t)) nil)
                     (list (lit :int 0) '((0 . :int) (0 . :int)))))
    (let ((run (advance-evaluation (start-program-validation (first case) (second case)) 10000)))
      (check (eq :error (evaluation-status run)))
      (check (null (evaluation-value run)))))
  ;; Returned literal/container/quoted conses must not expose validated code.
  (let* ((code (code-type nil :int))
         (value (app (op :+ :int) (lit :int 2) (lit :int 3)))
         (model (lit (sequence-type code) (list value)))
         (program (validated-for-test model nil))
         (first (advance-evaluation (start-validated-evaluation program nil) 10000)))
    (setf (first (first (evaluation-value first))) :corrupted)
    (check (equal (list value) (evaluation-value (advance-evaluation (start-validated-evaluation program nil) 10000))))
    (let ((stale (%make-validated-program :expression model :inputs nil :versions '(0 0 0))))
      (raises (start-validated-evaluation stale nil)))))

(deftest prepared-execution-keeps-input-checks-errors-and-cutoffs
  (let* ((scope '((99 . :int))) (code (code-type scope :int))
         (x (var 99 :int)) (source (app (op :+ :int) x (lit :int 0)))
         (inputs (list (cons 0 code) (cons 1 :int)))
         (model (app (op :code-child (tuple-type code code)) (var 0 code) (var 1 :int)))
         (program (validated-for-test model inputs)))
    (dolist (values (list (list source 0) (list source -1) (list source 2)
                         (list source (ash 1 128)) (list x 0)))
      (let* ((raw (evaluate model inputs values))
             (whole (advance-evaluation (start-validated-evaluation program values) 1000000))
             (total (evaluation-work whole))
             (unit (start-validated-evaluation program values)) (batch (start-validated-evaluation program values)))
        (check (eq (evaluation-status raw) (evaluation-status whole)))
        (check (equal (evaluation-value raw) (evaluation-value whole)))
        (check (= (evaluation-work raw) (+ (syntax-work model) total)))
        (dolist (limit (remove-duplicates (sort (list 0 1 (1- total) total) #'<)))
          (loop while (< (evaluation-work unit) limit) do (advance-evaluation unit 1))
          (advance-evaluation batch (- limit (evaluation-work batch)))
          (check (equalp unit batch))
          (check (= limit (evaluation-work batch)))
          (check (eq (if (= limit total) (evaluation-status whole) :unknown) (evaluation-status batch))))))
    (dolist (values (list (list (var 7 :int) 0) (list source t) (list source) (list source 0 1)))
      (check (eq :error (evaluation-status (advance-evaluation (start-validated-evaluation program values) 1000000))))))
  (let* ((domain (gf 5)) (inputs (list (cons 0 domain)))
         (model (app (op :/ domain) (lit domain 1) (var 0 domain)))
         (program (validated-for-test model inputs)))
    (dolist (value '(-1 5 t 0))
      (check (eq :error (evaluation-status (advance-evaluation (start-validated-evaluation program (list value)) 10000))))))
  ;; Constant programs have zero input work, but still obey a zero budget.
  (let* ((model (lit :int 7)) (program (validated-for-test model nil))
         (run (start-validated-evaluation program nil)))
    (advance-evaluation run 0)
    (check (eq :unknown (evaluation-status run)))
    (advance-evaluation run 1000)
    (check (= 7 (evaluation-value run)))
    (check (= (- (evaluation-work (evaluate model nil nil)) (syntax-work model)) (evaluation-work run)))
    (let ((ledger (make-ledger)) (bad (start-validated-evaluation program '(1))))
      (advance-accounted-evaluation bad 1 ledger :execution :error)
      (check (eq :error (evaluation-status bad)))
      (check (= 1 (ledger-total ledger))))))

(defun amortization-fixture ()
  (let* ((domain (gf 5)) (inputs (list (cons 99 domain))) (x (var 99 domain))
         (expression (app (op :+ domain) x (lit domain 0)))
         (law (checked-law (make-law domain inputs expression x))))
    (values domain inputs expression x law)))

(deftest rewrite-preparation-publication-reuse-and-scope
  (multiple-value-bind (domain inputs expression x law) (amortization-fixture)
    (let* ((library (prepare-rewrite-library (list law) domain))
           (cache (rewrite-library-program-cache library))
           (cold (start-rewriting expression inputs library))
           (orphan (start-rewriting expression inputs library))
           (static (syntax-work (second (first (rewriting-pending-programs cold))))))
      (check (zerop (hash-table-count cache)))
      (advance-rewriting cold (rewriting-setup-work cold))
      (check (zerop (hash-table-count cache)))
      (advance-rewriting cold (1- static))
      (check (zerop (hash-table-count cache)))
      (check (eq :unknown (rewriting-status cold)))
      (advance-rewriting cold 1)
      (check (= 1 (hash-table-count cache)))
      (check (eq :unknown (rewriting-status cold)))
      (check (zerop (rewriting-work orphan)))
      (check (rewriting-pending-programs orphan))
      (advance-rewriting cold 1000000)
      (let* ((warm (start-rewriting expression (copy-tree inputs) library))
             (program (cdr (first (rewriting-programs cold)))))
        (check (null (rewriting-pending-programs warm)))
        (check (eq program (cdr (first (rewriting-programs warm)))))
        (advance-rewriting warm 1000000)
        (check (equal x (rewriting-value warm)))
        (check (equal (rewriting-value cold) (rewriting-value warm)))
        (check (= (* 2 static) (- (rewriting-work cold) (rewriting-work warm)))))
      ;; Reusing a library in another scope prepares and validates another program.
      (let* ((larger (append (copy-tree inputs) (list (cons 0 :bool))))
             (other (start-rewriting expression larger library)))
        (check (rewriting-pending-programs other))
        (setf (car (first larger)) 123) ; caller mutation cannot change the cache key
        (advance-rewriting other 1000000)
        (check (equal x (rewriting-value other)))
        (check (= 2 (hash-table-count cache)))
        (check (null (rewriting-pending-programs
                      (start-rewriting expression (append inputs (list (cons 0 :bool))) library)))))
      ;; Frozen rules are insulated from both original evidence and inspection copies.
      (setf (law-guard (law-validation-law law)) (lit :bool nil))
      (setf (rewrite-rule-replacement (first (rewrite-library-rules library))) (lit domain 4))
      (check (equal x (rewriting-value (advance-rewriting (start-rewriting expression inputs library) 1000000))))
      (let ((other-scope (list (cons 0 domain))))
        (check (equal (var 0 domain)
                      (rewriting-value (advance-rewriting
                                        (start-rewriting (app (op :+ domain) (var 0 domain) (lit domain 0)) other-scope library)
                                        1000000)))))
      (raises (prepare-rewrite-library (list law) domain))
      (setf (car (rewrite-library-versions library)) 0)
      (raises (start-rewriting expression inputs library))))
  ;; An empty prepared bundle is also a valid cached result.
  (let* ((library (prepare-rewrite-library nil (gf 5)))
         (cold (advance-rewriting (start-rewriting (lit (gf 5) 0) nil library) 100)))
    (check (eq :complete (rewriting-status cold)))
    (check (= 1 (hash-table-count (rewrite-library-program-cache library))))))

(deftest rewrite-cache-budget-parity-across-multiple-rules
  (multiple-value-bind (domain inputs expression x law) (amortization-fixture)
    (let* ((second (checked-law (make-law domain inputs (app (op :* domain) x (lit domain 1)) x)))
           (unit-library (prepare-rewrite-library (list law second) domain))
           (batch-library (prepare-rewrite-library (list law second) domain))
           (unit (start-rewriting expression inputs unit-library))
           (batch (start-rewriting expression inputs batch-library))
           (static (mapcar (lambda (entry) (syntax-work (second entry))) (rewriting-pending-programs unit)))
           (setup (rewriting-setup-work unit)) (ready (+ setup (reduce #'+ static))))
      (dolist (limit (list 0 1 setup (+ setup (first static)) (1- ready) ready (+ ready 1) 100000))
        (loop while (and (< (rewriting-work unit) limit) (eq :unknown (rewriting-status unit))) do (advance-rewriting unit 1))
        (advance-rewriting batch (- limit (rewriting-work batch)))
        (check (equalp unit batch))
        (check (= (if (< limit ready) 0 1) (hash-table-count (rewrite-library-program-cache unit-library))))
        (check (<= (rewriting-work batch) limit)))
      (let* ((warm-unit (start-rewriting expression inputs unit-library))
             (warm-batch (start-rewriting expression inputs batch-library))
             (reference (advance-rewriting (start-rewriting expression inputs unit-library) 100000))
             (total (rewriting-work reference)))
        (dolist (limit (sort (remove-duplicates (list 0 1 (rewriting-setup-work warm-unit) (1- total) total)) #'<))
          (loop while (< (rewriting-work warm-unit) limit) do (advance-rewriting warm-unit 1))
          (advance-rewriting warm-batch (- limit (rewriting-work warm-batch)))
          (check (equalp warm-unit warm-batch))
          (check (= limit (rewriting-work warm-batch))))
        (check (equal x (rewriting-value warm-batch)))))))

(defun call-counting-functions (names thunk)
  "Count actual preparation calls, without replacing their implementation."
  (let ((originals (mapcar (lambda (name) (cons name (symbol-function name))) names))
        (counts (make-hash-table)))
    (unwind-protect
         (progn
           (dolist (entry originals)
             (let ((name (car entry)) (function (cdr entry)))
               (setf (symbol-function name)
                     (lambda (&rest arguments)
                       (incf (gethash name counts 0)) (apply function arguments)))))
           (funcall thunk counts))
      (dolist (entry originals) (setf (symbol-function (car entry)) (cdr entry))))))

(deftest checked-search-amortizes-once-with-fresh-job-isolation
  (multiple-value-bind (frame oracle) (gf5-fixture)
    (let* ((domain (gf 5)) (inputs (schema-inputs (frame-schema frame))) (x (var 0 domain))
           (law (checked-law (make-law domain inputs (app (op :+ domain) x (lit domain 0)) x)))
           (language (make-language domain inputs)) (bound (description-size oracle inputs)))
      (call-counting-functions
       '(compile-rule-transformer start-program-validation start-validated-evaluation)
       (lambda (counts)
         (dotimes (i 2)
           (let ((job (start-search frame language :laws (list law))))
             (check (eq :bounded-exhaustion (message-claim (resume-search job bound 1000000))))
             (check (= 649 (loop for bucket being the hash-values of (enumerator-buckets (search-job-enumerator job))
                                sum (length bucket))))
             (check (= 10 (length (search-job-results job))))
             (check (= 31 (search-job-reused-rejections job)))
             (check (< (ledger-total (search-job-ledger job)) 1000000))
             (check (= (1+ i) (gethash 'compile-rule-transformer counts)))
             (check (= (1+ i) (gethash 'start-program-validation counts)))
             (check (= (* 597 (1+ i)) (gethash 'start-validated-evaluation counts))))))))))
