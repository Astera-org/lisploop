(in-package #:lisploop)

(deftest division-subtraction-and-lazy-conditionals
  (dolist (case '((5 2 2) (-5 2 -2) (5 -2 -2) (-5 -2 2) (1 2 0) (0 -2 0)))
    (destructuring-bind (a b quotient) case
      (check (= quotient (result (app (op :/ :int) (lit :int a) (lit :int b)))))))
  (let ((n (1+ (ash 1 256))))
    (check (= (- n 2) (result (app (op :- :int) (lit :int n) (lit :int 2)))))
    (check (= (ash 1 255) (result (app (op :/ :int) (lit :int n) (lit :int 2))))))
  (dolist (domain (list :int (gf 5) (gf 7) (gf 263)))
    (let* ((bad (app (op :/ domain) (lit domain 1) (lit domain 0)))
           (zero (lit domain 0)))
      (check (eq :error (evaluation-status (evaluate bad nil nil))))
      (check (eq :error (evaluation-status (evaluate (app (op :* domain) zero bad) nil nil))))
      (dolist (yes '(nil t))
        (let ((safe (app (op :if domain) (lit :bool yes) (if yes zero bad) (if yes bad zero))))
          (check (= 0 (result safe)))
          (check-codec-roundtrip safe nil)))
      (check (eq :error (evaluation-status
                         (evaluate (app (op :if domain) (lit :bool t) bad zero) nil nil))))
      (check (eq :error (evaluation-status
                         (evaluate (app (op :if domain) (lit :bool nil) (lit :bool t) zero) nil nil))))))
  (dolist (p '(5 7 263))
    (let ((domain (gf p)))
      (loop for b from 1 below p do
        (let ((inverse (loop for n from 1 below p when (= 1 (mod (* n b) p)) return n)))
          (loop for a below (if (= p 263) 3 p) do
            (check (= (mod (* a inverse) p)
                      (result (app (op :/ domain) (lit domain a) (lit domain b)))))
            (check (= (mod (- a b) p)
                      (result (app (op :- domain) (lit domain a) (lit domain b)))))))))))

(deftest conditional-and-division-resumption
  (let* ((inputs '((0 . :int))) (x (var 0 :int))
         (safe (app (op :if :int) (app (op := :int) x (lit :int 0))
                    (lit :int 0) (app (op :/ :int) (lit :int (ash 1 256)) x))))
    (check-codec-roundtrip safe inputs)
    (dolist (value '(0 1 -2))
      (let ((unit (start-evaluation safe inputs (list value)))
            (batch (start-evaluation safe inputs (list value))))
        (dolist (budget '(0 1 10 90 200 500 1000 10000))
          (loop repeat budget do (advance-evaluation unit 1))
          (advance-evaluation batch budget)
          (check (equalp unit batch)))
        (check (eq :value (evaluation-status batch)))))
    (let ((bad (app (op :/ :int) x (lit :int 0))))
      (let ((unit (start-evaluation bad inputs '(2))) (batch (start-evaluation bad inputs '(2))))
        (loop repeat 100 do (advance-evaluation unit 1))
        (advance-evaluation batch 100)
        (check (equalp unit batch))
        (check (eq :error (evaluation-status batch)))))
    ;; Unselected arithmetic is not charged, although its syntax is validated.
    (check (< (evaluation-work (evaluate safe inputs '(0)))
               (evaluation-work (evaluate safe inputs '(1)))))))

(deftest mixed-type-enumeration-and-predicate-frames
  (let* ((inputs '((0 . :bool) (1 . :int)))
         (operators (list (op :if :int) (op :if :bool) (op := :int)))
         (language (make-language :int inputs :operators operators :literals '(0)))
         (frame (simple-frame :int inputs '(((nil 0) 0) ((nil 1) 0) ((t 0) 0) ((t 1) 1))))
         (model (app (op :if :int) (var 0 :bool) (var 1 :int) (lit :int 0)))
         (bound (description-size model inputs))
         (job (start-search frame language))
         (leaves (list (var 0 :bool) (var 1 :int) (lit :int 0) (lit :bool nil) (lit :bool t)))
         (reference (copy-list leaves)))
    ;; Independent one-application Cartesian reference. A second application
    ;; cannot fit this bound; all arities and both result types are checked.
    (dolist (operator operators)
      (labels ((products (types args)
                 (if (null types) (push (apply #'app operator (reverse args)) reference)
                     (dolist (leaf leaves)
                       (when (equal (first types) (expression-type leaf inputs))
                         (products (rest types) (cons leaf args)))))))
        (products (second (operator-type operator)) nil)))
    (setf reference (remove-if (lambda (e) (> (body-size e inputs) (body-size model inputs))) reference))
    (check (eq :bounded-exhaustion (message-claim (resume-search job bound 1000000))))
    (check (find model (search-job-results job) :key #'candidate-expression :test #'equal))
    (let ((actual (loop for bucket being the hash-values of (enumerator-buckets (search-job-enumerator job))
                        append (coerce bucket 'list))))
      (check (= (length actual) (length reference)))
      (check (null (set-exclusive-or actual reference :test #'equal))))
    (dolist (expression reference) (check-codec-roundtrip expression inputs)))
  (let* ((inputs '((0 . :int)))
         (frame (simple-frame :bool inputs '(((-1) nil) ((0) t) ((1) nil))))
         (language (make-language :int inputs :operators (list (op := :int)) :literals '(0)))
         (oracle (app (op := :int) (var 0 :int) (lit :int 0)))
         (job (start-search frame language)))
    (check (eq :bounded-exhaustion (message-claim (resume-search job (description-size oracle inputs) 100000))))
    (let* ((predicate (candidate-expression (search-job-best job)))
           (allowed (predicate-allowed :int predicate)))
      (check (accepts allowed 0)) (check (not (accepts allowed 2)))
      (multiple-value-bind (pattern substitutions) (anti-unify (list predicate oracle) inputs)
        (check (equal predicate (instantiate pattern (first substitutions))))
        (check (equal oracle (instantiate pattern (second substitutions))))))))

(defun checked-law (law)
  (let ((validation (resume-law-validation (start-law-validation law) 1000000)))
    (check (eq :validated (law-validation-status validation)))
    validation))

(defun test-law-discovery (domain)
  (let* ((inputs (list (cons 0 domain) (cons 1 domain)))
         (rows (loop for a below (second domain) append (loop for b below (second domain) collect (list a b))))
         (scope (make-observation-scope (probe-frame domain inputs rows) (make-language domain inputs)))
         (job (start-observation-search scope))
         (bound (+ (header-size inputs domain) (application-overhead (op :+ domain))
                   (* 2 (body-size (lit domain 0) inputs)))))
    (check (eq :bounded-exhaustion (message-claim (resume-observation-search job bound 1000000))))
    (values (propose-observed-laws job) job)))

(defun find-equation (laws left right)
  (find-if (lambda (law) (let ((sides (rest (law-equation law))))
                           (or (equal sides (list left right)) (equal sides (list right left))))) laws))

(deftest laws-discovered-and-independently-validated
  (dolist (p '(5 7))
    (let* ((domain (gf p)) (a (var 0 domain)) (b (var 1 domain)) (plus (op :+ domain))
           (laws (test-law-discovery domain)))
      (check (find-equation laws (app plus a b) (app plus b a)))
      (check (find-equation laws (app plus a (lit domain 0)) a))
      (dolist (law laws)
        (let ((validation (checked-law law)))
          (check (= (* p p) (law-certificate-assignments (law-validation-certificate validation))))
          (check-codec-roundtrip (law-statement law) (law-inputs law)))))))

(deftest law-scope-counterexamples-and-cutoffs
  (let* ((domain (gf 5)) (inputs (list (cons 0 domain))) (x (var 0 domain))
         (power (loop with e = x repeat 4 do (setf e (app (op :* domain) e x)) finally (return e)))
         (law (make-law domain inputs power x))
         (five (checked-law law))
         (seven (resume-law-validation (start-law-validation (retype-law law (gf 7))) 1000000))
         (integer (resume-law-validation (start-law-validation (retype-law law :int) :samples '((0) (1) (2))) 1000000)))
    (check (eq :refuted (law-validation-status seven)))
    (check (equal '(2) (getf (law-validation-counterexample seven) :inputs)))
    (check (eq :refuted (law-validation-status integer)))
    (raises (prepare-rewrite-library (list five) (gf 7)))
    (let* ((square (make-law domain inputs (app (op :* domain) x x) x))
           (sample (resume-law-validation (start-law-validation square :samples '((0) (1))) 100000)))
      (check (eq :conjecture (law-validation-status sample)))
      (check (null (law-validation-certificate sample)))
      (raises (prepare-rewrite-library (list sample) domain))
      (check (eq :refuted (law-validation-status
                          (resume-law-validation (start-law-validation square) 100000)))))
    (let ((unit (start-law-validation law)) (batch (start-law-validation law)))
      (dolist (limit '(0 1 10 100 500 1000 10000))
        (resume-law-validation unit limit :quantum 1)
        (resume-law-validation batch limit)
        (check (equalp unit batch))
        (check (<= (ledger-total (law-validation-ledger batch)) limit)))
      (check (eq :validated (law-validation-status batch))))
    (let ((vacuous (make-law domain inputs x (lit domain 0) :guard (lit :bool nil))))
      (check (eq :vacuous (law-validation-status
                          (resume-law-validation (start-law-validation vacuous) 100000)))))
    ;; Validation owns a copy, and its certificate is bound to exact DSL data.
    (setf (law-guard law) (lit :bool nil))
    (check (prepare-rewrite-library (list five) domain))
    (setf (law-guard (law-validation-law five)) (lit :bool nil))
    (raises (prepare-rewrite-library (list five) domain))))

(defun normalize-for-test (expression inputs validations domain)
  (let ((state (start-rewriting expression inputs (prepare-rewrite-library validations domain))))
    (advance-rewriting state 10000000)
    (check (eq :complete (rewriting-status state)))
    (rewriting-value state)))

(deftest guarded-rewrites-preserve-errors-and-terminate
  (let* ((domain (gf 5)) (inputs (list (cons 0 domain))) (x (var 0 domain))
         (zero (lit domain 0)) (one (lit domain 1)) (mul (op :* domain)) (div (op :/ domain))
         (condition (app (op := domain) x zero)) (guard (negate-predicate condition))
         (cancel (make-law domain inputs (app div x x) one :guard guard))
         (rules (list (checked-law (make-law domain inputs (app mul zero x) zero))
                      (checked-law (make-law domain inputs (app (op :- domain) x x) zero))
                      (checked-law cancel)))
         (bad (app div one zero))
         (safe (app (op :if domain) condition zero (app div x x)))
         (rewritten (normalize-for-test safe inputs rules domain)))
    (check (equal rewritten (app (op :if domain) condition zero one)))
    (check (equal (app div x x) (normalize-for-test (app div x x) inputs rules domain)))
    (check (eq :refuted (law-validation-status
                        (resume-law-validation (start-law-validation
                          (make-law domain inputs (app div x x) one)) 100000))))
    (dolist (expression (list (app mul zero bad) (app (op :- domain) bad bad)))
      (check (equal expression (normalize-for-test expression inputs rules domain)))
      (check (eq :error (evaluation-status (evaluate expression inputs '(0))))))
    (dotimes (value 5) (check (= (result safe inputs (list value)) (result rewritten inputs (list value)))))
    (let ((unit (start-rewriting safe inputs (prepare-rewrite-library rules domain)))
          (batch (start-rewriting safe inputs (prepare-rewrite-library rules domain))))
      (dolist (budget '(0 1 10 100 1000 10000))
        (loop repeat budget do (advance-rewriting unit 1))
        (advance-rewriting batch budget)
        (check (equalp unit batch)))
      (check (eq :complete (rewriting-status batch)))))
  (let* ((domain (gf 5)) (inputs (list (cons 0 domain) (cons 1 domain)))
         (a (var 0 domain)) (b (var 1 domain)) (plus (op :+ domain))
         (law (checked-law (make-law domain inputs (app plus a b) (app plus b a)))))
    (check (equal (normalize-for-test (app plus a b) inputs (list law law) domain)
                  (normalize-for-test (app plus b a) inputs (list law law) domain)))))

(deftest equality-constrained-search-keeps-alternatives-and-costs
  (multiple-value-bind (frame oracle) (gf5-fixture)
    (let* ((domain (gf 5)) (inputs (schema-inputs (frame-schema frame)))
           (a (var 0 domain)) (plus (op :+ domain))
           (laws (test-law-discovery domain))
           (law (checked-law (find-equation laws (app plus a (lit domain 0)) a)))
           (language (make-language domain inputs))
           (plain (start-search frame language :call-id :plain))
           (unit (start-search frame language :call-id :checked :laws (list law)))
           (batch (start-search frame language :call-id :checked :laws (list law)))
           (bound (description-size oracle inputs)))
      (dolist (limit '(0 1 100 500 2000 10000 100000 3000000))
        (resume-search unit bound limit :quantum 1)
        (resume-search batch bound limit)
        (check (equalp unit batch))
        (check (<= (ledger-total (search-job-ledger batch)) limit)))
      (resume-search plain bound 2000000)
      (check (= bound (search-job-completed-bound batch)))
      (check (plusp (search-job-reused-rejections batch)))
      (check (equalp (enumerator-buckets (search-job-enumerator plain))
                     (enumerator-buckets (search-job-enumerator batch))))
      (check (equal (mapcar (lambda (c) (list (candidate-expression c) (candidate-size c) (candidate-run-work c)))
                            (search-job-results plain))
                    (mapcar (lambda (c) (list (candidate-expression c) (candidate-size c) (candidate-run-work c)))
                            (search-job-results batch)))))))

(deftest partial-terms-and-boolean-guards
  (let* ((domain (gf 5)) (inputs (list (cons 0 domain) (cons 1 :bool)))
         (x (var 0 domain)) (c (var 1 :bool))
         (law (checked-law (make-law domain inputs (app (op :if domain) c x x) x)))
         (bad (app (op := domain) (app (op :/ domain) x (lit domain 0)) x))
         (expression (app (op :if domain) bad x x)))
    ;; Dropping a failing CONDITION is just as unsound as dropping an operand.
    (check (equal expression (normalize-for-test expression inputs (list law) domain)))
    (check (eq :error (evaluation-status (evaluate expression inputs '(1 t)))))
    (check (equal x (normalize-for-test (app (op :if domain) c x x) inputs (list law) domain))))
  (let* ((domain (gf 5)) (inputs (list (cons 0 domain))) (x (var 0 domain))
         (guard (negate-predicate (app (op := domain) x (lit domain 0))))
         (law (make-law domain inputs (app (op :/ domain) x x) (lit domain 1) :guard guard))
         (state (start-law-validation law)))
    (resume-law-validation state 1)
    (check (eq :unknown (law-validation-status state)))
    (check (null (law-validation-certificate state)))
    (raises (prepare-rewrite-library (list state) domain))
    (resume-law-validation state 100000)
    (check (= 4 (law-certificate-active (law-validation-certificate state))))
    (let ((bad-guard (make-law domain inputs x x :guard
                               (app (op := domain) (app (op :/ domain) x (lit domain 0)) x))))
      (check (eq :refuted (law-validation-status
                           (resume-law-validation (start-law-validation bad-guard) 100000)))))
    ;; A Boolean observation target must not turn numeric intermediates into
    ;; Boolean records merely because its packet header is shorter.
    (let* ((frame (probe-frame :bool inputs '((0) (1))))
           (job (start-observation-search (make-observation-scope frame
                     (make-language domain inputs :operators (list (op := domain))))))
           (bound (description-size (app (op := domain) x x) inputs)))
      (check (eq :bounded-exhaustion (message-claim (resume-observation-search job bound 100000))))
      (check (every (lambda (record) (eq :bool (observed-expression-type record))) (observation-job-records job)))
      (check (find-observation job (app (op := domain) x x))))))

(deftest exhaustive-rewrite-preservation-on-tiny-grammar
  (let* ((domain (gf 2)) (inputs (list (cons 0 domain))) (x (var 0 domain))
         (zero (lit domain 0)) (one (lit domain 1))
         (laws (mapcar #'checked-law
                        (list (make-law domain inputs (app (op :+ domain) x zero) x)
                              (make-law domain inputs (app (op :* domain) x zero) zero)
                              (make-law domain inputs (app (op :- domain) x x) zero)
                              (make-law domain inputs (app (op :/ domain) x one) x))))
         (library (prepare-rewrite-library laws domain))
         (operators (mapcar (lambda (name) (op name domain)) '(:+ :* :- :/)))
         (leaves (list x zero one)))
    (dolist (expression (append leaves (reference-node-trees leaves operators 1)
                                (reference-node-trees leaves operators 2)))
      (let* ((state (advance-rewriting (start-rewriting expression inputs library) 1000000))
             (normalized (rewriting-value state)))
        (check (eq :complete (rewriting-status state)))
        (check (<= (description-size normalized inputs) (description-size expression inputs)))
        (dotimes (value 2)
          (let ((before (evaluate expression inputs (list value)))
                (after (evaluate normalized inputs (list value))))
            (check (eq (evaluation-status before) (evaluation-status after)))
            (when (eq :value (evaluation-status before))
              (check (equal (evaluation-value before) (evaluation-value after))))))))))

(deftest truncating-division-does-not-transfer-field-identities
  (let* ((domain (gf 5)) (inputs (list (cons 0 domain))) (x (var 0 domain)) (two (lit domain 2))
         (law (make-law domain inputs (app (op :* domain) two (app (op :/ domain) x two)) x))
         (field (checked-law law))
         (integer (resume-law-validation (start-law-validation (retype-law law :int) :samples '((2) (3))) 100000)))
    (check (eq :refuted (law-validation-status integer)))
    (check (equal '(3) (getf (law-validation-counterexample integer) :inputs)))
    (raises (prepare-rewrite-library (list field) :int)))
  (let* ((expression (app (op :/ :int) (lit :int 5) (lit :int 2)))
         (packet (encode-model expression)) (start (+ (header-size nil :int) 2)))
    (check-codec-roundtrip expression nil)
    (setf (subseq packet start (+ start +opcode-width+)) #*1111)
    (raises (decode-model packet))))

(defun reference-typed-trees (type leaves operators applications inputs)
  "Independent reference indexed by operator COUNT, not encoded size partitions."
  (if (zerop applications)
      (remove-if-not (lambda (leaf) (equal type (expression-type leaf inputs))) leaves)
      (labels ((arguments (types remaining)
                 (if (null types) (when (zerop remaining) (list nil))
                     (loop for used from 0 to remaining append
                       (loop for first in (reference-typed-trees (first types) leaves operators used inputs) append
                         (loop for rest in (arguments (rest types) (- remaining used)) collect (cons first rest)))))))
        (loop for operator in operators
              when (equal type (third (operator-type operator))) append
                (loop for args in (arguments (second (operator-type operator)) (1- applications))
                      collect (apply #'app operator args))))))

(deftest nested-mixed-type-enumeration-reference
  (let* ((domain (gf 2)) (inputs (list (cons 0 domain)))
         (operators (list (op :if domain) (op :if :bool) (op := domain)))
         (language (make-language domain inputs :operators operators))
         (frame (probe-frame domain inputs '((0) (1))))
         (leaves (list (var 0 domain) (lit domain 0) (lit domain 1) (lit :bool nil) (lit :bool t)))
         (body-bound 24) (bound (+ (header-size inputs domain) body-bound))
         (unit (start-search frame language :call-id :typed))
         (batch (start-search frame language :call-id :typed))
         (reference (remove-if (lambda (e) (> (body-size e inputs) body-bound))
                               (loop for type in (list domain :bool) append
                                 (loop for count from 0 to 2 append
                                   (reference-typed-trees type leaves operators count inputs))))))
    (dolist (limit '(1 100 1000 10000 2000000))
      (resume-search unit bound limit :quantum 1)
      (resume-search batch bound limit)
      (check (equalp unit batch)))
    (check (= bound (search-job-completed-bound batch)))
    (let ((actual (loop for bucket being the hash-values of (enumerator-buckets (search-job-enumerator batch))
                        append (coerce bucket 'list))))
      (check (= (length actual) (length reference)))
      (check (null (set-exclusive-or actual reference :test #'equal))))))
