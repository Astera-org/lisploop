(in-package #:lisploop)

(deftest abstraction-stages-1-to-3-and-controls
  (let* ((domain :int)
         (work (make-ledger))
         (inputs (list (cons 0 domain) (cons 1 domain)))
         (x0 (var 0 domain))
         (x1 (var 1 domain))
         (plus (op :+ domain))
         (mul (op :* domain))
         (t1 (app plus (lit domain 2) (lit domain 2)))
         (t2 (app mul (lit domain 3) (lit domain 3)))
         (t2-broken (app mul (lit domain 3) (lit domain 4))))
    ;; Stage 1 & 2 & 3: Aligned AU with operator hole + repeated hole
    (multiple-value-bind (pat substs)
        (anti-unify (list t1 t2) inputs work)
      (let ((ref-pat (m6-reference-aligned-au (list t1 t2) inputs)))
        (check (patterns-isomorphic-p pat ref-pat inputs work))
        (check (= 2 (length (pattern-holes pat))))
        (check (= 2 (length substs)))
        ;; Pattern instantiation and first-order matching
        (loop for target in (list t1 t2)
              for subst in substs
              do (check (equal target (instantiate pat subst)))
                 (multiple-value-bind (m-subst matched-p)
                     (match-pattern pat target inputs work)
                   (check matched-p)
                   (check (equal subst m-subst))))
        ;; Constructor compilation via :code-apply and child substitution frame
        (multiple-value-bind (ctor-expr ctor-inputs)
            (compile-au-constructor pat inputs work)
          (check (= 2 (length ctor-inputs)))
          (let ((sub-frame (au-substitutions-frame pat substs :inputs inputs :ledger work)))
            (check (= 2 (length (frame-rows sub-frame))))
            (let ((sub-model (lookup-model sub-frame work)))
              (check (plusp (replay-model sub-model sub-frame))))
            (loop for target in (list t1 t2)
                  for row in (frame-rows sub-frame)
                  for tuple-val = (first (extract-allowed-values (row-requirement row)))
                  for ev = (evaluate ctor-expr ctor-inputs tuple-val :ledger work)
                  do (check (eq :value (evaluation-status ev)))
                     (check (equal target (evaluation-value ev))))))))
    ;; Control 1: Breaking repeated hole (* 3 3) -> (* 3 4) yields 3 distinct holes
    (multiple-value-bind (broken-pat broken-substs)
        (anti-unify (list t1 t2-broken) inputs work)
      (check (= 3 (length (pattern-holes broken-pat))))
      (loop for target in (list t1 t2-broken)
            for subst in broken-substs
            do (check (equal target (instantiate broken-pat subst)))))
    ;; Control 2: Incompatible operator signatures (= :int) vs (= (gf 5)) -> whole-AST hole ?0
    (let* ((eq-int (app (op := domain) (lit domain 1) (lit domain 1)))
           (eq-gf5 (app (op := (gf 5)) (lit (gf 5) 1) (lit (gf 5) 1))))
      (multiple-value-bind (incompat-pat incompat-substs)
          (anti-unify (list eq-int eq-gf5) nil work)
        (check (hole-p incompat-pat))
        (check (eq :bool (ast-type incompat-pat)))
        (check (equal eq-int (instantiate incompat-pat (first incompat-substs))))
        (check (equal eq-gf5 (instantiate incompat-pat (second incompat-substs))))))
    ;; Control 3: Incompatible result sorts (:bool vs :int) must signal an error
    (raises (anti-unify (list (lit :bool t) (lit domain 1)) nil work))
    ;; Control 4: Planted template whose substitutions share extra structure tightens to LGG
    (let* ((loose-pat (app plus (hole 0 domain) (hole 1 domain)))
           (s1 (list (cons 0 x0) (cons 1 (app mul (lit domain 2) x0))))
           (s2 (list (cons 0 x1) (cons 1 (app mul (lit domain 2) x1))))
           (inst1 (instantiate loose-pat s1))
           (inst2 (instantiate loose-pat s2))
           (tight-pat (anti-unify (list inst1 inst2) inputs work))
           (expected-lgg (app plus (hole 0 domain) (app mul (lit domain 2) (hole 0 domain)))))
      (check (patterns-isomorphic-p tight-pat expected-lgg inputs work))
      (check (not (patterns-isomorphic-p tight-pat loose-pat inputs work))))))

(deftest abstraction-subtree-path-and-occurrence-indexing
  (let* ((domain :int)
         (work (make-ledger))
         (inputs (list (cons 0 domain) (cons 1 domain)))
         (x0 (var 0 domain))
         (x1 (var 1 domain))
         (plus (op :+ domain))
         (mul (op :* domain))
         (tree (app plus
                    (app mul x0 (lit domain 2))
                    (app plus x1 (lit domain 3))))
         (occs (collect-tree-occurrences tree inputs :tree-index 0 :ledger work)))
    (check (= 7 (length occs)))
    (dolist (occ occs)
      (let ((path (tree-occurrence-path occ))
            (sub (tree-occurrence-term occ))
            (wrapper (tree-occurrence-wrapper occ)))
        (check (equal sub (subtree-at-path tree path)))
        (check (equal tree (replace-at-path tree path sub)))
        (check (equal tree (instantiate wrapper (list (cons (tree-occurrence-context-hole-id occ) sub)))))))))

(deftest abstraction-tree-corpus-packet-and-spliced-model
  (let* ((domain :int)
         (work (make-ledger)))
    (multiple-value-bind (trees inputs oracle)
        (planted-abstraction-fixture :domain domain :repetitions 1 :include-unrelated-p t :ledger work)
      (let* ((corpus (make-tree-corpus trees inputs :domain domain :ledger work))
             (decoded (decode-tree-corpus (tree-corpus-packet corpus)))
             (c-frame (tree-corpus-frame corpus))
             (spliced-model (corpus-abstraction-model
                             corpus
                             (getf oracle :pattern)
                             (getf oracle :paths)
                             (getf oracle :substitutions)
                             work))
             (ev (evaluate spliced-model nil nil :ledger work)))
        (check (equal trees decoded))
        (check (= 1 (length (frame-rows c-frame))))
        (check (eq :value (evaluation-status ev)))
        (check (equal (tree-corpus-packet corpus) (evaluation-value ev)))
        (check (equal trees (decode-tree-corpus (evaluation-value ev))))))))

(deftest abstraction-hidden-occurrence-subgraph-search-and-compression
  (let* ((domain :int)
         (work (make-ledger)))
    (multiple-value-bind (trees1 inputs1 oracle1)
        (planted-abstraction-fixture :domain domain :repetitions 1 :ledger work)
      (multiple-value-bind (best-comp1 best-struct1 proposals1)
          (discover-subexpression-abstractions trees1 inputs1 :ledger work)
        (let ((dict1 (find :dictionary proposals1 :key #'subexpression-abstraction-kind))
              (root1 (find :aligned-root proposals1 :key #'subexpression-abstraction-kind)))
          ;; Hidden paths and planted template recovered on 4 wrapped trees
          (check (patterns-isomorphic-p (getf oracle1 :pattern)
                                        (subexpression-abstraction-pattern best-struct1)
                                        inputs1 work))
          (check (equal (getf oracle1 :paths) (subexpression-abstraction-paths best-struct1)))
          (check (patterns-isomorphic-p (getf oracle1 :pattern)
                                        (subexpression-abstraction-pattern best-comp1)
                                        inputs1 work))
          ;; Positive bit compression beating literal, whole-tree dictionary, and aligned root AU
          (check (plusp (subexpression-abstraction-gain best-comp1)))
          (check (< (subexpression-abstraction-bits best-comp1)
                    (subexpression-abstraction-literal-bits best-comp1)))
          (check (< (subexpression-abstraction-bits best-comp1)
                    (subexpression-abstraction-bits dict1)))
          (check (< (subexpression-abstraction-bits best-comp1)
                    (subexpression-abstraction-bits root1)))
          ;; Replay check
          (let ((ev1 (evaluate (subexpression-abstraction-model best-comp1) nil nil :ledger work)))
            (check (eq :value (evaluation-status ev1)))
            (check (equal trees1 (decode-tree-corpus (evaluation-value ev1))))))
        ;; Repetition scaling: repetitions = 2 increases bit gain strictly
        (multiple-value-bind (trees2 inputs2 oracle2)
            (planted-abstraction-fixture :domain domain :repetitions 2 :ledger work)
          (multiple-value-bind (best-comp2 best-struct2)
              (discover-subexpression-abstractions trees2 inputs2 :ledger work)
            (check (patterns-isomorphic-p (getf oracle2 :pattern)
                                          (subexpression-abstraction-pattern best-struct2)
                                          inputs2 work))
            (check (equal (getf oracle2 :paths) (subexpression-abstraction-paths best-struct2)))
            (check (> (subexpression-abstraction-gain best-comp2)
                      (subexpression-abstraction-gain best-comp1)))
            (let ((ev2 (evaluate (subexpression-abstraction-model best-comp2) nil nil :ledger work)))
              (check (eq :value (evaluation-status ev2)))
              (check (equal trees2 (decode-tree-corpus (evaluation-value ev2)))))))))))

(deftest abstraction-unrelated-tree-controls-and-randomized-trials
  (let* ((domain :int)
         (work (make-ledger)))
    (multiple-value-bind (mixed-trees mixed-inputs mixed-oracle)
        (planted-abstraction-fixture :domain domain :repetitions 2 :include-unrelated-p t :ledger work)
      (multiple-value-bind (best-comp best-struct)
          (discover-subexpression-abstractions mixed-trees mixed-inputs :ledger work)
        (check (patterns-isomorphic-p (getf mixed-oracle :pattern)
                                      (subexpression-abstraction-pattern best-struct)
                                      mixed-inputs work))
        (check (equal (getf mixed-oracle :paths)
                      (subexpression-abstraction-paths best-struct)))
        (check (plusp (subexpression-abstraction-gain best-comp)))
        (let ((ev (evaluate (subexpression-abstraction-model best-comp) nil nil :ledger work)))
          (check (eq :value (evaluation-status ev)))
          (check (equal mixed-trees (decode-tree-corpus (evaluation-value ev)))))))
    ;; Deterministic LCG randomized planted-template trials
    (let ((state 424242))
      (dotimes (trial 3)
        (multiple-value-bind (r-trees r-inputs r-oracle next-state)
            (randomized-planted-abstraction-fixture :domain domain :state state :count 4
                                                    :include-unrelated-p t :ledger work)
          (declare (ignore r-oracle))
          (setf state next-state)
          (multiple-value-bind (best-comp best-struct)
              (discover-subexpression-abstractions r-trees r-inputs :ledger work)
            (check (plusp (subexpression-abstraction-structural-score best-struct)))
            (dolist (prop (list best-comp best-struct))
              (let ((ev (evaluate (subexpression-abstraction-model prop) nil nil :ledger work)))
                (check (eq :value (evaluation-status ev)))
                (check (equal r-trees (decode-tree-corpus (evaluation-value ev))))))))))))

(deftest abstraction-validated-law-alternate-syntax
  (let* ((domain (gf 5))
         (work (make-ledger))
         (law-inputs (list (cons 0 domain)))
         (x (var 0 domain))
         (zero (lit domain 0))
         (one (lit domain 1))
         (plus (op :+ domain))
         (mul (op :* domain))
         (v1 (start-law-validation (make-law domain law-inputs (app plus x zero) x)))
         (v2 (start-law-validation (make-law domain law-inputs (app mul x one) x))))
    (resume-law-validation v1 100000)
    (resume-law-validation v2 100000)
    (check (eq :validated (law-validation-status v1)))
    (check (eq :validated (law-validation-status v2)))
    (let* ((library (prepare-rewrite-library (list v1 v2) domain))
           (scope (list (cons 0 domain) (cons 1 domain)))
           (a (var 0 domain))
           (b (var 1 domain))
           (sub0 (app mul a (lit domain 2)))
           (sub1 (app mul b (lit domain 3)))
           (sub2 (app mul (app plus a b) (lit domain 4)))
           (raw-trees
             (list (app plus sub0 sub0)
                   (app plus sub1 sub1)
                   (app plus (app plus sub2 zero) sub2)
                   (app plus sub0 (app mul sub0 one)))))
      (multiple-value-bind (raw-best-comp raw-best-struct raw-proposals)
          (discover-subexpression-abstractions raw-trees scope :domain domain :ledger work)
        (declare (ignore raw-best-struct))
        (multiple-value-bind (norm-best-comp norm-best-struct norm-proposals norm-corpus norm-trees)
            (discover-subexpression-abstractions raw-trees scope :domain domain
                                                 :rewrite-library library :ledger work)
          (declare (ignore norm-best-struct norm-corpus))
          (let ((raw-root (find :aligned-root raw-proposals :key #'subexpression-abstraction-kind))
                (norm-root (find :aligned-root norm-proposals :key #'subexpression-abstraction-kind)))
            ;; Raw trees retain exact AST spelling while normalized trees rewrite (+ sub2 0) and (* sub0 1)
            (check (not (equal raw-trees norm-trees)))
            (let ((ev-raw (evaluate (subexpression-abstraction-model raw-best-comp) nil nil :ledger work))
                  (ev-norm (evaluate (subexpression-abstraction-model norm-best-comp) nil nil :ledger work)))
              (check (equal raw-trees (decode-tree-corpus (evaluation-value ev-raw))))
              (check (equal norm-trees (decode-tree-corpus (evaluation-value ev-norm)))))
            ;; Validated law rewriting exposes a tighter LGG and smaller corpus description S
            (check (> (subexpression-abstraction-structural-score norm-root)
                      (subexpression-abstraction-structural-score raw-root)))
            (check (< (subexpression-abstraction-bits norm-root)
                      (subexpression-abstraction-bits raw-root)))))))
    ;; On :INT, sampled laws remain :conjecture and are rejected by prepare-rewrite-library,
    ;; while raw syntactic AU works on :INT and preserves exact AST spelling.
    (let* ((int-x (var 0 :int))
           (int-zero (lit :int 0))
           (int-one (lit :int 1))
           (int-plus (op :+ :int))
           (int-mul (op :* :int))
           (int-law (make-law :int '((0 . :int)) (app int-plus int-x int-zero) int-x))
           (int-val (start-law-validation int-law :samples '((-2) (-1) (0) (1) (2)))))
      (resume-law-validation int-val 100000)
      (check (eq :conjecture (law-validation-status int-val)))
      (raises (prepare-rewrite-library (list int-val) :int))
      (let* ((int-scope '((0 . :int) (1 . :int)))
             (int-a (var 0 :int))
             (int-b (var 1 :int))
             (int-sub0 (app int-mul int-a (lit :int 2)))
             (int-sub1 (app int-mul int-b (lit :int 3)))
             (int-sub2 (app int-mul (app int-plus int-a int-b) (lit :int 4)))
             (int-trees
               (list (app int-plus int-sub0 int-sub0)
                     (app int-plus int-sub1 int-sub1)
                     (app int-plus (app int-plus int-sub2 int-zero) int-sub2)
                     (app int-plus int-sub0 (app int-mul int-sub0 int-one)))))
        (multiple-value-bind (int-best-comp int-best-struct int-proposals)
            (discover-subexpression-abstractions int-trees int-scope :domain :int :ledger work)
          (declare (ignore int-best-struct))
          (let ((int-root (find :aligned-root int-proposals :key #'subexpression-abstraction-kind))
                (ev-int (evaluate (subexpression-abstraction-model int-best-comp) nil nil :ledger work)))
            (check (= 2 (length (pattern-holes (app int-plus (app int-mul (hole 0 :int) (hole 1 :int))
                                                    (app int-mul (hole 0 :int) (hole 1 :int)))))))
            (check (= 5 (length (pattern-holes (subexpression-abstraction-pattern int-root)))))
            (check (equal int-trees (decode-tree-corpus (evaluation-value ev-int))))))))))

(deftest abstraction-experiment-runner
  (let ((output (with-output-to-string (*standard-output*)
                  (run-m6))))
    (check (search "M6 / Stages 1-3" output))
    (check (search "M6 / Stage 4" output))
    (check (search "M6 / Stage 5" output))))
