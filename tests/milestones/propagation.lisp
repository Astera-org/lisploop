(in-package #:lisploop)

(deftest propagator-dsl-matching-and-library-isolation
  (dolist (domain (list (gf 5) (gf 7) :int))
    (let* ((work (make-ledger))
           (controls (reverse (arithmetic-controls domain)))
           (library (prepare-propagator-library controls work))
           (inputs (arithmetic-inputs domain))
           (known (app (op :+ domain) (var 0 domain) (lit domain 1)))
           (parent (simple-frame domain inputs '(((1 0) 2)))))
      (dolist (discovery (arithmetic-controls domain))
        (let* ((operator (arithmetic-relation-operator (solve-discovery-relation discovery)))
               (position (solve-discovery-position discovery))
               (decoder (arithmetic-application operator position known (var 99 domain)))
               (raw (pullback-frame parent decoder 99 domain nil work))
               (cold (make-ledger))
               (prop (propagate-requirements raw (discovery-propagator-library controls cold) cold)))
          (check (= 1 (+ (propagation-narrowed prop) (propagation-suggested prop))))
          (check (listp (extract-allowed-values (row-requirement (first (frame-rows (propagation-frame prop)))))))
          (let* ((warm (make-ledger))
                 (warm-prop (propagate-requirements raw library warm)))
            (check (= 1 (+ (propagation-narrowed warm-prop) (propagation-suggested warm-prop))))
            ;; Pre-prepared library amortizes preparation overhead compared to cold rule conversion.
            (check (< (ledger-total warm) (ledger-total cold))))))
      ;; Nested linear application unwinds across multiple steps
      (let* ((nested (app (op :+ domain) known (app (op :+ domain) (var 99 domain) (lit domain 1))))
             (prop (propagate-requirements (pullback-frame parent nested 99 domain nil work) library work)))
        (check (equal (list (if (eq domain :int) -1 (1- (second domain))))
                      (extract-allowed-values (row-requirement (first (frame-rows (propagation-frame prop))))))))
      ;; Bare variable and non-linear occurrence remain un-narrowed
      (dolist (decoder (list (var 99 domain) (app (op :* domain) (var 99 domain) (var 99 domain))))
        (let ((prop (propagate-requirements (pullback-frame parent decoder 99 domain nil work) library work)))
          (check (zerop (+ (propagation-narrowed prop) (propagation-suggested prop))))
          (check (= 1 (propagation-retained prop)))))
      (let* ((other (if (eq domain :int) (gf 5) :int))
             (other-parent (simple-frame other (arithmetic-inputs other) '(((1 0) 2))))
             (other-raw (pullback-frame other-parent (app (op :+ other) (var 0 other) (var 99 other)) 99 other nil work))
             (other-prop (propagate-requirements other-raw library work)))
        (check (zerop (+ (propagation-narrowed other-prop) (propagation-suggested other-prop)))))
      (setf (propagator-library-versions library) '(0 0 0))
      (raises (propagate-requirements (pullback-frame parent known 99 domain nil work) library work))))
  (let* ((discovery (copy-solve-discovery (arithmetic-control :int :+ 1))) (work (make-ledger))
         (library (prepare-propagator-library (list discovery) work))
         (saved (copy-tree (arithmetic-propagator-witness (first (propagator-library-rules library))))))
    (setf (solve-discovery-witness discovery) (lit :int 999))
    (check (equal saved (arithmetic-propagator-witness (first (propagator-library-rules library)))))
    (check (null (propagator-library-rules (prepare-propagator-library (list discovery) work))))))

(deftest integer-proposals-check-original-forward-requirements
  (let* ((discovery (copy-solve-discovery (arithmetic-control :int :+ 1)))
         (decoder (app (op :+ :int) (var 0 :int) (var 9 :int)))
         (bindings (list (cons 3 (var 1 :int))))
         (parent (simple-frame :int (arithmetic-inputs :int) '(((0 0) 2) ((1 1) 3))))
         (work (make-ledger))
         (raw (pullback-frame parent decoder 9 :int bindings work)))
    ;; Fits k=0, but fails on the new k=1 row. No stale certificate is used.
    (setf (solve-discovery-witness discovery) (var 1 :int) (solve-discovery-guard discovery) (lit :bool t))
    (validate-arithmetic-solver discovery :samples '((0 2)) :uniqueness-samples '((0 2 2)))
    (let ((propagation (propagate-requirements raw (discovery-propagator-library discovery work) work)))
      (check (= 1 (propagation-suggested propagation))) (check (= 1 (propagation-rejected propagation)))
      (check (= 1 (propagation-retained propagation))) (check (propagation-fallback propagation))
      (check (equal '(2) (extract-allowed-values (row-requirement (first (frame-rows (propagation-frame propagation)))))))
      (check (equalp (second (frame-rows (propagation-original propagation)))
                     (second (frame-rows (propagation-frame propagation))))))
    ;; A fresh runtime error also falls back; the guard is not trusted to prevent it.
    (setf (solve-discovery-witness discovery) (app (op :/ :int) (var 1 :int)
                                                   (app (op :- :int) (var 0 :int) (lit :int 1))))
    (validate-arithmetic-solver discovery :samples '((0 0)) :uniqueness-samples '((0 0 0)))
    (let ((propagation (propagate-requirements raw (discovery-propagator-library discovery (make-ledger)) (make-ledger))))
      (check (zerop (propagation-suggested propagation)))
      (check (equalp (propagation-original propagation) (propagation-frame propagation))))))

(defun division-propagation-control (&optional coupled corrupt)
  (let* ((discovery (arithmetic-control :int :/ 0))
         (parent (simple-frame :int (arithmetic-inputs :int)
                               (if coupled '(((2 0) 1) ((3 0) 1)) '(((2 0) 1)))))
         (ledger (make-ledger))
         (raw (pullback-frame parent (app (op :/ :int) (var 9 :int) (var 0 :int))
                              9 :int (list (cons 3 (var 1 :int))) ledger))
         (propagation (propagate-requirements raw (discovery-propagator-library discovery ledger) ledger))
         (inputs (schema-inputs (frame-schema (propagation-frame propagation))))
         (language (make-language :int inputs :operators nil :literals '(0 1 2 3 4))))
    (when corrupt
      (setf (propagation-frame propagation) (simple-frame :int inputs '(((0) 0)))))
    (values propagation language (+ (header-size inputs :int) 7))))

(deftest tentative-failure-and-success-both-preserve-integer-alternatives
  (dolist (case '((nil nil) (t nil) (nil t)))
    (multiple-value-bind (propagation language bound) (division-propagation-control (first case) (second case))
      (let ((state (start-propagation-search propagation language :quantum 32)))
        (check (eq :candidate (message-claim (resume-propagation-search state bound 1000000 :stop-on-first t))))
        (check (propagation-search-fallback state))
        (check (eq :bounded-exhaustion (message-claim (resume-propagation-search state bound 1000000))))
        (let ((values (sort (mapcar (lambda (c) (result (candidate-expression c) (language-inputs language) '(0)))
                                    (propagation-search-results state))
                            #'<)))
          (check (equal (if (first case) '(3) '(2 3)) values)))
        (when (first case)
          (check (null (search-job-results (propagation-search-primary state)))))
        ;; Corrupt tentative proposal (0) is found in primary but rejected by forward replay against original frame.
        (when (second case)
          (check (search-job-results (propagation-search-primary state)))
          (check (not (member 0 (mapcar (lambda (c) (result (candidate-expression c) (language-inputs language) '(0)))
                                        (propagation-search-results state))))))))))

(deftest propagation-search-resumption-and-bound-extension
  (multiple-value-bind (propagation language bound) (division-propagation-control)
    (let ((last-step-claim nil))
      (check-anytime-resumption
       :make-job (lambda () (start-propagation-search propagation language :quantum 17))
       :advance (lambda (ps &key limit final)
                  (declare (ignore final))
                  (let ((msg (resume-propagation-search ps bound (or limit 1000000))))
                    (when limit (setf last-step-claim (message-claim msg)))))
       :work-fn (lambda (ps) (ledger-total (propagation-search-ledger ps)))
       :score-fn (lambda (ps) (and (propagation-search-best ps)
                                   (candidate-size (propagation-search-best ps))))
       :view-fn (lambda (ps)
                  (let ((inputs (language-inputs (search-job-language (propagation-search-primary ps)))))
                    (list (propagation-search-first-work ps)
                          (and (propagation-search-best ps)
                               (candidate-size (propagation-search-best ps)))
                          (canonical-expression-sort
                           (mapcar #'candidate-expression (propagation-search-results ps))
                           inputs))))
       :exhaustive-p t)
      (check (eq :bounded-exhaustion last-step-claim)))
    (let ((state (start-propagation-search propagation language)))
      (check (eq :bounded-exhaustion (message-claim (resume-propagation-search state (1- bound) 1000000))))
      (check (null (propagation-search-results state)))
      (check (eq :bounded-exhaustion (message-claim (resume-propagation-search state bound 1000000))))
      (check (= 2 (length (propagation-search-results state)))))))

(deftest verified-integer-propagation-amortizes-expensive-forward-context
  (multiple-value-bind (plain guided original-work propagation-work acquisition replay)
      (integer-propagation-cost-control (arithmetic-controls :int))
    (check (< (+ (ledger-total propagation-work) (propagation-search-first-work guided))
              (+ (ledger-total original-work) (algebra-first-work plain))))
    (check (plusp acquisition))
    (check (plusp (ledger-total replay)))
    (check (propagation-search-fallback guided))
    (check (same-set-p (search-job-results plain) (propagation-search-results guided)
                       :key #'candidate-expression))))
