(in-package #:lisploop)

(defun compression-test-job (corpus models &optional (weight 0))
  (start-search (law-corpus-frame corpus) (make-language :int nil :operators nil :literals nil)
                :expressions models :run-weight weight :call-id :compression-test))

(defun compression-replay (model)
  (let ((run (evaluate (decode-model (encode-model model)) nil nil :budget 100000000)))
    (check (eq :value (evaluation-status run)))
    (decode-law-corpus (evaluation-value run))))

(defun same-law-syntax-p (left right)
  (and (equal (law-domain left) (law-domain right))
       (equal (law-inputs left) (law-inputs right))
       (equal (law-equation left) (law-equation right))
       (equal (law-guard left) (law-guard right))))

(deftest au-law-repeated-expression-and-operator-holes
  (let* ((laws (loop for n in '(2 3 4) for name in '(:+ :* :-) collect
                 (let* ((v (lit :int n))
                        (expression (app (op name :int) v v))
                        (guard (bool-not (app (op := :int) v (lit :int 0)))))
                   (make-law :int nil expression expression :guard guard))))
         (corpus (make-law-corpus laws)))
    (multiple-value-bind (models pattern substitutions groups) (propose-law-compressions corpus)
      (check (= 1 (length groups)))
      (check (some (lambda (binding) (operator-p (cdr binding))) (first substitutions)))
      (loop for law in laws for substitution in substitutions do
        (check (equal (law-statement law) (instantiate pattern substitution))))
      (dolist (model models)
        (check-codec-roundtrip model nil)
        (check (every #'same-law-syntax-p laws (compression-replay model))))
      ;; A complete instantiation needs all hole bindings and their exact sorts.
      (let ((pieces (au-packet-pieces pattern nil)))
        (raises (instantiate-packet-pieces pieces nil nil))
        (raises (instantiate-packet-pieces pieces (mapcar (lambda (b) (cons (car b) (lit :bool t)))
                                                          (first substitutions))
                                           nil)))
      (let* ((changed (copy-tree substitutions))
             (binding (find-if (lambda (entry) (and (lit-p (cdr entry))
                                                    (eq :int (ast-type (cdr entry)))))
                               (first changed))))
        (check binding)
        (setf (cdr binding) (lit :int 99))
        (let* ((wrong (law-template-model corpus pattern changed))
               (job (compression-test-job corpus (list wrong))))
          (resume-search job (description-size wrong) 1000000)
          (check (null (search-job-results job)))
          (check (= 1 (search-job-rejected job)))))
      ;; No template/generalization receives a certificate by being reconstructed.
      (let ((decoded (compression-replay (third models))))
        (check (every (lambda (law) (equal '(:decoded-syntax) (law-origin law))) decoded))
        (check (eq :unknown (law-validation-status (start-law-validation (first decoded)))))))))

(deftest au-law-corpus-occurrences-isolation-and-type-boundaries
  (let* ((domain (gf 5)) (inputs (list (cons 99 domain))) (x (var 99 domain))
         (a (make-law domain inputs (app (op :+ domain) x (lit domain 0)) x))
         (b (make-law domain inputs (app (op :* domain) x (lit domain 1)) x))
         (laws (list b a b a a)) (corpus (make-law-corpus laws)))
    (multiple-value-bind (models pattern substitutions groups) (propose-law-compressions corpus)
      (declare (ignore pattern substitutions))
      (check (equal '(0 1 2 3 4) (sort (mapcan (lambda (g) (copy-list (law-template-group-positions g))) groups) #'<)))
      (dolist (model models)
        (let ((decoded (compression-replay model)))
          (check (= 5 (length decoded)))
          (check (every #'same-law-syntax-p laws decoded))
          (check (every (lambda (law) (eq :validated (law-validation-status (checked-law law)))) decoded))))
      (let ((saved (encode-model (third models))))
        (setf (law-guard a) (lit :bool nil))
        (check (equal (lit :bool t) (law-guard (second (law-corpus-laws corpus)))))
        (setf (law-corpus-packet corpus) nil (law-corpus-laws corpus) nil)
        (check (= 5 (length (compression-replay (decode-model saved)))))))
    (raises (make-law-corpus (list b (retype-law b (gf 7)))))
    (raises (make-law-corpus (list b (make-law domain nil (lit domain 0) (lit domain 0))))))
  (raises (make-law-corpus nil))
  (raises (decode-law-corpus nil))
  (raises (decode-law-corpus (bits-as-values (encode-model (lit :int 0)))))
  (let* ((law (make-law :int nil (lit :int 0) (lit :int 0))) (corpus (make-law-corpus (list law))))
    (raises (decode-law-corpus (butlast (law-corpus-packet corpus))))))

(deftest compression-checks-syntax-including-guards-not-boolean-outputs
  (let* ((left (app (op :+ :int) (lit :int 2) (lit :int 0))) (right (lit :int 2))
         (a (make-law :int nil left right)) (b (make-law :int nil left right :guard (lit :bool nil)))
         (corpus (make-law-corpus (list a b)))
         (wrong-corpus (make-law-corpus (list a a)))
         (wrong (lit (sequence-type :bool) (law-corpus-packet wrong-corpus))))
    (check (eq t (result (law-statement a))))
    (check (eq t (result (law-statement b))))
    (let ((job (compression-test-job corpus (list wrong))))
      (check (eq :replay-complete (message-claim (resume-search job (description-size wrong) 1000000))))
      (check (null (search-job-results job)))
      (check (= 1 (search-job-rejected job)))))
  ;; Lossless storage of a false law is possible, and never upgrades its evidence.
  (let* ((domain (gf 5)) (inputs (list (cons 0 domain))) (x (var 0 domain))
         (bad (make-law domain inputs (app (op :/ domain) x x) (lit domain 1)))
         (models (propose-law-compressions (make-law-corpus (list bad)))))
    (let ((state (resume-law-validation (start-law-validation (first (compression-replay (third models)))) 100000)))
      (check (eq :refuted (law-validation-status state)))
      (check (null (law-validation-certificate state)))
      (check (equal '(0) (getf (law-validation-counterexample state) :inputs))))))

(deftest au-compression-cutoffs-objective-and-negative-gain
  (let* ((laws (loop for n from 2 to 12 collect
                 (make-law :int nil (app (op :+ :int) (lit :int n) (lit :int 0)) (lit :int n))))
         (corpus (make-law-corpus laws))
         (models (propose-law-compressions corpus))
         (bound (reduce #'max models :key #'description-size))
         (frame (law-corpus-frame corpus))
         (language (make-language :int nil :operators nil :literals nil)))
    (check-search-resumption
     (lambda () (start-search frame language :expressions models :call-id :unit-batch))
     bound :budget 10000000)
    (dolist (weight '(0 1 100))
      (let ((job (compression-test-job corpus models weight)))
        (resume-search job bound 10000000)
        (check (= (candidate-score (search-job-best job) weight)
                  (reduce #'min (search-job-results job)
                          :key (lambda (c) (+ (candidate-size c) (* weight (candidate-run-work c))))))))))
  (let* ((law (make-law :int nil (lit :int 0) (lit :int 0)))
         (corpus (make-law-corpus (list law)))
         (models (propose-law-compressions corpus))
         (job (compression-test-job corpus models)))
    (check (> (description-size (third models)) (description-size (first models))))
    (resume-search job (reduce #'max models :key #'description-size) 1000000)
    (check (equal (first models) (candidate-expression (search-job-best job))))))

(deftest au-compression-of-jointly-discovered-field-laws
  (dolist (p '(5 7))
    (let* ((validations (discover-guarded-field-laws p)) (ledger (make-ledger))
           (laws (mapcar #'law-validation-law validations)) (corpus (make-law-corpus laws ledger)))
      (multiple-value-bind (models pattern substitutions groups) (propose-law-compressions corpus ledger)
        (check (plusp (ledger-total ledger)))
        (check (= 5 (length groups)))
        (loop for law in laws for substitution in substitutions do
          (check (equal (law-statement law) (instantiate pattern substitution))))
        (let ((bound (reduce #'max models :key #'description-size))
              (job (compression-test-job corpus models)))
          (check (eq :replay-complete (message-claim (resume-search job bound 100000000))))
          (check (= 4 (length (search-job-results job))))
          (check (< (candidate-size (search-job-best job)) (description-size (first models))))
          (check (equal (third models) (candidate-expression (search-job-best job))))
          (let ((fast (compression-test-job corpus models 100)))
            (resume-search fast bound 100000000)
            (check (equal (first models) (candidate-expression (search-job-best fast))))
            (check (< (candidate-run-work (search-job-best fast))
                      (candidate-run-work (search-job-best job)))))
          (let ((decoded (compression-replay (candidate-expression (search-job-best job)))))
            (check (= (length laws) (length decoded)))
            (loop for original in laws for law in decoded do
              (check (same-law-syntax-p original law))
              (check (eq :validated (law-validation-status (checked-law law)))))))))))
